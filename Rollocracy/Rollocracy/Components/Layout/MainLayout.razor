            </div>

            <div class="rc-topbar__right">
                @if (CurrentSession is not null && CanViewSessionHeaderInfo)
                {
                    <div class="rc-session-strip">
                        <h5 class="rc-tool-panel__title">@L["Session_Manage_JoinUrl"]</h5>

                        <div class="rc-session-strip__group">
                            @if (CurrentSession.IsActive)
                            {
                                <code class="rc-session-strip__value rc-session-strip__value--link">@JoinUrl</code>
                            }
                            else
                            {
                                <code class="rc-session-strip__value rc-session-strip__value--inactive">@L["Session_Inactive"]</code>
                            }
                        </div>

                        <div class="rc-session-strip__group">
                            <span class="rc-session-strip__label">@L["Common_Password"]</span>
                            <div class="rc-session-strip__password">
                                <code class="rc-session-strip__value">@DisplayedPassword</code>
                                @if (!string.IsNullOrWhiteSpace(CurrentSession.SessionPassword))
                                {
                                    <button type="button"
                                            class="icon-button"
                                            @onclick="ToggleSessionPasswordVisibility"
                                            title="@(ShowSessionPassword? L["Session_Manage_HidePassword"] : L["Session_Manage_ShowPassword"])">
                                        👁
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="rc-session-strip__group">
                            <span class="rc-session-strip__label">@L["Session_ConnectedPlayers"]</span>
                            <span class="rc-session-strip__value">@(CurrentSessionStats?.ConnectedPlayersCount ?? 0)</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="rc-topbar__quick-actions">
                        <button type="button"
                                class="icon-button rc-alert-sound-toggle"
                                title="@(IsAlertSoundEnabled? L["Navigation_DisableAlertSound"] : L["Navigation_EnableAlertSound"])"
                                @onclick="ToggleAlertSound">
                            @if (IsAlertSoundEnabled)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor" aria-hidden="true"><path d="M560-131v-82q90-26 145-100t55-167q0-93-55-167t-145-100v-82q124 29 202 128.5T840-480q0 122-78 221.5T560-131ZM120-360v-240h160l200-200v640L280-360H120Zm280 4v-248L314-520H200v80h114l86 84Zm100 76v-401q47 22 73.5 66.5T600-520q0 49-26.5 93.5T500-360v80Zm0-160Zm0 0Z" /></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor" aria-hidden="true"><path d="m616-320-56-56q33-11 56.5-39.5T640-480q0-36-23.5-64.5T560-584l56-56q45 26 72.5 71t27.5 89q0 44-27.5 89T616-320ZM792-56 56-792l56-56 736 736-56 56ZM400-599 286-485H200v10l-80-80v-45h160l200-200v201l-80-80Zm80 440L280-359H120v-160L36-603l57-57 387 387v114Zm80-201-80-80v-360q64 24 102 78t38 122q0 10-1 20t-3 20l-56-56v-1q0-38-21-70.5T500-553v193l-20-20Z" /></svg>
                            }
                        </button>

                        <a class="rc-support-link"
                               href="@SupportRollocracyUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="@L["Navigation_SupportRollocracy"]">
                            <span class="rc-support-link__text">@L["Navigation_SupportRollocracy"]</span>
                            <span class="rc-support-link__icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="M640-440 474-602q-31-30-52.5-66.5T400-748q0-55 38.5-93.5T532-880q32 0 60 13.5t48 36.5q20-23 48-36.5t60-13.5q55 0 93.5 38.5T880-748q0 43-21 79.5T807-602L640-440Zm0-112 109-107q19-19 35-40.5t16-48.5q0-22-15-37t-37-15q-14 0-26.5 5.5T700-778l-60 72-60-72q-9-11-21.5-16.5T532-800q-22 0-37 15t-15 37q0 27 16 48.5t35 40.5l109 107ZM280-220l278 76 238-74q-5-9-14.5-15.5T760-240H558q-27 0-43-2t-33-8l-93-31 22-78 81 27q17 5 40 8t68 4q0-11-6.5-21T578-354l-234-86h-64v220ZM40-80v-440h304q7 0 14 1.5t13 3.5l235 87q33 12 53.5 42t20.5 66h80q50 0 85 33t35 87v40L560-60l-280-78v58H40Zm80-80h80v-280h-80v280Zm520-546Z" /></svg>
                            </span>
                        </a>
                    </div>
                }
            </div>
        </header>
        @if (CurrentSession is not null && CanViewSessionGauges)
        {
            <div class="rc-global-session-gauges">
                <div class="rc-session-gauge-strip">

                    @foreach (var gauge in CurrentSessionGauges)
                    {
                        var percent = gauge.MaxValue <= gauge.MinValue
                            ? 0
                            : Math.Clamp((int)Math.Round((double)(gauge.CurrentValue - gauge.MinValue) * 100 / (gauge.MaxValue - gauge.MinValue)), 0, 100);

                        @if (CanEditSessionGauges && EditingSessionGaugeId != gauge.SessionGaugeId)
                        {
                            <button type="button"
                                    class="rc-session-gauge-card rc-session-gauge-card--button"
                                    @onclick="() => BeginSessionGaugeEdit(gauge.SessionGaugeId, gauge.CurrentValue)">
                                <div class="rc-session-gauge-card__header">
                                    <span class="rc-session-gauge-card__name">@gauge.Name</span>
                                    <span class="rc-session-gauge-card__value">@gauge.CurrentValue / @gauge.MaxValue</span>
                                </div>

                                <div class="rc-session-gauge-card__track">
                                    <div class="rc-session-gauge-card__fill" style="@($"width:{percent}%")"></div>
                                </div>
                            </button>
                        }
                        else
                        {
                            <div class="rc-session-gauge-card">
                                <div class="rc-session-gauge-card__header">
                                    <span class="rc-session-gauge-card__name">@gauge.Name</span>
                                    <span class="rc-session-gauge-card__value">@gauge.CurrentValue / @gauge.MaxValue</span>
                                </div>

                                <div class="rc-session-gauge-card__track">
                                    <div class="rc-session-gauge-card__fill" style="@($"width:{percent}%")"></div>
                                </div>

                                @if (CanEditSessionGauges && EditingSessionGaugeId == gauge.SessionGaugeId)
                                {
                                    <div class="rc-session-gauge-card__editor">
                                        <input type="number"
                                               min="@gauge.MinValue"
                                               max="@gauge.MaxValue"
                                               value="@GetSessionGaugeEditedValue(gauge.SessionGaugeId, gauge.CurrentValue)"
                                               @onchange="e => ChangeSessionGaugeEditedValue(gauge.SessionGaugeId, int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : gauge.CurrentValue)" />
                                        <button type="button"
                                                class="rc-round-icon-button"
                                                @onclick="() => SaveSessionGaugeQuickValue(gauge.SessionGaugeId)"
                                                title="@L["Common_Yes"]">
                                            ✓
                                        </button>
                                        <button type="button"
                                                class="rc-round-icon-button"
                                                @onclick="CancelSessionGaugeEdit"
                                                title="@L["Common_Cancel"]">
                                            ✕
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(SessionGaugeMessage))
                {
                    <div class="rc-inline-error">@SessionGaugeMessage</div>
                }
            </div>
        }

        <main class="rc-main">
            <article class="rc-main__content">
                <CascadingValue Name="RollocracyAlertSoundEnabled" Value="IsAlertSoundEnabled">
                    @Body
                </CascadingValue>
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    @L["Layout_GlobalUnhandledError"]
    <a href="" class="reload">@L["Layout_Reload"]</a>
    <a class="dismiss">@L["Common_Close"]</a>
</div>

@code {
    private HubConnection? hubConnection;
    private bool IsSidebarCollapsed;
    private bool CanShowMjMenus;
    private bool CanShowCurrentSessionMjMenus;
    private bool ShowSessionPassword;
    private bool CanViewSessionHeaderInfo;
    private bool CanViewSessionGauges;
    private bool CanEditSessionGauges;

    private string CurrentTheme = "light";
    private string CurrentUserDisplayName = string.Empty;
    private string JoinUrl = string.Empty;
    private string SessionGaugeMessage = string.Empty;
    private bool IsAlertSoundEnabled = true;
    private const string SupportRollocracyUrl = "https://ko-fi.com/lunelianjdr";

    private Guid? CurrentUserId;
    private Guid? CurrentSessionId;
    private Session? CurrentSession;
    private SessionPublicStatsDto? CurrentSessionStats;
    private List<SessionGaugeDto> CurrentSessionGauges = new();

    private readonly Dictionary<Guid, int> SessionGaugeEditedValues = new();
    private Guid? EditingSessionGaugeId;

    private string DisplayedPassword
        => CurrentSession is null
            ? string.Empty
            : string.IsNullOrWhiteSpace(CurrentSession.SessionPassword)
                ? L["Navigation_NoPassword"]
                : ShowSessionPassword
                    ? CurrentSession.SessionPassword
                    : "••••";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var theme = await JS.InvokeAsync<string>("rollocracyTheme.getTheme");
        CurrentTheme = string.IsNullOrWhiteSpace(theme) ? "light" : theme;
        await JS.InvokeVoidAsync("rollocracyTheme.applyTheme", CurrentTheme);

        await RefreshShellContextAsync();
        await EnsureHubConnectionAsync();

        StateHasChanged();
    }

    private async Task RefreshShellContextAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        CurrentUserDisplayName = user.Identity?.IsAuthenticated == true
            ? user.Identity?.Name ?? string.Empty
            : string.Empty;

        CanShowMjMenus = false;
        CanShowCurrentSessionMjMenus = false;
        CurrentUserId = null;

        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrWhiteSpace(userIdValue) && Guid.TryParse(userIdValue, out var userId))
        {
            CurrentUserId = userId;
            CanShowMjMenus = await SessionService.CanUserCreateSessionsAsync(userId);
        }

        CurrentSessionId = await TryExtractCurrentSessionIdAsync();
        CurrentSession = null;
        CurrentSessionStats = null;
        CurrentSessionGauges.Clear();
        SessionGaugeEditedValues.Clear();
        EditingSessionGaugeId = null;
        JoinUrl = string.Empty;
        ShowSessionPassword = false;
        CanViewSessionHeaderInfo = false;
        CanShowCurrentSessionMjMenus = false;
        CanViewSessionGauges = false;
        CanEditSessionGauges = false;
        SessionGaugeMessage = string.Empty;

        if (!CurrentSessionId.HasValue)
            return;

        CurrentSession = await SessionService.GetSessionByIdAsync(CurrentSessionId.Value);
        if (CurrentSession is null)
            return;

        CurrentSessionStats = await CharacterService.GetSessionPublicStatsAsync(CurrentSessionId.Value);
        if (CurrentUserId.HasValue)
        {
            CanViewSessionHeaderInfo = CurrentSession.GameMasterUserAccountId == CurrentUserId.Value;
            CanShowCurrentSessionMjMenus = CanViewSessionHeaderInfo;
        }

        if (!string.IsNullOrWhiteSpace(CurrentUserDisplayName))
        {
            JoinUrl = $"{Navigation.BaseUri}{CurrentUserDisplayName}/{CurrentSession.SessionSlug}";
        }
        else
        {
            JoinUrl = $"{Navigation.BaseUri}{CurrentSession.SessionSlug}";
        }

        if (CurrentUserId.HasValue)
        {
            var visibleGauges = await SessionService.GetVisibleSessionGaugesAsync(CurrentSessionId.Value, CurrentUserId.Value);

            CurrentSessionGauges = visibleGauges;
            CanViewSessionGauges = visibleGauges.Count > 0;

            foreach (var gauge in visibleGauges)
            {
                SessionGaugeEditedValues[gauge.SessionGaugeId] = gauge.CurrentValue;
            }

            if (CanViewSessionGauges)
            {
                var playerSession = await ResolveCurrentPlayerSessionAsync(CurrentSessionId.Value, CurrentUserId.Value);

                CanEditSessionGauges =
                    CurrentSession.GameMasterUserAccountId == CurrentUserId.Value ||
                    playerSession?.SpecialRole == SessionSpecialRole.Assistant;
            }
        }
    }

    private async Task<Guid?> TryExtractCurrentSessionIdAsync()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrWhiteSpace(relativePath))
            return null;

        var segments = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (segments.Length >= 3 &&
            segments[0].Equals("mj", StringComparison.OrdinalIgnoreCase) &&
            segments[1].Equals("session", StringComparison.OrdinalIgnoreCase) &&
            Guid.TryParse(segments[2], out var mjSessionId))
        {
            return mjSessionId;
        }

        if (segments.Length >= 3 &&
            segments[0].Equals("player", StringComparison.OrdinalIgnoreCase) &&
            segments[1].Equals("room", StringComparison.OrdinalIgnoreCase) &&
            Guid.TryParse(segments[2], out var playerSessionId))
        {
            var playerSession = await SessionService.GetPlayerByIdAsync(playerSessionId);
            return playerSession?.SessionId;
        }

        return null;
    }

    private async Task<PlayerSession?> ResolveCurrentPlayerSessionAsync(Guid sessionId, Guid userAccountId)
    {
        var players = await SessionService.GetPlayersAsync(sessionId);

        return players.FirstOrDefault(ps => ps.UserAccountId == userAccountId);
    }

    private async Task EnsureHubConnectionAsync()
    {
        if (hubConnection is not null)
            return;

        var internalBaseUrl = Configuration["InternalUrls:AppBaseUrl"];

        if (string.IsNullOrWhiteSpace(internalBaseUrl))
        {
            internalBaseUrl = Navigation.BaseUri.TrimEnd('/');
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{internalBaseUrl.TrimEnd('/')}/sessionhub")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("CharacterStateChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshShellContextAsync();
                StateHasChanged();
            });
        });

        hubConnection.On("PresenceChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshShellContextAsync();
                StateHasChanged();
            });
        });

        await hubConnection.StartAsync();

        if (CurrentSessionId.HasValue)
        {
            await hubConnection.SendAsync("JoinSessionGroup", CurrentSessionId.Value.ToString());
        }
    }

    private Task ToggleSidebar()
    {
        IsSidebarCollapsed = !IsSidebarCollapsed;
        return Task.CompletedTask;
    }

    private Task ToggleAlertSound()
    {
        IsAlertSoundEnabled = !IsAlertSoundEnabled;
        return Task.CompletedTask;
    }


    private async Task CycleTheme()
    {
        CurrentTheme = CurrentTheme == "light" ? "dark" : "light";
        await JS.InvokeVoidAsync("rollocracyTheme.setTheme", CurrentTheme);
    }

    private Task ToggleSessionPasswordVisibility()
    {
        ShowSessionPassword = !ShowSessionPassword;
        return Task.CompletedTask;
    }

    private int GetSessionGaugeEditedValue(Guid sessionGaugeId, int fallbackValue)
    {
        return SessionGaugeEditedValues.TryGetValue(sessionGaugeId, out var value)
            ? value
            : fallbackValue;
    }

    private void BeginSessionGaugeEdit(Guid sessionGaugeId, int currentValue)
    {
        EditingSessionGaugeId = sessionGaugeId;
        SessionGaugeEditedValues[sessionGaugeId] = currentValue;
        SessionGaugeMessage = string.Empty;
    }

    private void CancelSessionGaugeEdit()
    {
        EditingSessionGaugeId = null;
        SessionGaugeMessage = string.Empty;
    }

    private void ChangeSessionGaugeEditedValue(Guid sessionGaugeId, int value)
    {
        SessionGaugeEditedValues[sessionGaugeId] = value;
    }

    private async Task SaveSessionGaugeQuickValue(Guid sessionGaugeId)
    {
        if (!CurrentSessionId.HasValue || !CurrentUserId.HasValue || !SessionGaugeEditedValues.TryGetValue(sessionGaugeId, out var value))
            return;

        try
        {
            SessionGaugeMessage = string.Empty;

            await SessionService.UpdateSessionGaugeCurrentValueAsync(
                CurrentSessionId.Value,
                CurrentUserId.Value,
                sessionGaugeId,
                value);

            EditingSessionGaugeId = null;

            await RefreshShellContextAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            SessionGaugeMessage = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshShellContextAsync();

            if (hubConnection is not null && CurrentSessionId.HasValue)
            {
                await hubConnection.SendAsync("JoinSessionGroup", CurrentSessionId.Value.ToString());
            }

            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;

        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}