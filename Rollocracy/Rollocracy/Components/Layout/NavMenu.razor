@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public string CurrentUserDisplayName { get; set; } = string.Empty;
    [Parameter] public bool CanShowMjMenus { get; set; }
    [Parameter] public bool CanShowCurrentSessionMjMenus { get; set; }
    [Parameter] public Guid? CurrentSessionId { get; set; }
    [Parameter] public string CurrentTheme { get; set; } = "light";
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnCycleTheme { get; set; }
    
    private const string SupportRollocracyUrl = "https://ko-fi.com/lunelianjdr";
    private bool CanShowAdministrationLink;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (user.Identity?.IsAuthenticated == true && Guid.TryParse(userIdValue, out var userId))
        {
            CanShowAdministrationLink = await AdministrationService.IsAdministratorAsync(userId);
        }
    }

    private void HandleLogout()
    {
        Navigation.NavigateTo("/auth/logout", forceLoad: true);
    }
}
