@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Rollocracy.Localization
@inject IStringLocalizer<SharedTexts> L
@inject NavigationManager Navigation

<div class="rc-nav @(IsCollapsed ? "collapsed" : string.Empty)">
    <div class="rc-nav__header">
        <div class="rc-nav__header-actions">

            @if (IsCollapsed)
            {
                <button type="button"
                        class="icon-button"
                        title="@L["Navigation_ToggleSidebar"]"
                        @onclick="async () => await OnToggleSidebar.InvokeAsync()">
                    @(IsCollapsed ? "»" : "«")
                </button>
            }

            <button type="button"
                    class="icon-button"
                    title="@L["Navigation_CycleTheme"]"
                    @onclick="async () => await OnCycleTheme.InvokeAsync()">
                @ThemeGlyph
            </button>

            <button type="button"
                    class="icon-button"
                    title="@L["Navigation_SupportSoon"]"
                    disabled>
                ❤
            </button>

            @if (!IsCollapsed)
            {
                <button type="button"
                        class="icon-button"
                        title="@L["Navigation_ToggleSidebar"]"
                        @onclick="async () => await OnToggleSidebar.InvokeAsync()">
                    @(IsCollapsed ? "»" : "«")
                </button>
            }
        </div>

        <div class="rc-nav__welcome">
            <div class="rc-nav__welcome-label">@L["Navigation_Welcome"]</div>
            <div class="rc-nav__welcome-name">
                @(string.IsNullOrWhiteSpace(CurrentUserDisplayName)
                    ? L["Navigation_Guest"]
                    : CurrentUserDisplayName)
            </div>
        </div>
    </div>

    <nav class="rc-nav__sections">
        <div class="rc-nav__section">
            <AuthorizeView>
                <Authorizing>
                    <span class="rc-nav__loading">@L["Common_Loading"]</span>
                </Authorizing>

                <NotAuthorized>
                    <NavLink class="rc-nav__link" href="/login" title="@L["Auth_Login_Action"]">
                        <span class="rc-nav__icon">⇥</span>
                        <span class="rc-nav__label">@L["Auth_Login_Action"]</span>
                    </NavLink>

                    <NavLink class="rc-nav__link" href="/register" title="@L["Auth_Register_Title"]">
                        <span class="rc-nav__icon">＋</span>
                        <span class="rc-nav__label">@L["Auth_Register_Title"]</span>
                    </NavLink>
                </NotAuthorized>

                <Authorized>
                    <NavLink class="rc-nav__link" href="/account/settings" title="@L["Account_Settings_Title"]">
                        <span class="rc-nav__icon">⚙</span>
                        <span class="rc-nav__label">@L["Account_Settings_Title"]</span>
                    </NavLink>

                    <NavLink class="rc-nav__link" @onclick="HandleLogout" href="/auth/logout" title="@L["Auth_Logout_Action"]">
                        <span class="rc-nav__icon">⇤</span>
                        <span class="rc-nav__label">@L["Auth_Logout_Action"]</span>
                    </NavLink>

                    <NavLink class="rc-nav__link" href="/player/resume-sessions" title="@L["Navigation_PlayerResumeSessions"]">
                        <span class="rc-nav__icon">↺</span>
                        <span class="rc-nav__label">@L["Navigation_PlayerResumeSessions"]</span>
                    </NavLink>

                    <NavLink class="rc-nav__link" href="/join" title="@L["Session_Join_Title"]">
                        <span class="rc-nav__icon">⇢</span>
                        <span class="rc-nav__label">@L["Session_Join_Title"]</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </div>

        @if (CanShowMjMenus)
        {
            <div class="rc-nav__section">
                <NavLink class="rc-nav__link" href="/mj/gamesystems" title="@L["GameSystem_List_Title"]">
                    <span class="rc-nav__icon">◫</span>
                    <span class="rc-nav__label">@L["GameSystem_List_Title"]</span>
                </NavLink>

                <NavLink class="rc-nav__link" href="/mj/sessions" title="@L["Navigation_GameSessions"]">
                    <span class="rc-nav__icon">◎</span>
                    <span class="rc-nav__label">@L["Navigation_GameSessions"]</span>
                </NavLink>
            </div>
        }

        @if (CanShowMjMenus && CurrentSessionId.HasValue)
        {
            <div class="rc-nav__section">
                <NavLink class="rc-nav__link" href="@($"/mj/session/{CurrentSessionId.Value}")" Match="NavLinkMatch.All" title="@L["Navigation_ViewCharacters"]">
                    <span class="rc-nav__icon">▣</span>
                    <span class="rc-nav__label">@L["Navigation_ViewCharacters"]</span>
                </NavLink>

                <NavLink class="rc-nav__link" href="@($"/mj/session/{CurrentSessionId.Value}/test")" title="@L["Navigation_Test"]">
                    <span class="rc-nav__icon">⚄</span>
                    <span class="rc-nav__label">@L["Navigation_Test"]</span>
                </NavLink>

                <a class="rc-nav__link" href="@($"/mj/session/{CurrentSessionId.Value}/poll")" title="@L["Poll_Title"]">
                    <span class="rc-nav__icon">☰</span>
                    <span class="rc-nav__label">@L["Poll_Title"]</span>
                </a>

                <NavLink class="rc-nav__link" href="@($"/mj/session/{CurrentSessionId.Value}/mass-distribution")" title="@L["MassDistribution_Title"]">
                    <span class="rc-nav__icon">✦</span>
                    <span class="rc-nav__label">@L["MassDistribution_Title"]</span>
                </NavLink>

                <NavLink class="rc-nav__link" href="@($"/mj/session/{CurrentSessionId.Value}/random-draw")" title="@L["RandomDraw_Title"]">
                    <span class="rc-nav__icon">⟡</span>
                    <span class="rc-nav__label">@L["RandomDraw_Title"]</span>
                </NavLink>

                <NavLink class="rc-nav__link" href="@($"/mj/session/{CurrentSessionId.Value}/settings")" title="@L["Session_Settings_Title"]">
                    <span class="rc-nav__icon">⚙</span>
                    <span class="rc-nav__label">@L["Session_Settings_Title"]</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public string CurrentUserDisplayName { get; set; } = string.Empty;
    [Parameter] public bool CanShowMjMenus { get; set; }
    [Parameter] public Guid? CurrentSessionId { get; set; }
    [Parameter] public string CurrentTheme { get; set; } = "light";
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnCycleTheme { get; set; }

    private string ThemeGlyph => CurrentTheme == "dark" ? "☾" : "☀";

    private void HandleLogout()
    {
        Navigation.NavigateTo("/auth/logout", forceLoad: true);
    }
}
