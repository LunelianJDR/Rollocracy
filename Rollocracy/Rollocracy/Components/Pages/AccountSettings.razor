@page "/account/settings"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Net.Http.Json
@using System.Net.Mail
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Account
@using Rollocracy.Domain.Interfaces
@using Rollocracy.Localization
@using System.Linq
@inject IAccountService AccountService
@inject IAccountSecurityService AccountSecurityService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["Account_Settings_Title"]</PageTitle>

@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToLogin)
{
    <p>@L["Common_Loading"]</p>
}
else if (Settings is null)
{
    <div class="rc-inline-error">@L["Account_Settings_LoadError"]</div>
}
else
{
    <section class="rc-tool-section">
        <div class="rc-tool-layout">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Account_Settings_Title"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Account_Settings_Subtitle"]</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="rc-inline-warning">@Message</div>
                }

                <div class="rc-test-stats-grid">
                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["Account_Settings_Username"]</span>
                        <span class="rc-stat-card__value rc-stat-card__value--small">@Settings.Username</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["Account_Settings_Email"]</span>
                        <span class="rc-stat-card__value rc-stat-card__value--small">
                            @(string.IsNullOrWhiteSpace(Settings.Email) ? L["Account_Settings_NoEmail"] : Settings.Email)
                        </span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["Common_Language"]</span>
                        <span class="rc-stat-card__value rc-stat-card__value--small">@Settings.Language.ToUpperInvariant()</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["Account_Settings_MaxPlayersPerSession"]</span>
                        <span class="rc-stat-card__value">@Settings.MaxPlayersPerSession</span>
                    </div>
                </div>
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Account_Settings_GeneralSection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Account_Settings_GeneralSubtitle"]</p>
                    </div>
                </div>

                <div class="rc-tool-form-grid">
                    <div class="rc-form-field rc-form-field--full">
                        <label>@L["Account_Settings_Email"]</label>
                        <input @bind="EditableEmail" type="email" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Account_Settings_EmailVerificationStatus"]</label>
                        <div class="rc-readonly-value">
                            @(Settings.IsEmailVerified? L["Account_Settings_EmailVerified"] : L["Account_Settings_EmailNotVerifiedYet"])
                        </div>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Common_Language"]</label>
                        <select @bind="EditableLanguage">
                            <option value="fr">@L["Language_French"]</option>
                            <option value="en">@L["Language_English"]</option>
                        </select>
                    </div>
                </div>

                <div class="rc-tool-actions">
                    <button type="button" @onclick="SaveGeneralInfo">@L["Common_Save"]</button>
                </div>

                @if (string.IsNullOrWhiteSpace(Settings.Email))
                {
                    <div class="rc-inline-warning">@L["Account_Settings_NoEmailWarning"]</div>
                }
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Account_Settings_IdentitySection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Account_Settings_IdentitySubtitle"]</p>
                    </div>
                </div>

                <div class="rc-tool-form-grid">
                    <div class="rc-form-field">
                        <label>@L["Account_Settings_CurrentUsername"]</label>
                        <div class="rc-readonly-value">@Settings.Username</div>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Account_Settings_NewUsername"]</label>
                        <input @bind="NewUsername" disabled="@(!Settings.HasEmail)" />
                    </div>
                </div>

                @if (!Settings.HasEmail)
                {
                    <div class="rc-inline-warning">@L["Account_Settings_UsernameChangeRequiresEmail"]</div>
                }

                <div class="rc-tool-actions">
                    <button type="button" @onclick="SaveUsername" disabled="@(!Settings.HasEmail)">
                        @L["Account_Settings_SaveUsername"]
                    </button>
                </div>
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Account_Settings_SecuritySection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Account_Settings_SecuritySubtitle"]</p>
                    </div>
                </div>

                <div class="rc-tool-form-grid">
                    <div class="rc-form-field rc-form-field--full">
                        <label>@L["Account_Settings_LastSensitiveChange"]</label>
                        <div class="rc-readonly-value">
                            @GetLastSensitiveChangeLabel()
                        </div>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Account_Settings_EmailVerificationStatus"]</label>
                        <div class="rc-readonly-value">
                            @(Settings.IsEmailVerified? L["Account_Settings_EmailVerified"] : L["Account_Settings_EmailNotVerifiedYet"])
                        </div>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Account_Settings_SendVerificationEmailLabel"]</label>
                        <div class="rc-tool-actions">
                            <button type="button"
                                    @onclick="SendVerificationEmail"
                                    disabled="@(!Settings.HasEmail || Settings.IsEmailVerified)">
                                @L["Account_Settings_SendVerificationEmail"]
                            </button>
                        </div>
                    </div>
                </div>

                <div class="rc-auth-form">
                    <div class="rc-form-field">
                        <label>@L["Account_Settings_CurrentPassword"]</label>
                        <input @bind="CurrentPassword" type="password" disabled="@(!Settings.HasEmail)" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Account_Settings_NewPassword"]</label>
                        <input @bind="NewPassword" type="password" disabled="@(!Settings.HasEmail)" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Account_Settings_ConfirmNewPassword"]</label>
                        <input @bind="ConfirmNewPassword" type="password" disabled="@(!Settings.HasEmail)" />
                    </div>
                </div>

                @if (!Settings.HasEmail)
                {
                    <div class="rc-inline-warning">@L["Account_Settings_PasswordChangeRequiresEmail"]</div>
                }

                <div class="rc-tool-actions">
                    <button type="button" @onclick="ChangePassword" disabled="@(!Settings.HasEmail)">
                        @L["Account_Settings_ChangePassword"]
                    </button>
                </div>
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Account_Settings_TwitchSection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Account_Settings_TwitchSubtitle"]</p>
                    </div>
                </div>

                <div class="rc-tool-form-grid">
                    <div class="rc-form-field">
                        <label>@L["Account_Settings_TwitchLinkStatus"]</label>
                        <div class="rc-readonly-value">
                            @(Settings.IsTwitchLinked
                                ? string.Format(L["Account_Settings_TwitchLinkedAs"], Settings.TwitchLogin)
                                : L["Account_Settings_TwitchNotLinked"])
                        </div>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Account_Settings_TwitchOAuthNoticeLabel"]</label>
                        <div class="rc-readonly-value">@L["Account_Settings_TwitchOAuthNotice"]</div>
                    </div>
                </div>

                @if (Settings.IsTwitchLinked &&
                                     !string.IsNullOrWhiteSpace(Settings.TwitchLogin) &&
                                     !string.Equals(Settings.Username, Settings.TwitchLogin, StringComparison.Ordinal))
                {
                    <div class="rc-inline-warning">
                        @string.Format(L["Account_Settings_TwitchRenameSuggestion"], Settings.TwitchLogin)
                    </div>
                }

                <div class="rc-tool-actions">
                    @if (!Settings.IsTwitchLinked)
                    {
                        <a class="rc-auth-link-button" href="/auth/twitch/link">@L["Account_Settings_LinkTwitch"]</a>
                    }
                    else
                    {
                        <button type="button" @onclick="RenameToTwitchLogin">@L["Account_Settings_RenameToTwitchLogin"]</button>
                        <button type="button" @onclick="UnlinkTwitch">@L["Account_Settings_UnlinkTwitch"]</button>
                    }
                </div>
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Account_Settings_GameMasterSection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Account_Settings_GameMasterSubtitle"]</p>
                    </div>
                </div>

                <label class="rc-filter-toggle">
                    <input type="checkbox"
                           checked="@Settings.WantsToBeGameMaster"
                           @onchange="OnGameMasterModeChanged"
                           disabled="@(!Settings.CanActivateGameMasterMode && !Settings.WantsToBeGameMaster)" />
                    <span>@L["Account_Settings_EnableGameMasterMode"]</span>
                </label>

                @if (!Settings.CanActivateGameMasterMode)
                {
                    <div class="rc-inline-warning">@L["Account_Settings_GameMasterNeedsEmail"]</div>
                }

                @if (Settings.WantsToBeGameMaster)
                {
                    <div class="rc-tool-form-grid">
                        <div class="rc-form-field">
                            <label>@L["Account_Settings_MaxPlayersPerSession"]</label>
                            <div class="rc-readonly-value">@Settings.MaxPlayersPerSession</div>
                        </div>

                        <div class="rc-form-field">
                            <label>@L["Account_Settings_GameMasterModeStatus"]</label>
                            <div class="rc-readonly-value">@L["Account_Settings_GameMasterModeEnabled"]</div>
                        </div>
                    </div>
                }
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Account_Settings_SubscriptionSection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Account_Settings_SubscriptionSubtitle"]</p>
                    </div>
                </div>

                @if (!Settings.WantsToBeGameMaster)
                {
                    <div class="rc-inline-warning">@L["Account_Settings_SubscriptionRequiresGameMasterMode"]</div>
                }
                else
                {
                    var hasScheduledChange = Settings.CancelSubscriptionAtRenewal || !string.IsNullOrWhiteSpace(Settings.PendingSubscriptionPlanCode);

                    <div class="rc-subscription-current-card @(hasScheduledChange ? "is-warning" : "is-active")">
                        <div class="rc-subscription-current-card__header">
                            <div>
                                <div class="rc-subscription-current-card__eyebrow">@L["Account_Settings_SubscriptionCurrentPlan"]</div>
                                <div class="rc-subscription-current-card__title">
                                    @(Settings.CurrentSubscriptionPlanCode is null
                                        ? L["Account_Settings_SubscriptionNoActivePlan"]
                                        : GetPlanDisplayName(Settings.CurrentSubscriptionPlanCode))
                                </div>
                            </div>

                            <div class="rc-subscription-current-card__badge">
                                @if (hasScheduledChange)
                                {
                                    <span class="rc-inline-pill">@L["Account_Settings_SubscriptionPendingBadge"]</span>
                                }
                                else
                                {
                                    <span class="rc-inline-pill">@L["Account_Settings_SubscriptionCurrentBadge"]</span>
                                }
                            </div>
                        </div>

                        <div class="rc-subscription-current-card__stats">
                            <div class="rc-subscription-current-card__stat">
                                <span class="rc-subscription-current-card__label">@L["Account_Settings_MaxPlayersPerSession"]</span>
                                <strong class="rc-subscription-current-card__value">@Settings.MaxPlayersPerSession</strong>
                            </div>

                            <div class="rc-subscription-current-card__stat">
                                <span class="rc-subscription-current-card__label">@L["Account_Settings_SubscriptionRenewsOn"]</span>
                                <strong class="rc-subscription-current-card__value">
                                    @(Settings.NextSubscriptionRenewalAtUtc.HasValue
                                        ? Settings.NextSubscriptionRenewalAtUtc.Value.ToLocalTime().ToString("g")
                                        : "—")
                                </strong>
                            </div>

                            <div class="rc-subscription-current-card__stat">
                                <span class="rc-subscription-current-card__label">@L["Account_Settings_SubscriptionPendingPlan"]</span>
                                <strong class="rc-subscription-current-card__value">
                                    @if (Settings.CancelSubscriptionAtRenewal)
                                    {
                                        @L["Account_Settings_SubscriptionCancellationScheduled"]
                                    }
                                    else if (!string.IsNullOrWhiteSpace(Settings.PendingSubscriptionPlanCode))
                                    {
                                        @GetPlanDisplayName(Settings.PendingSubscriptionPlanCode!)
                                    }
                                    else
                                    {
                                        @("—")
                                    }
                                </strong>
                            </div>
                        </div>
                    </div>

                    <div class="rc-subscription-plan-grid">
                        @foreach (var plan in SubscriptionPlans.OrderBy(x => x.DisplayOrder))
                        {
                            var isWarningCurrent = plan.IsCurrent && hasScheduledChange;
                            var cardClass = plan.IsCurrent
                                ? (isWarningCurrent ? "is-current-warning" : "is-current")
                                : (plan.IsPending ? "is-pending" : string.Empty);

                            <div class="rc-subscription-plan-card @cardClass">
                                <div class="rc-subscription-plan-card__header">
                                    <div>
                                        <div class="rc-subscription-plan-card__title">@GetPlanDisplayName(plan.Code)</div>
                                        <div class="rc-subscription-plan-card__subtitle">@GetPlanPriceLabel(plan)</div>
                                    </div>

                                    <div class="rc-subscription-plan-card__badges">
                                        @if (plan.IsCurrent)
                                        {
                                            <span class="rc-inline-pill">
                                                @(isWarningCurrent
                                                    ? L["Account_Settings_SubscriptionPendingBadge"]
                                                    : L["Account_Settings_SubscriptionCurrentBadge"])
                                            </span>
                                        }
                                        else if (plan.IsPending)
                                        {
                                            <span class="rc-inline-pill">@L["Account_Settings_SubscriptionPendingBadge"]</span>
                                        }
                                    </div>
                                </div>

                                <div class="rc-subscription-plan-card__capacity">
                                    @string.Format(L["Account_Settings_SubscriptionPlayersIncluded"], plan.MaxPlayersPerSession)
                                </div>

                                <div class="rc-tool-actions">
                                    @if (plan.IsCurrent)
                                    {
                                        @if (!plan.IsFree)
                                        {
                                            <button type="button" @onclick="CancelCurrentSubscription">
                                                @L["Account_Settings_SubscriptionUnsubscribe"]
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="() => SelectSubscriptionPlan(plan.PlanId)">
                                            @GetPlanActionLabel(plan)
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    private bool IsLoaded;
    private bool RedirectToLogin;
    private Guid CurrentUserId;
    private AccountSettingsDto? Settings;
    private List<AccountSubscriptionPlanDto> SubscriptionPlans = new();
    private string Message = string.Empty;

    private string EditableEmail = string.Empty;
    private string EditableLanguage = "fr";
    private string NewUsername = string.Empty;

    private string CurrentPassword = string.Empty;
    private string NewPassword = string.Empty;
    private string ConfirmNewPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToLogin = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);
        await LoadSettingsAsync();

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!string.IsNullOrWhiteSpace(uri.Query) && uri.Query.Contains("twitch_linked=1"))
        {
            Message = L["Account_Settings_TwitchLinkedMessage"];
        }

        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToLogin)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadSettingsAsync()
    {
        Message = string.Empty;

        try
        {
            Settings = await AccountService.GetAccountSettingsAsync(CurrentUserId);
            SubscriptionPlans = await AccountService.GetSubscriptionPlansAsync(CurrentUserId);

            EditableEmail = Settings.Email ?? string.Empty;
            EditableLanguage = Settings.Language;
            NewUsername = Settings.Username;
        }
        catch
        {
            Settings = null;
            SubscriptionPlans.Clear();
        }
    }

    private async Task SaveGeneralInfo()
    {
        try
        {
            Message = string.Empty;

            if (!string.IsNullOrWhiteSpace(EditableEmail) && !IsValidEmail(EditableEmail))
            {
                Message = $"{L["Common_Error"]} : {L["Auth_EmailInvalidFormat"]}";
                return;
            }

            await AccountService.UpdateGeneralInfoAsync(
                CurrentUserId,
                string.IsNullOrWhiteSpace(EditableEmail) ? null : EditableEmail,
                EditableLanguage);

            await LoadSettingsAsync();
            Message = L["Account_Settings_GeneralSaved"];
            Navigation.NavigateTo("/account/settings", forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task SaveUsername()
    {
        try
        {
            Message = string.Empty;

            if (!string.IsNullOrWhiteSpace(EditableEmail) && !IsValidEmail(EditableEmail))
            {
                Message = $"{L["Common_Error"]} : {L["Auth_EmailInvalidFormat"]}";
                return;
            }

            await AccountService.UpdateUsernameAsync(CurrentUserId, NewUsername);

            await LoadSettingsAsync();
            Message = L["Account_Settings_UsernameSaved"];
            Navigation.NavigateTo("/account/settings", forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task ChangePassword()
    {
        try
        {
            Message = string.Empty;

            if (NewPassword != ConfirmNewPassword)
            {
                Message = $"{L["Common_Error"]} : {L["Backend_NewPasswordsDoNotMatch"]}";
                return;
            }

            await AccountSecurityService.ChangePasswordAsync(
                CurrentUserId,
                CurrentPassword,
                NewPassword);

            CurrentPassword = string.Empty;
            NewPassword = string.Empty;
            ConfirmNewPassword = string.Empty;

            await LoadSettingsAsync();
            Message = L["Account_Settings_PasswordChanged"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task SendVerificationEmail()
    {
        try
        {
            Message = string.Empty;

            await AccountSecurityService.SendEmailVerificationAsync(CurrentUserId);

            await LoadSettingsAsync();
            Message = L["Account_Settings_VerificationEmailSent"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task RenameToTwitchLogin()
    {
        try
        {
            Message = string.Empty;

            var response = await Http.PostAsync("api/twitch/rename-current-to-twitch", null);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = $"{L["Common_Error"]} : {error}";
                return;
            }

            await LoadSettingsAsync();
            Message = L["Account_Settings_TwitchRenameSuccess"];
            Navigation.NavigateTo("/account/settings", forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task UnlinkTwitch()
    {
        try
        {
            Message = string.Empty;

            var response = await Http.PostAsync("api/twitch/unlink-current", null);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = $"{L["Common_Error"]} : {error}";
                return;
            }

            await LoadSettingsAsync();
            Message = L["Account_Settings_TwitchUnlinkedMessage"];
            Navigation.NavigateTo("/account/settings", forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task OnGameMasterModeChanged(ChangeEventArgs args)
    {
        try
        {
            Message = string.Empty;

            var enabled = args.Value is bool boolValue && boolValue;

            await AccountService.SetGameMasterModeAsync(CurrentUserId, enabled);

            await LoadSettingsAsync();
            Message = enabled
                ? L["Account_Settings_GameMasterModeEnabledMessage"]
                : L["Account_Settings_GameMasterModeDisabledMessage"];

            Navigation.NavigateTo("/account/settings", forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
            await LoadSettingsAsync();
        }
    }

    private string GetLastSensitiveChangeLabel()
    {
        if (Settings is null)
            return string.Empty;

        if (!Settings.LastSensitiveChangeAtUtc.HasValue)
            return L["Account_Settings_NoSensitiveChange"];

        var typeLabel = string.IsNullOrWhiteSpace(Settings.LastSensitiveChangeType)
            ? L["Account_Settings_SensitiveChangeUnknown"]
            : L[Settings.LastSensitiveChangeType];

        return $"{typeLabel} — {Settings.LastSensitiveChangeAtUtc.Value.ToLocalTime():g}";
    }

    private async Task SelectSubscriptionPlan(Guid planId)
    {
        try
        {
            Message = string.Empty;

            await AccountService.ChangeSubscriptionPlanAsync(CurrentUserId, planId);

            await LoadSettingsAsync();
            Message = L["Account_Settings_SubscriptionActionCompleted"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task CancelCurrentSubscription()
    {
        try
        {
            Message = string.Empty;

            await AccountService.CancelSubscriptionAsync(CurrentUserId);

            await LoadSettingsAsync();
            Message = L["Account_Settings_SubscriptionCancellationScheduled"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private string GetPlanDisplayName(string code)
    {
        return code switch
        {
            "aventurier" => L["Subscription_Plan_Aventurier"],
            "heros" => L["Subscription_Plan_Heros"],
            "champion" => L["Subscription_Plan_Champion"],
            "legende" => L["Subscription_Plan_Legende"],
            "mythique" => L["Subscription_Plan_Mythique"],
            "divin" => L["Subscription_Plan_Divin"],
            _ => code
        };
    }

    private string GetPlanPriceLabel(AccountSubscriptionPlanDto plan)
    {
        if (plan.IsFree)
            return L["Account_Settings_SubscriptionFreePrice"];

        return string.Format(L["Account_Settings_SubscriptionPaidPrice"], plan.MonthlyPriceTtc.ToString("0.##"));
    }

    private string GetPlanActionLabel(AccountSubscriptionPlanDto targetPlan)
    {
        var currentPlan = SubscriptionPlans.FirstOrDefault(x => x.IsCurrent);

        if (currentPlan is null)
            return L["Account_Settings_SubscriptionSelectPlan"];

        if (targetPlan.MaxPlayersPerSession > currentPlan.MaxPlayersPerSession)
            return L["Account_Settings_SubscriptionChangePlan"];

        return L["Account_Settings_SubscriptionChangePlanAtRenewal"];
    }

    private static bool IsValidEmail(string email)
    {
        try
        {
            var parsed = new MailAddress(email.Trim());
            return string.Equals(parsed.Address, email.Trim(), StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }
}
