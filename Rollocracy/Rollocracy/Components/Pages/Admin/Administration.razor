    private async Task ConfirmDeleteSubscriptionPlan(AdminSubscriptionPlanDto plan)
    {
        try
        {
            if (plan.Id == Guid.Empty)
            {
                Dashboard?.SubscriptionPlans.Remove(plan);
                return;
            }

            if (!await ConfirmDestructiveActionAsync())
                return;

            await AdministrationService.DeleteSubscriptionPlanAsync(CurrentUserId, plan.Id);
            await LoadDashboardAsync();
            Message = L["Admin_Deleted"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

