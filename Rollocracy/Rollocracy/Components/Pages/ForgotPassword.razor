@page "/forgot-password"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Account
@using Rollocracy.Localization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["Auth_ForgotPassword_Title"]</PageTitle>

<section class="rc-auth-shell">
    <div class="rc-auth-grid">
        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h1 class="rc-tool-panel__title">@L["Auth_ForgotPassword_Title"]</h1>
                <p class="rc-tool-panel__subtitle">@L["Auth_ForgotPassword_Subtitle"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="rc-inline-warning">@Message</div>
            }

            <div class="rc-auth-form">
                <div class="rc-form-field">
                    <label>@L["Auth_ForgotPassword_EmailOrUsername"]</label>
                    <input @bind="EmailOrUsername" />
                </div>

                <div class="rc-tool-actions">
                    <button @onclick="SendResetRequest">@L["Auth_ForgotPassword_Submit"]</button>
                    <a class="rc-auth-link-button" href="/login">@L["Auth_BackToLogin"]</a>
                </div>
            </div>
        </article>

        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h2 class="rc-tool-panel__title">@L["Auth_ForgotPassword_InfoTitle"]</h2>
                <p class="rc-tool-panel__subtitle">@L["Auth_ForgotPassword_InfoSubtitle"]</p>
            </div>

            <div class="rc-auth-stack">
                <div class="rc-readonly-value">@L["Auth_ForgotPassword_InfoLine1"]</div>
                <div class="rc-readonly-value">@L["Auth_ForgotPassword_InfoLine2"]</div>
            </div>
        </article>
    </div>
</section>

@code {
    private string EmailOrUsername = string.Empty;
    private string Message = string.Empty;

    private async Task SendResetRequest()
    {
        try
        {
            Message = string.Empty;

            if (string.IsNullOrWhiteSpace(EmailOrUsername))
            {
                Message = L["Auth_ForgotPassword_EmptyInput"];
                return;
            }

            var response = await Http.PostAsJsonAsync("api/auth/forgot-password", new ForgotPasswordRequestDto
            {
                EmailOrUsername = EmailOrUsername
            });

            if (!response.IsSuccessStatusCode)
            {
                Message = await ExtractApiErrorMessageAsync(response, L["Auth_ForgotPassword_RequestFailed"]);
                return;
            }

            Message = L["Auth_ForgotPassword_GenericSuccess"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task<string> ExtractApiErrorMessageAsync(HttpResponseMessage response, string fallbackMessage)
    {
        var contentType = response.Content.Headers.ContentType?.MediaType;
        var body = await response.Content.ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(body))
            return fallbackMessage;

        if (!string.IsNullOrWhiteSpace(contentType) &&
            contentType.Contains("html", StringComparison.OrdinalIgnoreCase))
        {
            return fallbackMessage;
        }

        var trimmed = body.Trim();

        if (trimmed.StartsWith("<!DOCTYPE html>", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("<html", StringComparison.OrdinalIgnoreCase))
        {
            return fallbackMessage;
        }

        return $"{L["Common_Error"]} : {trimmed}";
    }
}
