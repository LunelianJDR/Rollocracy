@page "/forgot-password"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Account
@using Rollocracy.Localization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["ForgotPassword_Title"]</PageTitle>

<section class="rc-auth-shell">
    <div class="rc-auth-grid">
        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h1 class="rc-tool-panel__title">@L["ForgotPassword_Title"]</h1>
                <p class="rc-tool-panel__subtitle">@L["ForgotPassword_Subtitle"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="rc-inline-warning">@Message</div>
            }

            <div class="rc-auth-form">
                <div class="rc-form-field">
                    <label>@L["ForgotPassword_EmailOrUsername"]</label>
                    <input @bind="EmailOrUsername" />
                </div>

                <div class="rc-tool-actions">
                    <button @onclick="SendResetRequest">@L["ForgotPassword_Submit"]</button>
                    <a class="rc-auth-link-button" href="/login">@L["ForgotPassword_BackToLogin"]</a>
                </div>
            </div>
        </article>

        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h2 class="rc-tool-panel__title">@L["ForgotPassword_InfoTitle"]</h2>
                <p class="rc-tool-panel__subtitle">@L["ForgotPassword_InfoSubtitle"]</p>
            </div>

            <div class="rc-auth-stack">
                <div class="rc-readonly-value">@L["ForgotPassword_InfoLine1"]</div>
                <div class="rc-readonly-value">@L["ForgotPassword_InfoLine2"]</div>
            </div>
        </article>
    </div>
</section>

@code {
    private string EmailOrUsername = string.Empty;
    private string Message = string.Empty;

    private async Task SendResetRequest()
    {
        try
        {
            Message = string.Empty;

            var response = await Http.PostAsJsonAsync("api/auth/forgot-password", new ForgotPasswordRequestDto
            {
                EmailOrUsername = EmailOrUsername
            });

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = $"{L["Common_Error"]} : {error}";
                return;
            }

            Message = L["ForgotPassword_GenericSuccess"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }
}