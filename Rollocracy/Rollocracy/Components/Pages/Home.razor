@page "/"
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text
@using System.Globalization
@using Rollocracy.Domain.Admin
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Interfaces
@using Rollocracy.Localization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IEmailService EmailService
@inject IAdministrationService AdministrationService
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["Home_PageTitle"]</PageTitle>

<section class="rc-tool-section">
    @if (!string.IsNullOrWhiteSpace(HomeMessage))
    {
        <div class="rc-inline-warning">@HomeMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(HomeErrorMessage))
    {
        <div class="rc-inline-error">@HomeErrorMessage</div>
    }

    <div class="rc-tool-layout">
        <div class="rc-tool-panel">
            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                <div class="rc-tool-panel__header-main">
                    <h3 class="rc-tool-panel__title">@L["Home_Intro_Title"]</h3>
                </div>
            </div>

            <div class="rc-tool-section">
                <p>@L["Home_Intro_Paragraph1"]</p>
                <p>@L["Home_Intro_Paragraph2"]</p>

                <ul>
                    <li>@L["Home_Intro_FeatureList1"]</li>
                    <li>@L["Home_Intro_FeatureList2"]</li>
                    <li>@L["Home_Intro_FeatureList3"]</li>
                    <li>@L["Home_Intro_FeatureList4"]</li>
                    <li>@L["Home_Intro_FeatureList5"]</li>
                </ul>
                
                <p>@L["Home_Intro_SupportRollocracy"]</p>

                <a class="rc-support-link"
                       href="@SupportRollocracyUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="@L["Navigation_SupportRollocracy"]">
                    @L["Navigation_SupportRollocracy"]
                </a>

                <AuthorizeView>
                    <NotAuthorized>
                        <div class="rc-tool-actions">
                            <button type="button" @onclick="GoToLogin">@L["Auth_Login_Action"]</button>
                            <button type="button" @onclick="GoToRegister">@L["Auth_Register_Title"]</button>
                        </div>
                    </NotAuthorized>

                    <Authorized>
                        <div class="rc-tool-actions">
                            <button type="button" @onclick="GoToJoin">@L["Session_Join_Title"]</button>
                            <button type="button" @onclick="GoToAccountSettings">@L["Account_Settings_Title"]</button>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        <div class="rc-tool-panel">
            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                <div class="rc-tool-panel__header-main">
                    <h3 class="rc-tool-panel__title">@L["Home_Videos_Title"]</h3>
                </div>
            </div>

            <div class="rc-tool-actions">
                @foreach (var video in Videos)
                {
                    <button type="button"
                            @onclick="() => SelectVideo(video.Key)">
                        @L[video.TabResourceKey]
                    </button>
                }
            </div>

            <div class="rc-tool-section">
                <p class="rc-tool-muted">@L[SelectedVideo.DescriptionResourceKey]</p>

                <iframe class="rc-home-video-frame"
                        height="420"
                        src="@SelectedVideo.EmbedUrl"
                        title="@L[SelectedVideo.TabResourceKey]"
                        loading="lazy"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen>
                </iframe>
            </div>
        </div>

        <div class="rc-tool-panel">
            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                <div class="rc-tool-panel__header-main">
                    <h3 class="rc-tool-panel__title">@L["Home_Project_Title"]</h3>
                </div>

                <div class="rc-tool-actions">
                    <button type="button" @onclick="ShowPatchnotesView">@L["Home_Project_ViewPatchnotes"]</button>
                    <button type="button" @onclick="ShowPlannedFeaturesView">@L["Home_Project_ViewPlannedFeatures"]</button>
                    @* <button type="button" @onclick="OpenBugReportForm" disabled>@L["Home_Project_ReportBug"]</button> *@
                </div>
            </div>

            @if (IsBugReportSent)
            {
                <div class="rc-tool-section">
                    <div>
                        <h4 class="rc-tool-panel__title">@L["Home_BugForm_SentTitle"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Home_BugForm_SentMessage"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="ReportAnotherBug">@L["Home_BugForm_ReportAnother"]</button>
                    </div>
                </div>
            }
            else if (IsBugReportMode)
            {
                <div class="rc-tool-section">
                    <div>
                        <h4 class="rc-tool-panel__title">@L["Home_BugForm_Title"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Home_BugForm_Subtitle"]</p>
                    </div>

                    <div class="rc-tool-form-grid">
                        <div class="rc-form-field rc-form-field--full">
                            <label>@L["Home_BugForm_PageLabel"]</label>
                            <input @bind="BugReportedPage"
                                   placeholder="@L["Home_BugForm_PagePlaceholder"]" />
                        </div>

                        <div class="rc-form-field rc-form-field--full">
                            <label>@L["Home_BugForm_DescriptionLabel"]</label>
                            <textarea rows="8"
                                      @bind="BugDescription"
                                      placeholder="@L["Home_BugForm_DescriptionPlaceholder"]"></textarea>
                        </div>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="SubmitBugReportAsync" disabled="@IsSendingBugReport">
                            @(IsSendingBugReport ? L["Common_Loading"] : L["Home_BugForm_Send"])
                        </button>
                        <button type="button" @onclick="CancelBugReport" disabled="@IsSendingBugReport">@L["Common_Cancel"]</button>
                    </div>
                </div>
            }
            else if (ShowPlannedFeatures)
            {
                <div class="rc-tool-section">
                    <div>
                        <h4 class="rc-tool-panel__title">@L["Home_Planned_Title"]</h4>
                    </div>

                    @if (HomeProjectContent.PlannedFeatures.Count == 0)
                    {
                        <p class="rc-tool-muted">@L["Home_Project_NoPlannedFeatures"]</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var feature in HomeProjectContent.PlannedFeatures)
                            {
                                <li>@feature.Text</li>
                            }
                        </ul>
                    }
                </div>
            }
            else
            {
                <div class="rc-tool-section">
                    @if (HomeProjectContent.PatchNotes.Count == 0)
                    {
                        <p class="rc-tool-muted">@L["Home_Project_NoPatchnotes"]</p>
                    }
                    else
                    {
                        <div class="rc-form-field">
                            <label>@L["Home_Project_SelectPatchnote"]</label>
                            <select value="@SelectedPatchnoteId" @onchange="OnPatchnoteChanged">
                                @foreach (var patchnote in HomeProjectContent.PatchNotes)
                                {
                                    <option value="@patchnote.Id">@string.Format(L["Home_Patchnote_VersionLabel"], patchnote.Version)</option>
                                }
                            </select>
                        </div>

                        @if (SelectedPatchnote is not null)
                        {
                            <div>
                                <h4 class="rc-tool-panel__title">@string.Format(L["Home_Patchnote_VersionTitle"], SelectedPatchnote.Version)</h4>
                                <p class="rc-tool-panel__subtitle">@SelectedPatchnote.PublishedAtUtc.ToLocalTime().ToString("d")</p>
                            </div>

                            <ul>
                                @foreach (var item in SelectedPatchnote.Entries)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    }
                </div>
            }
        </div>

        <div class="rc-tool-panel">
            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                <div class="rc-tool-panel__header-main">
                    <h3 class="rc-tool-panel__title">@L["Home_Thanks_Title"]</h3>
                </div>
            </div>

            <div class="rc-tool-section">
                <p>@L["Home_Thanks_Paragraph1"]</p>

                <ul>
                    <li>@L["Home_Thanks_TonyTruand"]</li>
                    <li>@L["Home_Thanks_FibreTigre"]</li>
                </ul>

                <p>@L["Home_Thanks_Paragraph2"]</p>
            </div>
        </div>
    </div>
</section>

@code {
    private const string BugReportEmail = "rollocracy@lunelian.com";

    private string SelectedVideoKey = "presentation";
    private Guid? SelectedPatchnoteId;
    private bool ShowPlannedFeatures;
    private bool IsBugReportMode;
    private bool IsBugReportSent;
    private bool IsSendingBugReport;

    private string BugReportedPage = string.Empty;
    private string BugDescription = string.Empty;

    private string HomeMessage = string.Empty;
    private string HomeErrorMessage = string.Empty;

    private const string SupportRollocracyUrl = "https://ko-fi.com/lunelianjdr";

    private readonly List<HomeVideoOption> Videos =
    [
        new(
            "presentation",
            "Home_Video_Presentation_Tab",
            "Home_Video_Presentation_Description",
            "https://www.youtube.com/embed/hKRUPYrAQoE"),
        new(
            "quickstart",
            "Home_Video_QuickStart_Tab",
            "Home_Video_QuickStart_Description",
            "https://www.youtube.com/embed/SRXH9AbT280"),
        new(
            "advanced",
            "Home_Video_Advanced_Tab",
            "Home_Video_Advanced_Description",
            "https://www.youtube.com/embed/d_HlPboLRL8")
    ];

    private HomeProjectContentDto HomeProjectContent = new();

    private HomeVideoOption SelectedVideo
        => Videos.FirstOrDefault(v => v.Key == SelectedVideoKey) ?? Videos[0];

    private PublicPatchNoteDto? SelectedPatchnote
        => SelectedPatchnoteId.HasValue
            ? HomeProjectContent.PatchNotes.FirstOrDefault(p => p.Id == SelectedPatchnoteId.Value)
            : HomeProjectContent.PatchNotes.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await LoadHomeProjectContentAsync();
    }

    private async Task LoadHomeProjectContentAsync()
    {
        var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        HomeProjectContent = await AdministrationService.GetHomeProjectContentAsync(language);

        if (HomeProjectContent.PatchNotes.Count > 0)
        {
            SelectedPatchnoteId = HomeProjectContent.PatchNotes[0].Id;
        }
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void GoToRegister()
    {
        Navigation.NavigateTo("/register");
    }

    private void GoToJoin()
    {
        Navigation.NavigateTo("/join");
    }

    private void GoToAccountSettings()
    {
        Navigation.NavigateTo("/account/settings");
    }

    private void SelectVideo(string key)
    {
        SelectedVideoKey = key;
    }

    private void ShowPatchnotesView()
    {
        ShowPlannedFeatures = false;
        IsBugReportMode = false;
        IsBugReportSent = false;
        IsSendingBugReport = false;
        HomeMessage = string.Empty;
        HomeErrorMessage = string.Empty;
    }

    private void ShowPlannedFeaturesView()
    {
        ShowPlannedFeatures = true;
        IsBugReportMode = false;
        IsBugReportSent = false;
        IsSendingBugReport = false;
        HomeMessage = string.Empty;
        HomeErrorMessage = string.Empty;
    }

    private void OpenBugReportForm()
    {
        IsBugReportMode = true;
        IsBugReportSent = false;
        IsSendingBugReport = false;
        HomeMessage = string.Empty;
        HomeErrorMessage = string.Empty;
    }

    private void CancelBugReport()
    {
        IsBugReportMode = false;
        IsBugReportSent = false;
        IsSendingBugReport = false;
        BugReportedPage = string.Empty;
        BugDescription = string.Empty;
        HomeMessage = string.Empty;
        HomeErrorMessage = string.Empty;
    }

    private void ReportAnotherBug()
    {
        IsBugReportMode = true;
        IsBugReportSent = false;
        IsSendingBugReport = false;
        BugReportedPage = string.Empty;
        BugDescription = string.Empty;
        HomeMessage = string.Empty;
        HomeErrorMessage = string.Empty;
    }

    private void OnPatchnoteChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var patchNoteId))
        {
            SelectedPatchnoteId = patchNoteId;
        }
    }

    private async Task SubmitBugReportAsync()
    {
        HomeMessage = string.Empty;
        HomeErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(BugReportedPage) || string.IsNullOrWhiteSpace(BugDescription))
        {
            HomeErrorMessage = L["Home_BugForm_MissingFields"];
            return;
        }

        try
        {
            IsSendingBugReport = true;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var username = user.Identity?.IsAuthenticated == true
                ? user.Identity?.Name ?? string.Empty
                : string.Empty;

            if (string.IsNullOrWhiteSpace(username))
            {
                username = L["Home_BugForm_GuestUser"];
            }

            var subject = $"Bug Report Rollocracy de {username}";

            var bodyBuilder = new StringBuilder();
            bodyBuilder.AppendLine(subject);
            bodyBuilder.AppendLine();
            bodyBuilder.AppendLine($"{L["Home_BugForm_PageLabel"]} : {BugReportedPage.Trim()}");
            bodyBuilder.AppendLine();
            bodyBuilder.AppendLine($"{L["Home_BugForm_DescriptionLabel"]} :");
            bodyBuilder.AppendLine(BugDescription.Trim());

            await EmailService.SendAsync(
                BugReportEmail,
                subject,
                bodyBuilder.ToString());

            IsBugReportMode = false;
            IsBugReportSent = true;
            BugReportedPage = string.Empty;
            BugDescription = string.Empty;
        }
        catch (Exception ex)
        {
            HomeErrorMessage = $"{L["Common_Error"]} : {ex.Message}";
        }
        finally
        {
            IsSendingBugReport = false;
        }
    }

    private sealed record HomeVideoOption(
        string Key,
        string TabResourceKey,
        string DescriptionResourceKey,
        string EmbedUrl);

}
