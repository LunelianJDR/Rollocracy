@page "/login"
@using Microsoft.Extensions.Localization
@using Rollocracy.Localization
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["Auth_Login_Title"]</PageTitle>

<section class="rc-auth-shell">
    <div class="rc-auth-grid">
        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h1 class="rc-tool-panel__title">@L["Auth_Login_Title"]</h1>
                <p class="rc-tool-panel__subtitle">@L["Auth_Login_Subtitle"]</p>
            </div>

            @if (HasError)
            {
                <div class="rc-inline-error">@L["Auth_InvalidCredentials"]</div>
            }

            @if (HasRegistered)
            {
                <div class="rc-inline-warning">@L["Auth_Login_RegisteredSuccess"]</div>
            }

            @if (HasResetSuccess)
            {
                <div class="rc-inline-warning">@L["Auth_ResetPassword_Success"]</div>
            }

            @if (HasVerifiedEmail)
            {
                <div class="rc-inline-warning">@L["Auth_VerifyEmail_Success"]</div>
            }

            @if (HasTwitchError)
            {
                <div class="rc-inline-error">@L["Auth_Login_TwitchError"]</div>
            }

            <form method="post" action="/auth/login" class="rc-auth-form">
                <div class="rc-form-field">
                    <label for="username">@L["Common_Username"]</label>
                    <input id="username" name="Username" autocomplete="username" />
                </div>

                <div class="rc-form-field">
                    <label for="password">@L["Common_Password"]</label>
                    <input id="password" name="Password" type="password" autocomplete="current-password" />
                </div>

                <label class="rc-filter-toggle">
                    <input id="remember-me" name="RememberMe" type="checkbox" value="true" />
                    <span>@L["Auth_Login_RememberMe"]</span>
                </label>

                <div class="rc-tool-actions">
                    <button type="submit">@L["Auth_Login_Action"]</button>
                </div>

                <a class="rc-auth-text-link" href="/forgot-password">@L["Auth_Login_ForgotPassword"]</a>
            </form>
        </article>

        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h2 class="rc-tool-panel__title">@L["Auth_Login_AlternativeTitle"]</h2>
                <p class="rc-tool-panel__subtitle">@L["Auth_Login_AlternativeSubtitle"]</p>
            </div>

            <div class="rc-auth-stack">
                <!-- Connexion directe Twitch -->
                <a class="rc-auth-link-button" href="/auth/twitch/login?language=fr">
                    @L["Auth_Login_WithTwitch"]
                </a>

                <p class="rc-tool-muted">@L["Auth_Login_TwitchDescription"]</p>

                <div class="rc-auth-divider"></div>

                <a class="rc-auth-link-button" href="/register">@L["Auth_Login_CreateAccount"]</a>
            </div>
        </article>
    </div>
</section>

@code {
    private bool HasError;
    private bool HasRegistered;
    private bool HasResetSuccess;
    private bool HasVerifiedEmail;
    private bool HasTwitchError;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

        if (!string.IsNullOrWhiteSpace(uri.Query) && uri.Query.Contains("error=1"))
            HasError = true;

        if (!string.IsNullOrWhiteSpace(uri.Query) && uri.Query.Contains("registered=1"))
            HasRegistered = true;

        if (!string.IsNullOrWhiteSpace(uri.Query) && uri.Query.Contains("reset=1"))
            HasResetSuccess = true;

        if (!string.IsNullOrWhiteSpace(uri.Query) && uri.Query.Contains("verified=1"))
            HasVerifiedEmail = true;

        if (!string.IsNullOrWhiteSpace(uri.Query) && uri.Query.Contains("twitch_error=1"))
            HasTwitchError = true;
    }
}
