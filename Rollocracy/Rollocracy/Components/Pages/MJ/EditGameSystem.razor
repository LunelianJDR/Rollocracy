    private string GetAttributeSummary(EditableAttributeDefinitionDto attribute)
    {
        var (min, max) = GetAttributeDefaultRange(attribute);
        return $"{min} {L["Common_To"]} {max}";
    }

    private (int Min, int Max) GetAttributeDefaultRange(EditableAttributeDefinitionDto attribute)
    {
        if (attribute.DefaultValueMode == BaseValueGenerationMode.DiceExpression)
        {
            var diceCount = Math.Max(0, attribute.DefaultValueDiceCount);
            var diceSides = Math.Max(0, attribute.DefaultValueDiceSides);
            var flatBonus = attribute.DefaultValueFlatBonus;
            var min = flatBonus + (diceCount > 0 && diceSides > 0 ? diceCount : 0);
            var max = flatBonus + (diceCount > 0 && diceSides > 0 ? diceCount * diceSides : 0);
            return (min, max);
        }

        return (attribute.DefaultValue, attribute.DefaultValue);
    }

    private string GetDerivedStatSummary(EditableDerivedStatDefinitionDto derivedStat)
    {
        var names = derivedStat.Components
            .Where(x => !x.IsDeleted)
            .Select(x => ResolveAttributeNameFromTemporaryKeyOrId(x.AttributeTemporaryKey, x.AttributeDefinitionId))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .ToList();

        return names.Count == 0 ? L["GameSystem_Editor_NoDerivedComponentsSummary"] : JoinHumanReadable(names);
    }

    private string GetMetricSummary(EditableMetricDefinitionDto metric)
    {
        var parts = new List<string>();
        if (metric.BaseValue != 0)
            parts.Add(metric.BaseValue.ToString());

        foreach (var step in metric.FormulaSteps.Where(x => !x.IsDeleted).OrderBy(x => x.Order).ThenBy(x => x.MetricFormulaStepId))
        {
            var source = step.SourceType == MetricFormulaSourceType.Constant
                ? FormatMetricConstant(step.ConstantValue)
                : GetMetricFormulaSourceLabel(step);

            if (string.IsNullOrWhiteSpace(source))
                continue;

            var op = step.OperationType switch
            {
                MetricFormulaOperationType.Add => "+",
                MetricFormulaOperationType.Subtract => "-",
                MetricFormulaOperationType.Multiply => "×",
                MetricFormulaOperationType.Divide => "/",
                _ => "+"
            };

            if (parts.Count == 0 && op == "+")
                parts.Add(source);
            else
                parts.Add($"{op} {source}");
        }

        return parts.Count == 0 ? L["GameSystem_Editor_NoMetricFormulaSummary"] : string.Join(" ", parts);
    }

    private string GetTraitSummary(EditableTraitDefinitionDto trait)
    {
        var options = trait.Options
            .Where(x => !x.IsDeleted && !string.IsNullOrWhiteSpace(x.Name))
            .Select(x => x.Name.Trim())
            .Take(5)
            .ToList();

        if (options.Count == 0)
            return L["GameSystem_Editor_NoTraitOptionsSummary"];

        var hasMore = trait.Options.Count(x => !x.IsDeleted && !string.IsNullOrWhiteSpace(x.Name)) > 4;
        var visible = options.Take(4).ToList();
        var summary = string.Join(", ", visible);
        return hasMore ? $"{summary}…" : summary;
    }

    private string GetGaugeSummary(EditableGaugeDefinitionDto gauge)
    {
        var typeLabel = gauge.IsHealthGauge ? L["GameSystem_Editor_GaugeHealthType"] : L["GameSystem_Editor_GaugeStandardType"];
        return $"{gauge.DefaultValue} | {typeLabel}";
    }

    private string JoinHumanReadable(IReadOnlyList<string> items)
    {
        if (items.Count == 0)
            return string.Empty;
        if (items.Count == 1)
            return items[0];
        if (items.Count == 2)
            return $"{items[0]} {L["Common_And"]} {items[1]}";
        return string.Join(", ", items.Take(items.Count - 1)) + $" {L["Common_And"]} {items[^1]}";
    }

    private string ResolveAttributeNameFromTemporaryKeyOrId(string? temporaryKey, Guid attributeDefinitionId)
    {
        if (CurrentSystem is null)
            return string.Empty;

        if (!string.IsNullOrWhiteSpace(temporaryKey))
        {
            var byKey = CurrentSystem.Attributes.FirstOrDefault(x => !x.IsDeleted && x.TemporaryKey == temporaryKey);
            if (byKey is not null)
                return byKey.Name;
        }

        return GetBaseAttributeName(attributeDefinitionId);
    }

