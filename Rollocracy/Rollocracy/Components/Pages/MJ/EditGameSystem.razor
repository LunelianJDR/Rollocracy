                        </div>
                        <div class="rc-tool-inline-actions">
                            @if (!IsCategoryCollapsed(EditorCategory.Attributes))
                            {
                                <button type="button" disabled="@IsCategoryLimitReached(EditorCategory.Attributes)" @onclick="AddAndSelectAttribute">@L["GameSystem_Editor_AddAttributeRow"]</button>
                            }
                            <button type="button" @onclick="() => ToggleCategoryCollapse(EditorCategory.Attributes)">@GetCategoryCollapseLabel(EditorCategory.Attributes)</button>
                        </div>
                    </div>
                    @if (!IsCategoryCollapsed(EditorCategory.Attributes))
                    {
                        <div class="rc-editor-list">
                            @foreach (var attributeItem in CurrentSystem.Attributes)
                            {
                                <button type="button" class="@GetEditorListItemClass(EditorCategory.Attributes, GetAttributeKey(attributeItem), attributeItem.IsDeleted)" @onclick="() => ToggleEditorSelection(EditorCategory.Attributes, GetAttributeKey(attributeItem))">
                                    <span class="rc-editor-list-item__title">@DisplayNameOrPlaceholder(attributeItem.Name)</span>
                                    <span class="rc-editor-list-item__summary">@GetAttributeSummary(attributeItem)</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="@GetCategoryCardCssClass(EditorCategory.DerivedStats)">
                    <div class="rc-editor-category-card__header">
                        <div class="rc-filter-group-card__title">
                            @L["GameSystem_Editor_DerivedStatsSection"]
                            <button type="button" class="rc-editor-category-card__title-button" @onclick="() => ToggleCategorySelection(EditorCategory.DerivedStats)"><svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="m403-96-22-114q-23-9-44.5-21T296-259l-110 37-77-133 87-76q-2-12-3-24t-1-25q0-13 1-25t3-24l-87-76 77-133 110 37q19-16 40.5-28t44.5-21l22-114h154l22 114q23 9 44.5 21t40.5 28l110-37 77 133-87 76q2 12 3 24t1 25q0 13-1 25t-3 24l87 76-77 133-110-37q-19 16-40.5 28T579-210L557-96H403Zm59-72h36l19-99q38-7 71-26t57-48l96 32 18-30-76-67q6-17 9.5-35.5T696-480q0-20-3.5-38.5T683-554l76-67-18-30-96 32q-24-29-57-48t-71-26l-19-99h-36l-19 99q-38 7-71 26t-57 48l-96-32-18 30 76 67q-6 17-9.5 35.5T264-480q0 20 3.5 38.5T277-406l-76 67 18 30 96-32q24 29 57 48t71 26l19 99Zm18-168q60 0 102-42t42-102q0-60-42-102t-102-42q-60 0-102 42t-42 102q0 60 42 102t102 42Zm0-144Z" /></svg></button>
                        </div>
                        <div class="rc-tool-inline-actions">
                            @if (!IsCategoryCollapsed(EditorCategory.DerivedStats))
                            {
                                <button type="button" disabled="@IsCategoryLimitReached(EditorCategory.DerivedStats)" @onclick="AddAndSelectDerivedStat">@L["GameSystem_Editor_AddDerivedStatRow"]</button>
                            }
                            <button type="button" @onclick="() => ToggleCategoryCollapse(EditorCategory.DerivedStats)">@GetCategoryCollapseLabel(EditorCategory.DerivedStats)</button>
                        </div>
                    </div>
                    @if (!IsCategoryCollapsed(EditorCategory.DerivedStats))
                    {
                        <div class="rc-editor-list">
                            @foreach (var derivedStat in CurrentSystem.DerivedStats)
                            {
                                <button type="button" class="@GetEditorListItemClass(EditorCategory.DerivedStats, GetDerivedStatKey(derivedStat), derivedStat.IsDeleted)" @onclick="() => ToggleEditorSelection(EditorCategory.DerivedStats, GetDerivedStatKey(derivedStat))">
                                    <span class="rc-editor-list-item__title">@DisplayNameOrPlaceholder(derivedStat.Name)</span>
                                    <span class="rc-editor-list-item__summary">@GetDerivedStatSummary(derivedStat)</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="@GetCategoryCardCssClass(EditorCategory.Metrics)">
                    <div class="rc-editor-category-card__header">
                        <div class="rc-filter-group-card__title">
                            @L["GameSystem_Editor_MetricsSection"]
                            <button type="button" class="rc-editor-category-card__title-button" @onclick="() => ToggleCategorySelection(EditorCategory.Metrics)"><svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M444-288h72v-240h-72v240Zm61.5-322.29q10.5-10.29 10.5-25.5t-10.29-25.71q-10.29-10.5-25.5-10.5t-25.71 10.29q-10.5 10.29-10.5 25.5t10.29 25.71q10.29 10.5 25.5 10.5t25.71-10.29ZM480.28-96Q401-96 331-126t-122.5-82.5Q156-261 126-330.96t-30-149.5Q96-560 126-629.5q30-69.5 82.5-122T330.96-834q69.96-30 149.5-30t149.04 30q69.5 30 122 82.5T834-629.28q30 69.73 30 149Q864-401 834-331t-82.5 122.5Q699-156 629.28-126q-69.73 30-149 30Zm-.28-72q130 0 221-91t91-221q0-130-91-221t-221-91q-130 0-221 91t-91 221q0 130 91 221t221 91Zm0-312Z" /></svg></button>
                        </div>
                        <div class="rc-tool-inline-actions">
                            @if (!IsCategoryCollapsed(EditorCategory.Metrics))
                            {
                                <button type="button" disabled="@IsCategoryLimitReached(EditorCategory.Metrics)" @onclick="AddAndSelectMetric">@L["GameSystem_Editor_AddMetricRow"]</button>
                            }
                            <button type="button" @onclick="() => ToggleCategoryCollapse(EditorCategory.Metrics)">@GetCategoryCollapseLabel(EditorCategory.Metrics)</button>
                        </div>
                    </div>
                    @if (!IsCategoryCollapsed(EditorCategory.Metrics))
                    {
                        <div class="rc-editor-list">
                            @foreach (var metric in CurrentSystem.Metrics)
                            {
                                <button type="button" class="@GetEditorListItemClass(EditorCategory.Metrics, GetMetricKey(metric), metric.IsDeleted)" @onclick="() => ToggleEditorSelection(EditorCategory.Metrics, GetMetricKey(metric))">
                                    <span class="rc-editor-list-item__title">@DisplayNameOrPlaceholder(metric.Name)</span>
                                    <span class="rc-editor-list-item__summary">@GetMetricSummary(metric)</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="@GetCategoryCardCssClass(EditorCategory.Traits)">
                    <div class="rc-editor-category-card__header">
                        <div class="rc-filter-group-card__title">
                            @L["GameSystem_Editor_TraitsSection"]
                            <button type="button" class="rc-editor-category-card__title-button" @onclick="() => ToggleCategorySelection(EditorCategory.Traits)"><svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M444-288h72v-240h-72v240Zm61.5-322.29q10.5-10.29 10.5-25.5t-10.29-25.71q-10.29-10.5-25.5-10.5t-25.71 10.29q-10.5 10.29-10.5 25.5t10.29 25.71q10.29 10.5 25.5 10.5t25.71-10.29ZM480.28-96Q401-96 331-126t-122.5-82.5Q156-261 126-330.96t-30-149.5Q96-560 126-629.5q30-69.5 82.5-122T330.96-834q69.96-30 149.5-30t149.04 30q69.5 30 122 82.5T834-629.28q30 69.73 30 149Q864-401 834-331t-82.5 122.5Q699-156 629.28-126q-69.73 30-149 30Zm-.28-72q130 0 221-91t91-221q0-130-91-221t-221-91q-130 0-221 91t-91 221q0 130 91 221t221 91Zm0-312Z" /></svg></button>
                        </div>
                        <div class="rc-tool-inline-actions">
                            @if (!IsCategoryCollapsed(EditorCategory.Traits))
                            {
                                <button type="button" disabled="@IsCategoryLimitReached(EditorCategory.Traits)" @onclick="AddAndSelectTrait">@L["GameSystem_Editor_AddTraitRow"]</button>
                            }
                            <button type="button" @onclick="() => ToggleCategoryCollapse(EditorCategory.Traits)">@GetCategoryCollapseLabel(EditorCategory.Traits)</button>
                        </div>
                    </div>
                    @if (!IsCategoryCollapsed(EditorCategory.Traits))
                    {
                        <div class="rc-editor-list">
                            @foreach (var trait in CurrentSystem.Traits)
                            {
                                <button type="button" class="@GetEditorListItemClass(EditorCategory.Traits, GetTraitKey(trait), trait.IsDeleted)" @onclick="() => ToggleEditorSelection(EditorCategory.Traits, GetTraitKey(trait))">
                                    <span class="rc-editor-list-item__title">@DisplayNameOrPlaceholder(trait.Name)</span>
                                    <span class="rc-editor-list-item__summary">@GetTraitSummary(trait)</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="@GetCategoryCardCssClass(EditorCategory.Gauges)">
                    <div class="rc-editor-category-card__header">
                        <div class="rc-filter-group-card__title">
                            @L["GameSystem_Editor_GaugesSection"]
                            <button type="button" class="rc-editor-category-card__title-button" @onclick="() => ToggleCategorySelection(EditorCategory.Gauges)"><svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M444-288h72v-240h-72v240Zm61.5-322.29q10.5-10.29 10.5-25.5t-10.29-25.71q-10.29-10.5-25.5-10.5t-25.71 10.29q-10.5 10.29-10.5 25.5t10.29 25.71q10.29 10.5 25.5 10.5t25.71-10.29ZM480.28-96Q401-96 331-126t-122.5-82.5Q156-261 126-330.96t-30-149.5Q96-560 126-629.5q30-69.5 82.5-122T330.96-834q69.96-30 149.5-30t149.04 30q69.5 30 122 82.5T834-629.28q30 69.73 30 149Q864-401 834-331t-82.5 122.5Q699-156 629.28-126q-69.73 30-149 30Zm-.28-72q130 0 221-91t91-221q0-130-91-221t-221-91q-130 0-221 91t-91 221q0 130 91 221t221 91Zm0-312Z" /></svg></button>
                        </div>
                        <div class="rc-tool-inline-actions">
                            @if (!IsCategoryCollapsed(EditorCategory.Gauges))
                            {
                                <button type="button" disabled="@IsCategoryLimitReached(EditorCategory.Gauges)" @onclick="AddAndSelectGauge">@L["GameSystem_Editor_AddGaugeRow"]</button>
                            }
                            <button type="button" @onclick="() => ToggleCategoryCollapse(EditorCategory.Gauges)">@GetCategoryCollapseLabel(EditorCategory.Gauges)</button>
                        </div>
                    </div>
                    @if (!IsCategoryCollapsed(EditorCategory.Gauges))
                    {
                        <div class="rc-editor-list">
                            @foreach (var gauge in CurrentSystem.Gauges)
                            {
                                <button type="button" class="@GetEditorListItemClass(EditorCategory.Gauges, GetGaugeKey(gauge), gauge.IsDeleted)" @onclick="() => ToggleEditorSelection(EditorCategory.Gauges, GetGaugeKey(gauge))">
                                    <span class="rc-editor-list-item__title">@DisplayNameOrPlaceholder(gauge.Name)</span>
                                    <span class="rc-editor-list-item__summary">@GetGaugeSummary(gauge)</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="@GetCategoryCardCssClass(EditorCategory.Talents)">
                    <div class="rc-editor-category-card__header">
                        <div class="rc-filter-group-card__title">
                            @L["GameSystem_Editor_TalentsSection"]
                            <button type="button" class="rc-editor-category-card__title-button" @onclick="() => ToggleCategorySelection(EditorCategory.Talents)"><svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="m403-96-22-114q-23-9-44.5-21T296-259l-110 37-77-133 87-76q-2-12-3-24t-1-25q0-13 1-25t3-24l-87-76 77-133 110 37q19-16 40.5-28t44.5-21l22-114h154l22 114q23 9 44.5 21t40.5 28l110-37 77 133-87 76q2 12 3 24t1 25q0 13-1 25t-3 24l87 76-77 133-110-37q-19 16-40.5 28T579-210L557-96H403Zm59-72h36l19-99q38-7 71-26t57-48l96 32 18-30-76-67q6-17 9.5-35.5T696-480q0-20-3.5-38.5T683-554l76-67-18-30-96 32q-24-29-57-48t-71-26l-19-99h-36l-19 99q-38 7-71 26t-57 48l-96-32-18 30 76 67q-6 17-9.5 35.5T264-480q0 20 3.5 38.5T277-406l-76 67 18 30 96-32q24 29 57 48t71 26l19 99Zm18-168q60 0 102-42t42-102q0-60-42-102t-102-42q-60 0-102 42t-42 102q0 60 42 102t102 42Zm0-144Z" /></svg></button>
                        </div>
                        <div class="rc-tool-inline-actions">
                            @if (!IsCategoryCollapsed(EditorCategory.Talents))
                            {
                                <button type="button" disabled="@IsCategoryLimitReached(EditorCategory.Talents)" @onclick="AddAndSelectTalent">@L["GameSystem_Editor_AddTalentRow"]</button>
                            }
                            <button type="button" @onclick="() => ToggleCategoryCollapse(EditorCategory.Talents)">@GetCategoryCollapseLabel(EditorCategory.Talents)</button>
                        </div>
                    </div>
                    @if (!IsCategoryCollapsed(EditorCategory.Talents))
                    {
                        <div class="rc-editor-list">
                            @foreach (var talent in CurrentSystem.Talents)
                            {
                                <button type="button" class="@GetEditorListItemClass(EditorCategory.Talents, GetTalentKey(talent), talent.IsDeleted)" @onclick="() => ToggleEditorSelection(EditorCategory.Talents, GetTalentKey(talent))">
                                    <span class="rc-editor-list-item__title">@DisplayNameOrPlaceholder(talent.Name)</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="@GetCategoryCardCssClass(EditorCategory.Items)">
                    <div class="rc-editor-category-card__header">
                        <div class="rc-filter-group-card__title">
                            @L["GameSystem_Editor_ItemsSection"]
