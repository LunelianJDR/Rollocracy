    {
        if (CurrentSystem is null || SelectedEditorCategory is null || string.IsNullOrWhiteSpace(SelectedEditorKey))
            return;

        switch (SelectedEditorCategory)
        {
            case EditorCategory.Attributes:
                if (FindAttribute(CurrentSystem, SelectedEditorKey) is { } attribute)
                    SelectedAttributeDraft = DeepClone(attribute);
                break;
            case EditorCategory.DerivedStats:
                if (FindDerivedStat(CurrentSystem, SelectedEditorKey) is { } derived)
                    SelectedDerivedStatDraft = DeepClone(derived);
                break;
            case EditorCategory.Metrics:
                if (FindMetric(CurrentSystem, SelectedEditorKey) is { } metric)
                    SelectedMetricDraft = DeepClone(metric);
                break;
            case EditorCategory.Traits:
                if (FindTrait(CurrentSystem, SelectedEditorKey) is { } trait)
                    SelectedTraitDraft = DeepClone(trait);
                break;
            case EditorCategory.Gauges:
                if (FindGauge(CurrentSystem, SelectedEditorKey) is { } gauge)
                    SelectedGaugeDraft = DeepClone(gauge);
                break;
            case EditorCategory.Talents:
                if (FindTalent(CurrentSystem, SelectedEditorKey) is { } talent)
                    SelectedTalentDraft = DeepClone(talent);
                break;
            case EditorCategory.Items:
                if (FindItem(CurrentSystem, SelectedEditorKey) is { } item)
