{
    <div class="rc-tool-form-grid">
        <div class="rc-form-field"><label>@L["Common_Name"]</label><input @bind="SelectedItemDraft.Name" /></div><div class="rc-form-field"><label>@L["GameSystem_Editor_DisplayOrder"]</label><input type="number" @bind="SelectedItemDraft.DisplayOrder" /></div><div class="rc-form-field rc-form-field--full"><label>@L["Common_Description"]</label><textarea rows="3" @bind="SelectedItemDraft.Description"></textarea></div><div class="rc-form-field"><label></label><label class="rc-filter-toggle"><input type="checkbox" @bind="SelectedItemDraft.IsSelectableAtCharacterCreation" /><span>@L["GameSystem_Editor_IsSelectableAtCharacterCreation"]</span></label></div><div class="rc-form-field"><label></label><label class="rc-filter-toggle"><input type="checkbox" @bind="SelectedItemDraft.IsConsumable" /><span>@L["GameSystem_Editor_ItemIsConsumable"]</span></label></div>@if (SelectedItemDraft.IsConsumable) {
        <div class="rc-form-field"><label>@L["GameSystem_Editor_ItemMaxQuantityPerCharacter"]</label><input type="number" min="1" @bind="SelectedItemDraft.MaxQuantityPerCharacter" /></div>
    }
</div>
<div class="rc-tool-subsection">
    <div class="rc-tool-subsection__header"><div class="rc-tool-subsection__title">@L["GameSystem_Editor_ItemModifiersSection"]</div><div class="rc-tool-inline-actions"><button type="button" @onclick="() => AddItemModifierRow(SelectedItemDraft)">@L["GameSystem_Editor_AddItemModifierRow"]</button></div></div>@foreach (var modifier in SelectedItemDraft.Modifiers) {
    <div class="rc-filter-group-card">
        <div class="rc-tool-form-grid rc-tool-form-grid--very-dense">
            <div class="rc-form-field"><label>@L["GameSystem_Editor_ModifierTargetType"]</label><select value="@modifier.TargetType.ToString()" @onchange="e => ChangeModifierTargetType(modifier, e.Value?.ToString())"><option value="@ModifierTargetType.BaseAttribute">@L["GameSystem_Editor_ModifierTarget_BaseAttribute"]</option><option value="@ModifierTargetType.DerivedStat">@L["GameSystem_Editor_ModifierTarget_DerivedStat"]</option><option value="@ModifierTargetType.Metric">@L["GameSystem_Editor_ModifierTarget_Metric"]</option><option value="@ModifierTargetType.Gauge">@L["GameSystem_Editor_ModifierTarget_Gauge"]</option></select></div><div class="rc-form-field">
            <label>@L["GameSystem_Editor_ModifierTarget"]</label><select @bind="modifier.TargetId">
            @foreach (var optionItem in GetModifierTargetOptions(modifier.TargetType))
            {
                <option value="@optionItem.Id">@optionItem.Name</option>
            }
        </select>
    </div>@if (modifier.OperationType == ModifierOperationType.AddValue && modifier.TargetType == ModifierTargetType.Gauge && SelectedItemDraft.IsConsumable) {
    <div class="rc-form-field"><label>@L["GameSystem_Editor_ItemModifierAffectsMaximum"]</label><label class="rc-filter-toggle"><input type="checkbox" checked="@ItemGaugeModifierAffectsMaximum(modifier)" @onchange="e => SetItemGaugeModifierAffectsMaximum(modifier, e.Value is bool value && value)" /><span>@L["GameSystem_Editor_ItemModifierAffectsMaximum"]</span></label></div>
}
<div class="rc-form-field"><label>@L["GameSystem_Editor_ModifierValueMode"]</label><select @bind="modifier.ValueMode"><option value="@ModifierValueMode.Fixed">@L["GameSystem_Editor_ModifierValueMode_Fixed"]</option><option value="@ModifierValueMode.Metric">@L["GameSystem_Editor_ModifierValueMode_Metric"]</option></select></div>@if (modifier.ValueMode == ModifierValueMode.Fixed) {
<div class="rc-form-field"><label>@L["GameSystem_Editor_ModifierValue"]</label><input type="number" @bind="modifier.Value" /></div>
                        } else
{

    <div class="rc-form-field">
        <label>@L["GameSystem_Editor_ModifierSourceMetric"]</label><select @bind="modifier.SourceMetricId">
        @foreach (var metricRef in GetEditableMetrics())
        {
            <option value="@metricRef.MetricDefinitionId">@metricRef.Name</option>
        }
    </select>
</div>
                        }
</div><div class="rc-tool-actions"><button type="button" @onclick="() => SelectedItemDraft.Modifiers.Remove(modifier)">@L["Common_Remove"]</button></div>
</div>
                        }
</div>
                    }
                }
</div>
</div>

<div class="rc-tool-actions rc-tool-actions--right rc-editor-footer-actions">
    <button type="button" @onclick="BackToOrigin">@GetReturnButtonLabel()</button>
    <button type="button" @onclick="SaveChanges">@L["Common_Save"]</button>
</div>
</section>
}

@code {
    [Parameter] public Guid GameSystemId { get; set; }
    [SupplyParameterFromQuery(Name = "returnTo")]
    public string? ReturnTo { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public Guid? ReturnSessionId { get; set; }

    [SupplyParameterFromQuery(Name = "playerSessionId")]
    public Guid? ReturnPlayerSessionId { get; set; }

    private Guid CurrentUserId;
    private bool IsLoaded;
    private bool RedirectToHome;
    private string Message = string.Empty;
    private bool ShowSharedConfirm;
    private string ReferenceCleanupConfirmationMessage = string.Empty;
    private GameSystemEditorDto? CurrentSystem;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);

        var canCreateSessions = await SessionService.CanUserCreateSessionsAsync(CurrentUserId);

        if (!canCreateSessions)
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        await LoadEditor();

        if (CurrentSystem is null)
        {
            IsLoaded = true;
            return;
        }

        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToHome)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadEditor()
    {
        Message = string.Empty;
        ShowSharedConfirm = false;
        CurrentSystem = await GameSystemService.GetGameSystemEditorAsync(GameSystemId, CurrentUserId);

        if (CurrentSystem is not null)
        {
            RefreshLoadedSnapshot();
            SelectedEditorCategory = null;
            SelectedEditorKey = null;
            ClearEditorDrafts();
        }
    }

    private bool CanReturnToOrigin()
    {
        if (string.Equals(ReturnTo, "mj-session", StringComparison.OrdinalIgnoreCase))
            return ReturnSessionId.HasValue;

        if (string.Equals(ReturnTo, "player-room", StringComparison.OrdinalIgnoreCase))
            return ReturnPlayerSessionId.HasValue;

        return false;
    }

    private string GetReturnButtonLabel()
    {
        if (string.Equals(ReturnTo, "mj-session", StringComparison.OrdinalIgnoreCase))
            return L["GameSystem_Editor_BackToSession"];

        if (string.Equals(ReturnTo, "player-room", StringComparison.OrdinalIgnoreCase))
            return L["Session_BackToSession"];

        return L["GameSystem_Editor_BackToList"];
    }

    private void BackToOrigin()
    {
        if (string.Equals(ReturnTo, "mj-session", StringComparison.OrdinalIgnoreCase) && ReturnSessionId.HasValue)
        {
            Navigation.NavigateTo($"/mj/session/{ReturnSessionId.Value}/settings");
            return;
        }

        if (string.Equals(ReturnTo, "player-room", StringComparison.OrdinalIgnoreCase) && ReturnPlayerSessionId.HasValue)
        {
            Navigation.NavigateTo($"/player/room/{ReturnPlayerSessionId.Value}");
            return;
        }

        Navigation.NavigateTo("/mj/gamesystems");
    }

    private void BackToGameSystems()
    {
        Navigation.NavigateTo("/mj/gamesystems");
    }

    private List<BaseAttributeReferenceDto> GetEditableBaseAttributes()
    {
        if (CurrentSystem is null)
            return new List<BaseAttributeReferenceDto>();

        return CurrentSystem.Attributes
            .Where(x => !x.IsDeleted)
            .Select(x => new BaseAttributeReferenceDto
            {
                AttributeDefinitionId = x.AttributeDefinitionId ?? Guid.Empty,
                TemporaryKey = !string.IsNullOrWhiteSpace(x.TemporaryKey)
                    ? x.TemporaryKey
                    : (x.AttributeDefinitionId?.ToString("N") ?? string.Empty),
                Name = x.Name
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.TemporaryKey))
            .ToList();
    }

    private string GetEditableBaseAttributesRenderKey()
    {
        var attributes = GetEditableBaseAttributes();

        return string.Join("|", attributes.Select(x => $"{x.TemporaryKey}:{x.Name}"));
    }


    private List<EditableMetricDefinitionDto> GetEditableMetrics()
    {
        if (CurrentSystem is null)
            return new List<EditableMetricDefinitionDto>();

        return CurrentSystem.Metrics
            .Where(x => !x.IsDeleted && x.MetricDefinitionId.HasValue)
            .ToList();
    }

    private void AddAttributeRow()
    {
        if (CurrentSystem is null || IsCategoryLimitReached(EditorCategory.Attributes))
            return;

        var tempKey = Guid.NewGuid().ToString("N");

        CurrentSystem.Attributes.Add(new EditableAttributeDefinitionDto
        {
            AttributeDefinitionId = Guid.NewGuid(),
            TemporaryKey = tempKey,
            Name = string.Empty,
            MinValue = 0,
            MaxValue = 20,
            DefaultValue = 10,
            CreationDistributionPoints = 0,
            MaxCreationDistributionPerCharacter = 0,
            DefaultValueMode = BaseValueGenerationMode.Fixed
        });
    }

    private void AddDerivedStatRow()
    {
        if (CurrentSystem is null || IsCategoryLimitReached(EditorCategory.DerivedStats))
            return;

        CurrentSystem.DerivedStats.Add(new EditableDerivedStatDefinitionDto
        {
            DerivedStatDefinitionId = Guid.NewGuid(),
            Name = string.Empty,
            MinValue = 0,
            MaxValue = 100,
            RoundMode = ComputedValueRoundMode.Ceiling,
            DisplayOrder = CurrentSystem.DerivedStats.Count,
            CreationDistributionPoints = 0,
            MaxCreationDistributionPerCharacter = 0
        });
    }

    private void AddDerivedComponentRow(EditableDerivedStatDefinitionDto derivedStat)
    {
        var availableAttributes = GetEditableBaseAttributes();

        if (availableAttributes.Count == 0)
            return;

        var attribute = availableAttributes.First();

        derivedStat.Components.Add(new EditableDerivedStatComponentDto
        {
            AttributeDefinitionId = attribute.AttributeDefinitionId,
            AttributeTemporaryKey = attribute.TemporaryKey,
            AttributeName = attribute.Name,
            Weight = 100
        });
    }

    private string GetBaseAttributeName(Guid attributeDefinitionId)
    {
        if (CurrentSystem is null)
            return string.Empty;

        return CurrentSystem.Attributes
            .Where(x => !x.IsDeleted)
            .FirstOrDefault(a => a.AttributeDefinitionId == attributeDefinitionId)?.Name ?? string.Empty;
    }

    private void AddMetricRow()
    {
        if (CurrentSystem is null || IsCategoryLimitReached(EditorCategory.Metrics))
            return;

        var metricId = Guid.NewGuid();

        CurrentSystem.Metrics.Add(new EditableMetricDefinitionDto
        {
            MetricDefinitionId = metricId,
            Name = string.Empty,
            TemporaryKey = metricId.ToString("N"),
            BaseValue = 0,
            MinValue = 0,
            MaxValue = 100,
            RoundMode = ComputedValueRoundMode.Ceiling,
            DisplayOrder = CurrentSystem.Metrics.Count
        });
    }

    private void AddMetricComponentRow(EditableMetricDefinitionDto metric)
    {
        if (CurrentSystem is null || GetEditableBaseAttributes().Count == 0)
            return;

        var attribute = GetEditableBaseAttributes().First();

        metric.Components.Add(new EditableMetricComponentDto
        {
            AttributeDefinitionId = attribute.AttributeDefinitionId,
            AttributeName = attribute.Name,
            Weight = 100
        });
    }

    private void AddMetricFormulaStepRow(EditableMetricDefinitionDto metric)
    {
        var firstAttribute = GetEditableBaseAttributes().FirstOrDefault();

        metric.FormulaSteps.Add(new EditableMetricFormulaStepDto
        {
            Order = metric.FormulaSteps.Count,
            OperationType = MetricFormulaOperationType.Add,
            SourceType = firstAttribute is not null ? MetricFormulaSourceType.BaseAttribute : MetricFormulaSourceType.Constant,
            SourceId = firstAttribute?.AttributeDefinitionId,
            ConstantValue = 0m
        });
    }

    private IReadOnlyList<MetricFormulaSourceOption> GetMetricFormulaSourceOptions(
        EditableMetricDefinitionDto metric,
        MetricFormulaSourceType sourceType)
    {
        if (CurrentSystem is null)
            return Array.Empty<MetricFormulaSourceOption>();

        return sourceType switch
        {
            MetricFormulaSourceType.BaseAttribute => GetEditableBaseAttributes()
                .Select(x => new MetricFormulaSourceOption(x.AttributeDefinitionId, x.Name))
                .ToList(),

            MetricFormulaSourceType.Gauge => CurrentSystem.Gauges
                .Where(x => !x.IsDeleted && x.GaugeDefinitionId.HasValue)
                .Select(x => new MetricFormulaSourceOption(x.GaugeDefinitionId!.Value, x.Name))
                .ToList(),

            MetricFormulaSourceType.DerivedStat => CurrentSystem.DerivedStats
                .Where(x => !x.IsDeleted && x.DerivedStatDefinitionId.HasValue)
                .Select(x => new MetricFormulaSourceOption(x.DerivedStatDefinitionId!.Value, x.Name))
                .ToList(),

            MetricFormulaSourceType.Metric => CurrentSystem.Metrics
                .Where(x => !x.IsDeleted && x.MetricDefinitionId.HasValue && x != metric)
                .Select(x => new MetricFormulaSourceOption(x.MetricDefinitionId!.Value, x.Name))
                .ToList(),

            _ => Array.Empty<MetricFormulaSourceOption>()
        };
    }

    private void ChangeMetricFormulaSourceId(EditableMetricFormulaStepDto step, string? rawValue)
    {
        if (!Guid.TryParse(rawValue, out var parsed))
            return;

        step.SourceId = parsed;
    }

    private void ChangeMetricFormulaSourceType(EditableMetricFormulaStepDto step, string? rawValue)
    {
        if (!Enum.TryParse<MetricFormulaSourceType>(rawValue, out var sourceType))
            return;

        step.SourceType = sourceType;

        if (sourceType == MetricFormulaSourceType.Constant)
        {
            step.SourceId = null;
            return;
        }

        var parentMetric = FindMetricContainingStep(step);
        if (parentMetric is null)
        {
            step.SourceId = null;
            return;
        }

        var firstOption = GetMetricFormulaSourceOptions(parentMetric, sourceType).FirstOrDefault();
        step.SourceId = firstOption?.Id;
    }

    private EditableMetricDefinitionDto? FindMetricContainingStep(EditableMetricFormulaStepDto step)
    {
        if (CurrentSystem is null)
            return null;

        return CurrentSystem.Metrics.FirstOrDefault(x => x.FormulaSteps.Contains(step));
    }

    private static string FormatMetricConstant(decimal value)
    {
        return value.ToString("0.####");
    }

    private string GetMetricFormulaStepSummary(EditableMetricFormulaStepDto step)
    {
        var operation = step.OperationType switch
        {
            MetricFormulaOperationType.Add => L["GameSystem_Editor_MetricFormulaOperation_Add"].Value,
            MetricFormulaOperationType.Subtract => L["GameSystem_Editor_MetricFormulaOperation_Subtract"].Value,
            MetricFormulaOperationType.Multiply => L["GameSystem_Editor_MetricFormulaOperation_Multiply"].Value,
            MetricFormulaOperationType.Divide => L["GameSystem_Editor_MetricFormulaOperation_Divide"].Value,
            _ => string.Empty
        };

        var source = step.SourceType == MetricFormulaSourceType.Constant
            ? FormatMetricConstant(step.ConstantValue)
            : GetMetricFormulaSourceLabel(step);

        return $"{operation} {source}";
    }

    private string GetMetricFormulaSourceLabel(EditableMetricFormulaStepDto step)
    {
        if (CurrentSystem is null || !step.SourceId.HasValue)
            return step.SourceName;

        return step.SourceType switch
        {
            MetricFormulaSourceType.BaseAttribute => GetEditableBaseAttributes().FirstOrDefault(x => x.AttributeDefinitionId == step.SourceId.Value)?.Name ?? step.SourceName,
            MetricFormulaSourceType.Gauge => CurrentSystem.Gauges.FirstOrDefault(x => x.GaugeDefinitionId == step.SourceId.Value)?.Name ?? step.SourceName,
            MetricFormulaSourceType.DerivedStat => CurrentSystem.DerivedStats.FirstOrDefault(x => x.DerivedStatDefinitionId == step.SourceId.Value)?.Name ?? step.SourceName,
            MetricFormulaSourceType.Metric => CurrentSystem.Metrics.FirstOrDefault(x => x.MetricDefinitionId == step.SourceId.Value)?.Name ?? step.SourceName,
            MetricFormulaSourceType.Constant => FormatMetricConstant(step.ConstantValue),
            _ => step.SourceName
        };
    }

    private void PrepareMetricsForSave(List<EditableMetricDefinitionDto> metrics)
    {
        foreach (var metric in metrics.Where(x => !x.IsDeleted))
        {
            var activeSteps = metric.FormulaSteps
                .Where(x => !x.IsDeleted)
                .OrderBy(x => x.Order)
                .ThenBy(x => x.MetricFormulaStepId)
                .ToList();

            for (var index = 0; index < activeSteps.Count; index++)
            {
                activeSteps[index].Order = index;
            }

            if (activeSteps.Count > 0)
            {
                metric.Components.Clear();
            }
        }
    }

    private sealed record MetricFormulaSourceOption(Guid Id, string Name);

    private void AddTraitRow()
    {
        if (CurrentSystem is null || IsCategoryLimitReached(EditorCategory.Traits))
            return;

        CurrentSystem.Traits.Add(new EditableTraitDefinitionDto { TraitDefinitionId = Guid.NewGuid(), Name = string.Empty });
    }

    private void AddTraitOptionRow(EditableTraitDefinitionDto trait)
    {
        if (IsTraitOptionLimitReached(trait))
            return;

        trait.Options.Add(new EditableTraitOptionDto { TraitOptionId = Guid.NewGuid(), Name = string.Empty });
    }

    private void AddTraitOptionModifierRow(EditableTraitOptionDto option)
    {
        var firstAttribute = GetEditableBaseAttributes().FirstOrDefault();

        option.Modifiers.Add(new EditableModifierDefinitionDto
        {
            TargetType = ModifierTargetType.BaseAttribute,
            TargetId = firstAttribute?.AttributeDefinitionId ?? Guid.Empty,
            Value = 0,
            ValueMode = ModifierValueMode.Fixed,
            SourceMetricId = GetEditableMetrics().FirstOrDefault()?.MetricDefinitionId
        });
    }

    private void AddGaugeRow()
    {
        if (CurrentSystem is null || IsCategoryLimitReached(EditorCategory.Gauges))
            return;

        CurrentSystem.Gauges.Add(new EditableGaugeDefinitionDto
        {
            GaugeDefinitionId = Guid.NewGuid(),
            Name = string.Empty,
            MinValue = 0,
            MaxValue = 10,
            DefaultValue = 10
        });
    }

    private void AddTalentRow()
    {
        if (CurrentSystem is null || IsCategoryLimitReached(EditorCategory.Talents))
            return;

        CurrentSystem.Talents.Add(new EditableTalentDefinitionDto
        {
            TalentDefinitionId = Guid.NewGuid(),
            Name = string.Empty,
            Description = string.Empty,
            DisplayOrder = CurrentSystem.Talents.Count,
            IsSelectableAtCharacterCreation = false
        });
    }

    private void AddTalentModifierRow(EditableTalentDefinitionDto talent)
    {
        var firstAttribute = GetEditableBaseAttributes().FirstOrDefault();

        talent.Modifiers.Add(new EditableModifierDefinitionDto
        {
            TargetType = ModifierTargetType.BaseAttribute,
            TargetId = firstAttribute?.AttributeDefinitionId ?? Guid.Empty,
            Value = 0,
            ValueMode = ModifierValueMode.Fixed,
            SourceMetricId = GetEditableMetrics().FirstOrDefault()?.MetricDefinitionId
        });
    }

    private void AddItemRow()
    {
        if (CurrentSystem is null || IsCategoryLimitReached(EditorCategory.Items))
            return;

        CurrentSystem.Items.Add(new EditableItemDefinitionDto
        {
            ItemDefinitionId = Guid.NewGuid(),
            Name = string.Empty,
            Description = string.Empty,
            DisplayOrder = CurrentSystem.Items.Count,
            IsSelectableAtCharacterCreation = false
        });
    }

    private void AddItemModifierRow(EditableItemDefinitionDto item)
    {
        var firstAttribute = GetEditableBaseAttributes().FirstOrDefault();

        item.Modifiers.Add(new EditableModifierDefinitionDto
        {
            TargetType = ModifierTargetType.BaseAttribute,
            TargetId = firstAttribute?.AttributeDefinitionId ?? Guid.Empty,
            Value = 0,
            ValueMode = ModifierValueMode.Fixed,
            SourceMetricId = GetEditableMetrics().FirstOrDefault()?.MetricDefinitionId,
            OperationType = ModifierOperationType.AddValue,
            FillGaugeCurrentValueOnly = false
        });
    }

    private IReadOnlyList<ModifierTargetOption> GetModifierTargetOptions(ModifierTargetType targetType)
    {
        if (CurrentSystem is null)
            return Array.Empty<ModifierTargetOption>();

        return targetType switch
        {
            ModifierTargetType.BaseAttribute => GetEditableBaseAttributes()
                .Select(x => new ModifierTargetOption(x.AttributeDefinitionId, x.Name))
                .ToList(),

            ModifierTargetType.Gauge => CurrentSystem.Gauges
                .Where(x => !x.IsDeleted && x.GaugeDefinitionId.HasValue)
                .Select(x => new ModifierTargetOption(x.GaugeDefinitionId!.Value, x.Name))
                .ToList(),

            ModifierTargetType.DerivedStat => CurrentSystem.DerivedStats
                .Where(x => !x.IsDeleted && x.DerivedStatDefinitionId.HasValue)
                .Select(x => new ModifierTargetOption(x.DerivedStatDefinitionId!.Value, x.Name))
                .ToList(),

            ModifierTargetType.Metric => CurrentSystem.Metrics
                .Where(x => !x.IsDeleted && x.MetricDefinitionId.HasValue)
                .Select(x => new ModifierTargetOption(x.MetricDefinitionId!.Value, x.Name))
                .ToList(),

            ModifierTargetType.Talent => CurrentSystem.Talents
                .Where(x => !x.IsDeleted && x.TalentDefinitionId.HasValue)
                .Select(x => new ModifierTargetOption(x.TalentDefinitionId!.Value, x.Name))
                .ToList(),

            ModifierTargetType.Item => CurrentSystem.Items
                .Where(x => !x.IsDeleted && x.ItemDefinitionId.HasValue)
                .Select(x => new ModifierTargetOption(x.ItemDefinitionId!.Value, x.Name))
                .ToList(),

            _ => Array.Empty<ModifierTargetOption>()
        };
    }

    private void ChangeModifierOperationType(EditableModifierDefinitionDto modifier, string? rawValue)
    {
        if (!Enum.TryParse<ModifierOperationType>(rawValue, out var parsed))
            return;

        modifier.OperationType = parsed;

        if (parsed == ModifierOperationType.Grant)
        {
            if (modifier.TargetType != ModifierTargetType.Talent &&
                modifier.TargetType != ModifierTargetType.Item)
            {
                modifier.TargetType = CurrentSystem?.Talents.Any(x => !x.IsDeleted && x.TalentDefinitionId.HasValue) == true
                    ? ModifierTargetType.Talent
                    : ModifierTargetType.Item;
            }

            var firstGrantOption = GetModifierTargetOptions(modifier.TargetType).FirstOrDefault();
            modifier.TargetId = firstGrantOption?.Id ?? Guid.Empty;

            modifier.ValueMode = ModifierValueMode.Fixed;
            modifier.Value = 0;
            modifier.SourceMetricId = null;
        }
        else
        {
            if (modifier.TargetType == ModifierTargetType.Talent ||
                modifier.TargetType == ModifierTargetType.Item)
            {
                modifier.TargetType = ModifierTargetType.BaseAttribute;
            }

            var firstValueOption = GetModifierTargetOptions(modifier.TargetType).FirstOrDefault();
            modifier.TargetId = firstValueOption?.Id ?? Guid.Empty;
        }
    }

    private void ChangeModifierTargetType(EditableModifierDefinitionDto modifier, string? rawValue)
    {
        if (!Enum.TryParse<ModifierTargetType>(rawValue, out var parsed))
            return;

        modifier.TargetType = parsed;

        var firstOption = GetModifierTargetOptions(parsed).FirstOrDefault();
        modifier.TargetId = firstOption?.Id ?? Guid.Empty;
    }

    private string GetModifierSummary(EditableModifierDefinitionDto modifier)
    {
        if (CurrentSystem is null)
            return string.Empty;

        var targetName = GetModifierTargetOptions(modifier.TargetType)
            .FirstOrDefault(x => x.Id == modifier.TargetId)?.Name ?? string.Empty;

        var value = modifier.ValueMode == ModifierValueMode.Metric
            ? GetEditableMetrics().FirstOrDefault(x => x.MetricDefinitionId == modifier.SourceMetricId)?.Name ?? string.Empty
            : modifier.Value.ToString();

        return $"{modifier.OperationType} {targetName} : {value}";
    }

    private sealed record ModifierTargetOption(Guid Id, string Name);

    private string GetCriticalSuccessLabel()
    {
        if (CurrentSystem is null)
            return L["GameSystem_Editor_CriticalSuccessValue"];

        var sign = CurrentSystem.TestResolutionMode == TestResolutionMode.SuccessThreshold
            ? "≥"
            : "≤";

        return $"{L["GameSystem_Editor_CriticalSuccessValue"]} {sign}";
    }

    private string GetCriticalFailureLabel()
    {
        if (CurrentSystem is null)
            return L["GameSystem_Editor_CriticalFailureValue"];

        var sign = CurrentSystem.TestResolutionMode == TestResolutionMode.SuccessThreshold
            ? "≤"
            : "≥";

        return $"{L["GameSystem_Editor_CriticalFailureValue"]} {sign}";
    }

    private int AttributeCreationDistributionPoints
    {
        get => CurrentSystem?.Attributes.FirstOrDefault(x => !x.IsDeleted)?.CreationDistributionPoints ?? 0;
        set
        {
            if (CurrentSystem is null)
                return;

            foreach (var attribute in CurrentSystem.Attributes.Where(x => !x.IsDeleted))
                attribute.CreationDistributionPoints = value;
        }
    }

    private int AttributeCreationDistributionMax
    {
        get => CurrentSystem?.Attributes.FirstOrDefault(x => !x.IsDeleted)?.MaxCreationDistributionPerCharacter ?? 0;
        set
        {
            if (CurrentSystem is null)
                return;

            foreach (var attribute in CurrentSystem.Attributes.Where(x => !x.IsDeleted))
                attribute.MaxCreationDistributionPerCharacter = value;
        }
    }

    private int DerivedStatCreationDistributionPoints
    {
        get => CurrentSystem?.DerivedStats.FirstOrDefault(x => !x.IsDeleted)?.CreationDistributionPoints ?? 0;
        set
        {
            if (CurrentSystem is null)
                return;

            foreach (var derivedStat in CurrentSystem.DerivedStats.Where(x => !x.IsDeleted))
                derivedStat.CreationDistributionPoints = value;
        }
    }

    private int DerivedStatCreationDistributionMax
    {
        get => CurrentSystem?.DerivedStats.FirstOrDefault(x => !x.IsDeleted)?.MaxCreationDistributionPerCharacter ?? 0;
        set
        {
            if (CurrentSystem is null)
                return;

            foreach (var derivedStat in CurrentSystem.DerivedStats.Where(x => !x.IsDeleted))
                derivedStat.MaxCreationDistributionPerCharacter = value;
        }
    }

    private void ApplyCreationConfigurationAcrossDefinitions()
    {
        if (CurrentSystem is null)
            return;

        if (CurrentSystem.Attributes.Count > 0)
        {
            var attributePoints = CurrentSystem.Attributes.First().CreationDistributionPoints;
            var attributeMax = CurrentSystem.Attributes.First().MaxCreationDistributionPerCharacter;

            foreach (var attribute in CurrentSystem.Attributes.Where(x => !x.IsDeleted))
            {
                attribute.CreationDistributionPoints = attributePoints;
                attribute.MaxCreationDistributionPerCharacter = attributeMax;
            }
        }

        if (CurrentSystem.DerivedStats.Count > 0)
        {
            var derivedPoints = CurrentSystem.DerivedStats.First().CreationDistributionPoints;
            var derivedMax = CurrentSystem.DerivedStats.First().MaxCreationDistributionPerCharacter;

            foreach (var derivedStat in CurrentSystem.DerivedStats.Where(x => !x.IsDeleted))
            {
                derivedStat.CreationDistributionPoints = derivedPoints;
                derivedStat.MaxCreationDistributionPerCharacter = derivedMax;
            }
        }
    }

    private async Task SaveChanges()
    {
        await SaveChangesInternal(false);
    }

    private async Task ConfirmSharedSave()
    {
        await SaveChangesInternal(true);
    }

    private Task CancelSharedSave()
    {
        ShowSharedConfirm = false;
        Message = string.Empty;
        return Task.CompletedTask;
    }

    private async Task SaveChangesInternal(bool confirmShared, bool confirmReferenceCleanup = false)
    {
        if (CurrentSystem is null)
            return;

        // Si le systÃ¨me est partagÃ© avec des sessions existantes
        // et qu'on n'a pas encore confirmÃ© explicitement,
        // on affiche d'abord le panneau de confirmation.
        if (!confirmShared &&
            !CurrentSystem.IsLockedToSessionCopy &&
            CurrentSystem.ImpactedSessions.Count > 0)
        {
            ShowSharedConfirm = true;
            Message = string.Empty;
            await ScrollToTopAsync();
            return;
        }

        try
        {
            Message = string.Empty;
            ShowSharedConfirm = false;

            PrepareMetricsForSave(CurrentSystem.Metrics);

            ApplyCreationConfigurationAcrossDefinitions();

            var request = new GameSystemApplyChangesRequestDto
            {
                Name = CurrentSystem.Name,
                Description = CurrentSystem.Description,
                TestResolutionMode = CurrentSystem.TestResolutionMode,
                DefaultTestDiceCount = CurrentSystem.DefaultTestDiceCount,
                DefaultTestDiceSides = CurrentSystem.DefaultTestDiceSides,
                CriticalSuccessValue = CurrentSystem.CriticalSuccessValue,
                CriticalFailureValue = CurrentSystem.CriticalFailureValue,
                DefaultSuccessThreshold = CurrentSystem.DefaultSuccessThreshold,
                ConfirmSharedSystemChanges = confirmShared,
                ConfirmDeletedReferenceCleanup = confirmReferenceCleanup,
                IsGeneric = CurrentSystem.IsGeneric,
                StartingTalentChoices = CurrentSystem.StartingTalentChoices,
                StartingItemChoices = CurrentSystem.StartingItemChoices,
                Attributes = CurrentSystem.Attributes,
                DerivedStats = CurrentSystem.DerivedStats,
                Metrics = CurrentSystem.Metrics,
                Traits = CurrentSystem.Traits,
                Gauges = CurrentSystem.Gauges,
                Talents = CurrentSystem.Talents,
                Items = CurrentSystem.Items
            };

            await GameSystemService.ApplyGameSystemChangesAsync(
                GameSystemId,
                CurrentUserId,
                request);

            await LoadEditor();
            Message = L["GameSystem_Editor_ChangesApplied"];
            await ScrollToTopAsync();
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
            await ScrollToTopAsync();
        }
    }

    private async Task UndoLastChange()
    {
        if (CurrentSystem is null || !CurrentSystem.CanUndoLastChange)
            return;

        try
        {
            Message = string.Empty;

            await GameSystemService.UndoLastGameSystemChangeAsync(GameSystemId, CurrentUserId);
            await LoadEditor();

            Message = L["GameSystem_Editor_LastChangeUndone"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

