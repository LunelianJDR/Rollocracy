    private void ApplySelectedEditorChanges()
    {
        if (CurrentSystem is null || SelectedEditorCategory is null)
            return;

        if (SelectedEditorKey is null)
        {
            switch (SelectedEditorCategory)
            {
                case EditorCategory.Attributes:
                    AttributeCreationDistributionPoints = AttributeCreationDistributionPointsDraft;
                    AttributeCreationDistributionMax = AttributeCreationDistributionMaxDraft;
                    break;
                case EditorCategory.DerivedStats:
                    DerivedStatCreationDistributionPoints = DerivedStatCreationDistributionPointsDraft;
                    DerivedStatCreationDistributionMax = DerivedStatCreationDistributionMaxDraft;
                    break;
                case EditorCategory.Talents:
                    CurrentSystem.StartingTalentChoices = StartingTalentChoicesDraft;
                    break;
                case EditorCategory.Items:
                    CurrentSystem.StartingItemChoices = StartingItemChoicesDraft;
                    break;
            }
            return;
        }

        switch (SelectedEditorCategory)
        {
            case EditorCategory.Attributes when SelectedAttributeDraft is not null:
                ReplaceInList(CurrentSystem.Attributes, FindAttribute(CurrentSystem, SelectedEditorKey), DeepClone(SelectedAttributeDraft));
                break;
            case EditorCategory.DerivedStats when SelectedDerivedStatDraft is not null:
                ReplaceInList(CurrentSystem.DerivedStats, FindDerivedStat(CurrentSystem, SelectedEditorKey), DeepClone(SelectedDerivedStatDraft));
                break;
            case EditorCategory.Metrics when SelectedMetricDraft is not null:
                ReplaceInList(CurrentSystem.Metrics, FindMetric(CurrentSystem, SelectedEditorKey), DeepClone(SelectedMetricDraft));
                break;
            case EditorCategory.Traits when SelectedTraitDraft is not null:
                ReplaceInList(CurrentSystem.Traits, FindTrait(CurrentSystem, SelectedEditorKey), DeepClone(SelectedTraitDraft));
                break;
            case EditorCategory.Gauges when SelectedGaugeDraft is not null:
                ReplaceInList(CurrentSystem.Gauges, FindGauge(CurrentSystem, SelectedEditorKey), DeepClone(SelectedGaugeDraft));
                break;
            case EditorCategory.Talents when SelectedTalentDraft is not null:
                ReplaceInList(CurrentSystem.Talents, FindTalent(CurrentSystem, SelectedEditorKey), DeepClone(SelectedTalentDraft));
                break;
            case EditorCategory.Items when SelectedItemDraft is not null:
                ReplaceInList(CurrentSystem.Items, FindItem(CurrentSystem, SelectedEditorKey), DeepClone(SelectedItemDraft));
                break;
        }

        LoadSelectedDraft();
    }

    private static void ReplaceInList<T>(List<T> list, T? currentItem, T replacement) where T : class
    {
        if (currentItem is null)
            return;
        var index = list.IndexOf(currentItem);
        if (index >= 0)
            list[index] = replacement;
    }

    private void CancelSelectedEditorChanges()
    {
        if (CurrentSystem is null || SelectedEditorCategory is null || LoadedSystemSnapshot is null)
            return;

        if (SelectedEditorKey is null)
        {
            InitializeCategoryDraft(SelectedEditorCategory.Value);
            return;
        }

        switch (SelectedEditorCategory)
        {
            case EditorCategory.Attributes:
                RestoreItem(CurrentSystem.Attributes, LoadedSystemSnapshot.Attributes, SelectedEditorKey, GetAttributeKey);
                break;
            case EditorCategory.DerivedStats:
                RestoreItem(CurrentSystem.DerivedStats, LoadedSystemSnapshot.DerivedStats, SelectedEditorKey, GetDerivedStatKey);
                break;
            case EditorCategory.Metrics:
                RestoreItem(CurrentSystem.Metrics, LoadedSystemSnapshot.Metrics, SelectedEditorKey, GetMetricKey);
                break;
            case EditorCategory.Traits:
                RestoreItem(CurrentSystem.Traits, LoadedSystemSnapshot.Traits, SelectedEditorKey, GetTraitKey);
                break;
            case EditorCategory.Gauges:
                RestoreItem(CurrentSystem.Gauges, LoadedSystemSnapshot.Gauges, SelectedEditorKey, GetGaugeKey);
                break;
            case EditorCategory.Talents:
                RestoreItem(CurrentSystem.Talents, LoadedSystemSnapshot.Talents, SelectedEditorKey, GetTalentKey);
                break;
            case EditorCategory.Items:
                RestoreItem(CurrentSystem.Items, LoadedSystemSnapshot.Items, SelectedEditorKey, GetItemKey);
                break;
        }

        LoadSelectedDraft();
    }

    private void RestoreItem<T>(List<T> currentList, List<T> loadedList, string key, Func<T, string> keySelector) where T : class
    {
        var currentItem = currentList.FirstOrDefault(x => keySelector(x) == key);
        var loadedItem = loadedList.FirstOrDefault(x => keySelector(x) == key);

        if (loadedItem is null)
        {
            if (currentItem is not null)
                currentList.Remove(currentItem);
            SelectedEditorCategory = null;
            SelectedEditorKey = null;
            ClearEditorDrafts();
            return;
        }

        if (currentItem is null)
        {
            currentList.Add(DeepClone(loadedItem));
        }
        else
        {
            var index = currentList.IndexOf(currentItem);
            currentList[index] = DeepClone(loadedItem);
        }
    }

    private void DeleteSelectedEditor()
    {
        if (CurrentSystem is null || SelectedEditorCategory is null)
            return;

        if (SelectedEditorKey is null)
        {
            switch (SelectedEditorCategory)
            {
                case EditorCategory.Attributes:
                    AttributeCreationDistributionPointsDraft = 0;
                    AttributeCreationDistributionMaxDraft = 0;
                    AttributeCreationDistributionPoints = 0;
                    AttributeCreationDistributionMax = 0;
                    break;
                case EditorCategory.DerivedStats:
                    DerivedStatCreationDistributionPointsDraft = 0;
                    DerivedStatCreationDistributionMaxDraft = 0;
                    DerivedStatCreationDistributionPoints = 0;
                    DerivedStatCreationDistributionMax = 0;
                    break;
                case EditorCategory.Talents:
                    StartingTalentChoicesDraft = 0;
                    CurrentSystem.StartingTalentChoices = 0;
                    break;
                case EditorCategory.Items:
                    StartingItemChoicesDraft = 0;
                    CurrentSystem.StartingItemChoices = 0;
                    break;
            }
            return;
        }

        switch (SelectedEditorCategory)
        {
            case EditorCategory.Attributes when FindAttribute(CurrentSystem, SelectedEditorKey) is { } attribute:
                DeleteOrMark(attribute.AttributeDefinitionId.HasValue, attribute, CurrentSystem.Attributes);
                break;
            case EditorCategory.DerivedStats when FindDerivedStat(CurrentSystem, SelectedEditorKey) is { } derived:
                DeleteOrMark(derived.DerivedStatDefinitionId.HasValue, derived, CurrentSystem.DerivedStats);
                break;
            case EditorCategory.Metrics when FindMetric(CurrentSystem, SelectedEditorKey) is { } metric:
                if (!IsVoteWeightMetric(metric)) DeleteOrMark(metric.MetricDefinitionId.HasValue, metric, CurrentSystem.Metrics);
                break;
            case EditorCategory.Traits when FindTrait(CurrentSystem, SelectedEditorKey) is { } trait:
                DeleteOrMark(trait.TraitDefinitionId.HasValue, trait, CurrentSystem.Traits);
                break;
            case EditorCategory.Gauges when FindGauge(CurrentSystem, SelectedEditorKey) is { } gauge:
                DeleteOrMark(gauge.GaugeDefinitionId.HasValue, gauge, CurrentSystem.Gauges);
                break;
            case EditorCategory.Talents when FindTalent(CurrentSystem, SelectedEditorKey) is { } talent:
                DeleteOrMark(talent.TalentDefinitionId.HasValue, talent, CurrentSystem.Talents);
                break;
            case EditorCategory.Items when FindItem(CurrentSystem, SelectedEditorKey) is { } item:
                DeleteOrMark(item.ItemDefinitionId.HasValue, item, CurrentSystem.Items);
                break;
        }

        SelectedEditorCategory = null;
        SelectedEditorKey = null;
        ClearEditorDrafts();
    }

    private static void DeleteOrMark<T>(bool existsInDb, T item, List<T> list) where T : class
    {
        var prop = typeof(T).GetProperty("IsDeleted");
        if (existsInDb && prop is not null)
            prop.SetValue(item, true);
        else
            list.Remove(item);
    }


