@page "/mj/gamesystems/{GameSystemId:guid}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.GameRules
@using Rollocracy.Localization
@using Microsoft.JSInterop
@using System.Text.Json

@inject IJSRuntime JS
@inject Rollocracy.Domain.Interfaces.IGameSystemService GameSystemService
@inject Rollocracy.Domain.Interfaces.ISessionService SessionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToHome)
{
    <p>@L["Common_Loading"]</p>
}
else if (CurrentSystem is null)
{
    <p>@L["GameSystem_NotFound"]</p>
}
else
{
    <section class="rc-tool-section rc-gs-editor-page">
        <div class="rc-tool-layout rc-tool-layout--top">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@CurrentSystem.Name</h4>
                        <p class="rc-tool-panel__subtitle">@L["GameSystem_Editor_Subtitle"]</p>
                    </div>
                    <div class="rc-tool-actions">
                        <button type="button" @onclick="BackToOrigin">@GetReturnButtonLabel()</button>
                        <button type="button" @onclick="SaveChanges">@L["Common_Save"]</button>
                        @if (CurrentSystem.CanUndoLastChange)
                        {
                            <button type="button" @onclick="UndoLastChange">@L["GameSystem_Editor_UndoLastChange"]</button>
                        }
                    </div>
                </div>

                @if (ShowSharedConfirm)
                {
                    <div class="rc-filter-group-card">
                        <p>@L["GameSystem_Editor_SharedConfirmMessage"]</p>
                        <div class="rc-tool-actions">
                            <button type="button" @onclick="ConfirmSharedSave">@L["Common_Yes"]</button>
                            <button type="button" @onclick="CancelSharedSave">@L["Common_Cancel"]</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="rc-inline-warning rc-inline-warning--soft">
                        <p>@Message</p>
                    </div>
                }

                <div class="@(HasPendingUnsavedChanges ? "rc-editor-save-state rc-editor-save-state--dirty" : "rc-editor-save-state rc-editor-save-state--saved")">
                    <strong>@(HasPendingUnsavedChanges ? L["GameSystem_Editor_PendingChangesTitle"] : L["GameSystem_Editor_AllChangesSavedTitle"])</strong>
                    <span>@(HasPendingUnsavedChanges ? L["GameSystem_Editor_PendingChangesBody"] : L["GameSystem_Editor_AllChangesSavedBody"])</span>
                </div>

                <div class="rc-test-stats-grid">
                    <div class="rc-stat-card"><span class="rc-stat-card__label">@L["GameSystem_Editor_StatsAttributes"]</span><span class="rc-stat-card__value">@GetCategoryCountLabel(EditorCategory.Attributes)</span></div>
                    <div class="rc-stat-card"><span class="rc-stat-card__label">@L["GameSystem_Editor_StatsDerivedStats"]</span><span class="rc-stat-card__value">@GetCategoryCountLabel(EditorCategory.DerivedStats)</span></div>
                    <div class="rc-stat-card"><span class="rc-stat-card__label">@L["GameSystem_Editor_StatsMetrics"]</span><span class="rc-stat-card__value">@GetCategoryCountLabel(EditorCategory.Metrics)</span></div>
                    <div class="rc-stat-card"><span class="rc-stat-card__label">@L["GameSystem_Editor_StatsTraits"]</span><span class="rc-stat-card__value">@GetCategoryCountLabel(EditorCategory.Traits)</span></div>
                </div>
                <div class="rc-test-stats-grid">
                    <div class="rc-stat-card"><span class="rc-stat-card__label">@L["GameSystem_Editor_StatsGauges"]</span><span class="rc-stat-card__value">@GetCategoryCountLabel(EditorCategory.Gauges)</span></div>
                    <div class="rc-stat-card"><span class="rc-stat-card__label">@L["GameSystem_Editor_StatsTalents"]</span><span class="rc-stat-card__value">@GetCategoryCountLabel(EditorCategory.Talents)</span></div>
                    <div class="rc-stat-card"><span class="rc-stat-card__label">@L["GameSystem_Editor_StatsItems"]</span><span class="rc-stat-card__value">@GetCategoryCountLabel(EditorCategory.Items)</span></div>
                    <div class="rc-stat-card"><span class="rc-stat-card__label">@L["GameSystem_Editor_StatsSessions"]</span><span class="rc-stat-card__value">@CurrentSystem.ImpactedSessions.Count</span></div>
                </div>

                @if (!CurrentSystem.IsLockedToSessionCopy && CurrentSystem.ImpactedSessions.Count > 0)
                {
                    <div class="rc-inline-warning">
                        <p><strong>@L["GameSystem_Editor_SharedWarningTitle"]</strong></p>
                        <p>@L["GameSystem_Editor_SharedWarningText"]</p>
                        <ul>
                            @foreach (var session in CurrentSystem.ImpactedSessions)
                            {
                                <li>@session.SessionName</li>
                            }
                        </ul>
                    </div>
                }

                @if (CurrentSystem.IsLockedToSessionCopy)
                {
                    <div class="rc-inline-warning">
                        <p><strong>@L["GameSystem_Editor_LockedCopyTitle"]</strong></p>
                        <p>@L["GameSystem_Editor_LockedCopyText"]</p>
                    </div>
                }
            </div>
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["GameSystem_Editor_GeneralSection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["GameSystem_Editor_GeneralSectionSubtitle"]</p>
                    </div>
                </div>
                <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                    <div class="rc-form-field"><label>@L["Common_Name"]</label><input @bind="CurrentSystem.Name" /></div>
                    <div class="rc-form-field"><label>@L["GameSystem_ResolutionMode"]</label><select @bind="CurrentSystem.TestResolutionMode"><option value="@TestResolutionMode.SuccessThreshold">@L["Resolution_SuccessThreshold"]</option><option value="@TestResolutionMode.RollUnderAttribute">@L["Resolution_RollUnderAttribute"]</option></select></div>
                    <div class="rc-form-field"><label>@L["GameSystem_Editor_DefaultTestDiceCount"]</label><input type="number" @bind="CurrentSystem.DefaultTestDiceCount" /></div>
                    <div class="rc-form-field"><label>@L["GameSystem_Editor_DefaultTestDiceSides"]</label><input type="number" @bind="CurrentSystem.DefaultTestDiceSides" /></div>
                    @if (CurrentSystem.TestResolutionMode == TestResolutionMode.SuccessThreshold)
                    {
                        <div class="rc-form-field"><label>@L["GameSystem_Editor_DefaultSuccessThreshold"]</label><input type="number" min="1" @bind="CurrentSystem.DefaultSuccessThreshold" /></div>
                    }
                    <div class="rc-form-field"><label>@GetCriticalSuccessLabel()</label><input type="number" @bind="CurrentSystem.CriticalSuccessValue" /></div>
                    <div class="rc-form-field"><label>@GetCriticalFailureLabel()</label><input type="number" @bind="CurrentSystem.CriticalFailureValue" /></div>
                    @if (CurrentSystem.CanEditGenericFlag && !CurrentSystem.IsLockedToSessionCopy)
                    {
                        <div class="rc-form-field"><label>@L["GameSystem_Editor_IsGeneric"]</label><label class="rc-filter-toggle"><input type="checkbox" @bind="CurrentSystem.IsGeneric" /><span>@L["Common_Yes"]</span></label></div>
                    }
                    <div class="rc-form-field rc-form-field--full"><label>@L["Common_Description"]</label><textarea rows="4" @bind="CurrentSystem.Description"></textarea></div>
                </div>
            </div>
        </div>

        <div class="rc-editor-shell">
            <div class="rc-editor-sidebar">
                <div class="@GetCategoryCardCssClass(EditorCategory.Attributes)">
                    <div class="rc-editor-category-card__header">
                        <div class="rc-filter-group-card__title">
                            @L["GameSystem_Editor_AttributesSection"]
