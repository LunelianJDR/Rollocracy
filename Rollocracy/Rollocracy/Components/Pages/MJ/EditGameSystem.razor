@page "/mj/gamesystems/{GameSystemId:guid}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.GameRules
@using Rollocracy.Localization

@inject Rollocracy.Domain.Interfaces.IGameSystemService GameSystemService
@inject Rollocracy.Domain.Interfaces.ISessionService SessionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<h3>@L["EditGameSystem_Title"]</h3>

@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToHome)
{
    <p>@L["Common_Loading"]</p>
}
else if (CurrentSystem is null)
{
    <p>@L["EditGameSystem_NotFound"]</p>
}
else
{
    <section class="rc-tool-section">
        <div class="rc-tool-layout rc-tool-layout--top">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@CurrentSystem.Name</h4>
                        <p class="rc-tool-panel__subtitle">@L["EditGameSystem_Subtitle"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="BackToGameSystems">@L["EditGameSystem_BackToList"]</button>
                        <button type="button" @onclick="SaveChanges">@L["Common_Save"]</button>

                        @if (CurrentSystem.CanUndoLastChange)
                        {
                            <button type="button" @onclick="UndoLastChange">@L["EditGameSystem_UndoLastChange"]</button>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <p>@Message</p>
                }

                <div class="rc-test-stats-grid">
                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["EditGameSystem_StatsAttributes"]</span>
                        <span class="rc-stat-card__value">@CurrentSystem.Attributes.Count(x => !x.IsDeleted)</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["EditGameSystem_StatsDerivedStats"]</span>
                        <span class="rc-stat-card__value">@CurrentSystem.DerivedStats.Count(x => !x.IsDeleted)</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["EditGameSystem_StatsMetrics"]</span>
                        <span class="rc-stat-card__value">@CurrentSystem.Metrics.Count(x => !x.IsDeleted)</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["EditGameSystem_StatsTraits"]</span>
                        <span class="rc-stat-card__value">@CurrentSystem.Traits.Count(x => !x.IsDeleted)</span>
                    </div>
                </div>

                <div class="rc-test-stats-grid">
                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["EditGameSystem_StatsGauges"]</span>
                        <span class="rc-stat-card__value">@CurrentSystem.Gauges.Count(x => !x.IsDeleted)</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["EditGameSystem_StatsTalents"]</span>
                        <span class="rc-stat-card__value">@CurrentSystem.Talents.Count(x => !x.IsDeleted)</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["EditGameSystem_StatsItems"]</span>
                        <span class="rc-stat-card__value">@CurrentSystem.Items.Count(x => !x.IsDeleted)</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["EditGameSystem_StatsSessions"]</span>
                        <span class="rc-stat-card__value">@CurrentSystem.ImpactedSessions.Count</span>
                    </div>
                </div>

                <div class="rc-inline-warning">
                    <p>@L["EditGameSystem_FoundationDeliveryNotice"]</p>
                    <p>@L["EditGameSystem_DiceDefaultHelp"]</p>
                </div>

                @if (!CurrentSystem.IsLockedToSessionCopy && CurrentSystem.ImpactedSessions.Count > 0)
                {
                    <div class="rc-inline-warning">
                        <p><strong>@L["EditGameSystem_SharedWarningTitle"]</strong></p>
                        <p>@L["EditGameSystem_SharedWarningText"]</p>
                        <ul>
                            @foreach (var session in CurrentSystem.ImpactedSessions)
                            {
                                <li>@session.SessionName</li>
                            }
                        </ul>
                    </div>
                }

                @if (CurrentSystem.IsLockedToSessionCopy)
                {
                    <div class="rc-inline-warning">
                        <p><strong>@L["EditGameSystem_LockedCopyTitle"]</strong></p>
                        <p>@L["EditGameSystem_LockedCopyText"]</p>
                    </div>
                }
            </div>
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["EditGameSystem_GeneralSection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["EditGameSystem_GeneralSectionSubtitle"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="SaveChanges">@L["Common_Save"]</button>
                    </div>
                </div>

                <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                    <div class="rc-form-field">
                        <label>@L["EditGameSystem_Name"]</label>
                        <input @bind="CurrentSystem.Name" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["EditGameSystem_ResolutionMode"]</label>
                        <select @bind="CurrentSystem.TestResolutionMode">
                            <option value="@TestResolutionMode.SuccessThreshold">@L["Resolution_SuccessThreshold"]</option>
                            <option value="@TestResolutionMode.RollUnderAttribute">@L["Resolution_RollUnderAttribute"]</option>
                        </select>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["EditGameSystem_DefaultTestDiceCount"]</label>
                        <input type="number" @bind="CurrentSystem.DefaultTestDiceCount" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["EditGameSystem_DefaultTestDiceSides"]</label>
                        <input type="number" @bind="CurrentSystem.DefaultTestDiceSides" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["EditGameSystem_CriticalSuccessValue"]</label>
                        <input type="number" @bind="CurrentSystem.CriticalSuccessValue" />
                        <span class="rc-tool-muted">@L["EditGameSystem_CriticalHelp"]</span>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["EditGameSystem_CriticalFailureValue"]</label>
                        <input type="number" @bind="CurrentSystem.CriticalFailureValue" />
                        <span class="rc-tool-muted">@L["EditGameSystem_CriticalHelp"]</span>
                    </div>

                    <div class="rc-form-field rc-form-field--full">
                        <label>@L["EditGameSystem_Description"]</label>
                        <textarea rows="4" @bind="CurrentSystem.Description"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <details class="rc-collapse-section" open>
            <summary class="rc-collapse-section__summary">
                <div class="rc-collapse-section__summary-main">
                    <div class="rc-collapse-section__summary-text">
                        <div class="rc-collapse-section__title">@L["EditGameSystem_AttributesSection"]</div>
                        <div class="rc-collapse-section__subtitle">@L["EditGameSystem_AttributesSubtitle"]</div>
                </div>
                        <div class="rc-collapse-section__summary-actions" @onclick:stopPropagation="true">
                            <button type="button" @onclick="SaveChanges">@L["Common_Save"]</button>
                        </div>
                    </div>
            </summary>

            <div class="rc-collapse-section__body">
                <div class="rc-tool-panel">
                    <div class="rc-tool-actions">
                        <button type="button" @onclick="AddAttributeRow">@L["EditGameSystem_AddAttributeRow"]</button>
                    </div>

                    @if (CurrentSystem.Attributes.Count == 0)
                    {
                        <div class="rc-empty-panel rc-empty-panel--small">
                            <p>@L["EditGameSystem_NoAttributes"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="rc-consequence-list">
                            @foreach (var attributeItem in CurrentSystem.Attributes)
                            {
                                <article class="rc-filter-group-card">
                                    @if (attributeItem.IsDeleted)
                                    {
                                        <div class="rc-inline-warning">
                                            <p><strong>@attributeItem.Name</strong> - @L["EditGameSystem_PendingDeletion"]</p>
                                        </div>

                                        <div class="rc-tool-actions">
                                            <button type="button" @onclick="() => attributeItem.IsDeleted = false">@L["EditGameSystem_Restore"]</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rc-tool-form-grid rc-tool-form-grid--very-dense">
                                            <div class="rc-form-field">
                                                <label>@L["Common_Name"]</label>
                                                <input @bind="attributeItem.Name" />
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["Common_Min"]</label>
                                                <input type="number" @bind="attributeItem.MinValue" />
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["Common_Max"]</label>
                                                <input type="number" @bind="attributeItem.MaxValue" />
                                            </div>

                                            @if (attributeItem.DefaultValueMode == BaseValueGenerationMode.DiceExpression)
                                            {
                                                <div class="rc-form-field">
                                                    <label>@L["EditGameSystem_DefaultFlatBonus"]</label>
                                                    <input type="number" @bind="attributeItem.DefaultValueFlatBonus" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="rc-form-field">
                                                    <label>@L["Common_DefaultValue"]</label>
                                                    <input type="number" @bind="attributeItem.DefaultValue" />
                                                </div>
                                            }
                                            <div class="rc-form-field">
                                                <label>@L["EditGameSystem_DefaultMode"]</label>
                                                <select @bind="attributeItem.DefaultValueMode">
                                                    <option value="@BaseValueGenerationMode.Fixed">@L["EditGameSystem_DefaultModeFixed"]</option>
                                                    <option value="@BaseValueGenerationMode.DiceExpression">@L["EditGameSystem_DefaultModeDice"]</option>
                                                </select>
                                            </div>

                                            @if (attributeItem.DefaultValueMode == BaseValueGenerationMode.DiceExpression)
                                            {
                                                <div class="rc-form-field">
                                                    <label>@L["EditGameSystem_DefaultDiceCount"]</label>
                                                    <input type="number" @bind="attributeItem.DefaultValueDiceCount" />
                                                </div>

                                                <div class="rc-form-field">
                                                    <label>@L["EditGameSystem_DefaultDiceSides"]</label>
                                                    <input type="number" @bind="attributeItem.DefaultValueDiceSides" />
                                                </div>
                                            }
                                        </div>

                                        <div class="rc-tool-actions">
                                            @if (attributeItem.AttributeDefinitionId.HasValue)
                                            {
                                                <button type="button" @onclick="() => attributeItem.IsDeleted = true">@L["EditGameSystem_Delete"]</button>
                                            }
                                            else
                                            {
                                                <button type="button" @onclick="() => CurrentSystem.Attributes.Remove(attributeItem)">@L["EditGameSystem_Delete"]</button>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>
        </details>

        <details class="rc-collapse-section">
            <summary class="rc-collapse-section__summary">
                <div class="rc-collapse-section__summary-main">
                    <div class="rc-collapse-section__summary-text">
                        <div class="rc-collapse-section__title">@L["EditGameSystem_DerivedStatsSection"]</div>
                        <div class="rc-collapse-section__subtitle">@L["EditGameSystem_DerivedStatsHelp"]</div>
                    </div>

                    <div class="rc-collapse-section__summary-actions" @onclick:stopPropagation="true">
                        <button type="button" @onclick="SaveChanges">@L["Common_Save"]</button>
                    </div>
                </div>
            </summary>

            <div class="rc-collapse-section__body">
                <div class="rc-tool-panel">
                    <div class="rc-tool-actions">
                        <button type="button" @onclick="AddDerivedStatRow">@L["EditGameSystem_AddDerivedStatRow"]</button>
                    </div>

                    @if (CurrentSystem.DerivedStats.Count == 0)
                    {
                        <div class="rc-empty-panel rc-empty-panel--small">
                            <p>@L["EditGameSystem_NoDerivedStats"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="rc-consequence-list">
                            @foreach (var derivedStat in CurrentSystem.DerivedStats)
                            {
                                <article class="rc-filter-group-card">
                                    @if (derivedStat.IsDeleted)
                                    {
                                        <div class="rc-inline-warning">
                                            <p><strong>@derivedStat.Name</strong> - @L["EditGameSystem_PendingDeletion"]</p>
                                        </div>

                                        <div class="rc-tool-actions">
                                            <button type="button" @onclick="() => derivedStat.IsDeleted = false">@L["EditGameSystem_Restore"]</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rc-tool-form-grid rc-tool-form-grid--very-dense">
                                            <div class="rc-form-field">
                                                <label>@L["Common_Name"]</label>
                                                <input @bind="derivedStat.Name" />
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["Common_Min"]</label>
                                                <input type="number" @bind="derivedStat.MinValue" />
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["Common_Max"]</label>
                                                <input type="number" @bind="derivedStat.MaxValue" />
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["EditGameSystem_RoundMode"]</label>
                                                <select @bind="derivedStat.RoundMode">
                                                    <option value="@ComputedValueRoundMode.Ceiling">@L["EditGameSystem_RoundModeCeiling"]</option>
                                                    <option value="@ComputedValueRoundMode.Floor">@L["EditGameSystem_RoundModeFloor"]</option>
                                                    <option value="@ComputedValueRoundMode.Nearest">@L["EditGameSystem_RoundModeNearest"]</option>
                                                    <option value="@ComputedValueRoundMode.None">@L["EditGameSystem_RoundModeNone"]</option>
                                                </select>
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["EditGameSystem_DisplayOrder"]</label>
                                                <input type="number" @bind="derivedStat.DisplayOrder" />
                                            </div>
                                        </div>

                                        <div class="rc-tool-subsection">
                                            <div class="rc-tool-subsection__header">
                                                <div class="rc-tool-subsection__title">@L["EditGameSystem_DerivedStatComponents"]</div>
                                                <div class="rc-tool-inline-actions">
                                                    <button type="button" @onclick="() => AddDerivedComponentRow(derivedStat)">
                                                        @L["EditGameSystem_AddDerivedComponentRow"]
                                                    </button>
                                                </div>
                                            </div>

                                            @foreach (var component in derivedStat.Components)
                                            {
                                                <div class="rc-filter-group-card">
                                                    @if (component.IsDeleted)
                                                    {
                                                        <span><strong>@GetBaseAttributeName(component.AttributeDefinitionId)</strong> - @L["EditGameSystem_PendingDeletion"]</span>
                                                        <div class="rc-tool-actions">
                                                            <button type="button" @onclick="() => component.IsDeleted = false">@L["EditGameSystem_Restore"]</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="rc-tool-form-grid rc-tool-form-grid--very-dense">
                                                            <div class="rc-form-field">
                                                                <label>@L["EditGameSystem_ComponentAttribute"]</label>
                                                                <select @bind="component.AttributeDefinitionId">
                                                                    @foreach (var attributeRef in CurrentSystem.AvailableBaseAttributes)
                                                                    {
                                                                        <option value="@attributeRef.AttributeDefinitionId">@attributeRef.Name</option>
                                                                    }
                                                                </select>
                                                            </div>

                                                            <div class="rc-form-field">
                                                                <label>@L["EditGameSystem_ComponentWeight"]</label>
                                                                <input type="number" @bind="component.Weight" />
                                                                <span class="rc-tool-muted">@L["EditGameSystem_ComponentWeightHelp"]</span>
                                                            </div>
                                                        </div>

                                                        <div class="rc-tool-actions">
                                                            @if (component.DerivedStatComponentId.HasValue)
                                                            {
                                                                <button type="button" @onclick="() => component.IsDeleted = true">@L["EditGameSystem_Delete"]</button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" @onclick="() => derivedStat.Components.Remove(component)">@L["EditGameSystem_Delete"]</button>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="rc-tool-actions">
                                            @if (derivedStat.DerivedStatDefinitionId.HasValue)
                                            {
                                                <button type="button" @onclick="() => derivedStat.IsDeleted = true">@L["EditGameSystem_Delete"]</button>
                                            }
                                            else
                                            {
                                                <button type="button" @onclick="() => CurrentSystem.DerivedStats.Remove(derivedStat)">@L["EditGameSystem_Delete"]</button>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>
        </details>

        <details class="rc-collapse-section">
            <summary class="rc-collapse-section__summary">
                <div class="rc-collapse-section__summary-main">
                    <div class="rc-collapse-section__summary-text">
                        <div class="rc-collapse-section__title">@L["EditGameSystem_MetricsSection"]</div>
                        <div class="rc-collapse-section__subtitle">@L["EditGameSystem_MetricsHelp"]</div>
                    </div>

                    <div class="rc-collapse-section__summary-actions" @onclick:stopPropagation="true">
                        <button type="button" @onclick="SaveChanges">@L["Common_Save"]</button>
                    </div>
                </div>
            </summary>

            <div class="rc-collapse-section__body">
                <div class="rc-tool-panel">
                    <div class="rc-tool-actions">
                        <button type="button" @onclick="AddMetricRow">@L["EditGameSystem_AddMetricRow"]</button>
                    </div>

                    @if (CurrentSystem.Metrics.Count == 0)
                    {
                        <div class="rc-empty-panel rc-empty-panel--small">
                            <p>@L["EditGameSystem_NoMetrics"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="rc-consequence-list">
                            @foreach (var metric in CurrentSystem.Metrics)
                            {
                                <article class="rc-filter-group-card">
                                    @if (metric.IsDeleted)
                                    {
                                        <div class="rc-inline-warning">
                                            <p><strong>@metric.Name</strong> - @L["EditGameSystem_PendingDeletion"]</p>
                                        </div>

                                        <div class="rc-tool-actions">
                                            <button type="button" @onclick="() => metric.IsDeleted = false">@L["EditGameSystem_Restore"]</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rc-tool-form-grid rc-tool-form-grid--very-dense">
                                            @if (IsVoteWeightMetric(metric))
                                            {
                                                <div class="rc-form-field rc-form-field--readonly">
                                                    <label>@L["Common_Name"]</label>
                                                    <div class="rc-readonly-value">@metric.Name</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="rc-form-field">
                                                    <label>@L["Common_Name"]</label>
                                                    <input @bind="metric.Name" />
                                                </div>
                                            }

                                            <div class="rc-form-field">
                                                <label>@L["EditGameSystem_MetricBaseValue"]</label>
                                                <input type="number" @bind="metric.BaseValue" />
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["Common_Min"]</label>
                                                <input type="number" @bind="metric.MinValue" />
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["Common_Max"]</label>
                                                <input type="number" @bind="metric.MaxValue" />
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["EditGameSystem_RoundMode"]</label>
                                                <select @bind="metric.RoundMode">
                                                    <option value="@ComputedValueRoundMode.Ceiling">@L["EditGameSystem_RoundModeCeiling"]</option>
                                                    <option value="@ComputedValueRoundMode.Floor">@L["EditGameSystem_RoundModeFloor"]</option>
                                                    <option value="@ComputedValueRoundMode.Nearest">@L["EditGameSystem_RoundModeNearest"]</option>
                                                    <option value="@ComputedValueRoundMode.None">@L["EditGameSystem_RoundModeNone"]</option>
                                                </select>
                                            </div>

                                            <div class="rc-form-field">
                                                <label>@L["EditGameSystem_DisplayOrder"]</label>
                                                <input type="number" @bind="metric.DisplayOrder" />
                                            </div>
                                        </div>

                                        <div class="rc-tool-subsection">
                                            <div class="rc-tool-subsection__header">
                                                <div class="rc-tool-subsection__title">@L["EditGameSystem_MetricFormulaSection"]</div>
                                                <div class="rc-tool-inline-actions">
                                                    <button type="button" @onclick="() => AddMetricFormulaStepRow(metric)">
                                                        @L["EditGameSystem_AddMetricFormulaStepRow"]
                                                    </button>
                                                </div>
                                            </div>

                                            @foreach (var step in metric.FormulaSteps.OrderBy(x => x.Order).ThenBy(x => x.MetricFormulaStepId))
                                            {
                                                <div class="rc-filter-group-card">
                                                    @if (step.IsDeleted)
                                                    {
                                                        <span>@GetMetricFormulaStepSummary(step) - @L["EditGameSystem_PendingDeletion"]</span>
                                                        <div class="rc-tool-actions">
                                                            <button type="button" @onclick="() => step.IsDeleted = false">@L["EditGameSystem_Restore"]</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="rc-tool-form-grid rc-tool-form-grid--very-dense">
                                                            <div class="rc-form-field">
                                                                <label>@L["EditGameSystem_MetricFormulaOperation"]</label>
                                                                <select @bind="step.OperationType">
                                                                    <option value="@MetricFormulaOperationType.Add">@L["EditGameSystem_MetricFormulaOperation_Add"]</option>
                                                                    <option value="@MetricFormulaOperationType.Subtract">@L["EditGameSystem_MetricFormulaOperation_Subtract"]</option>
                                                                    <option value="@MetricFormulaOperationType.Multiply">@L["EditGameSystem_MetricFormulaOperation_Multiply"]</option>
                                                                    <option value="@MetricFormulaOperationType.Divide">@L["EditGameSystem_MetricFormulaOperation_Divide"]</option>
                                                                </select>
                                                            </div>

                                                            <div class="rc-form-field">
                                                                <label>@L["EditGameSystem_MetricFormulaSourceType"]</label>
                                                                <select value="@step.SourceType.ToString()" @onchange="e => ChangeMetricFormulaSourceType(step, e.Value?.ToString())">
                                                                    <option value="@MetricFormulaSourceType.BaseAttribute">@L["EditGameSystem_MetricFormulaSource_BaseAttribute"]</option>
                                                                    <option value="@MetricFormulaSourceType.Gauge">@L["EditGameSystem_MetricFormulaSource_Gauge"]</option>
                                                                    <option value="@MetricFormulaSourceType.DerivedStat">@L["EditGameSystem_MetricFormulaSource_DerivedStat"]</option>
                                                                    <option value="@MetricFormulaSourceType.Metric">@L["EditGameSystem_MetricFormulaSource_Metric"]</option>
                                                                    <option value="@MetricFormulaSourceType.Constant">@L["EditGameSystem_MetricFormulaSource_Constant"]</option>
                                                                </select>
                                                            </div>

                                                            @if (step.SourceType == MetricFormulaSourceType.Constant)
                                                            {
                                                                <div class="rc-form-field">
                                                                    <label>@L["EditGameSystem_MetricFormulaConstantValue"]</label>
                                                                    <input type="number" step="0.01" @bind="step.ConstantValue" />
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                var options = GetMetricFormulaSourceOptions(metric, step.SourceType);

                                                                <div class="rc-form-field">
                                                                    <label>@L["EditGameSystem_MetricFormulaSourceValue"]</label>
                                                                    <select value="@(step.SourceId?.ToString() ?? string.Empty)" @onchange="e => ChangeMetricFormulaSourceId(step, e.Value?.ToString())">
                                                                        @foreach (var option in options)
                                                                        {
                                                                            <option value="@option.Id">@option.Name</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            }
                                                        </div>

                                                        <div class="rc-tool-actions">
                                                            @if (step.MetricFormulaStepId.HasValue)
                                                            {
                                                                <button type="button" @onclick="() => step.IsDeleted = true">@L["EditGameSystem_Delete"]</button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" @onclick="() => metric.FormulaSteps.Remove(step)">@L["EditGameSystem_Delete"]</button>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

