    private bool IsCategoryDirty(EditorCategory category)
    {
        if (CurrentSystem is null || LoadedSystemSnapshot is null)
            return false;

        return category switch
        {
            EditorCategory.Attributes => SerializeForChangeTracking(CurrentSystem.Attributes)
                != SerializeForChangeTracking(LoadedSystemSnapshot.Attributes),

            EditorCategory.DerivedStats => SerializeForChangeTracking(CurrentSystem.DerivedStats)
                != SerializeForChangeTracking(LoadedSystemSnapshot.DerivedStats),

            EditorCategory.Metrics => SerializeForChangeTracking(CurrentSystem.Metrics)
                != SerializeForChangeTracking(LoadedSystemSnapshot.Metrics),

            EditorCategory.Traits => SerializeForChangeTracking(CurrentSystem.Traits)
                != SerializeForChangeTracking(LoadedSystemSnapshot.Traits),

            EditorCategory.Gauges => SerializeForChangeTracking(CurrentSystem.Gauges)
                != SerializeForChangeTracking(LoadedSystemSnapshot.Gauges),

            EditorCategory.Talents => SerializeForChangeTracking(new
            {
                CurrentSystem.StartingTalentChoices,
                CurrentSystem.Talents
            }) != SerializeForChangeTracking(new
            {
                LoadedSystemSnapshot.StartingTalentChoices,
                LoadedSystemSnapshot.Talents
            }),

            EditorCategory.Items => SerializeForChangeTracking(new
            {
                CurrentSystem.StartingItemChoices,
                CurrentSystem.Items
            }) != SerializeForChangeTracking(new
            {
                LoadedSystemSnapshot.StartingItemChoices,
                LoadedSystemSnapshot.Items
            }),

            _ => false
        };
    }

    private static T DeepClone<T>(T source)
