                                                                </select>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="rc-tool-actions">
                                                        <button type="button" @onclick="() => item.Modifiers.Remove(modifier)">
                                                            @L["EditGameSystem_Delete"]
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="rc-tool-actions">
                                            @if (item.ItemDefinitionId.HasValue)
                                            {
                                                <button type="button" @onclick="() => item.IsDeleted = true">@L["EditGameSystem_Delete"]</button>
                                            }
                                            else
                                            {
                                                <button type="button" @onclick="() => CurrentSystem.Items.Remove(item)">@L["EditGameSystem_Delete"]</button>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>
        </details>
    </section>
}

@code {
    [Parameter] public Guid GameSystemId { get; set; }

    private Guid CurrentUserId;
    private bool IsLoaded;
    private bool RedirectToHome;
    private string Message = string.Empty;
    private bool ShowSharedConfirm;
    private GameSystemEditorDto? CurrentSystem;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);

        var canCreateSessions = await SessionService.CanUserCreateSessionsAsync(CurrentUserId);

        if (!canCreateSessions)
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        await LoadEditor();

        if (CurrentSystem is null)
        {
            IsLoaded = true;
            return;
        }

        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToHome)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadEditor()
    {
        Message = string.Empty;
        ShowSharedConfirm = false;
        CurrentSystem = await GameSystemService.GetGameSystemEditorAsync(GameSystemId, CurrentUserId);
    }

    private void BackToGameSystems()
    {
        Navigation.NavigateTo("/mj/gamesystems");
    }

    private void AddAttributeRow()
    {
        CurrentSystem?.Attributes.Add(new EditableAttributeDefinitionDto
        {
            Name = string.Empty,
            MinValue = 0,
            MaxValue = 20,
            DefaultValue = 10,
            DefaultValueMode = BaseValueGenerationMode.Fixed
        });
