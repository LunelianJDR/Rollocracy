@page "/mj/gamesystems"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Entities
@using Rollocracy.Domain.GameRules
@using Rollocracy.Localization

@inject Rollocracy.Domain.Interfaces.IGameSystemService GameSystemService
@inject Rollocracy.Domain.Interfaces.ISessionService SessionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L


@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToHome)
{
    <p>@L["Common_Loading"]</p>
}
else
{
    <section class="rc-tool-section">
        <div class="rc-tool-layout">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["GameSystems_Title"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["GameSystems_Subtitle"]</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <p>@Message</p>
                }

                <div class="rc-test-stats-grid">
                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["GameSystems_TotalSystems"]</span>
                        <span class="rc-stat-card__value">@GameSystemSummaries.Count</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["GameSystems_UsedSystems"]</span>
                        <span class="rc-stat-card__value">@GameSystemSummaries.Count(x => x.ImpactedSessionsCount > 0)</span>
                    </div>

                    <div class="rc-stat-card">
                        <span class="rc-stat-card__label">@L["GameSystems_FreeSystems"]</span>
                        <span class="rc-stat-card__value">@GameSystemSummaries.Count(x => x.ImpactedSessionsCount == 0)</span>
                    </div>
                </div>
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["GameSystems_CreatePanelTitle"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["GameSystems_CreatePanelSubtitle"]</p>
                    </div>
                </div>

                <div class="rc-tool-form-grid">
                    <div class="rc-form-field">
                        <label for="new-system-name">@L["GameSystems_NewName"]</label>
                        <input id="new-system-name" @bind="NewSystemName" />
                    </div>

                    <div class="rc-form-field">
                        <label for="new-system-resolution">@L["GameSystems_ResolutionMode"]</label>
                        <select id="new-system-resolution" @bind="NewSystemResolutionMode">
                            <option value="@TestResolutionMode.SuccessThreshold">@L["Resolution_SuccessThreshold"]</option>
                            <option value="@TestResolutionMode.RollUnderAttribute">@L["Resolution_RollUnderAttribute"]</option>
                        </select>
                    </div>

                    <div class="rc-form-field" style="grid-column: 1 / -1;">
                        <label for="new-system-description">@L["GameSystems_NewDescription"]</label>
                        <textarea id="new-system-description" rows="4" @bind="NewSystemDescription"></textarea>
                    </div>
                </div>

                <div class="rc-tool-actions">
                    <button type="button" @onclick="CreateGameSystem">@L["GameSystems_Create"]</button>
                </div>
            </div>
        </div>

        <div class="rc-tool-panel">
            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                <div class="rc-tool-panel__header-main">
                    <h4 class="rc-tool-panel__title">@L["GameSystems_ListTitle"]</h4>
                    <p class="rc-tool-panel__subtitle">@L["GameSystems_ListSubtitle"]</p>
                </div>
            </div>

            @if (GameSystemSummaries.Count == 0)
            {
                <div class="rc-empty-panel">
                    <p>@L["GameSystems_None"]</p>
                </div>
            }
            else
            {
                <div class="rc-session-list-grid">
                    @foreach (var item in GameSystemSummaries)
                    {
                        var isDeleteConfirmationOpen = PendingDeleteGameSystemId == item.System.Id;

                        <article class="rc-filter-group-card">
                            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                                <div class="rc-tool-panel__header-main">
                                    <h5 class="rc-tool-panel__title">@item.System.Name</h5>
                                    <p class="rc-tool-panel__subtitle">@GetResolutionLabel(item.System.TestResolutionMode)</p>
                                </div>
                            </div>

                            <div class="rc-tool-form-grid">
                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["GameSystems_Name"]</label>
                                    <div class="rc-readonly-value">@item.System.Name</div>
                                </div>

                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["GameSystems_Mode"]</label>
                                    <div class="rc-readonly-value">@GetResolutionLabel(item.System.TestResolutionMode)</div>
                                </div>

                                <div class="rc-form-field rc-form-field--readonly" style="grid-column: 1 / -1;">
                                    <label>@L["GameSystems_Description"]</label>
                                    <div class="rc-readonly-value">
                                        @if (string.IsNullOrWhiteSpace(item.System.Description))
                                        {
                                            <span>@L["Common_None"]</span>
                                        }
                                        else
                                        {
                                            @item.System.Description
                                        }
                                    </div>
                                </div>

                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["GameSystems_UsedBySessions"]</label>
                                    <div class="rc-readonly-value">@item.ImpactedSessionsCount</div>
                                </div>

                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["GameSystems_GenericLabel"]</label>
                                    <div class="rc-readonly-value">
                                        @(item.System.IsGeneric? L["Common_Yes"] : L["Common_No"])
                                    </div>
                                </div>
                            </div>

                            <div class="rc-tool-actions">
                                <button type="button" @onclick="() => EditSystem(item.System.Id)">
                                    @L["GameSystems_Edit"]
                                </button>

                                <button type="button" @onclick="() => AskDeleteSystem(item.System.Id)">
                                    @L["EditGameSystem_Delete"]
                                </button>
                            </div>

                            @if (item.ImpactedSessionsCount > 0)
                            {
                                <p class="rc-tool-muted">
                                    @string.Format(L["GameSystems_DeleteUsedWarning"], item.ImpactedSessionsCount)
                                </p>
                            }

                            @if (isDeleteConfirmationOpen)
                            {
                                <div class="rc-filter-group-card">
                                    @if (item.ImpactedSessionsCount > 0)
                                    {
                                        <p>@string.Format(L["GameSystems_DeleteConfirmationWithSessions"], item.ImpactedSessionsCount)</p>
                                    }
                                    else
                                    {
                                        <p>@L["GameSystems_DeleteConfirmation"]</p>
                                    }

                                    <div class="rc-tool-actions">
                                        <button type="button" @onclick="ConfirmDeleteSystem">@L["Common_Confirm"]</button>
                                        <button type="button" @onclick="CancelDeleteSystem">@L["Common_Cancel"]</button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    private bool IsLoaded;
    private bool RedirectToHome;
    private Guid CurrentUserId;
    private string Message = string.Empty;

    private string NewSystemName = string.Empty;
    private string NewSystemDescription = string.Empty;
    private TestResolutionMode NewSystemResolutionMode = TestResolutionMode.SuccessThreshold;

    private Guid? PendingDeleteGameSystemId;
    private List<GameSystemSummary> GameSystemSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);

        var canCreateSessions = await SessionService.CanUserCreateSessionsAsync(CurrentUserId);

        if (!canCreateSessions)
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        await LoadGameSystems();
        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToHome)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadGameSystems()
    {
        Message = string.Empty;
        PendingDeleteGameSystemId = null;
        GameSystemSummaries.Clear();

        var ownedSystems = await GameSystemService.GetGameSystemsByOwnerAsync(CurrentUserId);

        foreach (var system in ownedSystems)
        {
            var editor = await GameSystemService.GetGameSystemEditorAsync(system.Id, CurrentUserId);

            GameSystemSummaries.Add(new GameSystemSummary
            {
                System = system,
                ImpactedSessionsCount = editor?.ImpactedSessions.Count ?? 0
            });
        }
    }

    private async Task CreateGameSystem()
    {
        try
        {
            Message = string.Empty;

            if (string.IsNullOrWhiteSpace(NewSystemName))
            {
                Message = L["GameSystems_NameRequired"];
                return;
            }

            var createdSystem = await GameSystemService.CreateGameSystemAsync(
                CurrentUserId,
                NewSystemName,
                NewSystemDescription,
                NewSystemResolutionMode);

            Navigation.NavigateTo($"/mj/gamesystems/{createdSystem.Id}");
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private void EditSystem(Guid gameSystemId)
    {
        Navigation.NavigateTo($"/mj/gamesystems/{gameSystemId}");
    }

    private void AskDeleteSystem(Guid gameSystemId)
    {
        Message = string.Empty;
        PendingDeleteGameSystemId = gameSystemId;
    }

    private Task CancelDeleteSystem()
    {
        PendingDeleteGameSystemId = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteSystem()
    {
        if (!PendingDeleteGameSystemId.HasValue)
            return;

        try
        {
            Message = string.Empty;

            await GameSystemService.DeleteGameSystemAsync(PendingDeleteGameSystemId.Value, CurrentUserId);

            PendingDeleteGameSystemId = null;
            await LoadGameSystems();
            Message = L["GameSystems_Deleted"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private string GetResolutionLabel(TestResolutionMode mode)
    {
        return mode switch
        {
            TestResolutionMode.SuccessThreshold => L["Resolution_SuccessThreshold"],
            TestResolutionMode.RollUnderAttribute => L["Resolution_RollUnderAttribute"],
            _ => mode.ToString()
        };
    }

    private class GameSystemSummary
    {
        public GameSystem System { get; set; } = new();
        public int ImpactedSessionsCount { get; set; }
    }
}