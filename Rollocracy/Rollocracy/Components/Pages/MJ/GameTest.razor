    private GameTestCreateRequestDto BuildGameTestPresetRequest()
    {
        var difficultyValue = DifficultyScaleValues.ElementAtOrDefault(SelectedDifficultyIndex);
        var autoRollDelay = AutoRollDelayOptions.ElementAtOrDefault(SelectedAutoRollDelayIndex);

        return new GameTestCreateRequestDto
        {
            TargetKind = NewTargetKind,
            TargetDefinitionId = ParseSelectedAttributeId(),
            UseSystemDefaultDice = UseSystemDefaultDice,
            DiceCount = NewDiceCount,
            DiceSides = NewDiceSides,
            SuccessThreshold = NewSuccessThreshold,
            ModifierMode = difficultyValue >= 0 ? TestModifierMode.Bonus : TestModifierMode.Malus,
            DifficultyValue = Math.Abs(difficultyValue),
            TargetScope = NewTargetScope,
            TraitFilterMode = NewTraitFilterMode,
            IncludeNpcs = IncludeNpcsInTest,
            AutoRollDelaySeconds = autoRollDelay,
            GlobalSuccessThreshold1Percent = GlobalSuccessThresholds.Count > 0 ? GlobalSuccessThresholds[0] : null,
            GlobalSuccessThreshold2Percent = GlobalSuccessThresholds.Count > 1 ? GlobalSuccessThresholds[1] : null,
            GlobalSuccessThreshold3Percent = GlobalSuccessThresholds.Count > 2 ? GlobalSuccessThresholds[2] : null,
            AdvancedFilter = CloneAdvancedFilter(AdvancedFilter),
            TraitFilters = new List<GameTestTraitFilterGroupDto>(),
            Consequences = ConsequenceRows.Select(MapConsequenceRowToDto).ToList()
        };
    }

    private void ApplyGameTestPresetRequest(GameTestCreateRequestDto request)
    {
        NewTargetKind = request.TargetKind;
        SelectedAttributeId = request.TargetDefinitionId == Guid.Empty
            ? string.Empty
            : request.TargetDefinitionId.ToString();

        UseSystemDefaultDice = request.UseSystemDefaultDice;
        NewDiceCount = request.DiceCount;
        NewDiceSides = request.DiceSides;
        NewSuccessThreshold = request.SuccessThreshold;
        NewTargetScope = request.TargetScope;
        NewTraitFilterMode = request.TraitFilterMode;
        IncludeNpcsInTest = request.IncludeNpcs;

        var signedDifficultyValue = request.ModifierMode == TestModifierMode.Malus
            ? -request.DifficultyValue
            : request.DifficultyValue;

        SelectedDifficultyIndex = DifficultyScaleValues.FindIndex(x => x == signedDifficultyValue);
        if (SelectedDifficultyIndex < 0)
            SelectedDifficultyIndex = 0;

        SelectedAutoRollDelayIndex = AutoRollDelayOptions.FindIndex(x => x == request.AutoRollDelaySeconds);
        if (SelectedAutoRollDelayIndex < 0)
            SelectedAutoRollDelayIndex = 0;

        GlobalSuccessThresholds = new List<int>();
        if (request.GlobalSuccessThreshold1Percent.HasValue) GlobalSuccessThresholds.Add(request.GlobalSuccessThreshold1Percent.Value);
        if (request.GlobalSuccessThreshold2Percent.HasValue) GlobalSuccessThresholds.Add(request.GlobalSuccessThreshold2Percent.Value);
        if (request.GlobalSuccessThreshold3Percent.HasValue) GlobalSuccessThresholds.Add(request.GlobalSuccessThreshold3Percent.Value);

        AdvancedFilter = CloneAdvancedFilter(request.AdvancedFilter ?? new CharacterTargetFilterDto());
        ConsequenceRows = request.Consequences.Select(MapConsequenceDtoToRow).ToList();
    }

    private Guid ParseSelectedAttributeId()
    {
        return Guid.TryParse(SelectedAttributeId, out var id) ? id : Guid.Empty;
    }

    private CharacterTargetFilterDto CloneAdvancedFilter(CharacterTargetFilterDto source)
    {
        return new CharacterTargetFilterDto
        {
            OnlyAlive = source.OnlyAlive,
            OnlyDead = source.OnlyDead,
            OnlyOnline = source.OnlyOnline,
            IncludeNpcs = source.IncludeNpcs,
            MatchAllConditions = source.MatchAllConditions,
            TraitOptionIds = source.TraitOptionIds.ToList(),
            TalentIds = source.TalentIds.ToList(),
            ItemIds = source.ItemIds.ToList(),
            PollId = source.PollId,
            PollSelectedOptionId = source.PollSelectedOptionId,
            FilterOnPollResponse = source.FilterOnPollResponse,
            MustHaveSucceededLastTest = source.MustHaveSucceededLastTest,
            FilterOnLastTestResult = source.FilterOnLastTestResult,
            NameCharacterIds = source.NameCharacterIds.ToList(),
            RandomDrawIds = source.RandomDrawIds.ToList(),
            BiographyNotEmpty = source.BiographyNotEmpty,
            ValueFilters = source.ValueFilters.Select(x => new CharacterValueFilterDto
            {
                TargetType = x.TargetType,
                TargetId = x.TargetId,
                TargetName = x.TargetName,
                ComparisonType = x.ComparisonType,
                Value = x.Value
            }).ToList()
        };
    }

    private GameTestConsequenceDraftDto MapConsequenceRowToDto(SharedConsequenceRowModel row)
    {
        return new GameTestConsequenceDraftDto
        {
            ApplyOn = row.ApplyOn,
            OperationType = row.OperationType,
            TargetKind = row.TargetKind,
            TargetDefinitionId = row.TargetDefinitionId,
            ModifierMode = row.ValueMode == ModifierValueMode.Metric ? row.ModifierMode : TestModifierMode.Bonus,
            Value = row.Value,
            ValueMode = row.ValueMode,
            SourceMetricId = row.ValueMode == ModifierValueMode.Metric ? row.SourceMetricId : null
        };
    }

    private SharedConsequenceRowModel MapConsequenceDtoToRow(GameTestConsequenceDraftDto dto)
    {
        return new SharedConsequenceRowModel
        {
            RowId = Guid.NewGuid(),
            ApplyOn = dto.ApplyOn,
            OperationType = dto.OperationType,
            TargetKind = dto.TargetKind,
            TargetDefinitionId = dto.TargetDefinitionId,
            ModifierMode = dto.ValueMode == ModifierValueMode.Metric ? dto.ModifierMode : TestModifierMode.Bonus,
            Value = dto.Value,
            ValueMode = dto.ValueMode,
            SourceMetricId = dto.ValueMode == ModifierValueMode.Metric ? dto.SourceMetricId : null
        };
    }

