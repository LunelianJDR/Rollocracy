    private async Task SaveTestPresetConfirmed()
    {
        try
        {
            Message = string.Empty;

            var request = BuildGameTestPresetRequest();

            await GameTestService.SaveSessionPresetAsync(
                SessionId,
                CurrentUserId,
                NewTestPresetName,
                request,
                overwrite: false);

            TestPresets = await GameTestService.GetSessionPresetsAsync(SessionId, CurrentUserId);
            SelectedTestPresetId = TestPresets.FirstOrDefault(x => x.Name == NewTestPresetName.Trim())?.PresetId;

            ShowSaveTestPresetPanel = false;
            ConfirmOverwriteTestPresetVisible = false;
            NewTestPresetName = string.Empty;

            Message = L["Test_PresetSaved"];
        }
        catch (Exception ex)
        {
            if (ex.Message == L["Backend_TestPresetAlreadyExists"])
            {
                ConfirmOverwriteTestPresetVisible = true;
                return;
            }

            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

