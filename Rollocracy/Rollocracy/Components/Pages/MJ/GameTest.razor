    private bool HasModerateSuccessThreshold => GlobalSuccessThresholds.Count >= 2;
    private bool HasModerateFailureThreshold => GlobalSuccessThresholds.Count >= 3;

    private int? DraggingGlobalThresholdIndex;
    private ElementReference GlobalThresholdSliderTrackRef;

    private void AddGlobalThreshold()
    {
        if (GlobalSuccessThresholds.Count >= 3)
            return;

        if (GlobalSuccessThresholds.Count == 0)
        {
            GlobalSuccessThresholds.Add(50);
            return;
        }

        if (GlobalSuccessThresholds.Count == 1)
        {
            var first = GlobalSuccessThresholds[0];
            var second = Math.Max(5, first - 20);
            if (second >= first)
                second = first - 5;

            if (second >= 5)
                GlobalSuccessThresholds.Add(second);

            NormalizeGlobalThresholds();
            return;
        }

        if (GlobalSuccessThresholds.Count == 2)
        {
            var second = GlobalSuccessThresholds[1];
            var third = Math.Max(5, second - 20);
            if (third >= second)
                third = second - 5;

            if (third >= 5)
                GlobalSuccessThresholds.Add(third);

            NormalizeGlobalThresholds();
        }
    }

    private void RemoveGlobalThreshold()
    {
        if (GlobalSuccessThresholds.Count == 0)
            return;

        GlobalSuccessThresholds.RemoveAt(GlobalSuccessThresholds.Count - 1);
        NormalizeGlobalThresholds();
    }

    private void NormalizeGlobalThresholds()
    {
        GlobalSuccessThresholds = GlobalSuccessThresholds
            .Select(NormalizeSingleThresholdValue)
            .Distinct()
            .OrderByDescending(x => x)
            .Take(3)
            .ToList();

        EnforceThresholdSpacing();
    }

    private int NormalizeSingleThresholdValue(int value)
    {
        var normalized = (int)Math.Round(value / 5.0) * 5;
        normalized = Math.Clamp(normalized, 5, 95);
        return normalized;
    }

    private void EnforceThresholdSpacing()
    {
        if (GlobalSuccessThresholds.Count <= 1)
            return;

        GlobalSuccessThresholds = GlobalSuccessThresholds
            .OrderByDescending(x => x)
            .ToList();

        for (var i = 1; i < GlobalSuccessThresholds.Count; i++)
        {
            var maxAllowed = GlobalSuccessThresholds[i - 1] - 5;
            if (GlobalSuccessThresholds[i] > maxAllowed)
                GlobalSuccessThresholds[i] = maxAllowed;
        }

        for (var i = GlobalSuccessThresholds.Count - 2; i >= 0; i--)
        {
            var minAllowed = GlobalSuccessThresholds[i + 1] + 5;
            if (GlobalSuccessThresholds[i] < minAllowed)
                GlobalSuccessThresholds[i] = minAllowed;
        }

        for (var i = 0; i < GlobalSuccessThresholds.Count; i++)
        {
            GlobalSuccessThresholds[i] = Math.Clamp(GlobalSuccessThresholds[i], 5, 95);
        }

        for (var i = 1; i < GlobalSuccessThresholds.Count; i++)
        {
            if (GlobalSuccessThresholds[i - 1] - GlobalSuccessThresholds[i] < 5)
                GlobalSuccessThresholds[i] = Math.Max(5, GlobalSuccessThresholds[i - 1] - 5);
        }

        GlobalSuccessThresholds = GlobalSuccessThresholds
            .Distinct()
            .OrderByDescending(x => x)
            .Take(3)
            .ToList();
    }

    private string GetGlobalThresholdTrackStyle()
    {
        if (GlobalSuccessThresholds.Count == 0)
            return "background: var(--rc-bg-alt);";

        if (GlobalSuccessThresholds.Count == 1)
        {
            var t1 = GlobalSuccessThresholds[0];
            return $"background: linear-gradient(to right, #a13f3f 0%, #a13f3f {t1}%, #1d6b3c {t1}%, #1d6b3c 100%);";
        }

        if (GlobalSuccessThresholds.Count == 2)
        {
            var t1 = GlobalSuccessThresholds[0];
            var t2 = GlobalSuccessThresholds[1];
            return $"background: linear-gradient(to right, #a13f3f 0%, #a13f3f {t2}%, #d4b100 {t2}%, #d4b100 {t1}%, #1d6b3c {t1}%, #1d6b3c 100%);";
        }

        var x = GlobalSuccessThresholds[0];
        var y = GlobalSuccessThresholds[1];
        var z = GlobalSuccessThresholds[2];

        return $"background: linear-gradient(to right, #a13f3f 0%, #a13f3f {z}%, #d97a1f {z}%, #d97a1f {y}%, #d4b100 {y}%, #d4b100 {x}%, #1d6b3c {x}%, #1d6b3c 100%);";
    }

