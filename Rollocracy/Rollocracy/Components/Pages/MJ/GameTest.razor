    private async Task ApplySelectedTestPreset()
    {
        if (!SelectedTestPresetId.HasValue)
            return;

        var preset = TestPresets.FirstOrDefault(x => x.PresetId == SelectedTestPresetId.Value);
        if (preset is null)
            return;

        ApplyGameTestPresetRequest(preset.Request);

        ConfirmDeleteTestPresetVisible = false;
        await RefreshSelectedPollOptionOptionsAsync();
        StateHasChanged();
    }

