    private async Task HandleGlobalThresholdTrackMouseMove(MouseEventArgs args)
    {
        if (!DraggingGlobalThresholdIndex.HasValue)
            return;

        var trackRect = await JS.InvokeAsync<DomRectDto>("rollocracyThresholds.getElementRect", GlobalThresholdSliderTrackRef);
        if (trackRect.Width <= 0)
            return;

        var relativeX = args.ClientX - trackRect.Left;
        var percentage = (relativeX / trackRect.Width) * 100.0;
        var normalized = NormalizeSingleThresholdValue((int)Math.Round(percentage));

        SetGlobalThresholdValue(DraggingGlobalThresholdIndex.Value, normalized);
    }

    private void SetGlobalThresholdValue(int index, int value)
    {
        if (index < 0 || index >= GlobalSuccessThresholds.Count)
            return;

        value = NormalizeSingleThresholdValue(value);

        var maxAllowed = index == 0 ? 95 : GlobalSuccessThresholds[index - 1] - 5;
        var minAllowed = index == GlobalSuccessThresholds.Count - 1 ? 5 : GlobalSuccessThresholds[index + 1] + 5;

        value = Math.Clamp(value, minAllowed, maxAllowed);

        GlobalSuccessThresholds[index] = value;
        GlobalSuccessThresholds = GlobalSuccessThresholds
            .OrderByDescending(x => x)
            .ToList();
    }

