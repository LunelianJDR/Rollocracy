@page "/mj/session/{SessionId:guid}/journal"
@rendermode InteractiveServer

@using System.Security.Claims
@using System.Text.RegularExpressions
@using System.IO
@using System.Net
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Rollocracy.Domain.Entities
@using Rollocracy.Domain.Interfaces
@using Rollocracy.Localization
@using Blazored.TextEditor

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISessionService SessionService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L
@inject IJSRuntime JS

@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToHome)
{
    <p>@L["Common_Loading"]</p>
}
else if (Editor is null)
{
    <p>@L["Journal_NotFound"]</p>
}
else
{
    <section class="rc-tool-section rc-journal-management-page">
        @* <div class="rc-tool-layout rc-tool-layout--top">
            <div class="rc-tool-panel rc-journal-overview-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Journal_Title"]</h4>
                        <p class="rc-tool-panel__subtitle">@Editor.SessionName</p>
                    </div>
                </div>

                <div class="rc-journal-explanation-card">
                    <p>@L["Journal_Explanation"]</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="rc-inline-warning rc-inline-warning--soft">
                        <p>@Message</p>
                    </div>
                }
            </div>
        </div> *@

        <div class="rc-journal-dual-layout">
            <div class="rc-tool-panel rc-journal-scope-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Journal_PrivateTab"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Journal_PrivateSubtitle"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="() => SaveJournalAsync(false)">@L["Journal_SavePrivate"]</button>
                    </div>
                </div>

                <div class="@GetSaveStateCssClass(false)">
                    <strong>@(PrivateJournalHasUnsavedChanges ? L["Journal_UnsavedChangesTitle"] : L["Journal_AllChangesSavedTitle"])</strong>
                    <span>@(PrivateJournalHasUnsavedChanges ? L["Journal_PrivateUnsavedChangesBody"] : L["Journal_PrivateAllChangesSavedBody"])</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(PrivateJournalMessage))
                {
                    <div class="rc-inline-warning rc-inline-warning--soft">
                        <p>@PrivateJournalMessage</p>
                    </div>
                }

                @if (PrivatePage is null)
                {
                    <div class="rc-empty-panel">
                        <p>@L["Journal_NoPage"]</p>
                    </div>
                }
                else
                {
                    <div class="rc-journal-editor">
                        <div class="rc-journal-editor__topbar">
                            <div class="rc-journal-editor__nav">
                                <button type="button" @onclick="() => GoPreviousPageAsync(false)" disabled="@(CurrentPrivatePageIndex <= 0)">&lt;</button>
                                <span class="rc-journal-editor__page-number">@PrivatePage.PageNumber</span>
                                <button type="button" @onclick="() => GoNextPageAsync(false)">&gt;</button>
                                <span class="rc-journal-editor__page-title">@GetDisplayTitle(PrivatePage)</span>
                            </div>

                            <div class="rc-tool-actions">
                                <button type="button" @onclick="() => DeleteCurrentPageAsync(false)">@L["Journal_DeletePage"]</button>
                            </div>
                        </div>

                        <div class="rc-form-field rc-form-field--full">
                            <label>@L["Journal_PageTitle"]</label>
                            <input maxlength="120" value="@PrivatePage.Title" @oninput="args => OnPageTitleChanged(false, args)" />
                        </div>

                        <label class="rc-filter-toggle">
                            <input type="checkbox"
                                   checked="@PrivatePage.IsVisible"
                                   @onchange="OnPrivatePageVisibilityChanged" />
                            <span>@L["Journal_PrivatePageVisible"]</span>
                        </label>

                        @if (!PrivatePage.IsVisible)
                        {
                            <div class="rc-empty-panel" style="margin-top: 0.75rem;">
                                <p>@L["Journal_PrivatePageHidden"]</p>
                            </div>
                        }
                        else
                        {
                            <div class="rc-form-field rc-form-field--full" style="margin-top: 0.75rem;">
                                <label>@L["Journal_PageContent"]</label>

                                <div @ref="PrivateEditorHost"
                                     @onclick="() => MarkDirty(false)"
                                     @onkeyup="() => MarkDirty(false)">
                                    <BlazoredTextEditor @ref="PrivateJournalEditor"
                                                        @key="GetEditorRenderKey(false)"
                                                        Theme="snow"
                                                        Placeholder="@L["Journal_EditorPlaceholder"]">
                                        <ToolbarContent>
                                            <select class="ql-header">
                                                <option value="false">@L["Journal_FormatParagraph"]</option>
                                                <option value="4">@L["Journal_FormatSmallTitle"]</option>
                                                <option value="3">@L["Journal_FormatLargeTitle"]</option>
                                            </select>

                                            <span class="ql-formats">
                                                <button type="button" class="ql-bold rc-journal-toolbar-button" title="@L["Journal_FormatBold"]"><span>@L["Journal_FormatBold"]</span></button>
                                                <button type="button" class="ql-italic rc-journal-toolbar-button" title="@L["Journal_FormatItalic"]"><span>@L["Journal_FormatItalic"]</span></button>
                                                <button type="button" class="ql-underline rc-journal-toolbar-button" title="@L["Journal_FormatUnderline"]"><span>@L["Journal_FormatUnderline"]</span></button>
                                                <button type="button" class="ql-strike rc-journal-toolbar-button" title="@L["Journal_FormatStrike"]"><span>@L["Journal_FormatStrike"]</span></button>
                                            </span>

                                            <span class="ql-formats">
                                                <button type="button" class="ql-list rc-journal-toolbar-button" value="ordered" title="@L["Journal_ListOrdered"]"><span>@L["Journal_ListOrdered"]</span></button>
                                                <button type="button" class="ql-list rc-journal-toolbar-button" value="bullet" title="@L["Journal_ListBullet"]"><span>@L["Journal_ListBullet"]</span></button>
                                            </span>

                                            <span class="ql-formats">
                                                <button type="button" class="rc-journal-toolbar-button rc-journal-toolbar-button--image-url" @onclick="() => ToggleInsertImagePanel(false)" title="@L["Journal_InsertImageUrl"]">
                                                    <span>@L["Journal_InsertImageUrl"]</span>
                                                </button>
                                            </span>
                                        </ToolbarContent>
                                    </BlazoredTextEditor>
                                </div>

                                @if (ShowPrivateInsertImagePanel)
                                {
                                    <div class="rc-journal-image-url-panel">
                                        <div class="rc-form-field rc-form-field--full">
                                            <label>@L["Journal_ImageUrlLabel"]</label>
                                            <input value="@PrivateImageUrlInput" @oninput="args => OnImageUrlInputChanged(false, args)" placeholder="https://..." />
                                        </div>

                                        <div class="rc-tool-actions">
                                            <button type="button" @onclick="() => InsertImageFromUrlAsync(false)">@L["Journal_InsertImageAction"]</button>
                                            <button type="button" @onclick="() => CancelInsertImage(false)">@L["Common_Cancel"]</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="rc-tool-panel rc-journal-scope-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Journal_PublicTab"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Journal_PublicSubtitle"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="() => SaveJournalAsync(true)">@L["Journal_SavePublic"]</button>
                    </div>
                </div>

                <div class="@GetSaveStateCssClass(true)">
                    <strong>@(PublicJournalHasUnsavedChanges ? L["Journal_UnsavedChangesTitle"] : L["Journal_AllChangesSavedTitle"])</strong>
                    <span>@(PublicJournalHasUnsavedChanges ? L["Journal_PublicUnsavedChangesBody"] : L["Journal_PublicAllChangesSavedBody"])</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(PublicJournalMessage))
                {
                    <div class="rc-inline-warning rc-inline-warning--soft">
                        <p>@PublicJournalMessage</p>
                    </div>
                }

                @if (PublicPage is null)
                {
                    <div class="rc-empty-panel">
                        <p>@L["Journal_NoPage"]</p>
                    </div>
                }
                else
                {
                    <div class="rc-journal-editor">
                        <div class="rc-journal-editor__topbar">
                            <div class="rc-journal-editor__nav">
                                <button type="button" @onclick="() => GoPreviousPageAsync(true)" disabled="@(CurrentPublicPageIndex <= 0)">&lt;</button>
                                <span class="rc-journal-editor__page-number">@PublicPage.PageNumber</span>
                                <button type="button" @onclick="() => GoNextPageAsync(true)">&gt;</button>
                                <span class="rc-journal-editor__page-title">@GetDisplayTitle(PublicPage)</span>
                            </div>

                            <div class="rc-tool-actions">
                                <button type="button" @onclick="() => DeleteCurrentPageAsync(true)">@L["Journal_DeletePage"]</button>
                            </div>
                        </div>

                        <div class="rc-form-field rc-form-field--full">
                            <label>@L["Journal_PageTitle"]</label>
                            <input maxlength="120" value="@PublicPage.Title" @oninput="args => OnPageTitleChanged(true, args)" />
                        </div>

                        <div class="rc-form-field rc-form-field--full" style="margin-top: 0.75rem;">
                            <label>@L["Journal_PageContent"]</label>

                            <div @ref="PublicEditorHost"
                                 @onclick="() => MarkDirty(true)"
                                 @onkeyup="() => MarkDirty(true)">
                                <BlazoredTextEditor @ref="PublicJournalEditor"
                                                    @key="GetEditorRenderKey(true)"
                                                    Theme="snow"
                                                    Placeholder="@L["Journal_EditorPlaceholder"]">
                                    <ToolbarContent>
                                        <select class="ql-header">
                                            <option value="false">@L["Journal_FormatParagraph"]</option>
                                            <option value="4">@L["Journal_FormatSmallTitle"]</option>
                                            <option value="3">@L["Journal_FormatLargeTitle"]</option>
                                        </select>

                                        <span class="ql-formats">
                                            <button type="button" class="ql-bold rc-journal-toolbar-button" title="@L["Journal_FormatBold"]"><span>@L["Journal_FormatBold"]</span></button>
                                            <button type="button" class="ql-italic rc-journal-toolbar-button" title="@L["Journal_FormatItalic"]"><span>@L["Journal_FormatItalic"]</span></button>
                                            <button type="button" class="ql-underline rc-journal-toolbar-button" title="@L["Journal_FormatUnderline"]"><span>@L["Journal_FormatUnderline"]</span></button>
                                            <button type="button" class="ql-strike rc-journal-toolbar-button" title="@L["Journal_FormatStrike"]"><span>@L["Journal_FormatStrike"]</span></button>
                                        </span>

                                        <span class="ql-formats">
                                            <button type="button" class="ql-list rc-journal-toolbar-button" value="ordered" title="@L["Journal_ListOrdered"]"><span>@L["Journal_ListOrdered"]</span></button>
                                            <button type="button" class="ql-list rc-journal-toolbar-button" value="bullet" title="@L["Journal_ListBullet"]"><span>@L["Journal_ListBullet"]</span></button>
                                        </span>

                                        <span class="ql-formats">
                                            <button type="button" class="rc-journal-toolbar-button rc-journal-toolbar-button--image-url" @onclick="() => ToggleInsertImagePanel(true)" title="@L["Journal_InsertImageUrl"]">
                                                <span>@L["Journal_InsertImageUrl"]</span>
                                            </button>
                                        </span>
                                    </ToolbarContent>
                                </BlazoredTextEditor>
                            </div>

                            @if (ShowPublicInsertImagePanel)
                            {
                                <div class="rc-journal-image-url-panel">
                                    <div class="rc-form-field rc-form-field--full">
                                        <label>@L["Journal_ImageUrlLabel"]</label>
                                        <input value="@PublicImageUrlInput" @oninput="args => OnImageUrlInputChanged(true, args)" placeholder="https://..." />
                                    </div>

                                    <div class="rc-tool-actions">
                                        <button type="button" @onclick="() => InsertImageFromUrlAsync(true)">@L["Journal_InsertImageAction"]</button>
                                        <button type="button" @onclick="() => CancelInsertImage(true)">@L["Common_Cancel"]</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public Guid SessionId { get; set; }

    private Guid CurrentUserId;
    private bool IsLoaded;
    private bool RedirectToHome;
    private string Message = string.Empty;

    private SessionJournalEditorDto? Editor;
    private int CurrentPrivatePageIndex;
    private int CurrentPublicPageIndex;

    private BlazoredTextEditor? PrivateJournalEditor;
    private BlazoredTextEditor? PublicJournalEditor;
    private ElementReference PrivateEditorHost;
    private ElementReference PublicEditorHost;

    private bool ShouldLoadPrivatePageIntoEditor;
    private bool ShouldLoadPublicPageIntoEditor;
    private bool WaitOneRenderBeforeLoadingPrivateEditorContent;
    private bool WaitOneRenderBeforeLoadingPublicEditorContent;

    private bool ShowPrivateInsertImagePanel;
    private bool ShowPublicInsertImagePanel;
    private string PrivateImageUrlInput = string.Empty;
    private string PublicImageUrlInput = string.Empty;

    private bool PrivateJournalHasUnsavedChanges;
    private bool PublicJournalHasUnsavedChanges;
    private string PrivateJournalMessage = string.Empty;
    private string PublicJournalMessage = string.Empty;

    private List<SessionJournalPageDto> PrivatePages => Editor?.PrivatePages ?? new List<SessionJournalPageDto>();
    private List<SessionJournalPageDto> PublicPages => Editor?.PublicPages ?? new List<SessionJournalPageDto>();

    private SessionJournalPageDto? PrivatePage
        => PrivatePages.Count == 0
            ? null
            : PrivatePages[Math.Clamp(CurrentPrivatePageIndex, 0, PrivatePages.Count - 1)];

    private SessionJournalPageDto? PublicPage
        => PublicPages.Count == 0
            ? null
            : PublicPages[Math.Clamp(CurrentPublicPageIndex, 0, PublicPages.Count - 1)];

    private bool IsPrivateEditorVisible => PrivatePage is not null && PrivatePage.IsVisible;
    private bool IsPublicEditorVisible => PublicPage is not null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);

        await LoadEditorAsync();
        IsLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToHome)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        var mustRenderAgain = false;

        if (PrivateJournalEditor is not null && IsPrivateEditorVisible && ShouldLoadPrivatePageIntoEditor && PrivatePage is not null && WaitOneRenderBeforeLoadingPrivateEditorContent)
        {
            WaitOneRenderBeforeLoadingPrivateEditorContent = false;
            mustRenderAgain = true;
        }

        if (PublicJournalEditor is not null && IsPublicEditorVisible && ShouldLoadPublicPageIntoEditor && PublicPage is not null && WaitOneRenderBeforeLoadingPublicEditorContent)
        {
            WaitOneRenderBeforeLoadingPublicEditorContent = false;
            mustRenderAgain = true;
        }

        if (mustRenderAgain)
        {
            StateHasChanged();
            return;
        }

        await LoadEditorContentIfNeededAsync(false);
        await LoadEditorContentIfNeededAsync(true);
    }

    private async Task LoadEditorAsync()
    {
        Message = string.Empty;
        PrivateJournalMessage = string.Empty;
        PublicJournalMessage = string.Empty;

        Editor = await SessionService.GetSessionJournalEditorAsync(SessionId, CurrentUserId);

        ClampIndexes();
        ResetEditorLoadState(false);
        ResetEditorLoadState(true);
        PrivateJournalHasUnsavedChanges = false;
        PublicJournalHasUnsavedChanges = false;
    }

    private async Task LoadEditorContentIfNeededAsync(bool isPublic)
    {
        var editor = isPublic ? PublicJournalEditor : PrivateJournalEditor;
        var isVisible = isPublic ? IsPublicEditorVisible : IsPrivateEditorVisible;
        var shouldLoad = isPublic ? ShouldLoadPublicPageIntoEditor : ShouldLoadPrivatePageIntoEditor;
        var page = GetPage(isPublic);
        var host = isPublic ? PublicEditorHost : PrivateEditorHost;

        if (editor is null || !isVisible || !shouldLoad || page is null)
            return;

        try
        {
            var loaded = await JS.InvokeAsync<bool>(
                "rollocracyJournal.setHtml",
                host,
                page.ContentHtml ?? string.Empty);

            if (loaded)
            {
                SetShouldLoadEditorContent(isPublic, false);
            }
        }
        catch
        {
        }
    }

    private async Task RefreshPageFromEditorAsync(bool isPublic)
    {
        var page = GetPage(isPublic);
        if (page is null || !IsEditorVisible(isPublic))
            return;

        var host = isPublic ? PublicEditorHost : PrivateEditorHost;

        try
        {
            var html = await JS.InvokeAsync<string>("rollocracyJournal.getHtml", host);
            page.ContentHtml = NormalizeJournalHtml(html);
        }
        catch
        {
        }
    }

    private void ClampIndexes()
    {
        if (Editor is null)
            return;

        CurrentPrivatePageIndex = Editor.PrivatePages.Count == 0
            ? 0
            : Math.Clamp(CurrentPrivatePageIndex, 0, Editor.PrivatePages.Count - 1);

        CurrentPublicPageIndex = Editor.PublicPages.Count == 0
            ? 0
            : Math.Clamp(CurrentPublicPageIndex, 0, Editor.PublicPages.Count - 1);
    }

    private List<SessionJournalPageDto> GetPages(bool isPublic)
        => isPublic ? PublicPages : PrivatePages;

    private SessionJournalPageDto? GetPage(bool isPublic)
        => isPublic ? PublicPage : PrivatePage;

    private int GetCurrentPageIndex(bool isPublic)
        => isPublic ? CurrentPublicPageIndex : CurrentPrivatePageIndex;

    private void SetCurrentPageIndex(bool isPublic, int value)
    {
        if (isPublic)
            CurrentPublicPageIndex = value;
        else
            CurrentPrivatePageIndex = value;
    }

    private bool IsEditorVisible(bool isPublic)
        => isPublic ? IsPublicEditorVisible : IsPrivateEditorVisible;

    private string GetEditorRenderKey(bool isPublic)
    {
        var page = GetPage(isPublic);
        var currentPageId = page?.JournalPageId?.ToString("N") ?? "new";
        var visibility = isPublic ? true : page?.IsVisible;
        return $"{isPublic}-{GetCurrentPageIndex(isPublic)}-{visibility}-{currentPageId}";
    }

    private void ResetEditorLoadState(bool isPublic)
    {
        if (isPublic)
        {
            PublicJournalEditor = null;
            ShouldLoadPublicPageIntoEditor = true;
            WaitOneRenderBeforeLoadingPublicEditorContent = true;
        }
        else
        {
            PrivateJournalEditor = null;
            ShouldLoadPrivatePageIntoEditor = true;
            WaitOneRenderBeforeLoadingPrivateEditorContent = true;
        }
    }

    private void SetShouldLoadEditorContent(bool isPublic, bool value)
    {
        if (isPublic)
            ShouldLoadPublicPageIntoEditor = value;
        else
            ShouldLoadPrivatePageIntoEditor = value;
    }

    private void MarkDirty(bool isPublic)
    {
        if (isPublic)
        {
            PublicJournalHasUnsavedChanges = true;
            PublicJournalMessage = string.Empty;
        }
        else
        {
            PrivateJournalHasUnsavedChanges = true;
            PrivateJournalMessage = string.Empty;
        }

        Message = string.Empty;
    }

    private string GetSaveStateCssClass(bool isPublic)
    {
        var isDirty = isPublic ? PublicJournalHasUnsavedChanges : PrivateJournalHasUnsavedChanges;
        return isDirty
            ? "rc-editor-save-state rc-editor-save-state--dirty rc-journal-save-state"
            : "rc-editor-save-state rc-editor-save-state--saved rc-journal-save-state";
    }

    private void OnImageUrlInputChanged(bool isPublic, ChangeEventArgs args)
    {
        if (isPublic)
            PublicImageUrlInput = args.Value?.ToString() ?? string.Empty;
        else
            PrivateImageUrlInput = args.Value?.ToString() ?? string.Empty;
    }

    private void OnPageTitleChanged(bool isPublic, ChangeEventArgs args)
    {
        var page = GetPage(isPublic);
        if (page is null)
            return;

        page.Title = args.Value?.ToString() ?? string.Empty;
        MarkDirty(isPublic);
    }

    private Task OnPrivatePageVisibilityChanged(ChangeEventArgs args)
    {
        if (PrivatePage is null)
            return Task.CompletedTask;

        PrivatePage.IsVisible = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

        MarkDirty(false);
        ResetEditorLoadState(false);
        return InvokeAsync(StateHasChanged);
    }

    private async Task GoPreviousPageAsync(bool isPublic)
    {
        var pages = GetPages(isPublic);
        if (pages.Count == 0)
            return;

        await RefreshPageFromEditorAsync(isPublic);

        var currentIndex = GetCurrentPageIndex(isPublic);
        if (currentIndex > 0)
        {
            SetCurrentPageIndex(isPublic, currentIndex - 1);
            ResetEditorLoadState(isPublic);
        }
    }

    private async Task GoNextPageAsync(bool isPublic)
    {
        var pages = GetPages(isPublic);
        if (pages.Count == 0)
            return;

        await RefreshPageFromEditorAsync(isPublic);

        var currentIndex = GetCurrentPageIndex(isPublic);
        if (currentIndex < pages.Count - 1)
        {
            SetCurrentPageIndex(isPublic, currentIndex + 1);
            ResetEditorLoadState(isPublic);
            return;
        }

        var currentHtml = GetPage(isPublic)?.ContentHtml ?? string.Empty;

        if (!HasMeaningfulContent(currentHtml))
            return;

        var newPage = new SessionJournalPageDto
        {
            PageNumber = pages.Count + 1,
            Title = string.Empty,
            ContentHtml = string.Empty,
            IsVisible = isPublic
        };

        pages.Add(newPage);
        Reindex(pages);
        SetCurrentPageIndex(isPublic, pages.Count - 1);
        MarkDirty(isPublic);
        ResetEditorLoadState(isPublic);
    }

    private async Task DeleteCurrentPageAsync(bool isPublic)
    {
        var page = GetPage(isPublic);
        var pages = GetPages(isPublic);
        if (page is null)
            return;

        await RefreshPageFromEditorAsync(isPublic);

        pages.Remove(page);

        if (pages.Count == 0)
        {
            pages.Add(new SessionJournalPageDto
            {
                PageNumber = 1,
                Title = string.Empty,
                ContentHtml = string.Empty,
                IsVisible = isPublic
            });
        }

        Reindex(pages);
        SetCurrentPageIndex(isPublic, Math.Clamp(GetCurrentPageIndex(isPublic), 0, pages.Count - 1));
        MarkDirty(isPublic);
        ResetEditorLoadState(isPublic);
    }

    private void Reindex(List<SessionJournalPageDto> pages)
    {
        for (var i = 0; i < pages.Count; i++)
        {
            pages[i].PageNumber = i + 1;
        }
    }

    private async Task SaveJournalAsync(bool isPublic)
    {
        if (Editor is null)
            return;

        try
        {
            Message = string.Empty;
            SetScopeMessage(isPublic, string.Empty);

            await RefreshPageFromEditorAsync(isPublic);
            NormalizePages(GetPages(isPublic));

            var latestEditor = await SessionService.GetSessionJournalEditorAsync(SessionId, CurrentUserId);
            if (latestEditor is null)
                throw new Exception(L["Journal_NotFound"].Value);

            await SessionService.SaveSessionJournalAsync(
                SessionId,
                CurrentUserId,
                new SessionJournalSaveRequestDto
                {
                    PrivatePages = isPublic ? latestEditor.PrivatePages : Editor.PrivatePages,
                    PublicPages = isPublic ? Editor.PublicPages : latestEditor.PublicPages
                });

            var reloadedEditor = await SessionService.GetSessionJournalEditorAsync(SessionId, CurrentUserId);
            if (reloadedEditor is null)
                throw new Exception(L["Journal_NotFound"].Value);

            if (isPublic)
            {
                ReplacePages(Editor.PublicPages, reloadedEditor.PublicPages);
                PublicJournalHasUnsavedChanges = false;
                PublicJournalMessage = L["Journal_PublicSaved"].Value;

                if (!PrivateJournalHasUnsavedChanges)
                    ReplacePages(Editor.PrivatePages, reloadedEditor.PrivatePages);
            }
            else
            {
                ReplacePages(Editor.PrivatePages, reloadedEditor.PrivatePages);
                PrivateJournalHasUnsavedChanges = false;
                PrivateJournalMessage = L["Journal_PrivateSaved"].Value;

                if (!PublicJournalHasUnsavedChanges)
                    ReplacePages(Editor.PublicPages, reloadedEditor.PublicPages);
            }

            ClampIndexes();
            ResetEditorLoadState(isPublic);
        }
        catch (Exception ex)
        {
            SetScopeMessage(isPublic, $"{L["Common_Error"]} : {ex.Message}");
        }
    }

    private void SetScopeMessage(bool isPublic, string value)
    {
        if (isPublic)
            PublicJournalMessage = value;
        else
            PrivateJournalMessage = value;
    }

    private static void ReplacePages(List<SessionJournalPageDto> target, List<SessionJournalPageDto> source)
    {
        target.Clear();
        target.AddRange(source);
    }

    private string GetDisplayTitle(SessionJournalPageDto page)
    {
        return string.IsNullOrWhiteSpace(page.Title)
            ? L["Journal_DefaultPageTitle"].Value
            : page.Title.Trim();
    }

    private static bool HasMeaningfulContent(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return false;

        if (Regex.IsMatch(html, @"<img\b[^>]*\bsrc\s*=", RegexOptions.IgnoreCase | RegexOptions.Singleline))
            return true;

        var text = Regex.Replace(html, "<.*?>", string.Empty);
        text = text.Replace("&nbsp;", " ", StringComparison.OrdinalIgnoreCase);
        text = text.Trim();

        return !string.IsNullOrWhiteSpace(text);
    }

    private void ToggleInsertImagePanel(bool isPublic)
    {
        if (isPublic)
        {
            ShowPublicInsertImagePanel = !ShowPublicInsertImagePanel;

            if (!ShowPublicInsertImagePanel)
                PublicImageUrlInput = string.Empty;
        }
        else
        {
            ShowPrivateInsertImagePanel = !ShowPrivateInsertImagePanel;

            if (!ShowPrivateInsertImagePanel)
                PrivateImageUrlInput = string.Empty;
        }
    }

    private void CancelInsertImage(bool isPublic)
    {
        if (isPublic)
        {
            ShowPublicInsertImagePanel = false;
            PublicImageUrlInput = string.Empty;
        }
        else
        {
            ShowPrivateInsertImagePanel = false;
            PrivateImageUrlInput = string.Empty;
        }
    }

    private async Task InsertImageFromUrlAsync(bool isPublic)
    {
        var page = GetPage(isPublic);
        if (page is null || !IsEditorVisible(isPublic))
            return;

        SetScopeMessage(isPublic, string.Empty);

        var imageUrlInput = isPublic ? PublicImageUrlInput : PrivateImageUrlInput;
        if (!TryNormalizeImageUrl(imageUrlInput, out var normalizedImageUrl))
        {
            SetScopeMessage(isPublic, L["Journal_InvalidImageUrl"].Value);
            return;
        }

        var host = isPublic ? PublicEditorHost : PrivateEditorHost;

        try
        {
            var inserted = await JS.InvokeAsync<bool>(
                "rollocracyJournal.insertImageByUrl",
                host,
                normalizedImageUrl);

            if (!inserted)
            {
                SetScopeMessage(isPublic, L["Journal_ImageInsertFailed"].Value);
                return;
            }

            await RefreshPageFromEditorAsync(isPublic);
            page.ContentHtml = NormalizeJournalHtml(page.ContentHtml);
            CancelInsertImage(isPublic);
            MarkDirty(isPublic);
        }
        catch
        {
            SetScopeMessage(isPublic, L["Journal_ImageInsertFailed"].Value);
        }
    }

    private void NormalizePages(List<SessionJournalPageDto> pages)
    {
        foreach (var page in pages)
        {
            page.ContentHtml = NormalizeJournalHtml(page.ContentHtml);
        }
    }

    private static string NormalizeJournalHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return string.Empty;

        return Regex.Replace(
            html,
            @"<img\b(?<attrs>[^>]*)>",
            match => NormalizeImageTag(match.Value, match.Groups["attrs"].Value),
            RegexOptions.IgnoreCase | RegexOptions.Singleline);
    }

    private static string NormalizeImageTag(string originalTag, string attributes)
    {
        var srcMatch = Regex.Match(
            attributes,
            @"\bsrc\s*=\s*(?:(?<q>[""'])(?<src>.*?)(\k<q>)|(?<src>[^\s>]+))",
            RegexOptions.IgnoreCase | RegexOptions.Singleline);

        if (!srcMatch.Success)
            return originalTag;

        var rawSrc = WebUtility.HtmlDecode(srcMatch.Groups["src"].Value);
        if (!TryNormalizeImageUrl(rawSrc, out var normalizedSrc))
            return originalTag;

        var encodedSrc = WebUtility.HtmlEncode(normalizedSrc);
        var normalizedAttributes = Regex.Replace(
            attributes,
            @"\bsrc\s*=\s*(?:(?<q>[""'])(?<src>.*?)(\k<q>)|(?<src>[^\s>]+))",
            $"src=\"{encodedSrc}\"",
            RegexOptions.IgnoreCase | RegexOptions.Singleline,
            TimeSpan.FromMilliseconds(250));

        normalizedAttributes = EnsureImageAttribute(normalizedAttributes, "loading", "lazy");
        normalizedAttributes = EnsureImageAttribute(normalizedAttributes, "decoding", "async");
        normalizedAttributes = EnsureImageAttribute(normalizedAttributes, "referrerpolicy", "no-referrer");
        normalizedAttributes = EnsureImageAttribute(normalizedAttributes, "alt", "");

        return $"<img{normalizedAttributes}>";
    }

    private static string EnsureImageAttribute(string attributes, string name, string value)
    {
        if (Regex.IsMatch(attributes, $@"\b{Regex.Escape(name)}\s*=", RegexOptions.IgnoreCase))
            return attributes;

        return $"{attributes} {name}=\"{WebUtility.HtmlEncode(value)}\"";
    }

    private static bool TryNormalizeImageUrl(string? rawUrl, out string normalizedImageUrl)
    {
        normalizedImageUrl = string.Empty;

        if (string.IsNullOrWhiteSpace(rawUrl))
            return false;

        var trimmed = WebUtility.HtmlDecode(rawUrl).Trim();

        if (!Uri.TryCreate(trimmed, UriKind.Absolute, out var uri))
            return false;

        if (!string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
            return false;

        var extension = Path.GetExtension(uri.AbsolutePath);
        var allowedExtensions = new[] { ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".avif" };
        var hasAllowedExtension = !string.IsNullOrWhiteSpace(extension) && allowedExtensions.Contains(extension, StringComparer.OrdinalIgnoreCase);

        var queryFormat = GetQueryParameter(uri, "format");
        var allowedFormats = new[] { "png", "jpg", "jpeg", "pjpg", "gif", "webp", "bmp", "avif" };
        var hasAllowedQueryFormat = !string.IsNullOrWhiteSpace(queryFormat) && allowedFormats.Contains(queryFormat, StringComparer.OrdinalIgnoreCase);

        if (!hasAllowedExtension && !hasAllowedQueryFormat)
            return false;

        if (string.Equals(uri.Host, "i.redd.it", StringComparison.OrdinalIgnoreCase) && hasAllowedExtension)
        {
            normalizedImageUrl = uri.GetLeftPart(UriPartial.Path);
            return true;
        }

        normalizedImageUrl = uri.ToString();
        return true;
    }

    private static string? GetQueryParameter(Uri uri, string name)
    {
        var query = uri.Query;
        if (string.IsNullOrWhiteSpace(query))
            return null;

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = part.Split('=', 2);
            var key = Uri.UnescapeDataString(pieces[0]);
            if (!string.Equals(key, name, StringComparison.OrdinalIgnoreCase))
                continue;

            return pieces.Length == 2 ? Uri.UnescapeDataString(pieces[1]) : string.Empty;
        }

        return null;
    }

    private void BackToSettings()
    {
        Navigation.NavigateTo($"/mj/session/{SessionId}/settings");
    }
