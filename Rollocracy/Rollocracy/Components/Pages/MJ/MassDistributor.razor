@page "/mj/session/{SessionId:guid}/mass-distribution"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Characters
@using Rollocracy.Domain.Interfaces
@using Rollocracy.Localization
@using Rollocracy.Domain.GameRules
@using Rollocracy.Domain.GameTests
@using Rollocracy.Components.Pages.MJ.Shared

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IMassDistributionService MassDistributionService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L
@inject ISessionService SessionService
@inject ICharacterService CharacterService
@inject IPollService PollService


@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToHome)
{
    <p>@L["Common_Loading"]</p>
}
else if (Editor is null)
{
    <p>@L["MassDistribution_NotFound"]</p>
}
else
{
    <section class="rc-tool-section">
        <div class="rc-tool-layout">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h5 class="rc-tool-panel__title">@L["MassDistribution_Title"]</h5>
                        @* <p class="rc-tool-panel__subtitle">@Editor.SessionName · @L["MassDistribution_FilterSection"] / @L["MassDistribution_EffectsSection"]</p> *@
                    </div>

                    <div class="rc-tool-inline-actions">
                        <button @onclick="PreviewTargets">@L["MassDistribution_PreviewTargets"]</button>
                        <button @onclick="ApplyDistribution">@L["MassDistribution_Apply"]</button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="rc-inline-error">@Message</div>
                }

                @if (LastBatch is not null)
                {
                    <div class="rc-inline-info">
                        <div>
                            <strong>@L["MassDistribution_LastBatch"] :</strong>
                            @LastBatch.Name
                            · @LastBatch.TargetCharacterCount
                        </div>
                        <button @onclick="UndoLastDistribution">@L["MassDistribution_UndoLast"]</button>
                    </div>
                }

                <div class="rc-tool-form-grid">
                    <div class="rc-form-field rc-form-field--full">
                        <label>@L["MassDistribution_Name"]</label>
                        <input @bind="Request.Name" />
                    </div>
                </div>

                <div class="rc-tool-subsection">
                    <CharacterAudienceFilters Title="@L["Test_TargetScope"]"
                                              OnlyOnline="Request.Filter.OnlyOnline"
                                              OnlyAlive="Request.Filter.OnlyAlive"
                                              IncludeNpcs="Request.Filter.IncludeNpcs"
                                              BiographyNotEmpty="Request.Filter.BiographyNotEmpty"
                                              OnlyOnlineChanged="@(value => { Request.Filter.OnlyOnline = value; if (value) Request.Filter.OnlyAlive = true; })"
                                              OnlyAliveChanged="@(value => { Request.Filter.OnlyAlive = true; if (!value) Request.Filter.OnlyOnline = false; })"
                                              IncludeNpcsChanged="@(value => Request.Filter.IncludeNpcs = value)"
                                              BiographyNotEmptyChanged="@(value => Request.Filter.BiographyNotEmpty = value)" />
                        
                    <CharacterAdvancedFilters Filter="Request.Filter"
                                              TraitOptionGroups="AdvancedTraitOptionGroups"
                                              TalentOptions="AdvancedTalentOptions"
                                              ItemOptions="AdvancedItemOptions"
                                              AttributeTargets="AdvancedAttributeTargets"
                                              GaugeTargets="AdvancedGaugeTargets"
                                              DerivedStatTargets="AdvancedDerivedTargets"
                                              MetricTargets="AdvancedMetricTargets"
                                              PollOptions="AdvancedPollOptions"
                                              SelectedPollOptionOptions="AdvancedSelectedPollOptionOptions"
                                              RandomDrawOptions="AdvancedRandomDrawOptions"
                                              NameSuggestions="AdvancedNameSuggestions"
                                              OnPollSelectionChanged="RefreshSelectedPollOptionOptionsAsync" />
                </div>

                <Consequences Title="@L["MassDistribution_EffectsSection"]"
                              AddButtonLabel="@L["Test_AddConsequence"]"
                              EmptyLabel="@L["Test_NoConsequence"]"
                              ShowApplyOn="false"
                              ShowApplicationMode="false"
                              AllowSuccessFailureApplicationModes="false"
                              AllowMetricValueModeForSessionGauge="false"
                              Rows="ConsequenceRows"
                              ApplyOnOptions="ConsequenceApplyOnOptions"
                              AttributeTargets="ConsequenceAttributeTargets"
                              GaugeTargets="ConsequenceGaugeTargets"
                              SessionGaugeTargets="ConsequenceSessionGaugeTargets"
                              DerivedStatTargets="ConsequenceDerivedStatTargets"
                              MetricTargets="ConsequenceMetricTargets"
                              TalentTargets="ConsequenceTalentTargets"
                              ItemTargets="ConsequenceItemTargets"
                              AllowSessionGaugeTarget="true"
                              PreferredAddValueTargetKind="@(Editor?.BaseAttributes.Count > 0 ? TestConsequenceTargetKind.Attribute : TestConsequenceTargetKind.Gauge)" />

                <div class="rc-tool-actions rc-tool-actions--right">
                    <button @onclick="PreviewTargets">@L["MassDistribution_PreviewTargets"]</button>
                    <button @onclick="ApplyDistribution">@L["MassDistribution_Apply"]</button>
                </div>
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header">
                    <div>
                        <h5 class="rc-tool-panel__title">@PreviewPanelTitle</h5>
                        <p class="rc-tool-panel__subtitle">@L["MassDistribution_TargetCount"] : @PreviewCharacters.Count</p>
                    </div>
                </div>

                @if (PreviewCharacters.Count == 0)
                {
                    <div class="rc-empty-panel">
                        <p>@L["MassDistribution_NoPreview"]</p>
                    </div>
                }
                else
                {
                    <div class="rc-test-result-grid">
                        @foreach (var item in PreviewCharacters)
                        {
                            if (CharacterSummariesById.TryGetValue(item.CharacterId, out var summary))
                            {
                                <CharacterResultSummaryCard Character="summary" />
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public Guid SessionId { get; set; }

    private Guid CurrentUserId;
    private bool IsLoaded;
    private bool RedirectToHome;
    private string Message = string.Empty;

    private MassDistributionEditorDto? Editor;
    private List<SessionGaugeDto> SessionGauges = new();
    private MassDistributionRequestDto Request = new()
    {
        Filter = new CharacterTargetFilterDto
        {
            OnlyAlive = true,
            OnlyDead = false,
            OnlyOnline = true,
            IncludeNpcs = false,
            MatchAllConditions = true
        }
    };
    private List<SharedConsequenceRowModel> ConsequenceRows = new();
    private List<SharedConsequenceApplyOnOption> ConsequenceApplyOnOptions => new();

    private List<SharedConsequenceDefinitionOption> ConsequenceAttributeTargets
        => Editor?.BaseAttributes.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<SharedConsequenceDefinitionOption> ConsequenceGaugeTargets
        => Editor?.Gauges.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<SharedConsequenceDefinitionOption> ConsequenceSessionGaugeTargets
        => SessionGauges.Select(x => new SharedConsequenceDefinitionOption { Id = x.SessionGaugeId, Name = x.Name }).ToList();

    private List<SharedConsequenceDefinitionOption> ConsequenceDerivedStatTargets
        => Editor?.DerivedStats.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<SharedConsequenceDefinitionOption> ConsequenceMetricTargets
        => Editor?.Metrics.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<SharedConsequenceDefinitionOption> ConsequenceTalentTargets
        => Editor?.Talents.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<SharedConsequenceDefinitionOption> ConsequenceItemTargets
        => Editor?.Items.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private Dictionary<Guid, SessionCharacterSummaryDto> CharacterSummariesById = new();

    private List<MassDistributionPreviewCharacterDto> PreviewCharacters { get; set; } = new();

    private MassDistributionLastBatchDto? LastBatch;
    private bool HasAppliedDistribution;

    private List<CharacterFilterGroupItem> AdvancedTraitOptionGroups
    => Editor?.TraitOptions
        .GroupBy(x => new { x.GroupId, x.GroupName })
        .OrderBy(x => x.Key.GroupName)
        .Select(group => new CharacterFilterGroupItem
        {
            GroupName = group.Key.GroupName,
            Options = group
                .OrderBy(x => x.Name)
                .Select(x => new CharacterFilterReferenceItem
                {
                    Id = x.Id,
                    Name = x.Name
                })
                .ToList()
        })
        .ToList()
        ?? new List<CharacterFilterGroupItem>();

    private List<CharacterFilterReferenceItem> AdvancedTalentOptions
        => Editor?.Talents.Select(x => new CharacterFilterReferenceItem { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<CharacterFilterReferenceItem> AdvancedItemOptions
        => Editor?.Items.Select(x => new CharacterFilterReferenceItem { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<CharacterFilterReferenceItem> AdvancedAttributeTargets
        => Editor?.BaseAttributes.Select(x => new CharacterFilterReferenceItem { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<CharacterFilterReferenceItem> AdvancedGaugeTargets
        => Editor?.Gauges.Select(x => new CharacterFilterReferenceItem { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<CharacterFilterReferenceItem> AdvancedDerivedTargets
        => Editor?.DerivedStats.Select(x => new CharacterFilterReferenceItem { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<CharacterFilterReferenceItem> AdvancedMetricTargets
        => Editor?.Metrics.Select(x => new CharacterFilterReferenceItem { Id = x.Id, Name = x.Name }).ToList() ?? new();

    private List<CharacterFilterReferenceItem> AdvancedPollOptions = new();
    private List<CharacterFilterReferenceItem> AdvancedSelectedPollOptionOptions = new();
    private List<CharacterFilterReferenceItem> AdvancedRandomDrawOptions = new();
    private List<CharacterNameSuggestionItem> AdvancedNameSuggestions = new();

    private string PreviewPanelTitle
        => HasAppliedDistribution
            ? L["MassDistribution_AffectedCharacters"]
            : L["MassDistribution_PreviewResult"];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);
        Editor = await MassDistributionService.GetEditorAsync(SessionId, CurrentUserId);
        SessionGauges = await SessionService.GetSessionGaugesAsync(SessionId, CurrentUserId);
        LastBatch = await MassDistributionService.GetLastBatchAsync(SessionId, CurrentUserId);
        SyncRowsFromRequestEffects();
        await LoadCharacterSummariesAsync();
        await LoadAdvancedPollOptionsAsync();
        await LoadAdvancedRandomDrawOptionsAsync();
        await LoadAdvancedNameSuggestionsAsync();

        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToHome)
            Navigation.NavigateTo("/", forceLoad: true);

        return Task.CompletedTask;
    }


    private void SyncRowsFromRequestEffects()
    {
        ConsequenceRows = Request.Effects.Select(effect => new SharedConsequenceRowModel
        {
            RowId = Guid.NewGuid(),
            OperationType = effect.OperationType switch
            {
                CharacterEffectOperationType.AddValue => TestConsequenceOperationType.AddValue,
                CharacterEffectOperationType.GrantTalent => TestConsequenceOperationType.GrantTalent,
                CharacterEffectOperationType.RevokeTalent => TestConsequenceOperationType.RevokeTalent,
                CharacterEffectOperationType.GrantItem => TestConsequenceOperationType.GrantItem,
                CharacterEffectOperationType.RevokeItem => TestConsequenceOperationType.RevokeItem,
                _ => TestConsequenceOperationType.AddValue
            },
            TargetKind = effect.TargetType switch
            {
                CharacterEffectTargetType.Gauge => TestConsequenceTargetKind.Gauge,
                CharacterEffectTargetType.SessionGauge => TestConsequenceTargetKind.SessionGauge,
                CharacterEffectTargetType.BaseAttribute => TestConsequenceTargetKind.Attribute,
                CharacterEffectTargetType.DerivedStat => TestConsequenceTargetKind.DerivedStat,
                CharacterEffectTargetType.Metric => TestConsequenceTargetKind.Metric,
                CharacterEffectTargetType.Talent => TestConsequenceTargetKind.Talent,
                CharacterEffectTargetType.Item => TestConsequenceTargetKind.Item,
                _ => TestConsequenceTargetKind.Attribute
            },
            TargetDefinitionId = effect.TargetId,
            ModifierMode = effect.ValueMode == ModifierValueMode.Metric && effect.Value < 0
                ? TestModifierMode.Malus
                : TestModifierMode.Bonus,
            Value = effect.ValueMode == ModifierValueMode.Metric
                ? 1
                : effect.Value,
            ClampMode = effect.ClampMode,
            ClampMinTotal = effect.ClampMinTotal,
            ClampMaxTotal = effect.ClampMaxTotal,
            ValueMode = effect.ValueMode,
            SourceMetricId = effect.SourceMetricId
        }).ToList();
    }

    private void SyncRequestEffectsFromRows()
    {
        Request.Effects = ConsequenceRows.Select(row => new CharacterEffectDefinitionDto
        {
            OperationType = row.OperationType switch
            {
                TestConsequenceOperationType.AddValue => CharacterEffectOperationType.AddValue,
                TestConsequenceOperationType.GrantTalent => CharacterEffectOperationType.GrantTalent,
                TestConsequenceOperationType.RevokeTalent => CharacterEffectOperationType.RevokeTalent,
                TestConsequenceOperationType.GrantItem => CharacterEffectOperationType.GrantItem,
                TestConsequenceOperationType.RevokeItem => CharacterEffectOperationType.RevokeItem,
                _ => CharacterEffectOperationType.AddValue
            },
            TargetType = row.TargetKind switch
            {
                TestConsequenceTargetKind.Gauge => CharacterEffectTargetType.Gauge,
                TestConsequenceTargetKind.SessionGauge => CharacterEffectTargetType.SessionGauge,
                TestConsequenceTargetKind.Attribute => CharacterEffectTargetType.BaseAttribute,
                TestConsequenceTargetKind.DerivedStat => CharacterEffectTargetType.DerivedStat,
                TestConsequenceTargetKind.Metric => CharacterEffectTargetType.Metric,
                TestConsequenceTargetKind.Talent => CharacterEffectTargetType.Talent,
                TestConsequenceTargetKind.Item => CharacterEffectTargetType.Item,
                _ => CharacterEffectTargetType.BaseAttribute
            },
            TargetId = row.TargetDefinitionId,
            Value = row.OperationType == TestConsequenceOperationType.AddValue
                ? (row.ValueMode == ModifierValueMode.Metric
                    ? (row.ModifierMode == TestModifierMode.Bonus ? 1 : -1)
                    : row.Value)
                : 0,
            ClampMode = row.ClampMode,
            ClampMinTotal = row.ClampMinTotal,
            ClampMaxTotal = row.ClampMaxTotal,
            ValueMode = row.OperationType == TestConsequenceOperationType.AddValue &&
            row.TargetKind != TestConsequenceTargetKind.SessionGauge
                ? row.ValueMode
                : ModifierValueMode.Fixed,
            SourceMetricId = row.OperationType == TestConsequenceOperationType.AddValue &&
                 row.TargetKind != TestConsequenceTargetKind.SessionGauge &&
                 row.ValueMode == ModifierValueMode.Metric
            ? row.SourceMetricId
            : null
        }).ToList();
    }

    private void AddValueFilter()
    {
        var firstAttribute = Editor?.BaseAttributes.FirstOrDefault();

        Request.Filter.ValueFilters.Add(new CharacterValueFilterDto
        {
            TargetType = CharacterEffectTargetType.BaseAttribute,
            TargetId = firstAttribute?.Id ?? Guid.Empty,
            ComparisonType = CharacterValueComparisonType.GreaterThanOrEqual,
            Value = 0
        });
    }

    private async Task PreviewTargets()
    {
        try
        {
            Message = string.Empty;
            HasAppliedDistribution = false;
            SyncRequestEffectsFromRows();
            NormalizeAudienceFilter();
            PreviewCharacters = await MassDistributionService.PreviewTargetsAsync(SessionId, CurrentUserId, Request);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task ApplyDistribution()
    {
        try
        {
            Message = string.Empty;
            SyncRequestEffectsFromRows();

            NormalizeAudienceFilter();
            var count = await MassDistributionService.ApplyAsync(SessionId, CurrentUserId, Request);

            HasAppliedDistribution = true;
            PreviewCharacters = await MassDistributionService.PreviewTargetsAsync(SessionId, CurrentUserId, Request);
            LastBatch = await MassDistributionService.GetLastBatchAsync(SessionId, CurrentUserId);

            await LoadCharacterSummariesAsync();

            Message = $"{L["MassDistribution_ApplySuccess"]} : {count}";
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task UndoLastDistribution()
    {
        try
        {
            Message = string.Empty;

            var batchName = await MassDistributionService.UndoLastAsync(SessionId, CurrentUserId);

            LastBatch = await MassDistributionService.GetLastBatchAsync(SessionId, CurrentUserId);
            PreviewCharacters.Clear();
            HasAppliedDistribution = false;

            await LoadCharacterSummariesAsync();

            Message = $"{L["MassDistribution_UndoSuccess"]} : {batchName}";
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task LoadCharacterSummariesAsync()
    {
        var characters = await CharacterService.GetSessionCharacterSummariesAsync(
            SessionId,
            includeOffline: false,
            includeDead: false,
            includeNpcs: false);

        CharacterSummariesById = characters.ToDictionary(x => x.CharacterId, x => x);
    }

    private void NormalizeAudienceFilter()
    {
        Request.Filter.OnlyDead = false;
        Request.Filter.OnlyAlive = true;

        if (Request.Filter.OnlyOnline)
        {
            Request.Filter.OnlyAlive = true;
        }
    }

    private async Task LoadAdvancedPollOptionsAsync()
    {
        AdvancedPollOptions.Clear();

        var polls = await PollService.GetRecentPollsForGameMasterAsync(SessionId, 20);

        AdvancedPollOptions = polls
            .Select(x => new CharacterFilterReferenceItem
            {
                Id = x.PollId,
                Name = x.Question
            })
            .ToList();

        await RefreshSelectedPollOptionOptionsAsync();
    }

    private async Task RefreshSelectedPollOptionOptionsAsync()
    {
        AdvancedSelectedPollOptionOptions.Clear();

        if (!Request.Filter.PollId.HasValue)
            return;

        var poll = await PollService.GetPollByIdForGameMasterAsync(SessionId, Request.Filter.PollId.Value);
        if (poll is null)
            return;

        AdvancedSelectedPollOptionOptions = poll.Options
            .Select(x => new CharacterFilterReferenceItem
            {
                Id = x.OptionId,
                Name = x.Label
            })
            .ToList();
    }

    private async Task LoadAdvancedRandomDrawOptionsAsync()
    {
        AdvancedRandomDrawOptions.Clear();

        var editor = await CharacterService.GetRandomDrawEditorAsync(SessionId, CurrentUserId);
        if (editor is null)
            return;

        AdvancedRandomDrawOptions = editor.RecentDraws
            .Select(x => new CharacterFilterReferenceItem
            {
                Id = x.DrawId,
                Name = x.Name
            })
            .ToList();
    }

    private async Task LoadAdvancedNameSuggestionsAsync()
    {
        AdvancedNameSuggestions.Clear();

        var summaries = await CharacterService.GetSessionCharacterSummariesAsync(
            SessionId,
            includeOffline: true,
            includeDead: true,
            includeNpcs: true);

        AdvancedNameSuggestions = summaries
            .Where(x => !string.IsNullOrWhiteSpace(x.CharacterName) || !string.IsNullOrWhiteSpace(x.PlayerName))
            .Select(x => new CharacterNameSuggestionItem
            {
                CharacterId = x.CharacterId,
                CharacterName = x.CharacterName ?? string.Empty,
                PlayerName = x.PlayerName ?? string.Empty
            })
            .OrderBy(x => x.CharacterName)
            .ThenBy(x => x.PlayerName)
            .ToList();
    }
}