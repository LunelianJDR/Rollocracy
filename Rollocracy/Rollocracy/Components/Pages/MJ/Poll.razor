@page "/mj/session/{SessionId:guid}/poll"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Entities
@using Rollocracy.Domain.Characters
@using Rollocracy.Domain.GameRules
@using Rollocracy.Domain.GameTests
@using Rollocracy.Domain.Polls
@using Rollocracy.Localization
@using Rollocracy.Components.Pages.MJ.Shared
@using DomainSession = Rollocracy.Domain.Entities.Session
@using System.Globalization

@inject NavigationManager Navigation
@inject Rollocracy.Domain.Interfaces.ISessionService SessionService
@inject Rollocracy.Domain.Interfaces.IGameSystemService GameSystemService
@inject Rollocracy.Domain.Interfaces.IPollService PollService
@inject Rollocracy.Domain.Interfaces.ICharacterService CharacterService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedTexts> L


@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToHome)
{
    <p>@L["Common_Loading"]</p>
}
else if (CurrentSession is null)
{
    <p>@L["Session_NotFound"]</p>
}
else
{
    <section class="rc-tool-section">
        <div class="rc-tool-layout">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h5 class="rc-tool-panel__title">@L["Poll_Title"]</h5>
                        @* <p class="rc-tool-panel__subtitle">@L["Poll_Question"] / @L["Poll_Options"] / @L["Poll_OptionConsequences"]</p> *@
                    </div>

                    @if (LatestPoll is null || LatestPoll.IsClosed)
                    {
                        <div class="rc-tool-inline-actions">
                            <button type="button" @onclick="ShowSavePollPreset">@L["Poll_SavePreset"]</button>

                            @if (PollPresets.Count > 0)
                            {
                                <select @bind="SelectedPollPresetId" @bind:after="ApplySelectedPollPreset">
                                    <option value="">@L["Poll_SelectPreset"]</option>
                                    @foreach (var preset in PollPresets)
                                    {
                                        <option value="@preset.PresetId">@preset.Name</option>
                                    }
                                </select>

                                @if (SelectedPollPresetId.HasValue)
                                {
                                    @if (!ConfirmDeletePollPresetVisible)
                                    {
                                        <button type="button" @onclick="ShowDeletePollPresetConfirmation">
                                            @L["Poll_DeletePreset"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="DeleteSelectedPollPresetConfirmed">@L["Common_Yes"]</button>
                                        <button type="button" @onclick="CancelDeletePollPreset">@L["Common_No"]</button>
                                    }
                                }
                            }

                            <button @onclick="CreatePoll">@L["Poll_Create"]</button>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="rc-inline-error">@Message</div>
                }

                @if (ShowSavePollPresetPanel)
                {
                    <div class="rc-filter-group-card">
                        <div class="rc-form-field">
                            <label>@L["Poll_PresetName"]</label>
                            <input @bind="NewPollPresetName" />
                        </div>

                        @if (ConfirmOverwritePollPresetVisible)
                        {
                            <div class="rc-inline-warning">@L["Poll_PresetOverwriteConfirm"]</div>
                        }

                        <div class="rc-tool-inline-actions">
                            @if (!ConfirmOverwritePollPresetVisible)
                            {
                                <button type="button" @onclick="SavePollPresetConfirmed">@L["Common_Yes"]</button>
                                <button type="button" @onclick="CancelSavePollPreset">@L["Common_No"]</button>
                            }
                            else
                            {
                                <button type="button" @onclick="OverwritePollPresetConfirmed">@L["Common_Yes"]</button>
                                <button type="button" @onclick="CancelOverwritePollPreset">@L["Common_No"]</button>
                            }
                        </div>
                    </div>
                }

                @if (RecentPolls.Count > 0)
                {
                    <div class="rc-form-field">
                        <label>@L["Poll_History"]</label>
                        <select @bind="SelectedPollHistoryId" @bind:after="LoadPollHistory">
                            <option value="">@L["Poll_CurrentOrLatest"]</option>
                            @foreach (var poll in RecentPolls)
                            {
                                <option value="@poll.PollId">@poll.Question</option>
                            }
                        </select>
                    </div>
                }

                @if (LatestPoll is null || LatestPoll.IsClosed)
                {
                    <div class="rc-tool-form-grid">
                        <div class="rc-form-field rc-form-field--full">
                            <label>@L["Poll_Question"]</label>
                            <input @bind="NewPollQuestion" />
                        </div>
                    </div>

                    <CharacterAdvancedFilters Filter="AdvancedFilter"
                                              TraitOptionGroups="TraitOptionGroups"
                                              TalentOptions="TalentFilterOptions"
                                              ItemOptions="ItemFilterOptions"
                                              AttributeTargets="AttributeTargets"
                                              GaugeTargets="GaugeTargets"
                                              DerivedStatTargets="DerivedStatTargets"
                                              MetricTargets="MetricTargets"
                                              PollOptions="AdvancedPollOptions"
                                              SelectedPollOptionOptions="AdvancedSelectedPollOptionOptions"
                                              RandomDrawOptions="AdvancedRandomDrawOptions"
                                              NameSuggestions="AdvancedNameSuggestions"
                                              OnPollSelectionChanged="RefreshSelectedPollOptionOptionsAsync" />

                    <div class="rc-tool-subsection">
                        <div class="rc-tool-subsection__header">
                            <div class="rc-tool-subsection__title">@L["Poll_Options"]</div>
                            <div class="rc-tool-inline-actions">
                                <button @onclick="AddPollOption">@L["Poll_AddOption"]</button>
                            </div>
                        </div>

                        @for (var i = 0; i < NewPollOptions.Count; i++)
                        {
                            var optionIndex = i;
                            var optionRow = NewPollOptions[optionIndex];

                            <div class="rc-consequence-card">
                                <div class="rc-tool-subsection__header">
                                    <div class="rc-tool-subsection__title">@($"{L["Poll_OptionLabel"]} {optionIndex + 1}")</div>

                                    <div class="rc-tool-inline-actions">
                                        @if (NewPollOptions.Count > 2)
                                        {
                                            <button @onclick="() => RemovePollOption(optionIndex)">
                                                @L["Common_Remove"]
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="rc-form-field">
                                    <input @bind="NewPollOptions[optionIndex].Label" placeholder="@L["Poll_OptionLabel"]" />
                                </div>

                                <Consequences Title="@L["Poll_OptionConsequences"]"
                                              AddButtonLabel="@L["Poll_AddOptionConsequence"]"
                                              EmptyLabel="@L["Test_NoConsequence"]"
                                              ShowApplyOn="false"
                                              IsPollContext="true"
                                              ShowApplicationMode="false"
                                              AllowSuccessFailureApplicationModes="false"
                                              Rows="optionRow.Consequences"
                                              ApplyOnOptions="ConsequenceApplyOnOptions"
                                              AttributeTargets="ConsequenceAttributeTargets"
                                              GaugeTargets="ConsequenceGaugeTargets"
                                              SessionGaugeTargets="ConsequenceSessionGaugeTargets"
                                              DerivedStatTargets="ConsequenceDerivedStatTargets"
                                              MetricTargets="ConsequenceMetricTargets"
                                              TalentTargets="ConsequenceTalentTargets"
                                              ItemTargets="ConsequenceItemTargets"
                                              AllowSessionGaugeTarget="true"
                                              PreferredAddValueTargetKind="@(AvailableGaugeDefinitions.Count > 0 ? TestConsequenceTargetKind.Gauge : TestConsequenceTargetKind.Attribute)" />
                            </div>
                        }
                    </div>

                    <div class="rc-tool-actions rc-tool-actions--right">
                        <button @onclick="CreatePoll">@L["Poll_Create"]</button>
                    </div>
                }
                else
                {
                    <div class="rc-empty-panel">
                        <p>@L["Poll_CurrentOrLatest"]</p>
                    </div>
                }
            </div>

            <div class="rc-tool-panel">
                @if (LatestPoll is null)
                {
                    <div class="rc-empty-panel">
                        <p>@L["Poll_CurrentOrLatest"]</p>
                    </div>
                }
                else
                {
                    <div class="rc-tool-panel__header">
                        <div>
                            <h5 class="rc-tool-panel__title">@LatestPoll.Question</h5>
                            <p class="rc-tool-panel__subtitle">
                                @L["Poll_TotalVotes"] : @LatestPoll.TotalVotes
                                ·
                                @L["Poll_TotalWeightedVotes"] : @LatestPoll.TotalWeightedVotes.ToString("F2")
                            </p>
                        </div>

                        <div class="rc-tool-inline-actions">
                            @if (LatestPoll.IsClosed)
                            {
                                @if (CanUndoLatestPollConsequences)
                                {
                                    @if (!ConfirmUndoPollConsequencesVisible)
                                    {
                                        <button @onclick="ShowUndoPollConsequencesConfirmation">@L["Poll_UndoConsequences"]</button>
                                    }
                                    else
                                    {
                                        <button @onclick="UndoLatestPollConsequencesConfirmed">@L["Common_Yes"]</button>
                                        <button @onclick="CancelUndoPollConsequences">@L["Common_No"]</button>
                                    }
                                }
                            }
                            else
                            {
                                <button @onclick="ClosePoll">@L["Poll_Close"]</button>
                                <button @onclick="ToggleLivePollResults">
                                    @(ShowLivePollResults ? L["Poll_HideLiveResults"] : L["Poll_ShowLiveResults"])
                                </button>
                            }
                        </div>
                    </div>

                    @if (ConfirmUndoPollConsequencesVisible)
                    {
                        <div class="rc-inline-warning">@L["Poll_UndoConsequencesConfirmQuestion"]</div>
                    }

                    <div class="rc-test-stats-grid">
                        <div class="rc-stat-card">
                            <div class="rc-stat-card__label">@L["Poll_TotalVotes"]</div>
                            <div class="rc-stat-card__value">@LatestPoll.TotalVotes</div>
                        </div>

                        <div class="rc-stat-card">
                            <div class="rc-stat-card__label">@L["Poll_TotalWeightedVotes"]</div>
                            <div class="rc-stat-card__value">@LatestPoll.TotalWeightedVotes.ToString("F1")</div>
                        </div>

                        <div class="rc-stat-card">
                            <div class="rc-stat-card__label">@L["Poll_Participation"]</div>
                            <div class="rc-stat-card__value">@($"{LatestPoll.ParticipationPercent:F1}%")</div>
                        </div>

                        <div class="rc-stat-card">
                            <div class="rc-stat-card__label">@L["Poll_VoteWeightMode"]</div>
                            <div class="rc-stat-card__value rc-stat-card__value--small">
                                @(LatestPoll.VoteWeightMode == PollVoteWeightMode.Metric
                                    ? $"{L["Poll_VoteWeightModeMetric"]} - {LatestPoll.MetricName}"
                                    : L["Poll_VoteWeightModeFixedOne"])
                            </div>
                        </div>
                    </div>

                    @if (LatestPoll.IsClosed || ShowLivePollResults)
                    {
                        <div class="rc-tool-subsection">
                            <div class="rc-tool-subsection__title">@L["Poll_Options"]</div>

                            <div class="rc-test-result-grid">
                                @foreach (var option in LatestPoll.Options)
                                {
                                    var isLeadingOption = Math.Abs(option.WeightedVotePercent - HighestWeightedVotePercent) < 0.0001d;

                                    <div class="rc-test-result-card @(isLeadingOption ? "rc-poll-option-card--winner" : string.Empty)">
                                        <div class="rc-test-result-card__header">
                                            <div class="rc-test-result-card__title">@option.Label</div>
                                        </div>

                                        <div class="rc-test-result-card__body">
                                            <div class="rc-test-result-line">
                                                <span>@L["Poll_TotalVotes"]</span>
                                                <strong>@option.VoteCount</strong>
                                            </div>

                                            <div class="rc-poll-option-progress">
                                                <div class="rc-poll-option-progress__label">
                                                    <span>@L["Poll_WeightedPercent"]</span>
                                                    <strong>@($"{option.WeightedVotePercent:F1}%")</strong>
                                                </div>

                                                <div class="rc-poll-option-progress__track">
                                                    <div class="rc-poll-option-progress__fill @(isLeadingOption ? "winner" : string.Empty)"
                                                         style="@($"width:{GetWeightedPercentWidth(option.WeightedVotePercent)};")">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (LatestPoll.Votes.Count > 0)
                    {
                        <div class="rc-tool-subsection">
                            <div class="rc-tool-subsection__header">
                                <div class="rc-tool-subsection__title">@L["Poll_VoteDetails"]</div>
                                <div class="rc-tool-inline-actions">
                                    <button @onclick="TogglePollVoteDetails">
                                        @(ShowPollVoteDetails ? L["Poll_HideVoteDetails"] : L["Poll_ShowVoteDetails"])
                                    </button>
                                </div>
                            </div>

                            @if (ShowPollVoteDetails)
                            {
                                @foreach (var option in LatestPoll.Options)
                                {
                                    var votesForOption = LatestPoll.Votes
                                        .Where(v => v.OptionId == option.OptionId)
                                        .ToList();

                                    <div class="rc-poll-vote-group">
                                        <div class="rc-poll-vote-group__title">@option.Label</div>

                                        @if (votesForOption.Count == 0)
                                        {
                                            <p class="rc-tool-muted">@L["Session_Manage_NoCharactersToDisplay"]</p>
                                        }
                                        else
                                        {
                                            <div class="rc-test-result-grid">
                                                @foreach (var voteLine in votesForOption)
                                                {
                                                    if (CharacterSummariesById.TryGetValue(voteLine.CharacterId, out var summary))
                                                    {
                                                        <CharacterResultSummaryCard Character="summary">
                                                            <HeaderContent>
                                                                <div class="rc-poll-vote-card__weight">@voteLine.VoteWeight.ToString("F2")</div>
                                                            </HeaderContent>
                                                        </CharacterResultSummaryCard>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }

                    @if (LatestPoll.Consequences.Count > 0)
                    {
                        <div class="rc-tool-subsection">
                            <div class="rc-tool-subsection__title">@L["Poll_OptionConsequences"]</div>

                            <div class="rc-consequence-list">
                                @foreach (var consequence in LatestPoll.Consequences)
                                {
                                    <div class="rc-consequence-card">
                                        <div class="rc-test-result-line">
                                            <span>@consequence.OptionLabel</span>
                                            <strong>@consequence.TargetName</strong>
                                        </div>

                                        <div class="rc-test-result-line">
                                            <span>@L["Poll_ConsequenceOperation"]</span>
                                            <strong>@GetPollConsequenceOperationLabel(consequence.OperationType)</strong>
                                        </div>

                                        @if (consequence.OperationType == TestConsequenceOperationType.AddValue)
                                        {
                                            <div class="rc-test-result-line">
                                                <span>@L["Test_DifficultyValue"]</span>
                                                <strong class="@(consequence.Value >= 0 ? "rc-consequence-text--positive" : "rc-consequence-text--negative")">
                                                    @if (consequence.ValueMode == ModifierValueMode.Metric)
                                                    {
                                                        @($"{L["Common_SourceMetric"]} : {consequence.SourceMetricName}")
                                                    }
                                                    else if (consequence.ValueMode == ModifierValueMode.RandomDice)
                                                    {
                                                        @($"{(consequence.ModifierMode == TestModifierMode.Bonus ? "+" : "-")}{Math.Clamp(consequence.RandomDiceCount <= 0 ? 1 : consequence.RandomDiceCount, 1, 5)}d{Math.Clamp(consequence.RandomDiceSides <= 0 ? 6 : consequence.RandomDiceSides, 2, 100)}")
                                                    }
                                                    else
                                                    {
                                                        @($"{(consequence.Value >= 0 ? "+" : string.Empty)}{consequence.Value}")
                                                    }
                                                </strong>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public Guid SessionId { get; set; }

    private HubConnection? hubConnection;

    private DomainSession? CurrentSession;
    private GameSystem? AssignedGameSystem;

    private List<AttributeDefinition> AvailableAttributes = new();
    private List<TraitDefinition> AvailableTraitDefinitions = new();
    private List<GaugeDefinition> AvailableGaugeDefinitions = new();
    private List<MetricDefinition> AvailableMetrics = new();
    private List<EditableDerivedStatDefinitionDto> AvailableDerivedStats = new();
    private List<EditableTalentDefinitionDto> AvailableTalents = new();
    private List<EditableItemDefinitionDto> AvailableItems = new();
    private List<SessionGaugeDto> SessionGauges = new();
    private Dictionary<Guid, SessionCharacterSummaryDto> CharacterSummariesById = new();

    private PollForGameMasterDto? LatestPoll;
    private List<PollForGameMasterDto> RecentPolls = new();

    private List<SessionPollPresetDto> PollPresets = new();
    private Guid? SelectedPollPresetId;
    private string NewPollPresetName = string.Empty;

    private bool ShowSavePollPresetPanel;
    private bool ConfirmOverwritePollPresetVisible;
    private bool ConfirmDeletePollPresetVisible;

    private Guid CurrentUserId;
    private bool IsLoaded;
    private bool RedirectToHome;
    private string Message = string.Empty;

    private string NewPollQuestion = string.Empty;
    private Guid? VoteWeightMetricId;
    private string VoteWeightMetricDisplayName = string.Empty;
    private Guid? SelectedPollHistoryId;

    private CharacterTargetFilterDto AdvancedFilter = new()
    {
        MatchAllConditions = true
    };

    private List<CharacterFilterGroupItem> TraitOptionGroups = new();
    private List<CharacterFilterReferenceItem> TalentFilterOptions = new();
    private List<CharacterFilterReferenceItem> ItemFilterOptions = new();
    private List<CharacterFilterReferenceItem> AttributeTargets = new();
    private List<CharacterFilterReferenceItem> GaugeTargets = new();
    private List<CharacterFilterReferenceItem> DerivedStatTargets = new();
    private List<CharacterFilterReferenceItem> MetricTargets = new();
    private List<CharacterFilterReferenceItem> AdvancedPollOptions = new();
    private List<CharacterFilterReferenceItem> AdvancedSelectedPollOptionOptions = new();
    private List<CharacterFilterReferenceItem> AdvancedRandomDrawOptions = new();
    private List<CharacterNameSuggestionItem> AdvancedNameSuggestions = new();

    private bool ShowLivePollResults;
    private bool ShowPollVoteDetails;
    private bool ConfirmUndoPollConsequencesVisible;

    private List<PollOptionRowModel> NewPollOptions = new()
    {
        new(),
        new()
    };
    private List<SharedConsequenceApplyOnOption> ConsequenceApplyOnOptions => new();

    private List<SharedConsequenceDefinitionOption> ConsequenceAttributeTargets
        => AvailableAttributes.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList();

    private List<SharedConsequenceDefinitionOption> ConsequenceGaugeTargets
        => AvailableGaugeDefinitions.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList();

    private List<SharedConsequenceDefinitionOption> ConsequenceSessionGaugeTargets
        => SessionGauges.Select(x => new SharedConsequenceDefinitionOption { Id = x.SessionGaugeId, Name = x.Name }).ToList();

    private List<SharedConsequenceDefinitionOption> ConsequenceMetricTargets
        => AvailableMetrics.Select(x => new SharedConsequenceDefinitionOption { Id = x.Id, Name = x.Name }).ToList();

    private List<SharedConsequenceDefinitionOption> ConsequenceDerivedStatTargets
    => AvailableDerivedStats
        .Where(x => x.DerivedStatDefinitionId.HasValue)
        .Select(x => new SharedConsequenceDefinitionOption
        {
            Id = x.DerivedStatDefinitionId!.Value,
            Name = x.Name
        })
        .ToList();

    private List<SharedConsequenceDefinitionOption> ConsequenceTalentTargets
        => AvailableTalents
            .Where(x => x.TalentDefinitionId.HasValue)
            .Select(x => new SharedConsequenceDefinitionOption
            {
                Id = x.TalentDefinitionId!.Value,
                Name = x.Name
            })
            .ToList();

    private List<SharedConsequenceDefinitionOption> ConsequenceItemTargets
        => AvailableItems
            .Where(x => x.ItemDefinitionId.HasValue)
            .Select(x => new SharedConsequenceDefinitionOption
            {
                Id = x.ItemDefinitionId!.Value,
                Name = x.Name
            })
            .ToList();


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);

        await LoadPageData();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/sessionhub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("PollChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadLatestPoll();
                StateHasChanged();
            });
        });

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("JoinSessionGroup", SessionId.ToString());

        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToHome)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadPageData()
    {
        CurrentSession = await SessionService.GetSessionByIdAsync(SessionId);

        if (CurrentSession?.GameSystemId is Guid gameSystemId)
        {
            AssignedGameSystem = await GameSystemService.GetGameSystemByIdAsync(gameSystemId, CurrentUserId);

            if (AssignedGameSystem is not null)
            {
                AvailableAttributes = await GameSystemService.GetAttributeDefinitionsAsync(AssignedGameSystem.Id, CurrentUserId);
                AvailableTraitDefinitions = await GameSystemService.GetTraitDefinitionsAsync(AssignedGameSystem.Id, CurrentUserId);
                AvailableGaugeDefinitions = await GameSystemService.GetGaugeDefinitionsAsync(AssignedGameSystem.Id, CurrentUserId);
                AvailableMetrics = await GameSystemService.GetMetricDefinitionsAsync(AssignedGameSystem.Id, CurrentUserId);

                var voteWeightMetric = AvailableMetrics.FirstOrDefault(x =>
                    string.Equals(x.Name, L["SystemMetric_VoteWeight"], StringComparison.CurrentCultureIgnoreCase));
                VoteWeightMetricId = voteWeightMetric?.Id;
                VoteWeightMetricDisplayName = voteWeightMetric?.Name ?? L["SystemMetric_VoteWeight"];

                var editor = await GameSystemService.GetGameSystemEditorAsync(AssignedGameSystem.Id, CurrentUserId);
                if (editor is not null)
                {
                    AvailableDerivedStats = editor.DerivedStats;
                    AvailableTalents = editor.Talents;
                    AvailableItems = editor.Items;
                }

                var sessionItems = await SessionService.GetSessionItemDefinitionsAsync(SessionId, CurrentUserId);
                AvailableItems = AvailableItems
                    .Concat(sessionItems)
                    .OrderBy(x => x.DisplayOrder)
                    .ThenBy(x => x.Name)
                    .ToList();

                TraitOptionGroups.Clear();

                foreach (var definition in AvailableTraitDefinitions)
                {
                    var options = await GameSystemService.GetTraitOptionsAsync(definition.Id, CurrentUserId);

                    var optionItems = options
                        .Select(option => new CharacterFilterReferenceItem
                        {
                            Id = option.Id,
                            Name = option.Name
                        })
                        .ToList();

                    if (optionItems.Count > 0)
                    {
                        TraitOptionGroups.Add(new CharacterFilterGroupItem
                        {
                            GroupName = definition.Name,
                            Options = optionItems
                        });
                    }
                }

                TalentFilterOptions = AvailableTalents
                    .Where(x => x.TalentDefinitionId.HasValue)
                    .Select(x => new CharacterFilterReferenceItem
                    {
                        Id = x.TalentDefinitionId!.Value,
                        Name = x.Name
                    })
                    .ToList();

                ItemFilterOptions = AvailableItems
                    .Where(x => x.ItemDefinitionId.HasValue)
                    .Select(x => new CharacterFilterReferenceItem
                    {
                        Id = x.ItemDefinitionId!.Value,
                        Name = x.Name
                    })
                    .ToList();

                AttributeTargets = AvailableAttributes
                    .Select(x => new CharacterFilterReferenceItem
                    {
                        Id = x.Id,
                        Name = x.Name
                    })
                    .ToList();

                GaugeTargets = AvailableGaugeDefinitions
                    .Select(x => new CharacterFilterReferenceItem
                    {
                        Id = x.Id,
                        Name = x.Name
                    })
                    .ToList();

                DerivedStatTargets = AvailableDerivedStats
                    .Where(x => x.DerivedStatDefinitionId.HasValue)
                    .Select(x => new CharacterFilterReferenceItem
                    {
                        Id = x.DerivedStatDefinitionId!.Value,
                        Name = x.Name
                    })
                    .ToList();

                MetricTargets = AvailableMetrics
                    .Select(x => new CharacterFilterReferenceItem
                    {
                        Id = x.Id,
                        Name = x.Name
                    })
                    .ToList();
            }
        }

        SessionGauges = await SessionService.GetSessionGaugesAsync(SessionId, CurrentUserId);
        PollPresets = await PollService.GetSessionPresetsAsync(SessionId, CurrentUserId);
        await LoadCharacterSummariesAsync();
        await LoadLatestPoll();
        await LoadAdvancedPollOptionsAsync();
        await LoadAdvancedRandomDrawOptionsAsync();
        await LoadAdvancedNameSuggestionsAsync();
    }

    private async Task LoadLatestPoll()
    {
        LatestPoll = await PollService.GetLatestPollForGameMasterAsync(SessionId);
        RecentPolls = await PollService.GetRecentPollsForGameMasterAsync(SessionId, 5);
        ConfirmUndoPollConsequencesVisible = false;
        await LoadAdvancedPollOptionsAsync();
    }

    private Task AddPollOption()
    {
        NewPollOptions.Add(new PollOptionRowModel());
        return Task.CompletedTask;
    }

    private Task RemovePollOption(int index)
    {
        if (index >= 0 && index < NewPollOptions.Count && NewPollOptions.Count > 2)
        {
            NewPollOptions.RemoveAt(index);
        }

        return Task.CompletedTask;
    }

    private Task AddPollOptionConsequence(int optionIndex)
    {
        if (optionIndex < 0 || optionIndex >= NewPollOptions.Count)
            return Task.CompletedTask;

        var targetKind = AvailableGaugeDefinitions.Count > 0
            ? TestConsequenceTargetKind.Gauge
            : TestConsequenceTargetKind.Attribute;

        NewPollOptions[optionIndex].Consequences.Add(new SharedConsequenceRowModel
        {
            RowId = Guid.NewGuid(),
            OperationType = TestConsequenceOperationType.AddValue,
            TargetKind = targetKind,
            TargetDefinitionId = GetFirstConsequenceTargetId(targetKind),
            ModifierMode = TestModifierMode.Bonus,
            Value = 1,
            ClampMode = ConsequenceClampMode.None,
            ClampMinTotal = -100,
            ClampMaxTotal = 100,
            ValueMode = ModifierValueMode.Fixed,
            SourceMetricId = AvailableMetrics.FirstOrDefault()?.Id,
            RandomDiceCount = 1,
            RandomDiceSides = 6
        });

        return Task.CompletedTask;
    }

    private void OnPollConsequenceOperationChanged(SharedConsequenceRowModel consequence)
    {
        switch (consequence.OperationType)
        {
            case TestConsequenceOperationType.AddValue:
                consequence.TargetKind = AvailableGaugeDefinitions.Count > 0
                    ? TestConsequenceTargetKind.Gauge
                    : TestConsequenceTargetKind.Attribute;
                consequence.TargetDefinitionId = GetFirstConsequenceTargetId(consequence.TargetKind);
                consequence.ModifierMode = TestModifierMode.Bonus;

                if (consequence.Value == 0)
                    consequence.Value = 1;
                break;

            case TestConsequenceOperationType.GrantTalent:
                consequence.ModifierMode = TestModifierMode.Bonus;
                break;
            case TestConsequenceOperationType.RevokeTalent:
                consequence.TargetKind = TestConsequenceTargetKind.Talent;
                consequence.TargetDefinitionId = GetFirstConsequenceTargetId(consequence.TargetKind);
                consequence.Value = 0;
                consequence.ValueMode = ModifierValueMode.Fixed;
                consequence.SourceMetricId = AvailableMetrics.FirstOrDefault()?.Id;
                consequence.ModifierMode = TestModifierMode.Bonus;
                break;

            case TestConsequenceOperationType.GrantItem:
                consequence.ModifierMode = TestModifierMode.Bonus;
                break;
            case TestConsequenceOperationType.RevokeItem:
                consequence.TargetKind = TestConsequenceTargetKind.Item;
                consequence.TargetDefinitionId = GetFirstConsequenceTargetId(consequence.TargetKind);
                consequence.Value = 0;
                consequence.ValueMode = ModifierValueMode.Fixed;
                consequence.SourceMetricId = AvailableMetrics.FirstOrDefault()?.Id;
                consequence.ModifierMode = TestModifierMode.Bonus;
                break;
        }
    }

    private void OnPollConsequenceTargetKindChanged(SharedConsequenceRowModel consequence)
    {
        consequence.TargetDefinitionId = GetFirstConsequenceTargetId(consequence.TargetKind);
    }

    private Guid GetFirstConsequenceTargetId(TestConsequenceTargetKind targetKind)
    {
        return targetKind switch
        {
            TestConsequenceTargetKind.Gauge => AvailableGaugeDefinitions.FirstOrDefault()?.Id ?? Guid.Empty,
            TestConsequenceTargetKind.SessionGauge => SessionGauges.FirstOrDefault()?.SessionGaugeId ?? Guid.Empty,
            TestConsequenceTargetKind.Attribute => AvailableAttributes.FirstOrDefault()?.Id ?? Guid.Empty,
            TestConsequenceTargetKind.DerivedStat => AvailableDerivedStats.FirstOrDefault()?.DerivedStatDefinitionId ?? Guid.Empty,
            TestConsequenceTargetKind.Metric => AvailableMetrics.FirstOrDefault()?.Id ?? Guid.Empty,
            TestConsequenceTargetKind.Talent => AvailableTalents.FirstOrDefault()?.TalentDefinitionId ?? Guid.Empty,
            TestConsequenceTargetKind.Item => AvailableItems.FirstOrDefault()?.ItemDefinitionId ?? Guid.Empty,
            _ => Guid.Empty
        };
    }

    private async Task CreatePoll()
    {
        try
        {
            Message = string.Empty;

            if (!VoteWeightMetricId.HasValue)
            {
                Message = L["Poll_VoteWeightMetricMissing"];
                return;
            }

            var request = new PollCreateRequestDto
            {
                Question = NewPollQuestion,
                Options = NewPollOptions.Select(o => new PollOptionDraftDto
                {
                    Label = o.Label,
                    Consequences = o.Consequences
                        .Where(consequence => consequence.TargetDefinitionId != Guid.Empty)
                        .Where(consequence => consequence.OperationType != TestConsequenceOperationType.AddValue
                            || consequence.ValueMode != ModifierValueMode.Metric
                            || consequence.SourceMetricId.HasValue)
                        .Select(consequence => new PollOptionConsequenceInlineDraftDto
                        {
                            TargetKind = consequence.TargetKind,
                            TargetDefinitionId = consequence.TargetDefinitionId,
                            ApplicationMode = consequence.ApplicationMode,
                            ModifierMode = consequence.ValueMode == ModifierValueMode.Metric || consequence.ValueMode == ModifierValueMode.RandomDice
                                ? consequence.ModifierMode
                                : TestModifierMode.Bonus,
                            Value = consequence.ValueMode == ModifierValueMode.Metric || consequence.ValueMode == ModifierValueMode.RandomDice ? 0 : consequence.Value,
                            ClampMode = consequence.ClampMode,
                            ClampMinTotal = consequence.ClampMinTotal,
                            ClampMaxTotal = consequence.ClampMaxTotal,
                            ValueMode = consequence.ValueMode,
                            SourceMetricId = consequence.ValueMode == ModifierValueMode.Metric
                                ? consequence.SourceMetricId
                                : null,
                            RandomDiceCount = consequence.ValueMode == ModifierValueMode.RandomDice ? Math.Clamp(consequence.RandomDiceCount <= 0 ? 1 : consequence.RandomDiceCount, 1, 5) : 1,
                            RandomDiceSides = consequence.ValueMode == ModifierValueMode.RandomDice ? Math.Clamp(consequence.RandomDiceSides <= 0 ? 6 : consequence.RandomDiceSides, 2, 100) : 6,
                            OperationType = consequence.OperationType
                        })
                    .ToList()
                }).ToList(),
                VoteWeightMode = PollVoteWeightMode.Metric,
                MetricDefinitionId = VoteWeightMetricId,
                AdvancedFilter = new CharacterTargetFilterDto
                {
                    OnlyAlive = true,
                    OnlyDead = false,
                    OnlyOnline = false,
                    IncludeNpcs = false,
                    MatchAllConditions = AdvancedFilter.MatchAllConditions,
                    TraitOptionIds = AdvancedFilter.TraitOptionIds.ToList(),
                    TalentIds = AdvancedFilter.TalentIds.ToList(),
                    ItemIds = AdvancedFilter.ItemIds.ToList(),
                    PollId = AdvancedFilter.PollId,
                    PollSelectedOptionId = AdvancedFilter.PollSelectedOptionId,
                    FilterOnPollResponse = AdvancedFilter.FilterOnPollResponse,
                    MustHaveSucceededLastTest = AdvancedFilter.MustHaveSucceededLastTest,
                    FilterOnLastTestResult = AdvancedFilter.FilterOnLastTestResult,
                    NameCharacterIds = AdvancedFilter.NameCharacterIds.ToList(),
                    RandomDrawIds = AdvancedFilter.RandomDrawIds.ToList(),
                    ValueFilters = AdvancedFilter.ValueFilters
            .Select(x => new CharacterValueFilterDto
            {
                TargetType = x.TargetType,
                TargetId = x.TargetId,
                TargetName = x.TargetName,
                ComparisonType = x.ComparisonType,
                Value = x.Value
            })
            .ToList()
                }
            };

            LatestPoll = await PollService.CreatePollAsync(SessionId, CurrentUserId, request);

            NewPollQuestion = string.Empty;
            NewPollOptions = new List<PollOptionRowModel> { new(), new() };
            SelectedPollHistoryId = null;
            ShowLivePollResults = false;
            ShowPollVoteDetails = false;

            AdvancedFilter = new CharacterTargetFilterDto
            {
                MatchAllConditions = true
            };

            RecentPolls = await PollService.GetRecentPollsForGameMasterAsync(SessionId, 5);

            Message = L["Poll_Created"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

