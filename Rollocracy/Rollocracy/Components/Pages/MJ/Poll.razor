    private async Task SavePollPresetConfirmed()
    {
        try
        {
            Message = string.Empty;

            var request = BuildPollPresetRequest();

            await PollService.SaveSessionPresetAsync(
                SessionId,
                CurrentUserId,
                NewPollPresetName,
                request,
                overwrite: false);

            PollPresets = await PollService.GetSessionPresetsAsync(SessionId, CurrentUserId);
            SelectedPollPresetId = PollPresets.FirstOrDefault(x => x.Name == NewPollPresetName.Trim())?.PresetId;

            ShowSavePollPresetPanel = false;
            ConfirmOverwritePollPresetVisible = false;
            NewPollPresetName = string.Empty;

            Message = L["Poll_PresetSaved"];
        }
        catch (Exception ex)
        {
            if (ex.Message == L["Backend_PollPresetAlreadyExists"])
            {
                ConfirmOverwritePollPresetVisible = true;
                return;
            }

            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task OverwritePollPresetConfirmed()
    {
        try
        {
            Message = string.Empty;

            var request = BuildPollPresetRequest();

            await PollService.SaveSessionPresetAsync(
                SessionId,
                CurrentUserId,
                NewPollPresetName,
                request,
                overwrite: true);

            PollPresets = await PollService.GetSessionPresetsAsync(SessionId, CurrentUserId);
            SelectedPollPresetId = PollPresets.FirstOrDefault(x => x.Name == NewPollPresetName.Trim())?.PresetId;

            ShowSavePollPresetPanel = false;
            ConfirmOverwritePollPresetVisible = false;
            NewPollPresetName = string.Empty;

            Message = L["Poll_PresetSaved"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task DeleteSelectedPollPresetConfirmed()
    {
        try
        {
            if (!SelectedPollPresetId.HasValue)
                return;

            Message = string.Empty;

            await PollService.DeleteSessionPresetAsync(SessionId, CurrentUserId, SelectedPollPresetId.Value);

            PollPresets = await PollService.GetSessionPresetsAsync(SessionId, CurrentUserId);
            SelectedPollPresetId = null;
            ConfirmDeletePollPresetVisible = false;

            Message = L["Poll_PresetDeleted"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task ApplySelectedPollPreset()
    {
        if (!SelectedPollPresetId.HasValue)
            return;

        var preset = PollPresets.FirstOrDefault(x => x.PresetId == SelectedPollPresetId.Value);
        if (preset is null)
            return;

        ApplyPollPresetRequest(preset.Request);

        ConfirmDeletePollPresetVisible = false;
        await RefreshSelectedPollOptionOptionsAsync();
        StateHasChanged();
    }

    private Task CancelOverwritePollPreset()
    {
        ConfirmOverwritePollPresetVisible = false;
        return Task.CompletedTask;
    }

    private PollCreateRequestDto BuildPollPresetRequest()
    {
        return new PollCreateRequestDto
        {
            Question = NewPollQuestion,
            VoteWeightMode = PollVoteWeightMode.Metric,
            MetricDefinitionId = VoteWeightMetricId,
            AdvancedFilter = ClonePollAdvancedFilter(AdvancedFilter),
            Options = NewPollOptions.Select(o => new PollOptionDraftDto
            {
                Label = o.Label,
                Consequences = o.Consequences
                    .Where(c => c.TargetDefinitionId != Guid.Empty)
                    .Where(c => c.OperationType != TestConsequenceOperationType.AddValue
                        || c.ValueMode != ModifierValueMode.Metric
                        || c.SourceMetricId.HasValue)
                    .Select(c => new PollOptionConsequenceInlineDraftDto
                    {
                        TargetKind = c.TargetKind,
                        TargetDefinitionId = c.TargetDefinitionId,
                        ApplicationMode = c.ApplicationMode,
                        ModifierMode = c.ValueMode == ModifierValueMode.Metric || c.ValueMode == ModifierValueMode.RandomDice ? c.ModifierMode : TestModifierMode.Bonus,
                        Value = c.ValueMode == ModifierValueMode.Metric || c.ValueMode == ModifierValueMode.RandomDice ? 0 : c.Value,
                        ClampMode = c.ClampMode,
                        ClampMinTotal = c.ClampMinTotal,
                        ClampMaxTotal = c.ClampMaxTotal,
                        ValueMode = c.ValueMode,
                        SourceMetricId = c.ValueMode == ModifierValueMode.Metric ? c.SourceMetricId : null,
                        RandomDiceCount = c.ValueMode == ModifierValueMode.RandomDice ? Math.Clamp(c.RandomDiceCount <= 0 ? 1 : c.RandomDiceCount, 1, 5) : 1,
                        RandomDiceSides = c.ValueMode == ModifierValueMode.RandomDice ? Math.Clamp(c.RandomDiceSides <= 0 ? 6 : c.RandomDiceSides, 2, 100) : 6,
                        OperationType = c.OperationType
                    })
                    .ToList()
            }).ToList()
        };
    }

    private void ApplyPollPresetRequest(PollCreateRequestDto request)
    {
        NewPollQuestion = request.Question;
        VoteWeightMetricId = request.MetricDefinitionId;
        AdvancedFilter = ClonePollAdvancedFilter(request.AdvancedFilter ?? new CharacterTargetFilterDto());

        NewPollOptions = request.Options.Select(o => new PollOptionRowModel
        {
            Label = o.Label,
            Consequences = o.Consequences.Select(c => new SharedConsequenceRowModel
            {
                RowId = Guid.NewGuid(),
                OperationType = c.OperationType,
                TargetKind = c.TargetKind,
                TargetDefinitionId = c.TargetDefinitionId,
                ApplicationMode = c.ApplicationMode,
                ModifierMode = c.ValueMode == ModifierValueMode.Metric || c.ValueMode == ModifierValueMode.RandomDice ? c.ModifierMode : TestModifierMode.Bonus,
                Value = c.Value,
                ClampMode = c.ClampMode,
                ClampMinTotal = c.ClampMinTotal,
                ClampMaxTotal = c.ClampMaxTotal,
                ValueMode = c.ValueMode,
                SourceMetricId = c.ValueMode == ModifierValueMode.Metric ? c.SourceMetricId : null,
                RandomDiceCount = c.ValueMode == ModifierValueMode.RandomDice ? Math.Clamp(c.RandomDiceCount <= 0 ? 1 : c.RandomDiceCount, 1, 5) : 1,
                RandomDiceSides = c.ValueMode == ModifierValueMode.RandomDice ? Math.Clamp(c.RandomDiceSides <= 0 ? 6 : c.RandomDiceSides, 2, 100) : 6
            }).ToList()
        }).ToList();

        if (NewPollOptions.Count == 0)
        {
            NewPollOptions = new List<PollOptionRowModel> { new(), new() };
        }
    }

    private CharacterTargetFilterDto ClonePollAdvancedFilter(CharacterTargetFilterDto source)
    {
        return new CharacterTargetFilterDto
        {
            OnlyAlive = source.OnlyAlive,
            OnlyDead = source.OnlyDead,
            OnlyOnline = source.OnlyOnline,
            IncludeNpcs = source.IncludeNpcs,
            MatchAllConditions = source.MatchAllConditions,
            TraitOptionIds = source.TraitOptionIds.ToList(),
            TalentIds = source.TalentIds.ToList(),
            ItemIds = source.ItemIds.ToList(),
            PollId = source.PollId,
            PollSelectedOptionId = source.PollSelectedOptionId,
            FilterOnPollResponse = source.FilterOnPollResponse,
            MustHaveSucceededLastTest = source.MustHaveSucceededLastTest,
            FilterOnLastTestResult = source.FilterOnLastTestResult,
            NameCharacterIds = source.NameCharacterIds.ToList(),
            RandomDrawIds = source.RandomDrawIds.ToList(),
            BiographyNotEmpty = source.BiographyNotEmpty,
            ValueFilters = source.ValueFilters.Select(x => new CharacterValueFilterDto
            {
                TargetType = x.TargetType,
                TargetId = x.TargetId,
                TargetName = x.TargetName,
                ComparisonType = x.ComparisonType,
                Value = x.Value
            }).ToList()
        };
    }
