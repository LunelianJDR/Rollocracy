    private async Task LoadAdvancedNameSuggestionsAsync()
    {
        AdvancedNameSuggestions.Clear();

        var summaries = await CharacterService.GetSessionCharacterSummariesAsync(
            SessionId,
            includeOffline: true,
            includeDead: true,
            includeNpcs: true);

        AdvancedNameSuggestions = summaries
            .Where(x => !string.IsNullOrWhiteSpace(x.CharacterName) || !string.IsNullOrWhiteSpace(x.PlayerName))
            .Select(x => new CharacterNameSuggestionItem
            {
                CharacterId = x.CharacterId,
                CharacterName = x.CharacterName ?? string.Empty,
                PlayerName = x.PlayerName ?? string.Empty
            })
            .OrderBy(x => x.CharacterName)
            .ThenBy(x => x.PlayerName)
            .ToList();
    }

    private string GetPollConsequenceOperationCssClass(SharedConsequenceRowModel consequence)
    {
        return consequence.OperationType switch
        {
            TestConsequenceOperationType.AddValue when consequence.Value >= 0 => "rc-consequence-pill rc-consequence-pill--positive",
            TestConsequenceOperationType.AddValue when consequence.Value < 0 => "rc-consequence-pill rc-consequence-pill--negative",

            TestConsequenceOperationType.GrantTalent => "rc-consequence-pill rc-consequence-pill--positive",
            TestConsequenceOperationType.GrantItem => "rc-consequence-pill rc-consequence-pill--positive",

            TestConsequenceOperationType.RevokeTalent => "rc-consequence-pill rc-consequence-pill--negative",
            TestConsequenceOperationType.RevokeItem => "rc-consequence-pill rc-consequence-pill--negative",

            _ => "rc-consequence-pill"
        };
    }

    private string GetPollConsequenceValueCssClass(SharedConsequenceRowModel consequence)
    {
        if (consequence.OperationType != TestConsequenceOperationType.AddValue)
            return "rc-consequence-pill";

        return consequence.Value >= 0
            ? "rc-consequence-pill rc-consequence-pill--positive"
            : "rc-consequence-pill rc-consequence-pill--negative";
    }

