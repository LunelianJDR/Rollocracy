@page "/mj/sessions"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Rollocracy.Localization
@using DomainSession = Rollocracy.Domain.Entities.Session

@inject Rollocracy.Domain.Interfaces.ISessionService SessionService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L


@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToHome)
{
    <p>@L["Common_Loading"]</p>
}
else
{
    <section class="rc-tool-section">
        <div class="rc-tool-panel">
            <div class="rc-tool-panel__header">
                <div class="rc-tool-panel__header-main">
                    <h4 class="rc-tool-panel__title">@L["Session_List_Title"]</h4>
                    <p class="rc-tool-panel__subtitle">@L["Session_List_Subtitle"]</p>
                </div>

                <div class="rc-tool-actions">
                    <button type="button" @onclick="GoToCreateSession">
                        @L["Session_Create_Title"]
                    </button>
                </div>
            </div>

            <div class="rc-test-stats-grid">
                <div class="rc-stat-card">
                    <span class="rc-stat-card__label">@L["Session_List_TotalSessions"]</span>
                    <span class="rc-stat-card__value">@SessionSummaries.Count</span>
                </div>

                <div class="rc-stat-card">
                    <span class="rc-stat-card__label">@L["Session_List_ActiveSessions"]</span>
                    <span class="rc-stat-card__value">@SessionSummaries.Count(x => x.Session.IsActive)</span>
                </div>

                <div class="rc-stat-card">
                    <span class="rc-stat-card__label">@L["Session_List_InactiveSessions"]</span>
                    <span class="rc-stat-card__value">@SessionSummaries.Count(x => !x.Session.IsActive)</span>
                </div>

                <div class="rc-stat-card">
                    <span class="rc-stat-card__label">@L["Session_AliveCharacters"]</span>
                    <span class="rc-stat-card__value">@SessionSummaries.Sum(x => x.AliveCharacterCount)</span>
                </div>
            </div>
        </div>

        <div class="rc-tool-panel">
            <div class="rc-tool-panel__header">
                <div class="rc-tool-panel__header-main">
                    <h4 class="rc-tool-panel__title">@L["Session_List_ListTitle"]</h4>
                    <p class="rc-tool-panel__subtitle">@L["Session_List_ListSubtitle"]</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <p>@Message</p>
            }

            @if (SessionSummaries.Count == 0)
            {
                <div class="rc-empty-panel">
                    <p>@L["Session_List_None"]</p>
                </div>
            }
            else
            {
                <div class="rc-session-list-grid">
                    @foreach (var item in SessionSummaries)
                    {
                        var isDeleteConfirmationOpen = PendingDeleteSessionId == item.Session.Id;

                        <article class="rc-filter-group-card @(item.Session.IsActive ? "-active" : "-inactive")">
                            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                                <div class="rc-tool-panel__header-main">
                                    <h5 class="rc-tool-panel__title">@item.Session.SessionName</h5>
                                    <p class="rc-tool-panel__subtitle">
                                        @(item.Session.IsActive? L["Session_IsActive"] : L["Session_List_StatusInactive"])
                                    </p>
                                </div>
                            </div>

                            <div class="rc-tool-form-grid">
                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["Common_Name"]</label>
                                    <div class="rc-readonly-value">@item.Session.SessionName</div>
                                </div>

                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["Session_AliveCharacters"]</label>
                                    <div class="rc-readonly-value">@item.AliveCharacterCount</div>
                                </div>

                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["Session_IsActive"]</label>
                                    <div class="rc-readonly-value">
                                        @(item.Session.IsActive? L["Common_Yes"] : L["Common_No"])
                                    </div>
                                </div>

                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["Common_Url"]</label>
                                    <div class="rc-readonly-value">
                                        @if (item.Session.IsActive)
                                        {
                                            <code>@($"{Navigation.BaseUri}{CurrentUsername}/{item.Session.SessionSlug}")</code>
                                        }
                                        else
                                        {
                                            <span>@L["Session_List_InactiveUrl"]</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="rc-tool-actions">
                                <button type="button" @onclick="() => OpenSession(item.Session.Id)">
                                    @L["Session_List_Open"]
                                </button>

                                <button type="button" @onclick="() => OpenSessionSettings(item.Session.Id)">
                                    @L["Session_List_EditSettings"]
                                </button>

                                @if (item.Session.IsActive)
                                {
                                    <button type="button" @onclick="() => ToggleSessionState(item.Session.Id, false)">
                                        @L["Session_List_Deactivate"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button" @onclick="() => ToggleSessionState(item.Session.Id, true)">
                                        @L["Session_List_Activate"]
                                    </button>
                                }

                                <button type="button"
                                        disabled="@item.Session.IsActive"
                                        @onclick="() => AskDeleteSession(item.Session.Id)">
                                    @L["GameSystem_Editor_Delete"]
                                </button>
                            </div>

                            @if (item.Session.IsActive)
                            {
                                <p class="rc-tool-muted">@L["Session_List_DeleteDisabledBecauseActive"]</p>
                            }
                            else
                            {
                                <p class="rc-tool-muted">@L["Session_List_PlayerCanJoin"]</p>
                            }

                            @if (isDeleteConfirmationOpen)
                            {
                                <div class="rc-filter-group-card">
                                    <p>@L["Session_List_DeleteConfirmation"]</p>

                                    <div class="rc-tool-actions">
                                        <button type="button" @onclick="ConfirmDeleteSession">
                                            @L["Common_Yes"]
                                        </button>

                                        <button type="button" @onclick="CancelDeleteSession">
                                            @L["Common_Cancel"]
                                        </button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    private Guid CurrentUserId;
    private string CurrentUsername = string.Empty;
    private bool IsLoaded;
    private bool RedirectToHome;
    private string Message = string.Empty;
    private Guid? PendingDeleteSessionId;
    private List<SessionSummary> SessionSummaries = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);
        CurrentUsername = user.Identity?.Name ?? string.Empty;

        var canCreateSessions = await SessionService.CanUserCreateSessionsAsync(CurrentUserId);

        if (!canCreateSessions)
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        await LoadSessions();
        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToHome)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadSessions()
    {
        Message = string.Empty;
        PendingDeleteSessionId = null;
        SessionSummaries.Clear();

        var sessions = await SessionService.GetSessionsByGameMasterAsync(CurrentUserId);

        foreach (var session in sessions)
        {
            var aliveCount = await SessionService.GetAliveCharacterCountAsync(session.Id);

            SessionSummaries.Add(new SessionSummary
            {
                Session = session,
                AliveCharacterCount = aliveCount
            });
        }
    }

    private void GoToCreateSession()
    {
        Navigation.NavigateTo("/mj/create-session");
    }

    private void OpenSession(Guid sessionId)
    {
        Navigation.NavigateTo($"/mj/session/{sessionId}");
    }

    private void OpenSessionSettings(Guid sessionId)
    {
        Navigation.NavigateTo($"/mj/session/{sessionId}/settings");
    }

    private async Task ToggleSessionState(Guid sessionId, bool isActive)
    {
        try
        {
            Message = string.Empty;
            PendingDeleteSessionId = null;

            await SessionService.SetSessionActiveStateAsync(sessionId, CurrentUserId, isActive);
            await LoadSessions();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private void AskDeleteSession(Guid sessionId)
    {
        Message = string.Empty;
        PendingDeleteSessionId = sessionId;
    }

    private Task CancelDeleteSession()
    {
        PendingDeleteSessionId = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteSession()
    {
        if (!PendingDeleteSessionId.HasValue)
            return;

        try
        {
            Message = string.Empty;

            await SessionService.DeleteSessionAsync(PendingDeleteSessionId.Value, CurrentUserId);

            PendingDeleteSessionId = null;
            await LoadSessions();
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private class SessionSummary
    {
        public DomainSession Session { get; set; } = new();
        public int AliveCharacterCount { get; set; }
    }
}
