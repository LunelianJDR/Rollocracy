    private string PreviewJoinUrl
    {
        get
        {
            if (Settings is null)
                return string.Empty;

            if (!UpdateJoinUrlSlug)
                return Settings.JoinUrl;

            var normalizedBaseUri = Navigation.BaseUri.EndsWith("/") ? Navigation.BaseUri : $"{Navigation.BaseUri}/";
            var previewSlug = BuildPreviewSlug(SessionName);

            return $"{normalizedBaseUri}{CurrentUsername}/{previewSlug}";
        }
    }

    private string BuildPreviewSlug(string sessionName)
    {
        if (string.IsNullOrWhiteSpace(sessionName))
            return Settings?.SessionSlug ?? string.Empty;

        var slug = sessionName.Trim().ToLowerInvariant();
        slug = slug.Replace(" ", "-");
        slug = slug.Replace("'", "-");
        slug = slug.Replace("\"", "-");
        slug = new string(slug.Where(c => char.IsLetterOrDigit(c) || c == '-').ToArray());

        while (slug.Contains("--"))
            slug = slug.Replace("--", "-");

        slug = slug.Trim('-');

        if (string.IsNullOrWhiteSpace(slug))
            return Settings?.SessionSlug ?? string.Empty;

        return slug;
    }

