@page "/mj/session/{SessionId:guid}/settings"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization 
@using Rollocracy.Domain.Characters
@using Rollocracy.Domain.Entities
@using Rollocracy.Domain.GameRules
@using Rollocracy.Localization
@using DomainSession = Rollocracy.Domain.Entities.Session

@inject Rollocracy.Domain.Interfaces.ISessionService SessionService
@inject Rollocracy.Domain.Interfaces.IGameSystemService GameSystemService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L


@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (RedirectToHome)
{
    <p>@L["Common_Loading"]</p>
}
else if (Settings is null)
{
    <p>@L["Session_NotFound"]</p>
}
else
{
    <section class="rc-tool-section">
        <div class="rc-tool-layout">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Session_Settings_Title"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Session_Settings_Subtitle"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="BackToSession">@L["Session_BackToSession"]</button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <p>@Message</p>
                }

                <div class="rc-tool-form-grid">
                    <div class="rc-form-field">
                        <label for="session-name">@L["Session_Name"]</label>
                        <input id="session-name" maxlength="16" @bind="SessionName" />
                    </div>

                    <div class="rc-form-field">
                        <label for="session-password">@L["Session_Settings_Password"]</label>
                        <input id="session-password" @bind="SessionPassword" />
                    </div>

                    <div class="rc-form-field rc-form-field--readonly">
                        <label>@L["Session_Settings_CurrentSlug"]</label>
                        <div class="rc-readonly-value">@Settings.SessionSlug</div>
                    </div>

                    <div class="rc-form-field rc-form-field--readonly">
                        <label>@L["Session_Settings_CurrentJoinUrl"]</label>
                        <div class="rc-readonly-value"><code>@Settings.JoinUrl</code></div>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["Session_Settings_UpdateJoinUrlText"]</label>
                        <label class="rc-filter-toggle">
                            <input type="checkbox" @bind="UpdateJoinUrlSlug" />
                            <span>@L["Session_Settings_UpdateJoinUrl"]</span>
                        </label>
                    </div>

                    <div class="rc-form-field rc-form-field--readonly">
                        <label>@L["Session_Settings_NewJoinUrl"]</label>
                        <div class="rc-readonly-value">
                            <code>@PreviewJoinUrl</code>
                        </div>
                    </div>
                </div>

                <div class="rc-form-field rc-form-field--readonly">
                        <label>@L["Session_IsActive"]</label>
                        <div class="rc-inline-info">
                            <div class="rc-readonly-value">@(Settings.IsActive? L["Common_Yes"] : L["Common_No"])</div>

                            <div class="rc-inline-picker">
                                @if (Settings.IsActive)
                                {
                                    <button type="button" @onclick="DeactivateSession">
                                        @L["Session_List_Deactivate"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button" @onclick="ActivateSession">
                                        @L["Session_List_Activate"]
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                <div class="rc-tool-actions">
                    <button type="button" @onclick="SaveSettings">@L["Common_Save"]</button>
                </div>
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Session_Settings_GameSystemSection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Session_Settings_GameSystemSectionSubtitle"]</p>
                    </div>
                </div>

                @if (CurrentSession?.GameSystemId is null)
                {
                    <div class="rc-empty-panel">
                        <p>@L["Session_Settings_NoAssignedGameSystem"]</p>
                    </div>
                }
                else
                {
                    @if (AssignedGameSystem is null)
                    {
                        <div class="rc-empty-panel">
                            <p>@L["Session_Settings_NoAssignedGameSystem"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="rc-tool-form-grid">
                            <div class="rc-form-field rc-form-field--readonly">
                                <label>@L["Common_Name"]</label>
                                <div class="rc-readonly-value">@AssignedGameSystem.Name</div>
                            </div>

                            <div class="rc-form-field rc-form-field--readonly">
                                <label>@L["GameSystem_ResolutionMode"]</label>
                                <div class="rc-readonly-value">@GetResolutionLabel(AssignedGameSystem.TestResolutionMode)</div>
                            </div>

                            <div class="rc-form-field rc-form-field--readonly" style="grid-column: 1 / -1;">
                                <label>@L["Common_Description"]</label>
                                <div class="rc-readonly-value">
                                    @if (string.IsNullOrWhiteSpace(AssignedGameSystem.Description))
                                    {
                                        <span>@L["Common_None"]</span>
                                    }
                                    else
                                    {
                                        @AssignedGameSystem.Description
                                    }
                                </div>
                                @if (AssignedGameSystem is not null && !AssignedGameSystem.LockedToSessionId.HasValue)
                                {
                                    <p class="rc-tool-muted">@L["Session_Settings_EditAssignedGameSystemCreatesCopy"]</p>
                                }
                            </div>
                        </div>

                        <div class="rc-tool-actions">
                            <button type="button" @onclick="EditAssignedGameSystem">
                                @L["Session_Settings_EditAssignedGameSystem"]
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="rc-tool-layout">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Session_Gauges_Title"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Session_Settings_SessionGaugesSectionSubtitle"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="OpenCreateSessionGaugeEditor">
                            @L["Session_Settings_AddGaugeTitle"]
                        </button>
                    </div>
                </div>

                @if (SessionGauges.Count == 0)
                {
                    <div class="rc-empty-panel">
                        <p>@L["Session_Manage_NoSessionGauges"]</p>
                    </div>
                }
                else
                {
                    <div class="rc-consequence-list">
                        @foreach (var gauge in SessionGauges)
                        {
                            var isEditing = EditingSessionGaugeId == gauge.SessionGaugeId;
                            var isDeleteConfirm = PendingSessionGaugeDeleteId == gauge.SessionGaugeId;

                            <article class="rc-filter-group-card">
                                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                                    <div class="rc-tool-panel__header-main">
                                        <h5 class="rc-tool-panel__title">@gauge.Name</h5>
                                        <p class="rc-tool-panel__subtitle">
                                            @L["Session_Settings_CurrentValueLabel"] : @gauge.CurrentValue
                                            · min @gauge.MinValue
                                            · max @gauge.MaxValue
                                        </p>
                                    </div>
                                </div>

                                @if (isEditing)
                                {
                                    <div class="rc-tool-form-grid">
                                        <div class="rc-form-field">
                                            <label>@L["Common_Name"]</label>
                                            <input @bind="EditingSessionGaugeName" />
                                        </div>

                                        <div class="rc-form-field">
                                            <label>@L["Session_Manage_SessionGaugeMinValue"]</label>
                                            <input type="number" @bind="EditingSessionGaugeMinValue" />
                                        </div>

                                        <div class="rc-form-field">
                                            <label>@L["Session_Manage_SessionGaugeMaxValue"]</label>
                                            <input type="number" @bind="EditingSessionGaugeMaxValue" />
                                        </div>

                                        <div class="rc-form-field">
                                            <label>@L["Session_Manage_SessionGaugeCurrentValue"]</label>
                                            <input type="number" @bind="EditingSessionGaugeCurrentValue" />
                                        </div>
                                    </div>

                                    <div class="rc-tool-actions">
                                        <button type="button" @onclick="SaveEditedSessionGauge">@L["Common_Save"]</button>
                                        <button type="button" @onclick="CancelEditSessionGauge">@L["Common_Cancel"]</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="rc-tool-form-grid">
                                        <div class="rc-form-field rc-form-field--readonly">
                                            <label>@L["Common_Name"]</label>
                                            <div class="rc-readonly-value">@gauge.Name</div>
                                        </div>

                                        <div class="rc-form-field rc-form-field--readonly">
                                            <label>@L["Session_Manage_SessionGaugeMinValue"]</label>
                                            <div class="rc-readonly-value">@gauge.MinValue</div>
                                        </div>

                                        <div class="rc-form-field rc-form-field--readonly">
                                            <label>@L["Session_Manage_SessionGaugeMaxValue"]</label>
                                            <div class="rc-readonly-value">@gauge.MaxValue</div>
                                        </div>

                                        <div class="rc-form-field rc-form-field--readonly">
                                            <label>@L["Session_Manage_SessionGaugeCurrentValue"]</label>
                                            <div class="rc-readonly-value">@gauge.CurrentValue</div>
                                        </div>
                                    </div>

                                    <div class="rc-tool-actions">
                                        <button type="button" @onclick="() => StartEditSessionGauge(gauge)">
                                            @L["Session_Settings_EditGauge"]
                                        </button>
                                        <button type="button" @onclick="() => AskDeleteSessionGauge(gauge.SessionGaugeId)">
                                            @L["Common_Remove"]
                                        </button>
                                    </div>
                                }

                                @if (isDeleteConfirm)
                                {
                                    <div class="rc-filter-group-card">
                                        <p>@L["Session_Manage_ConfirmDeleteSessionGauge"]</p>

                                        <div class="rc-tool-actions">
                                            <button type="button" @onclick="ConfirmDeleteSessionGauge">@L["Common_Yes"]</button>
                                            <button type="button" @onclick="CancelDeleteSessionGauge">@L["Common_Cancel"]</button>
                                        </div>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
                @if (ShowCreateSessionGaugeEditor)
                {
                    <div class="rc-filter-group-card">
                        <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                            <div class="rc-tool-panel__header-main">
                                <h5 class="rc-tool-panel__title">@L["Session_Settings_AddGaugeTitle"]</h5>
                                <p class="rc-tool-panel__subtitle">@L["Session_Settings_AddGaugeSubtitle"]</p>
                            </div>
                        </div>

                        <div class="rc-tool-form-grid">
                            <div class="rc-form-field">
                                <label>@L["Common_Name"]</label>
                                <input @bind="NewSessionGaugeName" />
                            </div>

                            <div class="rc-form-field">
                                <label>@L["Session_Manage_SessionGaugeMinValue"]</label>
                                <input type="number" @bind="NewSessionGaugeMinValue" />
                            </div>

                            <div class="rc-form-field">
                                <label>@L["Session_Manage_SessionGaugeMaxValue"]</label>
                                <input type="number" @bind="NewSessionGaugeMaxValue" />
                            </div>

                            <div class="rc-form-field">
                                <label>@L["Session_Manage_SessionGaugeCurrentValue"]</label>
                                <input type="number" @bind="NewSessionGaugeCurrentValue" />
                            </div>
                        </div>

                        <div class="rc-tool-actions">
                            <button type="button" @onclick="CreateSessionGauge">@L["Common_Save"]</button>
                            <button type="button" @onclick="CancelCreateSessionGaugeEditor">@L["Common_Cancel"]</button>
                        </div>
                    </div>
                }
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["SessionSettings_SessionItemsTitle"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["SessionSettings_SessionItemsSubtitle"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="AddSessionItemRow">@L["GameSystem_Editor_AddItemRow"]</button>
                        <button type="button" @onclick="SaveSessionItems">@L["Common_Save"]</button>
                    </div>
                </div>

                @if (SessionItems.Count == 0)
                {
                    <div class="rc-empty-panel">
                        <p>@L["SessionSettings_NoSessionItems"]</p>
                    </div>
                }
                else
                {
                    @foreach (var item in SessionItems.Where(x => !x.IsDeleted).OrderBy(x => x.DisplayOrder))
                    {
                        <div class="rc-filter-group-card">
                            <div class="rc-tool-form-grid">
                                <div class="rc-form-field">
                                    <label>@L["Common_Name"]</label>
                                    <input @bind="item.Name" />
                                </div>

                                <div class="rc-form-field">
                                    <label>@L["Common_Description"]</label>
                                    <input @bind="item.Description" />
                                </div>
                            </div>

                            <div class="rc-tool-actions">
                                <button type="button" @onclick="() => AddSessionItemModifierRow(item)">
                                    @L["GameSystem_Editor_AddItemModifierRow"]
                                </button>

                                <button type="button" @onclick="() => item.IsDeleted = true">
                                    @L["Common_Remove"]
                                </button>
                            </div>

                            @foreach (var modifier in item.Modifiers)
                            {
                                <div class="rc-tool-form-grid--dense">
                                    <div class="rc-form-field">
                                        <label>@L["GameSystem_Editor_ModifierTargetType"]</label>
                                        <select value="@modifier.TargetType" @onchange="e => ChangeSessionItemModifierTargetType(modifier, e.Value?.ToString())">
                                            <option value="@ModifierTargetType.BaseAttribute">@L["GameSystem_Editor_ModifierTarget_BaseAttribute"]</option>
                                            <option value="@ModifierTargetType.DerivedStat">@L["GameSystem_Editor_ModifierTarget_DerivedStat"]</option>
                                            <option value="@ModifierTargetType.Metric">@L["GameSystem_Editor_ModifierTarget_Metric"]</option>
                                            <option value="@ModifierTargetType.Gauge">@L["GameSystem_Editor_ModifierTarget_Gauge"]</option>
                                        </select>
                                    </div>

                                    <div class="rc-form-field">
                                        <label>@L["GameSystem_Editor_ModifierTarget"]</label>
                                        <select @bind="modifier.TargetId">
                                            @foreach (var option in GetSessionItemModifierTargetOptions(modifier.TargetType))
                                            {
                                                <option value="@option.Id">@option.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="rc-form-field">
                                        <label>@L["GameSystem_Editor_ModifierValueMode"]</label>
                                        <select @bind="modifier.ValueMode">
                                            <option value="@ModifierValueMode.Fixed">@L["GameSystem_Editor_ModifierValueMode_Fixed"]</option>
                                            <option value="@ModifierValueMode.Metric">@L["GameSystem_Editor_ModifierValueMode_Metric"]</option>
                                        </select>
                                    </div>

                                    @if (modifier.ValueMode == ModifierValueMode.Fixed)
                                    {
                                        <div class="rc-form-field">
                                            <label>@L["GameSystem_Editor_ModifierValue"]</label>
                                            <input type="number" @bind="modifier.Value" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rc-form-field">
                                            <label>@L["GameSystem_Editor_ModifierSourceMetric"]</label>
                                            <select @bind="modifier.SourceMetricId">
                                                @foreach (var metric in CurrentSystemEditor?.AvailableMetrics ?? Enumerable.Empty<EditableMetricDefinitionDto>())
                                                {
                                                    if (!metric.IsDeleted && metric.MetricDefinitionId.HasValue)
                                                    {
                                                        <option value="@metric.MetricDefinitionId.Value">@metric.Name</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    }

                                    <div class="rc-tool-actions">
                                        <button type="button" @onclick="() => item.Modifiers.Remove(modifier)">
                                            @L["Common_Remove"]
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Session_Settings_SpecialRolesSection"]</h4>
                        <p class="rc-tool-panel__subtitle">@L["Session_Settings_SpecialRolesSectionSubtitle"]</p>
                    </div>

                    <div class="rc-tool-actions">
                        <button type="button" @onclick="OpenSpecialRoleEditor">
                            @L["Session_Manage_AddSpecialRole"]
                        </button>
                    </div>
                </div>
                <div class="rc-tool-muted" style="margin-top: 0.5rem;">
                    <p>@L["Session_Settings_SpecialRoles_Description"]</p>
                    <ul>
                        <li>@L["Session_Settings_SpecialRoles_Observer"]</li>
                        <li>@L["Session_Settings_SpecialRoles_Assistant"]</li>
                    </ul>
                </div>

                @if (ShowSpecialRoleEditor)
                {
                    <div class="rc-filter-group-card">
                        <div class="rc-tool-form-grid">
                            <div class="rc-form-field">
                                <label>@L["Session_Manage_SelectPlayer"]</label>
                                <select @bind="SelectedSpecialRolePlayerSessionId">
                                    <option value="">@L["Session_Manage_SelectPlayer"]</option>
                                    @foreach (var player in SpecialRoleEligiblePlayers)
                                    {
                                        <option value="@player.Id">@player.PlayerName</option>
                                    }
                                </select>
                            </div>

                            <div class="rc-form-field">
                                <label>@L["Session_Settings_SpecialRole"]</label>
                                <select @bind="SelectedSpecialRole">
                                    <option value="@SessionSpecialRole.Observer">@L["SessionSpecialRole_Observer"]</option>
                                    @* <option value="@SessionSpecialRole.Assistant">@L["SessionSpecialRole_Assistant"]</option> *@
                                </select>
                            </div>
                        </div>

                        <div class="rc-tool-actions">
                            <button type="button" @onclick="ValidateSpecialRole">@L["Common_Save"]</button>
                            <button type="button" @onclick="CancelSpecialRoleEditor">@L["Common_Cancel"]</button>
                        </div>
                    </div>
                }

                @if (SpecialRoleAssignments.Count == 0)
                {
                    <div class="rc-empty-panel">
                        <p>@L["Session_Manage_NoSpecialRoles"]</p>
                    </div>
                }
                else
                {
                    <div class="rc-consequence-list">
                        @foreach (var player in SpecialRoleAssignments)
                        {
                            <article class="rc-filter-group-card">
                                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                                    <div class="rc-tool-panel__header-main">
                                        <h5 class="rc-tool-panel__title">@player.PlayerName</h5>
                                        <p class="rc-tool-panel__subtitle">@GetSpecialRoleLabel(player.SpecialRole)</p>
                                    </div>
                                </div>

                                <div class="rc-tool-actions">
                                    <button type="button" @onclick="() => RemoveSpecialRole(player.Id)">
                                        @L["Common_Remove"]
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public Guid SessionId { get; set; }

    private bool IsLoaded;
    private bool RedirectToHome;
    private Guid CurrentUserId;
    private string CurrentUsername = string.Empty;

    private DomainSession? CurrentSession;
    private SessionSettingsDto? Settings;

    private string SessionName = string.Empty;
    private string SessionPassword = string.Empty;
    private bool UpdateJoinUrlSlug;
    private string Message = string.Empty;

    private List<PlayerSession> SpecialRoleEligiblePlayers = new();
    private List<PlayerSession> SpecialRoleAssignments = new();
    private string SelectedSpecialRolePlayerSessionId = string.Empty;
    private SessionSpecialRole SelectedSpecialRole = SessionSpecialRole.Observer;
    private bool ShowSpecialRoleEditor;

    private Rollocracy.Domain.Entities.GameSystem? AssignedGameSystem;
    private bool ShowCreateSessionGaugeEditor;

    private List<EditableItemDefinitionDto> SessionItems = new();
    private GameSystemEditorDto? CurrentSystemEditor;

    private List<SessionGaugeDto> SessionGauges = new();
    private string NewSessionGaugeName = string.Empty;
    private int NewSessionGaugeMinValue = 0;
    private int NewSessionGaugeMaxValue = 10;
    private int NewSessionGaugeCurrentValue = 10;

    private Guid? PendingSessionGaugeDeleteId;

    private Guid? EditingSessionGaugeId;
    private string EditingSessionGaugeName = string.Empty;
    private int EditingSessionGaugeMinValue;
    private int EditingSessionGaugeMaxValue = 10;
    private int EditingSessionGaugeCurrentValue = 10;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);
        CurrentUsername = user.Identity?.Name ?? string.Empty;

        var canCreateSessions = await SessionService.CanUserCreateSessionsAsync(CurrentUserId);

        if (!canCreateSessions)
        {
            RedirectToHome = true;
            IsLoaded = true;
            return;
        }

        await LoadAll();
        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToHome)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadAll()
    {
        Message = string.Empty;

        CurrentSession = await SessionService.GetSessionByIdAsync(SessionId);
        Settings = await SessionService.GetSessionSettingsAsync(SessionId, CurrentUserId, Navigation.BaseUri);

        if (Settings is null)
            return;

        AssignedGameSystem = null;

        if (CurrentSession?.GameSystemId is Guid gameSystemId)
        {
            AssignedGameSystem = await GameSystemService.GetGameSystemByIdAsync(gameSystemId, CurrentUserId);
        }

        SessionName = Settings.SessionName;
        SessionPassword = Settings.SessionPassword;
        UpdateJoinUrlSlug = false;

        SpecialRoleEligiblePlayers = await SessionService.GetEligibleSpecialRolePlayersAsync(SessionId, CurrentUserId);
        SpecialRoleAssignments = await SessionService.GetPlayersWithSpecialRolesAsync(SessionId, CurrentUserId);
        SessionGauges = await SessionService.GetSessionGaugesAsync(SessionId, CurrentUserId);

        SessionItems = await SessionService.GetSessionItemDefinitionsAsync(SessionId, CurrentUserId);

        if (Settings.GameSystemId.HasValue)
        {
            CurrentSystemEditor = await GameSystemService.GetGameSystemEditorAsync(Settings.GameSystemId.Value, CurrentUserId);
        }

        CancelEditSessionGauge();
        PendingSessionGaugeDeleteId = null;
        ShowSpecialRoleEditor = false;
        ShowCreateSessionGaugeEditor = false;
    }

    private async Task SaveSettings()
    {
        try
        {
            Message = string.Empty;

            if (string.IsNullOrWhiteSpace(SessionName))
            {
                Message = L["Session_Settings_NameRequired"];
                return;
            }

            if (SessionName.Trim().Length > 16)
            {
                Message = L["Session_NameMaxLength"];
                return;
            }

            await SessionService.UpdateSessionSettingsAsync(
                SessionId,
                CurrentUserId,
                SessionName,
                SessionPassword,
                UpdateJoinUrlSlug);

            await LoadAll();

            Message = UpdateJoinUrlSlug
                ? L["Session_Settings_SavedWithUrlChange"]
                : L["Session_Settings_Saved"];
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task EditAssignedGameSystem()
    {
        if (CurrentSession is null)
            return;

        try
        {
            Message = string.Empty;

            var editableSystem = await GameSystemService.EnsureSessionUsesEditableGameSystemAsync(
                CurrentSession.Id,
                CurrentUserId);

            await LoadAll();

            Navigation.NavigateTo($"/mj/gamesystems/{editableSystem.Id}");
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private void OpenSpecialRoleEditor()
    {
        ShowSpecialRoleEditor = true;

        if (string.IsNullOrWhiteSpace(SelectedSpecialRolePlayerSessionId) && SpecialRoleEligiblePlayers.Count > 0)
        {
            SelectedSpecialRolePlayerSessionId = SpecialRoleEligiblePlayers[0].Id.ToString();
        }
    }

    private void CancelSpecialRoleEditor()
