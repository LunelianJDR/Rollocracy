@page "/player/room/{PlayerSessionId:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Characters
@using Rollocracy.Domain.GameTests
@using Rollocracy.Domain.Interfaces
@using Rollocracy.Localization
@using Rollocracy.Domain.Polls
@using Rollocracy.Domain.Entities
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Text.RegularExpressions

@inject ICharacterService CharacterService
@inject IGameTestService GameTestService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L
@inject IPollService PollService
@inject ISessionNotifier SessionNotifier
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISessionService SessionService
@inject IJSRuntime JS

@if (!IsLoaded)
{
    <p>@L["Common_Loading"]</p>
}
else if (State is null)
{
    <p>@L["Session_Player_NotFound"]</p>
}
else
{
    <section class="rc-player-room">
        <div class="rc-player-room__main">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">@L["Session_Player_CharacterPanelTitle"]</h4>
                    </div>

                    <div class="rc-tool-actions">
                        @if (IsViewingDeadCharacter)
                        {
                            <button type="button" @onclick="CloseViewedDeadCharacter">@L["Session_Player_CloseViewedCharacter"]</button>
                        }
                        else if (State.AliveCharacter is not null)
                        {
                            @if (IsEditingBiography)
                            {
                                <button type="button" @onclick="SaveBiography">@L["Common_Save"]</button>
                                <button type="button" @onclick="CancelBiographyEdit">@L["Common_Cancel"]</button>
                            }
                            else if (ShowBiographyPanel)
                            {
                                <button type="button" @onclick="BeginBiographyEdit">@L["Session_Player_EditBiography"]</button>
                                <button type="button" @onclick="ShowStatsView">@L["Session_Player_Statistics"]</button>
                            }
                            else if (ShowStorePanel)
                            {
                                <button type="button" @onclick="CloseStorePanel">@L["Session_Player_Statistics"]</button>
                            }
                            else
                            {
                                <button type="button" @onclick="ShowBiographyView">@L["Session_Player_ViewBiography"]</button>
                                @if (SessionStore?.Exists == true)
                                {
                                    <button type="button" disabled="@(!SessionStore.IsEnabled)" @onclick="ToggleStorePanel">@L["Session_Store_Button"]</button>
                                }
                            }

                            
                        }
                    </div>
                </div>

                @if (ActiveTest is not null && !IsTestDismissed)
                {
                    <div class="rc-filter-group-card rc-player-action-card @(HighlightActiveTest ? "rc-player-action-card--highlight" : string.Empty)">
                        <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                            <div class="rc-tool-panel__header-main">
                                <h5 class="rc-tool-panel__title">@L["Test_PlayerSectionTitle"]</h5>
                                <p class="rc-tool-panel__subtitle">@ActiveTest.AttributeName · @($"{ActiveTest.DiceCount}d{ActiveTest.DiceSides}")</p>
                            </div>

                            @if (ActiveTest.AlreadyRolled)
                            {
                                <div class="rc-tool-actions">
                                    <button type="button" class="rc-round-icon-button" @onclick="DismissActiveTest" title="@L["Common_Close"]">X</button>
                                </div>
                            }
                        </div>

                        @if (!ActiveTest.AlreadyRolled && ActiveTest.AutoRollAtUtc >= DateTime.UtcNow)
                        {
                            @if (IsRollingCurrentTest)
                            {
                                <div class="rc-player-roll-animation">
                                    <img src="/images/AnimatedDice_150.gif" alt="@L["Session_Player_RollingDice"]" height="70" width="70" />
                                </div>
                            }
                            else
                            {
                                <button type="button" @onclick="RollCurrentTest">@L["Test_RollButton", $"{ActiveTest.DiceCount}d{ActiveTest.DiceSides}"]</button>
                            }
                        }
                        else if (ActiveTest.Result is not null)
                        {
                            <div class="rc-tool-form-grid  rc-tool-form-grid--very-dense">
                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["Test_EffectiveAttributeValue"]</label>
                                    <div class="rc-readonly-value">@ActiveTest.Result.EffectiveAttributeValue</div>
                                </div>
                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["Test_FinalValue"]</label>
                                    <div class="rc-readonly-value">@ActiveTest.Result.FinalValue</div>
                                </div>
                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["Test_RollDelta"]</label>
                                    <div class="rc-readonly-value">
                                        @(ActiveTest.Result.FinalValue - ActiveTest.Result.EffectiveAttributeValue)
                                    </div>
                                </div>
                                <div class="rc-form-field rc-form-field--readonly">
                                    <label>@L["Test_Result"]</label>
                                    <div class="rc-player-test-outcome @(ActiveTest.Result.IsSuccess ? "success" : "failure")">
                                        @(ActiveTest.Result.IsSuccess? L["Test_Success"] : L["Test_Failure"])
                                    </div>
                                </div>
                            </div>

                            <p>@L["Test_DiceResults"] : @string.Join(" - ", ActiveTest.Result.DiceResults)</p>
                        }
                    </div>
                }

                @if (LatestPoll is not null && !IsPollDismissed)
                {
                    <div class="rc-filter-group-card rc-player-action-card @(HighlightLatestPoll ? "rc-player-action-card--highlight" : string.Empty)">
                        <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                            <div class="rc-tool-panel__header-main">
                                <h5 class="rc-tool-panel__title">@L["Poll_PlayerSectionTitle"]</h5>
                                <p class="rc-tool-panel__subtitle">@LatestPoll.Question</p>
                            </div>

                            @if (LatestPoll.IsClosed || LatestPoll.HasVoted)
                            {
                                <div class="rc-tool-actions">
                                    <button type="button" class="rc-round-icon-button" @onclick="DismissLatestPoll" title="@L["Common_Close"]">X</button>
                                </div>
                            }
                        </div>

                        @if (!LatestPoll.IsClosed && !LatestPoll.HasVoted)
                        {
                            <div class="rc-tool-actions">
                                @foreach (var option in LatestPoll.Options)
                                {
                                    <button type="button" @onclick="() => Vote(option.OptionId)">@option.Label</button>
                                }
                            </div>
                        }
                        else
                        {
                            @if (LatestPoll.HasVoted)
                            {
                                <p>@L["Poll_VoteRegistered"]</p>
                            }

                            @if (LatestPoll.SelectedOptionId.HasValue)
                            {
                                var selectedOption = LatestPoll.Options
                                    .FirstOrDefault(x => x.OptionId == LatestPoll.SelectedOptionId.Value);

                                @if (selectedOption is not null)
                                {
                                    <p>@L["Poll_YourVote"] : @selectedOption.Label</p>
                                }
                            }
                            
                        }
                    </div>
                }

                @if (!State.HasAssignedGameSystem)
                {
                    <div class="rc-empty-panel">
                        <p>@L["Session_Player_NoGameSystem"]</p>
                    </div>
                }
                else if (IsViewingDeadCharacter && ViewedDeadCharacter is not null)
                {
                    @RenderCharacterSheet(ViewedDeadCharacter, true)
                }
                else if (State.AliveCharacter is not null)
                {
                    @if (IsEditingBiography)
                    {
                        <div class="rc-player-character-sheet">
                            <div class="rc-player-character-sheet__hero">
                                <div class="rc-player-character-sheet__name">@State.AliveCharacter.Name</div>
                                <div class="rc-player-character-sheet__status @(State.AliveCharacter.IsAlive ? "alive" : "dead")">
                                    @(State.AliveCharacter.IsAlive? L["Common_Alive"] : L["Common_Dead"])
                                </div>
                            </div>

                            <div class="rc-filter-group-card">
                                <div class="rc-form-field rc-form-field--full">
                                    <label>@L["Common_Biography"]</label>
                                    <textarea rows="12" @bind="BiographyDraft"></textarea>
                                </div>
                            </div>
                        </div>
                    }
                    else if (ShowBiographyPanel)
                    {
                        <div class="rc-player-character-sheet">
                            <div class="rc-player-character-sheet__hero">
                                <div class="rc-player-character-sheet__name">@State.AliveCharacter.Name</div>
                                <div class="rc-player-character-sheet__status @(State.AliveCharacter.IsAlive ? "alive" : "dead")">
                                    @(State.AliveCharacter.IsAlive? L["Common_Alive"] : L["Common_Dead"])
                                </div>
                            </div>

                            <div class="rc-filter-group-card">
                                <div class="rc-detail-block__title">@L["Common_Biography"]</div>
                                @if (string.IsNullOrWhiteSpace(State.AliveCharacter.Biography))
                                {
                                    <p>@L["Session_Player_NoBiography"]</p>
                                }
                                else
                                {
                                    <div class="rc-player-character-sheet__biography">@State.AliveCharacter.Biography</div>
                                }
                            </div>
                        </div>
                    }
                    else if (ShowStorePanel && SessionStore?.Exists == true)
                    {
                        <div class="rc-filter-group-card">
                            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                                <div class="rc-tool-panel__header-main">
                                    <h5 class="rc-tool-panel__title">@L["Session_Store_Title"]</h5>
                                    @* <p class="rc-tool-panel__subtitle">@L["Session_Store_PlayerSubtitle"]</p> *@
                                </div>

                                @* <div class="rc-tool-actions">
                                    <button type="button" @onclick="CloseStorePanel">@L["Common_Close"]</button>
                                </div> *@
                            </div>

                            <div class="rc-form-field">
                                <label>@L["Session_Store_FilterGauge"]</label>
                                <select @bind="StoreGaugeFilterIdString" @bind:after="OnStoreGaugeFilterChanged">
                                    <option value="">@L["Session_Store_FilterAll"]</option>
                                    @foreach (var gauge in SessionStore.AvailableGauges)
                                    {
                                        <option value="@gauge.GaugeDefinitionId.ToString()">@gauge.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                                <label class="rc-filter-toggle">
                                    <input type="checkbox" @bind="HideOwnedStoreOffers" @bind:after="OnStoreOfferVisibilityFilterChanged" />
                                    <span>@L["Session_Store_HideOwned"]</span>
                                </label>@*

                                <label class="rc-filter-toggle">
                                    <input type="checkbox" @bind="HideTooExpensiveStoreOffers" @bind:after="OnStoreOfferVisibilityFilterChanged" />
                                    <span>@L["Session_Store_HideTooExpensive"]</span>
                                </label> *@

                                <label class="rc-filter-toggle">
                                    <input type="checkbox" @bind="ShowConsumableStoreOffersOnly" @bind:after="OnStoreOfferVisibilityFilterChanged" />
                                    <span>@L["Session_Store_ConsumablesOnly"]</span>
                                </label>
                            </div>

                            <div class="rc-session-store-list">
                                @foreach (var offer in GetVisibleStoreOffers())
                                {
                                    <div class="rc-session-store-offer">
                                        <div class="rc-session-store-offer__main">
                                            <div class="rc-session-store-offer__title">@offer.TargetName</div>
                                            <div class="rc-session-store-offer__meta">
                                                <span>@(offer.OfferType == SessionStoreOfferType.Talent ? L["Character_Edit_Talents"] : L["Character_Edit_Items"])</span>
                                                <span>·</span>
                                                <span>@offer.CurrencyGaugeName</span>
                                                <span>·</span>
                                                <span>@offer.Cost</span>
                                                @if (offer.IsConsumable)
                                                {
                                                    <span>·</span>
                                                    <span>@($"{offer.CurrentQuantity}/{offer.MaxQuantityPerCharacter}")</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="rc-tool-inline-actions">
                                            @if (PendingStoreOfferId == offer.OfferId)
                                            {
                                                <span class="rc-tool-muted">@L["Session_Store_BuyConfirm"]</span>
                                                <button type="button" @onclick="@(() => ConfirmPurchaseStoreOffer(offer.OfferId))">✓</button>
                                                <button type="button" @onclick="CancelPurchaseStoreOffer">X</button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        disabled="@(!offer.IsPurchasable)"
                                                        @onclick="@(() => BeginPurchaseStoreOffer(offer.OfferId))">
                                                    @L["Session_Store_Buy"]
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @RenderCharacterSheet(State.AliveCharacter, false)
                    }
                }
                else
                {
                    @if (IsCreatingCharacterInline && CreationTemplate is not null)
                    {
                        <div class="rc-filter-group-card">
                            <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                                <div class="rc-tool-panel__header-main">
                                    <h5 class="rc-tool-panel__title">@L["Session_Player_CreateCharacter"]</h5>
                                    <p class="rc-tool-panel__subtitle">@CreationTemplate.GameSystemName</p>
                                </div>
                            </div>

                            <div class="rc-tool-form-grid">
                                <div class="rc-form-field">
                                    <label>@L["Character_Edit_Name"]</label>
                                    <input value="@NewCharacterName"
                                           maxlength="22"
                                           @ref="NewCharacterNameInputRef"
                                           @oninput="OnNewCharacterNameInput" />
                                </div>

                                <div class="rc-form-field rc-form-field--full">
                                    <label>@L["Common_Biography"]</label>
                                    <textarea rows="4" @bind="NewCharacterBiography"></textarea>
                                </div>
                            </div>

                            @if (CreationTemplate.AttributePointsToDistribute > 0 && CreationTemplate.Attributes.Count > 0)
                            {
                                <div class="rc-detail-block">
                                    <div class="rc-detail-block__title">@L["CharacterCreation_AttributeDistributionTitle"]</div>
                                    <p class="rc-tool-muted">@L["CharacterCreation_PointsRemaining", RemainingCreationAttributePoints]</p>

                                    <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                                        @foreach (var typeattribute in CreationTemplate.Attributes)
                                        {
                                            <div class="rc-form-field">
                                                <label>@typeattribute.Name (+@typeattribute.DefaultValue)</label>
                                                <input type="number"
                                                       min="0"
                                                       max="@GetCreationAttributeInputMax(typeattribute.AttributeDefinitionId)"
                                                       value="@CreationAttributeValues[typeattribute.AttributeDefinitionId]"
                                                       @onchange="e => OnCreationAttributeBonusChanged(typeattribute.AttributeDefinitionId, e)" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (CreationTemplate.DerivedStatPointsToDistribute > 0 && CreationTemplate.DerivedStats.Count > 0)
                            {
                                <div class="rc-detail-block">
                                    <div class="rc-detail-block__title">@L["CharacterCreation_DerivedStatDistributionTitle"]</div>
                                    <p class="rc-tool-muted">@L["CharacterCreation_PointsRemaining", RemainingCreationDerivedStatPoints]</p>

                                    <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                                        @foreach (var derivedStat in CreationTemplate.DerivedStats)
                                        {
                                            <div class="rc-form-field">
                                                <label>@derivedStat.Name</label>
                                                <input type="number"
                                                       min="0"
                                                       max="@GetCreationDerivedStatInputMax(derivedStat.DerivedStatDefinitionId)"
                                                       value="@CreationDerivedStatValues[derivedStat.DerivedStatDefinitionId]"
                                                       @onchange="e => OnCreationDerivedStatBonusChanged(derivedStat.DerivedStatDefinitionId, e)" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (CreationTemplate.Traits.Count > 0)
                            {
                                <div class="rc-detail-block">
                                    <div class="rc-detail-block__title">@L["Session_Player_Traits"]</div>
                                    <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                                        @foreach (var trait in CreationTemplate.Traits)
                                        {
                                            <div class="rc-form-field">
                                                <label>@trait.Name</label>

                                                @if (trait.IsRandomSelectionGroup)
                                                {
                                                    <div class="rc-readonly-value">@L["Session_Player_RandomTraitGroup"]</div>
                                                }
                                                else
                                                {
                                                    <select @bind="CreationTraitSelections[trait.TraitDefinitionId]">
                                                        <option value="">@L["CharacterCreation_SelectOptionPlaceholder"]</option>
                                                        @foreach (var option in GetSelectableCreationOptions(trait))
                                                        {
                                                            <option value="@option.TraitOptionId">@option.Name</option>
                                                        }
                                                    </select>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (CreationTemplate.TalentChoicesToSelect > 0 && CreationTemplate.Talents.Count > 0)
                            {
                                <div class="rc-detail-block">
                                    <div class="rc-detail-block__title">@L["CharacterCreation_TalentChoicesTitle"]</div>
                                    <p class="rc-tool-muted">@L["CharacterCreation_ChoicesSelected", SelectedCreationTalentIds.Count, CreationTemplate.TalentChoicesToSelect]</p>
                                    <div class="rc-character-inline-list">
                                        @foreach (var talent in CreationTemplate.Talents)
                                        {
                                            <label class="rc-filter-toggle">
                                                <input type="checkbox"
                                                       checked="@SelectedCreationTalentIds.Contains(talent.TalentDefinitionId)"
                                                       disabled="@IsCreationTalentDisabled(talent.TalentDefinitionId)"
                                                       @onchange="e => ToggleCreationTalent(talent.TalentDefinitionId, e.Value is bool value && value)" />
                                                <span>@talent.Name</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }

                            @if (CreationTemplate.ItemChoicesToSelect > 0 && CreationTemplate.Items.Count > 0)
                            {
                                <div class="rc-detail-block">
                                    <div class="rc-detail-block__title">@L["CharacterCreation_ItemChoicesTitle"]</div>
                                    <p class="rc-tool-muted">@L["CharacterCreation_ChoicesSelected", SelectedCreationItemIds.Count, CreationTemplate.ItemChoicesToSelect]</p>
                                    <div class="rc-character-inline-list">
                                        @foreach (var item in CreationTemplate.Items)
                                        {
                                            <label class="rc-filter-toggle">
                                                <input type="checkbox"
                                                       checked="@SelectedCreationItemIds.Contains(item.ItemDefinitionId)"
                                                       disabled="@IsCreationItemDisabled(item.ItemDefinitionId)"
                                                       @onchange="e => ToggleCreationItem(item.ItemDefinitionId, e.Value is bool value && value)" />
                                                <span>@item.Name</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!IsRandomCharacterCreationEnabled && !AreRequiredCreationTraitsSelected())
                            {
                                <p class="rc-inline-warning">@L["CharacterCreation_RequiredTraits"]</p>
                            }

                            <div class="rc-tool-actions">
                                <label class="rc-filter-toggle">
                                    <input type="checkbox" @bind="IsRandomCharacterCreationEnabled" />
                                    <span>@L["CharacterCreation_RandomizeRemaining"]</span>
                                </label>

                                <button type="button"
                                        @onclick="HandleCreateCharacterInline"
                                        disabled="@(!CanSubmitCharacterCreation() || !CanSubmitCharacterName())">
                                    @L["Session_Player_CreateCharacter"]
                                </button>
                                <button type="button" @onclick="CancelInlineCharacterCreation">@L["Common_Cancel"]</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="rc-filter-group-card">
                            @if (State.DeadCharacters.Count == 0)
                            {
                                <p>@L["Session_Player_NoCharacterYet"]</p>
                            }
                            else
                            {
                                <p>@L["Session_Player_OnlyDeadCharacters"]</p>
                            }

                            @if (State.CanCreateNewCharacter)
                            {
                                <button type="button" @onclick="GoToCreateCharacter">@L["Session_Player_CreateNewCharacter"]</button>
                            }
                            else if (State.CanCreateNewCharacterAtUtc.HasValue)
                            {
                                <p>@L["Session_Player_CreateCharacterCountdown", RemainingCreationSeconds]</p>
                            }
                        </div>
                    }
                }

                @if (State.DeadCharacters.Count > 0)
                {
                    <div class="rc-filter-group-card">
                        <div class="rc-detail-block__title">@L["Session_Player_DeadCharacters"]</div>

                        <div class="rc-character-inline-list">
                            @foreach (var deadCharacter in State.DeadCharacters)
                            {
                                <button type="button" @onclick="() => ViewDeadCharacter(deadCharacter.CharacterId)">
                                    @deadCharacter.Name
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="rc-inline-error">@Message</div>
                }
            </div>
        </div>

        <aside class="rc-player-room__side">
            <div class="rc-tool-panel">
                <div class="rc-tool-panel__header rc-tool-panel__header--top-aligned">
                    <div class="rc-tool-panel__header-main">
                        <h4 class="rc-tool-panel__title">
                            @(ShowSessionCharactersPanel && State.CanViewSessionCharacters
                                ? L["Session_Player_SessionCharactersPanelTitle"]
                                : ShowJournalPanel
                                    ? L["Journal_PublicTab"]
                                    : L["Session_Player_StreamPanelTitle"])
                        </h4>
                        <p class="rc-tool-panel__subtitle">
                            @(ShowSessionCharactersPanel && State.CanViewSessionCharacters
                                ? L["Session_Player_SessionCharactersPanelSubtitle"]
                                : ShowJournalPanel
                                    ? L["Journal_PlayerSubtitle"]
                                    : L["Session_Player_StreamPanelSubtitle"])
                        </p>
                    </div>

                    <div class="rc-tool-actions">
                        @if (State.CanViewSessionCharacters)
                        {
                            @if (ShowSessionCharactersPanel)
                            {
                                <button type="button" @onclick="ShowStreamView">
                                    @L["Session_Player_ShowStreamPanel"]
                                </button>
                            }
                            else
                            {
                                <button type="button" @onclick="ShowSessionCharactersView">
                                    @L["Session_Player_ShowSessionCharactersPanel"]
                                </button>
                            }
                        }

                        @if (!ShowSessionCharactersPanel && PublicJournal is not null && PublicJournal.PublicPages.Count > 0)
                        {
                            <button type="button" @onclick="ToggleJournalPanel">
                                @(ShowJournalPanel? L["Journal_ShowStream"] : L["Journal_ShowJournal"])
                            </button>
                        }

                        @if (ShowEditSystemConfirm)
                        {
                            <div class="rc-filter-group-card">
                                <p>@L["Session_Player_EditSystemConfirmMessage"]</p>
                                <p class="rc-tool-muted">@L["Session_Player_EditSystemConfirmWarning"]</p>

                                <div class="rc-tool-actions">
                                    <button type="button" @onclick="ConfirmEditSessionGameSystem">@L["Common_Yes"]</button>
                                    <button type="button" @onclick="CancelEditSessionGameSystem">@L["Common_No"]</button>
                                </div>
                            </div>
                        }

                        @if (ShowSessionCharactersPanel && State.CanEditSessionCharacters)
                        {
                            <button type="button" @onclick="CreateNpcFromAssistantPanel">
                                @L["Session_Manage_CreateNpc"]
                            </button>
                        }

                        @if (!ShowSessionCharactersPanel)
                        {
                            <button type="button" @onclick="() => IsTwitchEnabled = !IsTwitchEnabled">
                                @(IsTwitchEnabled? L["Session_Player_DisableStream"] : L["Session_Player_EnableStream"])
                            </button>
                        }

                        @if (ShowSessionCharactersPanel && State.SessionGameSystemId.HasValue && State.CanEditSessionGameSystem && !ShowEditSystemConfirm)
                        {
                            <button type="button" @onclick="EditSessionGameSystem">
                                @L["Session_Player_EditSessionGameSystem"]
                            </button>
                        }
                    </div>
                </div>

                @if (ShowSessionCharactersPanel && State.CanViewSessionCharacters)
                {
                    <section class="rc-character-view">
                        <div class="rc-character-view__filters">
                            <label class="rc-filter-toggle">
                                <input type="checkbox" @bind="ShowObservedAttributes" />
                                <span>@L["Session_Manage_ShowAttributes"]</span>
                            </label>

                            <label class="rc-filter-toggle">
                                <input type="checkbox" @bind="ShowObservedDerivedStats" />
                                <span>@L["Session_Manage_ShowDerivedStats"]</span>
                            </label>

                            <label class="rc-filter-toggle">
                                <input type="checkbox" @bind="ShowObservedTraits" />
                                <span>@L["Session_Manage_ShowTraits"]</span>
                            </label>

                            <label class="rc-filter-toggle">
                                <input type="checkbox" @bind="ShowObservedGauges" />
                                <span>@L["Session_Manage_ShowGauges"]</span>
                            </label>

                            <label class="rc-filter-toggle">
                                <input type="checkbox" @bind="SpecialIncludeOffline" @bind:after="LoadSpecialRoleCharacters" />
                                <span>@L["Session_Manage_ShowOfflineCharacters"]</span>
                            </label>

                            <label class="rc-filter-toggle">
                                <input type="checkbox" @bind="SpecialIncludeDead" @bind:after="LoadSpecialRoleCharacters" />
                                <span>@L["Session_Manage_ShowDeadCharacters"]</span>
                            </label>
                            <label class="rc-filter-toggle">
                                <input type="checkbox" @bind="SpecialIncludeNpcs" @bind:after="LoadSpecialRoleCharacters" />
                                <span>@L["Session_Manage_ShowNpcs"]</span>
                            </label>

                            <div class="rc-filter-toggle">
                                <label>@L["Session_Manage_SortBy"]</label>
                                <select @bind="ObservedCharacterSortMode">
                                    @foreach (var option in GetObservedCharacterSortOptions())
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="rc-character-view__layout @(ObservedCharacterSheet is not null ? "has-selection" : string.Empty)">
                            <div class="rc-character-view__grid">
                                @if (SpecialRoleCharacters.Count == 0)
                                {
                                    <div class="rc-empty-panel">
                                        <p>@L["Session_Player_NoSessionCharactersVisible"]</p>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var character in GetSortedObservedCharacters())
                                    {
                                        var healthGauges = character.Gauges.Where(g => g.IsHealthGauge).ToList();
                                        var regularGauges = character.Gauges.Where(g => !g.IsHealthGauge).ToList();
                                        var isSelected = ObservedCharacterSheet?.CharacterId == character.CharacterId;

                                        <button type="button"
                                                class="rc-character-card @(isSelected ? "selected" : string.Empty)"
                                                @onclick="() => ToggleObservedCharacterDetails(character.CharacterId)">

                                            <div class="rc-character-card__header">
                                                <div class="rc-character-card__title-wrap">
                                                    <div class="rc-character-card__title">@character.CharacterName</div>

                                                    <div class="rc-character-card__player">
                                                        <span class="rc-character-card__player-name">@character.PlayerName</span>
                                                    </div>

                                                    <div class="rc-character-card__meta-row">
                                                        <span class="rc-character-chip @(character.IsAlive ? "alive" : "dead")">
                                                            @(character.IsAlive? L["Common_Alive"] : L["Common_Dead"])
                                                        </span>

                                                        <span class="rc-character-chip @(character.IsOnline ? "online" : "offline")">
                                                            @(character.IsOnline? L["Common_Online"] : L["Common_Offline"])
                                                        </span>

                                                        @if (character.IsNpc)
                                                        {
                                                            <span class="rc-character-chip npc">@L["Common_Npc"]</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            @if (ShowObservedAttributes && character.Attributes.Count > 0)
                                            {
                                                <div class="rc-character-card__section">
                                                    <div class="rc-character-card__section-title">@L["Session_Player_Attributes"]</div>
                                                    <div class="rc-character-inline-list">
                                                        @foreach (var attributeItem in character.Attributes)
                                                        {
                                                            <span class="rc-inline-pill">@attributeItem.Name: @attributeItem.Value</span>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (ShowObservedDerivedStats && character.DerivedStats.Count > 0)
                                            {
                                                <div class="rc-character-card__section">
                                                    <div class="rc-character-card__section-title">@L["Session_Player_DerivedStats"]</div>
                                                    <div class="rc-character-inline-list">
                                                        @foreach (var derivedItem in character.DerivedStats)
                                                        {
                                                            <span class="rc-inline-pill">@derivedItem.Name: @derivedItem.Value</span>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (ShowObservedTraits && character.Traits.Count > 0)
                                            {
                                                <div class="rc-character-card__section">
                                                    <div class="rc-character-card__section-title">@L["Session_Player_Traits"]</div>
                                                    <div class="rc-character-inline-list">
                                                        @foreach (var traitItem in character.Traits)
                                                        {
                                                            <span class="rc-inline-pill">@traitItem.TraitName: @traitItem.OptionName</span>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (healthGauges.Count > 0 || (ShowObservedGauges && regularGauges.Count > 0))
                                            {
                                                <div class="rc-character-card__section">
                                                    <div class="rc-character-card__section-title">@L["Session_Player_Gauges"]</div>

                                                    @if (healthGauges.Count > 0)
                                                    {
                                                        <div class="rc-character-gauges">
                                                            @foreach (var gauge in healthGauges)
                                                            {
                                                                var percent = gauge.MaxValue <= gauge.MinValue
                                                                    ? 0
                                                                    : Math.Clamp((int)Math.Round((double)(gauge.Value - gauge.MinValue) * 100 / (gauge.MaxValue - gauge.MinValue)), 0, 100);

                                                                <div class="rc-health-gauge">
                                                                    <div class="rc-health-gauge__header">
                                                                        <span>@gauge.Name</span>
                                                                        <strong>@gauge.Value / @gauge.MaxValue</strong>
                                                                    </div>
                                                                    <div class="rc-health-gauge__track">
                                                                        <div class="rc-health-gauge__fill" style="@($"width:{percent}%")"></div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }

                                                    @if (ShowObservedGauges && regularGauges.Count > 0)
                                                    {
                                                        <div class="rc-character-gauges">
                                                            @foreach (var gauge in regularGauges)
                                                            {
                                                                <div class="rc-character-gauge-line">
                                                                    <span class="rc-character-gauge-line__name">@gauge.Name</span>
                                                                    <span class="rc-character-gauge-line__value">@gauge.Value / @gauge.MaxValue</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </button>
                                    }
                                }
                            </div>

                            @if (ObservedCharacterSheet is not null)
                            {
                                <aside class="rc-character-detail-panel">
                                    <div class="rc-character-detail-panel__header">
                                        <div>
                                            <h5 class="rc-character-detail-panel__title">@ObservedCharacterSheet.Name</h5>
                                            <div class="rc-character-detail-panel__meta">
                                                <span class="rc-character-chip @(ObservedCharacterSheet.IsAlive ? "alive" : "dead")">
                                                    @(ObservedCharacterSheet.IsAlive? L["Common_Alive"] : L["Common_Dead"])
                                                </span>
                                            </div>
                                        </div>

                                        <div class="rc-character-detail-panel__actions">
                                            @if (State.CanEditSessionCharacters)
                                            {
                                                @if (IsObservedCharacterEditMode || IsObservedBiographyEditMode)
                                                {
                                                    <button type="button" @onclick="CancelObservedCharacterPanelEdition">@L["Common_Cancel"]</button>
                                                }
                                                else
                                                {
                                                    <button type="button" @onclick="BeginObservedCharacterEdit">@L["EditCharacter_EditCharacter"]</button>
                                                }
                                            }

                                            @if (!IsObservedCharacterEditMode && !IsObservedBiographyEditMode)
                                            {
                                                @if (ShowObservedCharacterBioPanel)
                                                {
                                                    @if (State.CanEditSessionCharacters)
                                                    {
                                                        <button type="button" @onclick="BeginObservedBiographyEdit">@L["Session_Player_EditBiography"]</button>
                                                    }
                                                    <button type="button" @onclick="HideObservedBiography">@L["Session_Player_Statistics"]</button>
                                                }
                                                else
                                                {
                                                    <button type="button" @onclick="ShowObservedBiography">@L["Session_Player_ViewBiography"]</button>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <div class="rc-character-detail-panel__body">
                                        @if (IsObservedCharacterEditMode && ObservedEditableCharacter is not null)
                                        {
                                            @* <div class="rc-tool-form-grid">
                                                <div class="rc-form-field">
                                                    <label>@L["Character_Edit_Name"]</label>
                                                    <input @bind="ObservedEditableCharacter.Name" />
                                                </div>

                                                @foreach (var typeattribute in ObservedEditableCharacter.Attributes)
                                                {
                                                    <div class="rc-form-field">
                                                                <label>@typeattribute.Name</label>
                                                                <input type="number" @bind="typeattribute.Value" />
                                                    </div>
                                                }

                                                @foreach (var gauge in ObservedEditableCharacter.Gauges)
                                                {
                                                    <div class="rc-form-field">
                                                        <label>@gauge.Name</label>
                                                        <input type="number" @bind="gauge.Value" />
                                                    </div>
                                                }

                                                @foreach (var trait in ObservedEditableCharacter.Traits)
                                                {
                                                    <div class="rc-form-field">
                                                        <label>@trait.TraitName</label>
                                                        <select @bind="trait.SelectedOptionId">
                                                            @foreach (var option in trait.Options)
                                                            {
                                                                <option value="@option.TraitOptionId">@option.Name</option>
                                                            }
                                                        </select>
                                                    </div>
                                                }
                                            </div> *@
                                            <div class="rc-detail-block">
                                                <div class="rc-detail-block__title">@L["Character_Edit_PlayerName"]</div>
                                                <div>@ObservedEditableCharacter.PlayerName</div>
                                            </div>

                                            <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                                                <div class="rc-form-field">
                                                    <label>@L["Character_Edit_Name"]</label>
                                                    <input @bind="ObservedEditableCharacter.Name" />
                                                </div>
                                            </div>

                                            <div class="rc-detail-block">
                                                <div class="rc-detail-block__title">@L["Session_Player_Attributes"]</div>
                                                <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                                                    @foreach (var attributeItem in ObservedEditableCharacter.Attributes)
                                                    {
                                                        <div class="rc-form-field">
                                                            <label>@attributeItem.Name (@attributeItem.MinValue - @attributeItem.MaxValue)</label>
                                                            <input type="number"
                                                                   min="@attributeItem.MinValue"
                                                                   max="@attributeItem.MaxValue"
                                                                   @bind="attributeItem.Value" />
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            @if (ObservedEditableCharacter.DerivedStats.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["Session_Player_DerivedStats"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var derived in ObservedEditableCharacter.DerivedStats)
                                                        {
                                                            <li>@derived.Name : @derived.Value</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedEditableCharacter.Metrics.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["Session_Player_Metrics"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var metric in ObservedEditableCharacter.Metrics)
                                                        {
                                                            <li>@metric.Name : @metric.Value</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            <div class="rc-detail-block">
                                                <div class="rc-detail-block__title">@L["Session_Player_Traits"]</div>
                                                <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                                                    @foreach (var traitItem in ObservedEditableCharacter.Traits)
                                                    {
                                                        <div class="rc-form-field">
                                                            <label>@traitItem.TraitName</label>
                                                            <select @bind="traitItem.SelectedOptionId">
                                                                <option value="">--</option>
                                                                @foreach (var optionItem in traitItem.Options)
                                                                {
                                                                    <option value="@optionItem.TraitOptionId">@optionItem.Name</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="rc-detail-block">
                                                <div class="rc-detail-block__title">@L["Session_Player_Gauges"]</div>
                                                <div class="rc-tool-form-grid rc-tool-form-grid--dense">
                                                    @foreach (var gaugeItem in ObservedEditableCharacter.Gauges)
                                                    {
                                                        <div class="rc-form-field">
                                                            <label>
                                                                @gaugeItem.Name (@gaugeItem.MinValue - @gaugeItem.MaxValue)
                                                                @if (gaugeItem.IsHealthGauge)
                                                                {
                                                                    <span>- @L["Character_Edit_HealthGauge"]</span>
                                                                }
                                                            </label>
                                                            <input type="number"
                                                                   min="@gaugeItem.MinValue"
                                                                   max="@gaugeItem.MaxValue"
                                                                   @bind="gaugeItem.Value" />
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="rc-detail-block">
                                                <div class="rc-detail-block__title">@L["Character_Edit_Talents"]</div>
                                                @if (ObservedEditableCharacter.Talents.Count == 0)
                                                {
                                                    <p>@L["Character_Edit_NoTalentsDefined"]</p>
                                                }
                                                else
                                                {
                                                    <div class="rc-character-inline-list">
                                                        @foreach (var talentItem in ObservedEditableCharacter.Talents)
                                                        {
                                                            <label class="rc-filter-toggle">
                                                                <input type="checkbox" @bind="talentItem.IsSelected" />
                                                                <span>@talentItem.Name</span>
                                                            </label>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <div class="rc-detail-block">
                                                <div class="rc-detail-block__title">@L["Character_Edit_Items"]</div>
                                                @if (ObservedEditableCharacter.Items.Count == 0)
                                                {
                                                    <p>@L["Character_Edit_NoItemsDefined"]</p>
                                                }
                                                else
                                                {
                                                    <div class="rc-character-inline-list">
                                                        @foreach (var item in ObservedEditableCharacter.Items)
                                                        {
                                                            <div class="rc-consumable-edit-line">
                                                                <label class="rc-filter-toggle">
                                                                    <input type="checkbox" @bind="item.IsSelected" />
                                                                    <span>@item.Name</span>
                                                                </label>
                                                                @if (item.IsConsumable && item.IsSelected)
                                                                {
                                                                    <input type="number"
                                                                           min="0"
                                                                           max="@item.MaxQuantityPerCharacter"
                                                                           @bind="item.Quantity"
                                                                           class="rc-consumable-qty-input" />
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>


                                            <div class="rc-tool-actions">
                                                <button type="button" @onclick="SaveObservedCharacterEdits">@L["Common_Save"]</button>
                                            </div>
                                        }
                                        else if (IsObservedBiographyEditMode && ObservedEditableCharacter is not null)
                                        {
                                            <div class="rc-form-field rc-form-field--full">
                                                <label>@L["Common_Biography"]</label>
                                                <textarea rows="12" @bind="ObservedEditableCharacter.Biography"></textarea>
                                            </div>

                                            <div class="rc-tool-actions">
                                                <button type="button" @onclick="SaveObservedBiography">@L["Common_Save"]</button>
                                            </div>
                                        }
                                        else if (ShowObservedCharacterBioPanel)
                                        {
                                            <div class="rc-character-bio">
                                                @if (string.IsNullOrWhiteSpace(ObservedCharacterSheet.Biography))
                                                {
                                                    <span>@L["Session_Player_NoBiography"]</span>
                                                }
                                                else
                                                {
                                                    @ObservedCharacterSheet.Biography
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="rc-detail-block">
                                                <div class="rc-detail-block__title">@L["Session_Player_Attributes"]</div>
                                                <ul class="rc-detail-list">
                                                    @foreach (var item in ObservedCharacterSheet.Attributes)
                                                    {
                                                        <li>@item.Name : @item.Value</li>
                                                    }
                                                </ul>
                                            </div>

                                            @if (ObservedCharacterSheet.DerivedStats.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["Session_Player_DerivedStats"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var item in ObservedCharacterSheet.DerivedStats)
                                                        {
                                                            <li>@item.Name : @item.Value</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedCharacterSheet.Traits.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["Session_Player_Traits"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var item in ObservedCharacterSheet.Traits)
                                                        {
                                                            <li>@item.TraitName : @item.OptionName</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedCharacterSheet.Talents.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["Character_Edit_Talents"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var item in ObservedCharacterSheet.Talents)
                                                        {
                                                            <li>@item.Name</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedCharacterSheet.Items.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["Character_Edit_Items"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var item in ObservedCharacterSheet.Items)
                                                        {
                                                            <li>@item.Name</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedCharacterSheet.Gauges.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["Session_Player_Gauges"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var gauge in ObservedCharacterSheet.Gauges)
                                                        {
                                                            <li>@gauge.Name : @gauge.Value / @gauge.MaxValue</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        }

                                        @if (!string.IsNullOrWhiteSpace(ObservedCharacterPanelMessage))
                                        {
                                            <div class="rc-inline-error">@ObservedCharacterPanelMessage</div>
                                        }
                                    </div>
                                </aside>
                            }
                        </div>
                    </section>
                }
                else if (ShowJournalPanel)
                {
                    @if (CurrentPublicJournalPage is null)
                    {
                        <div class="rc-empty-panel rc-empty-panel--small">
                            <p>@L["Journal_EmptyPage"]</p>
                        </div>
                    }
                    else
                    {
                        <section class="rc-journal-viewer">
                            <div class="rc-journal-viewer__nav">
                                <button type="button" @onclick="PreviousPublicJournalPage" disabled="@(CurrentPublicJournalPageIndex <= 0)">&lt;</button>
                                <span class="rc-journal-viewer__page-number">@CurrentPublicJournalPage.PageNumber</span>
                                <button type="button" @onclick="NextPublicJournalPage" disabled="@(PublicJournal is null || CurrentPublicJournalPageIndex >= PublicJournal.PublicPages.Count - 1)">&gt;</button>
                                <span class="rc-journal-viewer__page-title">@GetJournalDisplayTitle(CurrentPublicJournalPage)</span>
                            </div>

                            @if (string.IsNullOrWhiteSpace(CurrentPublicJournalPage.ContentHtml))
                            {
                                <div class="rc-empty-panel rc-empty-panel--small">
                                    <p>@L["Journal_EmptyPage"]</p>
                                </div>
                            }
                            else
                            {
                                <div class="rc-journal-content">
                                    @((MarkupString)CurrentPublicJournalPage.ContentHtml)
                                </div>
                            }
                        </section>
                    }
                }
                else
                {
                    @if (!IsTwitchEnabled)
                    {
                        <div class="rc-empty-panel rc-empty-panel--small">
                            <p>@L["Session_Player_StreamDisabled"]</p>
                        </div>
                    }
                    else if (string.IsNullOrWhiteSpace(TwitchChannelName))
                    {
                        <div class="rc-empty-panel rc-empty-panel--small">
                            <p>@L["Session_Player_NoTwitchStreamConfigured"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="rc-player-stream">
                            @if (ShowTwitchChat)
                            {
                                <iframe class="rc-player-stream__chat"
                                        src="@($"https://www.twitch.tv/embed/{TwitchChannelName}/chat?parent={TwitchParentHost}")">
                                </iframe>
                            }

                            <iframe class="rc-player-stream__video"
                                    src="@($"https://player.twitch.tv/?channel={TwitchChannelName}&parent={TwitchParentHost}")"
                                    allow="fullscreen">
                            </iframe>
                        </div>

                        <div class="rc-tool-actions" style="margin-top: 0.75rem;">
                            <button type="button" @onclick="() => ShowTwitchChat = !ShowTwitchChat">
                                @(ShowTwitchChat? L["Session_Player_HideChat"] : L["Session_Player_ShowChat"])
                            </button>
                        </div>
                    }
                }
            </div>
        </aside>
    </section>
}

@code {
    [Parameter] public Guid PlayerSessionId { get; set; }
    [SupplyParameterFromQuery(Name = "restored")] public string? RestoredFlag { get; set; }
    [CascadingParameter(Name = "RollocracyAlertSoundEnabled")] public bool IsAlertSoundEnabled { get; set; } = true;

    private bool IsLoaded;
    private string Message = string.Empty;
    private PlayerRoomStateDto? State;
    private CharacterSheetDto? ViewedDeadCharacter;
    private ActivePlayerGameTestDto? ActiveTest;
    private List<SessionCharacterSummaryDto> SpecialRoleCharacters { get; set; } = new();
    private CharacterSheetDto? ObservedCharacterSheet;
    private bool SpecialIncludeOffline;
    private bool SpecialIncludeDead;
    private HubConnection? hubConnection;
    private bool PresenceJoined;
    private IJSObjectReference? presenceModule;
    private bool leaveBeaconRegistered;
    private bool _isDisposed;
    private readonly System.Threading.SemaphoreSlim _hubRefreshLock = new(1, 1);
    private Guid CurrentUserId;
    private bool RedirectToLogin;

    private bool ShowSessionCharactersPanel;
    private bool ShowObservedAttributes = false;
    private bool ShowObservedDerivedStats = false;
    private bool ShowObservedTraits = true;
    private bool ShowObservedGauges = false;
    private bool SpecialIncludeNpcs;
    private string ObservedCharacterSortMode = "character-name";

    private SessionJournalViewDto? PublicJournal;
    private bool ShowJournalPanel;
    private int CurrentPublicJournalPageIndex;

    private EditableCharacterDto? ObservedEditableCharacter;
    private bool IsObservedCharacterEditMode;
    private bool IsObservedBiographyEditMode;
    private bool ShowObservedCharacterBioPanel;
    private string ObservedCharacterPanelMessage = string.Empty;
    private bool ShowEditSystemConfirm;
    private bool IsRollingCurrentTest;
    private CharacterCreationTemplateDto? CreationTemplate;
    private string NewCharacterName = string.Empty;
    private string NewCharacterBiography = string.Empty;
    private Dictionary<Guid, int> CreationAttributeValues = new();
    private Dictionary<Guid, int> CreationDerivedStatValues = new();
    private Dictionary<Guid, Guid?> CreationTraitSelections = new();
    private bool IsRandomCharacterCreationEnabled;
    private HashSet<Guid> SelectedCreationTalentIds = new();
    private HashSet<Guid> SelectedCreationItemIds = new();

    private bool IsCreatingCharacterInline;
    private bool IsEditingBiography;
    private string BiographyDraft = string.Empty;
    private bool ShowBiographyPanel;
    private bool IsViewingDeadCharacter => ViewedDeadCharacter is not null;

    private ElementReference NewCharacterNameInputRef;
    private bool IsNewCharacterNameInputFilterAttached;

    private Guid? PendingConsumableItemDefinitionId;
    private PlayerSessionStoreDto? SessionStore;
    private bool ShowStorePanel;
    private Guid? StoreGaugeFilterId;
    private string StoreGaugeFilterIdString = string.Empty;
    private Guid? PendingStoreOfferId;
    private bool HideOwnedStoreOffers;
    private bool HideTooExpensiveStoreOffers;
    private bool ShowConsumableStoreOffersOnly;

    private bool IsTwitchEnabled = false;
    private bool ShowTwitchChat = true;
    private bool IsTestDismissed;
    private bool IsPollDismissed;
    private bool HighlightActiveTest;
    private bool HighlightLatestPoll;
    private Guid? LastAlertedActiveTestId;
    private Guid? LastAlertedPollId;
    private CancellationTokenSource? ActiveTestHighlightCancellation;
    private CancellationTokenSource? LatestPollHighlightCancellation;

    private int DiffTestResult;

    // Le live Twitch affiché côté joueur découle du compte Twitch du MJ.
    // Si le MJ n'a pas lié Twitch, on n'affiche pas l'embed.
    private string? TwitchChannelName
        => string.IsNullOrWhiteSpace(State?.GameMasterTwitchLogin)
            ? null
            : State.GameMasterTwitchLogin;

    private string TwitchParentHost => new Uri(Navigation.BaseUri).Host;

    private bool CanAlertForCurrentTest(ActivePlayerGameTestDto? test)
        => test is not null && !test.AlreadyRolled && test.AutoRollAtUtc >= DateTime.UtcNow;

    private bool CanAlertForCurrentPoll(PollForPlayerDto? poll)
        => poll is not null && !poll.IsClosed && !poll.HasVoted;

    private async Task TriggerActiveTestAlertAsync(Guid gameTestId)
    {
        LastAlertedActiveTestId = gameTestId;
        ActiveTestHighlightCancellation = await TriggerRoomAlertAsync(
            setHighlight: value => HighlightActiveTest = value,
            cancellationSource: ActiveTestHighlightCancellation);
    }

    private async Task TriggerLatestPollAlertAsync(Guid pollId)
    {
        LastAlertedPollId = pollId;
        LatestPollHighlightCancellation = await TriggerRoomAlertAsync(
            setHighlight: value => HighlightLatestPoll = value,
            cancellationSource: LatestPollHighlightCancellation);
    }

    private async Task<CancellationTokenSource> TriggerRoomAlertAsync(
    Action<bool> setHighlight,
    CancellationTokenSource? cancellationSource)
    {
        cancellationSource?.Cancel();
        cancellationSource?.Dispose();

        var newCancellationSource = new CancellationTokenSource();
        var token = newCancellationSource.Token;

        setHighlight(true);
        await InvokeAsync(StateHasChanged);

        if (presenceModule is not null && IsAlertSoundEnabled)
        {
            try
            {
                await presenceModule.InvokeVoidAsync("playAlertSound");
            }
            catch
            {
            }
        }

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(4000, token);
                if (token.IsCancellationRequested)
                    return;

                if (_isDisposed)
                    return;

                setHighlight(false);
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException)
            {
            }
        });

        return newCancellationSource;
    }


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToLogin = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);

        await LoadState(refreshJournal: false);
        await LoadActiveTest(allowArrivalAlert: false);
        await LoadLatestPoll(allowArrivalAlert: false);
        await LoadPublicJournal();
        await InitializeHubIfNeeded();
        StartCreationCountdownIfNeeded();

        if (RestoredFlag == "1")
        {
            Message = L["Session_Player_OldCharacterRestored"];
        }

        IsLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToLogin)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (firstRender)
        {
            presenceModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/playerPresence.js");

            await RegisterBrowserPresenceIfNeededAsync();
        }

        if (IsCreatingCharacterInline && CreationTemplate is not null && !IsNewCharacterNameInputFilterAttached)
        {
            try
            {
                await JS.InvokeVoidAsync("rollocracyRoom.attachCharacterNameFilter", NewCharacterNameInputRef);
                IsNewCharacterNameInputFilterAttached = true;
            }
            catch
            {
            }
        }

        if ((!IsCreatingCharacterInline || CreationTemplate is null) && IsNewCharacterNameInputFilterAttached)
        {
            IsNewCharacterNameInputFilterAttached = false;
        }
    }

    private async Task RegisterBrowserPresenceIfNeededAsync()
    {
        if (presenceModule is null || State is null || !PresenceJoined)
            return;

        await presenceModule.InvokeVoidAsync(
