    private List<PlayerSessionStoreOfferDto> GetVisibleStoreOffers()
    {
        if (SessionStore is null)
            return new List<PlayerSessionStoreOfferDto>();

        var query = SessionStore.Offers.AsEnumerable();

        if (StoreGaugeFilterId.HasValue)
        {
            query = query.Where(x => x.CurrencyGaugeDefinitionId == StoreGaugeFilterId.Value);
        }

        if (HideOwnedStoreOffers)
        {
            query = query.Where(x => !x.IsOwned || x.IsConsumable);
        }

        if (HideTooExpensiveStoreOffers)
        {
            query = query.Where(x => x.IsPurchasable);
        }

        if (ShowConsumableStoreOffersOnly)
        {
            query = query.Where(x => x.IsConsumable);
        }

        return query
            .OrderBy(x => x.CurrencyGaugeName, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(x => x.OfferType)
            .ThenBy(x => x.TargetName, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

