                                            </div>


                                    <div class="rc-tool-actions">
                                        <button type="button" @onclick="SaveObservedCharacterEdits">@L["Common_Save"]</button>
                                    </div>
                                }
                                else if (IsObservedBiographyEditMode && ObservedEditableCharacter is not null)
                                {
                                    <div class="rc-form-field rc-form-field--full">
                                        <label>@L["EditCharacter_Biography"]</label>
                                        <textarea rows="12" @bind="ObservedEditableCharacter.Biography"></textarea>
                                    </div>

                                    <div class="rc-tool-actions">
                                        <button type="button" @onclick="SaveObservedBiography">@L["Common_Save"]</button>
                                    </div>
                                }
                                else if (ShowObservedCharacterBioPanel)
                                {
                                    <div class="rc-character-bio">
                                        @if (string.IsNullOrWhiteSpace(ObservedCharacterSheet.Biography))
                                        {
                                            <span>@L["PlayerRoom_NoBiography"]</span>
                                        }
                                        else
                                        {
                                            @ObservedCharacterSheet.Biography
                                        }
                                    </div>
                                }
                                        else
                                        {
                                            <div class="rc-detail-block">
                                                <div class="rc-detail-block__title">@L["PlayerRoom_Attributes"]</div>
                                                <ul class="rc-detail-list">
                                                    @foreach (var item in ObservedCharacterSheet.Attributes)
                                                    {
                                                        <li>@item.Name : @item.Value</li>
                                                    }
                                                </ul>
                                            </div>

                                            @if (ObservedCharacterSheet.DerivedStats.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["PlayerRoom_DerivedStats"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var item in ObservedCharacterSheet.DerivedStats)
                                                        {
                                                            <li>@item.Name : @item.Value</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedCharacterSheet.Traits.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["PlayerRoom_Traits"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var item in ObservedCharacterSheet.Traits)
                                                        {
                                                            <li>@item.TraitName : @item.OptionName</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedCharacterSheet.Talents.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["EditCharacter_Talents"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var item in ObservedCharacterSheet.Talents)
                                                        {
                                                            <li>@item.Name</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedCharacterSheet.Items.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["EditCharacter_Items"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var item in ObservedCharacterSheet.Items)
                                                        {
                                                            <li>@item.Name</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (ObservedCharacterSheet.Gauges.Count > 0)
                                            {
                                                <div class="rc-detail-block">
                                                    <div class="rc-detail-block__title">@L["PlayerRoom_Gauges"]</div>
                                                    <ul class="rc-detail-list">
                                                        @foreach (var gauge in ObservedCharacterSheet.Gauges)
                                                        {
                                                            <li>@gauge.Name : @gauge.Value / @gauge.MaxValue</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        }

                                @if (!string.IsNullOrWhiteSpace(ObservedCharacterPanelMessage))
                                {
                                    <div class="rc-inline-error">@ObservedCharacterPanelMessage</div>
                                }
                            </div>
                        </aside>
                    }
                </div>
            </section>
        }
        else
        {
            @if (!IsTwitchEnabled)
            {
                <div class="rc-empty-panel rc-empty-panel--small">
                    <p>@L["PlayerRoom_StreamDisabled"]</p>
                </div>
            }
            else
            {
                <div class="rc-player-stream">
                    @if (ShowTwitchChat)
                    {
                        <iframe class="rc-player-stream__chat"
                                src="@($"https://www.twitch.tv/embed/{TwitchChannelName}/chat?parent={TwitchParentHost}")">
                        </iframe>
                    }

                    <iframe class="rc-player-stream__video"
                            src="@($"https://player.twitch.tv/?channel={TwitchChannelName}&parent={TwitchParentHost}")"
                            allow="fullscreen">
                    </iframe>
                </div>

                <div class="rc-tool-actions" style="margin-top: 0.75rem;">
                    <button type="button" @onclick="() => ShowTwitchChat = !ShowTwitchChat">
                        @(ShowTwitchChat ? L["PlayerRoom_HideChat"] : L["PlayerRoom_ShowChat"])
                    </button>
                </div>
            }
        }
    </div>
</aside>
    </section>
}

@code {
    [Parameter] public Guid PlayerSessionId { get; set; }
    [SupplyParameterFromQuery(Name = "restored")] public string? RestoredFlag { get; set; }

    private bool IsLoaded;
    private string Message = string.Empty;
    private PlayerRoomStateDto? State;
    private CharacterSheetDto? ViewedDeadCharacter;
    private ActivePlayerGameTestDto? ActiveTest;
    private List<SessionCharacterSummaryDto> SpecialRoleCharacters { get; set; } = new();
    private CharacterSheetDto? ObservedCharacterSheet;
    private bool SpecialIncludeOffline;
    private bool SpecialIncludeDead;
    private HubConnection? hubConnection;
    private bool PresenceJoined;
    private Guid CurrentUserId;
    private bool RedirectToLogin;

    private bool ShowSessionCharactersPanel;
    private bool ShowObservedAttributes = false;
    private bool ShowObservedDerivedStats = false;
    private bool ShowObservedTraits = true;
    private bool ShowObservedGauges = false;
    private bool SpecialIncludeNpcs;
    private string ObservedCharacterSortMode = "character-name";

    private EditableCharacterDto? ObservedEditableCharacter;
    private bool IsObservedCharacterEditMode;
    private bool IsObservedBiographyEditMode;
    private bool ShowObservedCharacterBioPanel;
    private string ObservedCharacterPanelMessage = string.Empty;
    private bool ShowEditSystemConfirm;
    private bool IsRollingCurrentTest;
    private CharacterCreationTemplateDto? CreationTemplate;
    private string NewCharacterName = string.Empty;
    private string NewCharacterBiography = string.Empty;
    private Dictionary<Guid, int> CreationAttributeValues = new();
    private Dictionary<Guid, Guid> CreationTraitSelections = new();

    private bool IsCreatingCharacterInline;
    private bool IsEditingBiography;
    private string BiographyDraft = string.Empty;
    private bool ShowBiographyPanel;
    private bool IsViewingDeadCharacter => ViewedDeadCharacter is not null;

    private bool IsTwitchEnabled = false;
    private bool ShowTwitchChat = true;
    private bool IsTestDismissed;
    private bool IsPollDismissed;

    private const string TwitchChannelName = "silkinaeltv";
    private string TwitchParentHost => new Uri(Navigation.BaseUri).Host;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        var userIdValue = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!isAuthenticated || string.IsNullOrWhiteSpace(userIdValue))
        {
            RedirectToLogin = true;
            IsLoaded = true;
            return;
        }

        CurrentUserId = Guid.Parse(userIdValue);

        await LoadState();
        await LoadActiveTest();
        await LoadLatestPoll();
        await InitializeHubIfNeeded();
        StartCreationCountdownIfNeeded();

        if (RestoredFlag == "1")
        {
            Message = L["PlayerRoom_OldCharacterRestored"];
        }

        IsLoaded = true;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RedirectToLogin)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadState()
    {
        try
        {
            Message = string.Empty;
            State = await CharacterService.GetPlayerRoomStateAsync(PlayerSessionId);

            if (State?.AliveCharacter is null)
            {
                IsEditingBiography = false;
                ShowBiographyPanel = false;
            }

            ViewedDeadCharacter = null;
            StartCreationCountdownIfNeeded();

            if (State is not null && !State.CanCreateNewCharacter)
            {
                IsCreatingCharacterInline = false;
                CreationTemplate = null;
            }

            if (State?.CanViewSessionCharacters == true)
            {
                await LoadSpecialRoleCharacters();
            }
            else
            {
                SpecialRoleCharacters.Clear();
                ObservedCharacterSheet = null;
                ObservedEditableCharacter = null;
                IsObservedCharacterEditMode = false;
                IsObservedBiographyEditMode = false;
                ShowObservedCharacterBioPanel = false;
            }
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task LoadActiveTest()
    {
        try
        {
            ActiveTest = await GameTestService.GetActiveGameTestForPlayerAsync(PlayerSessionId);
            IsTestDismissed = false;
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task InitializeHubIfNeeded()
    {
        if (State is null)
            return;

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/sessionhub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("PresenceChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadState();
                StateHasChanged();
            });
        });

        hubConnection.On("CharacterStateChanged", async () =>
{
    await InvokeAsync(async () =>
    {
        await LoadState();
        await LoadActiveTest();
        await LoadLatestPoll();
        StateHasChanged();
    });
});

        hubConnection.On("TestChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadState();
                await LoadActiveTest();
                StateHasChanged();
            });
        });

        hubConnection.On("PollChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadState();
                await LoadLatestPoll();
                StateHasChanged();
            });
        });

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("JoinSessionGroup", State.SessionId.ToString());

        if (State.AliveCharacter is not null || State.DeadCharacters.Count > 0)
        {
            await hubConnection.SendAsync(
                "JoinPlayerPresence",
                State.SessionId.ToString(),
                PlayerSessionId.ToString(),
                false);

            PresenceJoined = true;
        }
    }

    private async Task RollCurrentTest()
    {
        try
        {
            if (ActiveTest is null || IsRollingCurrentTest)
                return;

            Message = string.Empty;
            IsRollingCurrentTest = true;

            StateHasChanged();
            await Task.Delay(1000);

            await GameTestService.RollForPlayerAsync(PlayerSessionId, ActiveTest.GameTestId, false);
            await LoadActiveTest();
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
        finally
        {
            IsRollingCurrentTest = false;
        }
    }

    private async Task GoToCreateCharacter()
    {
        try
        {
            Message = string.Empty;

            CreationTemplate = await CharacterService.GetCharacterCreationTemplateAsync(PlayerSessionId);
            CreationAttributeValues.Clear();
            CreationTraitSelections.Clear();

            foreach (var attribute in CreationTemplate.Attributes)
            {
                CreationAttributeValues[attribute.AttributeDefinitionId] = attribute.DefaultValue;
            }

            foreach (var trait in CreationTemplate.Traits)
            {
                if (trait.IsRandomSelectionGroup)
                    continue;

                var firstUnlockedOption = trait.Options.FirstOrDefault(x => !x.IsLockedForCharacterCreation);
                if (firstUnlockedOption is not null)
                {
                    CreationTraitSelections[trait.TraitDefinitionId] = firstUnlockedOption.TraitOptionId;
                }
            }

            NewCharacterName = string.Empty;
            NewCharacterBiography = string.Empty;
            IsCreatingCharacterInline = true;
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private Task CancelInlineCharacterCreation()
    {
        IsCreatingCharacterInline = false;
        CreationTemplate = null;
        NewCharacterName = string.Empty;
        NewCharacterBiography = string.Empty;
        CreationAttributeValues.Clear();
        CreationTraitSelections.Clear();
        return Task.CompletedTask;
    }

    private async Task HandleCreateCharacterInline()
    {
        try
        {
            if (CreationTemplate is null)
                return;

            Message = string.Empty;

            await CharacterService.CreateCharacterAsync(
                PlayerSessionId,
                NewCharacterName,
                NewCharacterBiography,
                CreationAttributeValues,
                CreationTraitSelections);

            await SessionNotifier.NotifyCharacterStateChangedAsync(CreationTemplate.SessionId);

            IsCreatingCharacterInline = false;
            await LoadState();
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task LoadDeadCharacter(Guid characterId)
    {
        try
        {
            ViewedDeadCharacter = await CharacterService.GetCharacterSheetAsync(PlayerSessionId, characterId);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task ViewDeadCharacter(Guid characterId)
    {
        await LoadDeadCharacter(characterId);
        ShowBiographyPanel = false;
        IsEditingBiography = false;
    }

    private Task CloseViewedDeadCharacter()
    {
        ViewedDeadCharacter = null;
        return Task.CompletedTask;
    }

    private void BeginBiographyEdit()
    {
        if (State?.AliveCharacter is null)
            return;

        ShowBiographyPanel = true;
        BiographyDraft = State.AliveCharacter.Biography ?? string.Empty;
        IsEditingBiography = true;
        Message = string.Empty;
    }

    private void ShowBiographyView()
    {
        ShowBiographyPanel = true;
        IsEditingBiography = false;
        BiographyDraft = State?.AliveCharacter?.Biography ?? string.Empty;
    }

    private void ShowStatsView()
    {
        ShowBiographyPanel = false;
        IsEditingBiography = false;
    }

    private Task CancelBiographyEdit()
    {
        IsEditingBiography = false;
        ShowBiographyPanel = true;
        BiographyDraft = State?.AliveCharacter?.Biography ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task SaveBiography()
    {
        try
        {
            if (State?.AliveCharacter is null)
                return;

            Message = string.Empty;

            await CharacterService.UpdateCharacterBiographyForPlayerAsync(
                PlayerSessionId,
                State.AliveCharacter.CharacterId,
                BiographyDraft);

            IsEditingBiography = false;
            await LoadState();
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task LoadSpecialRoleCharacters()
    {
        try
        {
            if (State is null || !State.CanViewSessionCharacters)
            {
                SpecialRoleCharacters.Clear();
                ObservedCharacterSheet = null;
                return;
            }

            SpecialRoleCharacters = await CharacterService.GetSessionCharacterSummariesForPlayerAsync(
                PlayerSessionId,
                SpecialIncludeOffline,
                SpecialIncludeDead,
                SpecialIncludeNpcs);

            if (ObservedCharacterSheet is not null)
            {
                ObservedCharacterSheet = await CharacterService.GetCharacterSheetForPlayerAsync(PlayerSessionId, ObservedCharacterSheet.CharacterId);
            }
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task ToggleObservedCharacterDetails(Guid characterId)
    {
        try
        {
            if (ObservedCharacterSheet?.CharacterId == characterId)
            {
                ObservedCharacterSheet = null;
                ObservedEditableCharacter = null;
                IsObservedCharacterEditMode = false;
                IsObservedBiographyEditMode = false;
                ShowObservedCharacterBioPanel = false;
                ObservedCharacterPanelMessage = string.Empty;
                return;
            }

            ObservedCharacterSheet = await CharacterService.GetCharacterSheetForPlayerAsync(PlayerSessionId, characterId);
            ObservedEditableCharacter = null;
            IsObservedCharacterEditMode = false;
            IsObservedBiographyEditMode = false;
            ShowObservedCharacterBioPanel = false;
            ObservedCharacterPanelMessage = string.Empty;
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task BeginObservedCharacterEdit()
    {
        if (State is null || ObservedCharacterSheet is null || !State.CanEditSessionCharacters)
            return;

        ObservedEditableCharacter = await CharacterService.GetEditableCharacterForSessionAsync(
            State.SessionId,
            ObservedCharacterSheet.CharacterId,
            CurrentUserId);

        IsObservedCharacterEditMode = ObservedEditableCharacter is not null;
        IsObservedBiographyEditMode = false;
        ShowObservedCharacterBioPanel = false;
        ObservedCharacterPanelMessage = string.Empty;
    }

    private async Task BeginObservedBiographyEdit()
    {
        if (State is null || ObservedCharacterSheet is null || !State.CanEditSessionCharacters)
            return;

        ObservedEditableCharacter = await CharacterService.GetEditableCharacterForSessionAsync(
            State.SessionId,
            ObservedCharacterSheet.CharacterId,
            CurrentUserId);

        ShowObservedCharacterBioPanel = true;
        IsObservedBiographyEditMode = ObservedEditableCharacter is not null;
        IsObservedCharacterEditMode = false;
        ObservedCharacterPanelMessage = string.Empty;
    }

    private Task ShowObservedBiography()
    {
        ShowObservedCharacterBioPanel = true;
        IsObservedBiographyEditMode = false;
        IsObservedCharacterEditMode = false;
        ObservedCharacterPanelMessage = string.Empty;
        return Task.CompletedTask;
    }

    private Task HideObservedBiography()
    {
        ShowObservedCharacterBioPanel = false;
        IsObservedBiographyEditMode = false;
        ObservedCharacterPanelMessage = string.Empty;
        return Task.CompletedTask;
    }

    private Task CancelObservedCharacterPanelEdition()
    {
        IsObservedCharacterEditMode = false;
        IsObservedBiographyEditMode = false;
        ObservedCharacterPanelMessage = string.Empty;
        return Task.CompletedTask;
    }

    private async Task SaveObservedCharacterEdits()
    {
        if (State is null || ObservedEditableCharacter is null)
            return;

        try
        {
            ObservedCharacterPanelMessage = string.Empty;

            var result = await CharacterService.UpdateCharacterForSessionAsync(
                State.SessionId,
                ObservedEditableCharacter.CharacterId,
                CurrentUserId,
                new UpdateCharacterRequestDto
                {
                    Name = ObservedEditableCharacter.Name,
                    Biography = ObservedEditableCharacter.Biography,
                    Attributes = ObservedEditableCharacter.Attributes,
                    Traits = ObservedEditableCharacter.Traits,
                    Gauges = ObservedEditableCharacter.Gauges,
                    SelectedTalentIds = ObservedEditableCharacter.Talents
                        .Where(x => x.IsSelected)
                        .Select(x => x.DefinitionId)
                        .ToList(),
                    SelectedItemIds = ObservedEditableCharacter.Items
                        .Where(x => x.IsSelected)
                        .Select(x => x.DefinitionId)
                        .ToList()
                });

            await LoadSpecialRoleCharacters();

            if (ObservedCharacterSheet is not null)
            {
                ObservedCharacterSheet = await CharacterService.GetCharacterSheetForPlayerAsync(
                    PlayerSessionId,
                    ObservedCharacterSheet.CharacterId);
            }

            ObservedEditableCharacter = await CharacterService.GetEditableCharacterForSessionAsync(
                State.SessionId,
                ObservedEditableCharacter.CharacterId,
                CurrentUserId);

            IsObservedCharacterEditMode = false;
            ObservedCharacterPanelMessage = L["EditCharacter_Saved"];

            if (result.ResurrectionBlocked)
            {
                ObservedCharacterPanelMessage = $"{ObservedCharacterPanelMessage} {L["EditCharacter_ResurrectionBlocked"]}";
            }
        }
        catch (Exception ex)
        {
            ObservedCharacterPanelMessage = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task SaveObservedBiography()
    {
        if (State is null || ObservedEditableCharacter is null)
            return;

        try
        {
            ObservedCharacterPanelMessage = string.Empty;

            await CharacterService.UpdateCharacterForSessionAsync(
                State.SessionId,
                ObservedEditableCharacter.CharacterId,
                CurrentUserId,
                new UpdateCharacterRequestDto
                {
                    Name = ObservedEditableCharacter.Name,
                    Biography = ObservedEditableCharacter.Biography,
                    Attributes = ObservedEditableCharacter.Attributes,
                    Traits = ObservedEditableCharacter.Traits,
                    Gauges = ObservedEditableCharacter.Gauges,
                    SelectedTalentIds = ObservedEditableCharacter.Talents
                        .Where(x => x.IsSelected)
                        .Select(x => x.DefinitionId)
                        .ToList(),
                    SelectedItemIds = ObservedEditableCharacter.Items
                        .Where(x => x.IsSelected)
                        .Select(x => x.DefinitionId)
                        .ToList()
                });

            await LoadSpecialRoleCharacters();

            if (ObservedCharacterSheet is not null)
            {
                ObservedCharacterSheet = await CharacterService.GetCharacterSheetForPlayerAsync(
                    PlayerSessionId,
                    ObservedCharacterSheet.CharacterId);
            }

            ObservedEditableCharacter = await CharacterService.GetEditableCharacterForSessionAsync(
                State.SessionId,
                ObservedEditableCharacter.CharacterId,
                CurrentUserId);

            IsObservedBiographyEditMode = false;
            ShowObservedCharacterBioPanel = true;
            ObservedCharacterPanelMessage = L["SessionPage_BiographySaved"];
        }
        catch (Exception ex)
        {
            ObservedCharacterPanelMessage = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

