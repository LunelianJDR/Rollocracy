    private async Task HandleCreateCharacterInline()
    {
        try
        {
            if (CreationTemplate is null)
                return;

            if (!CanSubmitCharacterName())
                return;

            Message = string.Empty;

            await CharacterService.CreateCharacterAsync(
                PlayerSessionId,
                NewCharacterName,
                NewCharacterBiography,
                CreationAttributeValues,
                CreationTraitSelections
                    .Where(x => x.Value.HasValue)
                    .ToDictionary(x => x.Key, x => x.Value!.Value),
                CreationDerivedStatValues,
                SelectedCreationTalentIds.ToList(),
                SelectedCreationItemIds.ToList());

            if (hubConnection is not null && !PresenceJoined && State is not null)
            {
                await hubConnection.SendAsync(
                    "JoinPlayerPresence",
                    State.SessionId.ToString(),
                    PlayerSessionId.ToString(),
                    false);

                PresenceJoined = true;
                await RegisterBrowserPresenceIfNeededAsync();
            }

            await SessionNotifier.NotifyCharacterStateChangedAsync(CreationTemplate.SessionId);

            IsCreatingCharacterInline = false;
            await LoadState(refreshJournal: false);
            await LoadActiveTest(allowArrivalAlert: false);
            await LoadLatestPoll(allowArrivalAlert: false);

            IsCreatingCharacterInline = false;
            NewCharacterName = string.Empty;
            NewCharacterBiography = string.Empty;
            CreationAttributeValues.Clear();
            CreationDerivedStatValues.Clear();
            CreationTraitSelections.Clear();
            SelectedCreationTalentIds.Clear();
            SelectedCreationItemIds.Clear();
            IsRandomCharacterCreationEnabled = false;
            CreationTemplate = null;
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

