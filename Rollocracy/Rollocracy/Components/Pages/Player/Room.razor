    private async Task LoadState(bool refreshJournal = true)
    {
        try
        {
            Message = string.Empty;
            var previousState = State;

            State = await CharacterService.GetPlayerRoomStateAsync(PlayerSessionId);
            SessionStore = await SessionService.GetPlayerSessionStoreAsync(PlayerSessionId);
            StoreGaugeFilterIdString = StoreGaugeFilterId?.ToString() ?? string.Empty;

            if (refreshJournal)
            {
                await LoadPublicJournal();
            }

            if (State?.AliveCharacter is null)
            {
                IsEditingBiography = false;
                ShowBiographyPanel = false;
                ShowStorePanel = false;
                PendingStoreOfferId = null;
            }

            if (SessionStore?.Exists != true)
            {
                ShowStorePanel = false;
                PendingStoreOfferId = null;
                StoreGaugeFilterId = null;
                StoreGaugeFilterIdString = string.Empty;
            }
            else if (!SessionStore.IsEnabled)
            {
                ShowStorePanel = false;
                PendingStoreOfferId = null;
            }

            if (ViewedDeadCharacter is not null)
            {
                var stillExists = State?.DeadCharacters.Any(x => x.CharacterId == ViewedDeadCharacter.CharacterId) == true;
                if (!stillExists)
                {
                    ViewedDeadCharacter = null;
                }
            }

            StartCreationCountdownIfNeeded();

            if (State is not null && !State.CanCreateNewCharacter)
            {
                IsCreatingCharacterInline = false;
                CreationTemplate = null;
            }

            if (State?.CanViewSessionCharacters != true)
            {
                SpecialRoleCharacters.Clear();
                ObservedCharacterSheet = null;
                ObservedEditableCharacter = null;
                IsObservedCharacterEditMode = false;
                IsObservedBiographyEditMode = false;
                ShowObservedCharacterBioPanel = false;
                ShowSessionCharactersPanel = false;
            }
            else if (ShowSessionCharactersPanel)
            {
                await LoadSpecialRoleCharacters();
            }

            if (previousState?.AliveCharacter is not null &&
                State?.AliveCharacter is not null &&
                previousState.AliveCharacter.CharacterId == State.AliveCharacter.CharacterId &&
                IsEditingBiography)
            {
                BiographyDraft = State.AliveCharacter.Biography ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task LoadActiveTest(bool allowArrivalAlert = true)
    {
        try
        {
            var previousTestId = ActiveTest?.GameTestId;
            var wasDismissed = IsTestDismissed;

            var loadedTest = await GameTestService.GetActiveGameTestForPlayerAsync(PlayerSessionId);
            ActiveTest = loadedTest;

            if (loadedTest is null)
            {
                IsTestDismissed = false;
                HighlightActiveTest = false;
            }
            else if (previousTestId != loadedTest.GameTestId)
            {
                IsTestDismissed = false;

                if (allowArrivalAlert &&
                    CanAlertForCurrentTest(loadedTest) &&
                    LastAlertedActiveTestId != loadedTest.GameTestId)
                {
                    await TriggerActiveTestAlertAsync(loadedTest.GameTestId);
                }
            }
            else
            {
                IsTestDismissed = wasDismissed;
            }
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task InitializeHubIfNeeded()
    {
        if (State is null)
            return;

        // En préprod/prod, ce composant s’exécute côté serveur.
        // On utilise donc une URL interne configurable pour SignalR.
        var internalBaseUrl = Configuration["InternalUrls:AppBaseUrl"];

        if (string.IsNullOrWhiteSpace(internalBaseUrl))
        {
            internalBaseUrl = Navigation.BaseUri.TrimEnd('/');
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{internalBaseUrl.TrimEnd('/')}/sessionhub")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("PresenceChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RunHubRefreshAsync(async () =>
                {
                    if (ShowSessionCharactersPanel && State?.CanViewSessionCharacters == true)
                    {
                        await LoadSpecialRoleCharacters();
                    }

                    StateHasChanged();
                });
            });
        });

        hubConnection.On("CharacterStateChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RunHubRefreshAsync(async () =>
                {
                    await LoadState(refreshJournal: false);
                    await LoadActiveTest(allowArrivalAlert: true);
                    StateHasChanged();
                });
            });
        });

        hubConnection.On("TestChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RunHubRefreshAsync(async () =>
                {
                    await LoadState(refreshJournal: false);
                    await LoadActiveTest(allowArrivalAlert: true);
                    StateHasChanged();
                });
            });
        });

        hubConnection.On("PollChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RunHubRefreshAsync(async () =>
                {
                    await LoadLatestPoll(allowArrivalAlert: true);
                    StateHasChanged();
                });
            });
        });

        hubConnection.On("JournalChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await RunHubRefreshAsync(async () =>
                {
                    await LoadPublicJournal();
                    StateHasChanged();
                });
            });
        });

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("JoinSessionGroup", State.SessionId.ToString());

        if (State.AliveCharacter is not null || State.DeadCharacters.Count > 0)
        {
            await hubConnection.SendAsync(
                "JoinPlayerPresence",
                State.SessionId.ToString(),
                PlayerSessionId.ToString(),
                false);

            PresenceJoined = true;
            await RegisterBrowserPresenceIfNeededAsync();
        }
    }

    private async Task RunHubRefreshAsync(Func<Task> action)
    {
        if (_isDisposed)
            return;

        await _hubRefreshLock.WaitAsync();

        try
        {
            if (_isDisposed)
                return;

            await action();
        }
        finally
        {
            _hubRefreshLock.Release();
        }
    }

    private async Task RollCurrentTest()
    {
        try
        {
            if (ActiveTest is null || IsRollingCurrentTest)
                return;

            Message = string.Empty;
            IsRollingCurrentTest = true;

            StateHasChanged();
            await Task.Delay(1000);

            await GameTestService.RollForPlayerAsync(PlayerSessionId, ActiveTest.GameTestId, false);
            await LoadActiveTest(allowArrivalAlert: false);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
        finally
        {
            IsRollingCurrentTest = false;
        }
    }

    private async Task GoToCreateCharacter()
    {
        try
        {
            Message = string.Empty;

            CreationTemplate = await CharacterService.GetCharacterCreationTemplateAsync(PlayerSessionId);
            CreationAttributeValues = CreationTemplate.Attributes.ToDictionary(x => x.AttributeDefinitionId, x => 0);
            CreationDerivedStatValues = CreationTemplate.DerivedStats.ToDictionary(x => x.DerivedStatDefinitionId, x => 0);
            CreationTraitSelections.Clear();
            SelectedCreationTalentIds.Clear();
            SelectedCreationItemIds.Clear();

            foreach (var trait in CreationTemplate.Traits)
            {
                if (trait.IsRandomSelectionGroup)
                    continue;

                CreationTraitSelections[trait.TraitDefinitionId] = null;
            }

            NewCharacterName = string.Empty;
            NewCharacterBiography = string.Empty;
            IsRandomCharacterCreationEnabled = false;
            IsCreatingCharacterInline = true;
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

