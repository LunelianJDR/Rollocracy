    private int RemainingCreationAttributePoints
        => CreationTemplate is null
            ? 0
            : CreationTemplate.AttributePointsToDistribute - CreationAttributeValues.Values.Sum();

    private int RemainingCreationDerivedStatPoints
        => CreationTemplate is null
            ? 0
            : CreationTemplate.DerivedStatPointsToDistribute - CreationDerivedStatValues.Values.Sum();

    private int GetCreationAttributeInputMax(Guid attributeDefinitionId)
    {
        if (CreationTemplate is null || !CreationAttributeValues.ContainsKey(attributeDefinitionId))
            return 0;

        var currentValue = CreationAttributeValues[attributeDefinitionId];
        var remaining = RemainingCreationAttributePoints;

        var maxPerAttribute = CreationTemplate.MaxAttributePointsPerAttribute > 0
            ? CreationTemplate.MaxAttributePointsPerAttribute
            : CreationTemplate.AttributePointsToDistribute;

        return Math.Max(0, Math.Min(maxPerAttribute, currentValue + remaining));
    }

    private int GetCreationDerivedStatInputMax(Guid derivedStatDefinitionId)
    {
        if (CreationTemplate is null || !CreationDerivedStatValues.ContainsKey(derivedStatDefinitionId))
            return 0;

        var currentValue = CreationDerivedStatValues[derivedStatDefinitionId];
        var remaining = RemainingCreationDerivedStatPoints;

        var maxPerStat = CreationTemplate.MaxDerivedStatPointsPerStat > 0
            ? CreationTemplate.MaxDerivedStatPointsPerStat
            : CreationTemplate.DerivedStatPointsToDistribute;

        return Math.Max(0, Math.Min(maxPerStat, currentValue + remaining));
    }

    private bool IsCreationTalentDisabled(Guid talentDefinitionId)
    {
        if (CreationTemplate is null || CreationTemplate.TalentChoicesToSelect <= 0)
            return false;

        if (SelectedCreationTalentIds.Contains(talentDefinitionId))
            return false;

        return SelectedCreationTalentIds.Count >= CreationTemplate.TalentChoicesToSelect;
    }

    private bool IsCreationItemDisabled(Guid itemDefinitionId)
    {
        if (CreationTemplate is null || CreationTemplate.ItemChoicesToSelect <= 0)
            return false;

        if (SelectedCreationItemIds.Contains(itemDefinitionId))
            return false;

        return SelectedCreationItemIds.Count >= CreationTemplate.ItemChoicesToSelect;
    }

    private void OnCreationAttributeBonusChanged(Guid attributeDefinitionId, ChangeEventArgs args)
    {
        if (CreationTemplate is null || !CreationAttributeValues.ContainsKey(attributeDefinitionId))
            return;

        var rawValue = args.Value?.ToString();
        var parsed = 0;
        int.TryParse(rawValue, out parsed);
        parsed = Math.Max(0, parsed);

        if (CreationTemplate.MaxAttributePointsPerAttribute > 0)
            parsed = Math.Min(parsed, CreationTemplate.MaxAttributePointsPerAttribute);

        CreationAttributeValues[attributeDefinitionId] = parsed;

        var remaining = RemainingCreationAttributePoints;
        if (remaining < 0)
        {
            CreationAttributeValues[attributeDefinitionId] = Math.Max(0, parsed + remaining);
        }
    }

    private void OnCreationDerivedStatBonusChanged(Guid derivedStatDefinitionId, ChangeEventArgs args)
    {
        if (CreationTemplate is null || !CreationDerivedStatValues.ContainsKey(derivedStatDefinitionId))
            return;

        var rawValue = args.Value?.ToString();
        var parsed = 0;
        int.TryParse(rawValue, out parsed);
        parsed = Math.Max(0, parsed);

        if (CreationTemplate.MaxDerivedStatPointsPerStat > 0)
            parsed = Math.Min(parsed, CreationTemplate.MaxDerivedStatPointsPerStat);

        CreationDerivedStatValues[derivedStatDefinitionId] = parsed;

        var remaining = RemainingCreationDerivedStatPoints;
        if (remaining < 0)
        {
            CreationDerivedStatValues[derivedStatDefinitionId] = Math.Max(0, parsed + remaining);
        }
    }

    private void ToggleCreationTalent(Guid talentDefinitionId, bool isSelected)
