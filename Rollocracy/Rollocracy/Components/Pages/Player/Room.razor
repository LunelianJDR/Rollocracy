    private IEnumerable<(string Value, string Label)> GetObservedCharacterSortOptions()
    {
        yield return ("character-name", L["Session_Manage_Sort_CharacterName"]);
        yield return ("player-name", L["Session_Manage_Sort_PlayerName"]);

        var healthGaugeNames = SpecialRoleCharacters
            .SelectMany(x => x.Gauges)
            .Where(x => x.IsHealthGauge)
            .Select(x => x.Name)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        foreach (var gaugeName in healthGaugeNames)
        {
            yield return ($"gauge:{gaugeName}", $"{L["Session_Manage_Sort_HealthGauge"]} - {gaugeName}");
        }

        var traitNames = SpecialRoleCharacters
            .SelectMany(x => x.Traits)
            .Select(x => x.TraitName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        foreach (var traitName in traitNames)
        {
            yield return ($"trait:{traitName}", $"{L["Session_Manage_Sort_Trait"]} - {traitName}");
        }
    }

    private IEnumerable<SessionCharacterSummaryDto> GetSortedObservedCharacters()
    {
        var query = SpecialRoleCharacters.AsEnumerable();

        query = ObservedCharacterSortMode switch
        {
            "player-name" => query
                .OrderBy(x => x.PlayerName, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(x => x.CharacterName, StringComparer.CurrentCultureIgnoreCase),

            _ when ObservedCharacterSortMode.StartsWith("gauge:", StringComparison.OrdinalIgnoreCase) => query
                .OrderBy(x => GetObservedGaugeSortValue(x, ObservedCharacterSortMode["gauge:".Length..]))
                .ThenBy(x => x.CharacterName, StringComparer.CurrentCultureIgnoreCase),

            _ when ObservedCharacterSortMode.StartsWith("trait:", StringComparison.OrdinalIgnoreCase) => query
                .OrderBy(x => GetObservedTraitSortValue(x, ObservedCharacterSortMode["trait:".Length..]), StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(x => x.CharacterName, StringComparer.CurrentCultureIgnoreCase),

            _ => query
                .OrderBy(x => x.CharacterName, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(x => x.PlayerName, StringComparer.CurrentCultureIgnoreCase)
        };

        return query;
    }

    private int GetObservedGaugeSortValue(SessionCharacterSummaryDto character, string gaugeName)
    {
        return character.Gauges
            .FirstOrDefault(x => string.Equals(x.Name, gaugeName, StringComparison.CurrentCultureIgnoreCase))
            ?.Value ?? int.MaxValue;
    }

    private string GetObservedTraitSortValue(SessionCharacterSummaryDto character, string traitName)
    {
        return character.Traits
            .FirstOrDefault(x => string.Equals(x.TraitName, traitName, StringComparison.CurrentCultureIgnoreCase))
            ?.OptionName ?? string.Empty;
    }

