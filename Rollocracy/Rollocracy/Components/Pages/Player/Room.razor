    private bool AreRequiredCreationTraitsSelected()
    {
        if (CreationTemplate is null)
            return false;

        foreach (var trait in CreationTemplate.Traits.Where(x => !x.IsRandomSelectionGroup))
        {
            if (!CreationTraitSelections.TryGetValue(trait.TraitDefinitionId, out var selectedOptionId) ||
                !selectedOptionId.HasValue ||
                selectedOptionId.Value == Guid.Empty)
            {
                return false;
            }
        }

        return true;
    }

    private bool CanSubmitCharacterCreation()
    {
        if (CreationTemplate is null)
            return false;

        if (IsRandomCharacterCreationEnabled)
            return true;

        if (CreationTemplate.AttributePointsToDistribute > 0 && RemainingCreationAttributePoints != 0)
            return false;

        if (CreationTemplate.DerivedStatPointsToDistribute > 0 && RemainingCreationDerivedStatPoints != 0)
            return false;

        if (!AreRequiredCreationTraitsSelected())
            return false;

        if (CreationTemplate.TalentChoicesToSelect > 0 && SelectedCreationTalentIds.Count != CreationTemplate.TalentChoicesToSelect)
            return false;

        if (CreationTemplate.ItemChoicesToSelect > 0 && SelectedCreationItemIds.Count != CreationTemplate.ItemChoicesToSelect)
            return false;

        return true;
    }

    private static readonly Regex CharacterNameAllowedCharactersRegex = new(@"[^\p{L}\p{N},'""/\- ]+", RegexOptions.Compiled);

    private void OnNewCharacterNameInput(ChangeEventArgs args)
    {
        var rawValue = args.Value?.ToString() ?? string.Empty;

        rawValue = CharacterNameAllowedCharactersRegex.Replace(rawValue, string.Empty);

        if (rawValue.Length > 22)
        {
            rawValue = rawValue[..22];
        }

        if (!string.Equals(NewCharacterName, rawValue, StringComparison.Ordinal))
        {
            NewCharacterName = rawValue;
        }
    }

    private bool CanSubmitCharacterName()
    {
        return !string.IsNullOrWhiteSpace(NewCharacterName);
    }

