    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        creationCountdownTimer?.Dispose();
        ActiveTestHighlightCancellation?.Cancel();
        ActiveTestHighlightCancellation?.Dispose();
        LatestPollHighlightCancellation?.Cancel();
        LatestPollHighlightCancellation?.Dispose();

        if (presenceModule is not null)
        {
            try
            {
                await presenceModule.InvokeVoidAsync("unregisterPlayerPresence");
            }
            catch
            {
            }

            try
            {
                await presenceModule.DisposeAsync();
            }
            catch
            {
            }
        }

        if (hubConnection is not null)
        {
            try
            {
                if (PresenceJoined && State is not null && hubConnection.State == HubConnectionState.Connected)
                {
                    await hubConnection.SendAsync(
                        "LeavePlayerPresence",
                        State.SessionId.ToString(),
                        PlayerSessionId.ToString());
                }
            }
            catch
            {
            }

            try
            {
                await hubConnection.StopAsync();
            }
            catch
            {
            }

            await hubConnection.DisposeAsync();
        }
    }

    private System.Threading.Timer? creationCountdownTimer;
    private int RemainingCreationSeconds;

    private void StartCreationCountdownIfNeeded()
    {
        creationCountdownTimer?.Dispose();
        creationCountdownTimer = null;

        if (State is null || State.CanCreateNewCharacter || !State.CanCreateNewCharacterAtUtc.HasValue)
        {
            RemainingCreationSeconds = 0;
            return;
        }

        void UpdateRemaining()
        {
            if (State?.CanCreateNewCharacterAtUtc is null)
            {
                RemainingCreationSeconds = 0;
                return;
            }

            var remaining = State.CanCreateNewCharacterAtUtc.Value - DateTime.UtcNow;
            RemainingCreationSeconds = Math.Max(0, (int)Math.Ceiling(remaining.TotalSeconds));
        }

        UpdateRemaining();

        creationCountdownTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                UpdateRemaining();

                if (RemainingCreationSeconds <= 0)
                {
                    creationCountdownTimer?.Dispose();
                    creationCountdownTimer = null;
                    await LoadState(refreshJournal: false);
                }

                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private PollForPlayerDto? LatestPoll;

    private async Task LoadLatestPoll(bool allowArrivalAlert = true)
    {
        try
        {
            var previousPollId = LatestPoll?.PollId;
            var wasDismissed = IsPollDismissed;

            var loadedPoll = await PollService.GetLatestPollForPlayerAsync(PlayerSessionId);
            LatestPoll = loadedPoll;

            if (loadedPoll is null)
            {
                IsPollDismissed = false;
                HighlightLatestPoll = false;
            }
            else if (previousPollId != loadedPoll.PollId)
            {
                IsPollDismissed = false;

                if (allowArrivalAlert &&
                    CanAlertForCurrentPoll(loadedPoll) &&
                    LastAlertedPollId != loadedPoll.PollId)
                {
                    await TriggerLatestPollAlertAsync(loadedPoll.PollId);
                }
            }
            else
            {
                IsPollDismissed = wasDismissed;
            }
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task Vote(Guid optionId)
    {
        try
        {
            Message = string.Empty;

            if (LatestPoll is null)
                return;

            await PollService.VoteAsync(PlayerSessionId, LatestPoll.PollId, optionId);
            await LoadLatestPoll(allowArrivalAlert: false);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

