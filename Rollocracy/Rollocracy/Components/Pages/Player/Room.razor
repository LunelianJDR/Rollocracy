    private IEnumerable<(string Value, string Label)> GetObservedCharacterSortOptions()
    {
        yield return ("character-name", L["SessionPage_Sort_CharacterName"]);
        yield return ("player-name", L["SessionPage_Sort_PlayerName"]);

        var healthGaugeNames = SpecialRoleCharacters
            .SelectMany(x => x.Gauges)
            .Where(x => x.IsHealthGauge)
            .Select(x => x.Name)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        foreach (var gaugeName in healthGaugeNames)
        {
            yield return ($"gauge:{gaugeName}", $"{L["SessionPage_Sort_HealthGauge"]} - {gaugeName}");
        }

        var traitNames = SpecialRoleCharacters
            .SelectMany(x => x.Traits)
            .Select(x => x.TraitName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        foreach (var traitName in traitNames)
        {
            yield return ($"trait:{traitName}", $"{L["SessionPage_Sort_Trait"]} - {traitName}");
        }
    }

    private IEnumerable<SessionCharacterSummaryDto> GetSortedObservedCharacters()
    {
        var query = SpecialRoleCharacters.AsEnumerable();

        query = ObservedCharacterSortMode switch
        {
            "player-name" => query
                .OrderBy(x => x.PlayerName, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(x => x.CharacterName, StringComparer.CurrentCultureIgnoreCase),

            _ when ObservedCharacterSortMode.StartsWith("gauge:", StringComparison.OrdinalIgnoreCase) => query
                .OrderBy(x => GetObservedGaugeSortValue(x, ObservedCharacterSortMode["gauge:".Length..]))
                .ThenBy(x => x.CharacterName, StringComparer.CurrentCultureIgnoreCase),

            _ when ObservedCharacterSortMode.StartsWith("trait:", StringComparison.OrdinalIgnoreCase) => query
                .OrderBy(x => GetObservedTraitSortValue(x, ObservedCharacterSortMode["trait:".Length..]), StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(x => x.CharacterName, StringComparer.CurrentCultureIgnoreCase),

            _ => query
                .OrderBy(x => x.CharacterName, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(x => x.PlayerName, StringComparer.CurrentCultureIgnoreCase)
        };

        return query;
    }

    private int GetObservedGaugeSortValue(SessionCharacterSummaryDto character, string gaugeName)
    {
        return character.Gauges
            .FirstOrDefault(x => string.Equals(x.Name, gaugeName, StringComparison.CurrentCultureIgnoreCase))
            ?.Value ?? int.MaxValue;
    }

    private string GetObservedTraitSortValue(SessionCharacterSummaryDto character, string traitName)
    {
        return character.Traits
            .FirstOrDefault(x => string.Equals(x.TraitName, traitName, StringComparison.CurrentCultureIgnoreCase))
            ?.OptionName ?? string.Empty;
    }

    private RenderFragment RenderCharacterSheet(CharacterSheetDto sheet, bool isDeadView) => builder =>
{
    var seq = 0;

    void Open(string tag) => builder.OpenElement(seq++, tag);
    void Close() => builder.CloseElement();
    void Text(string value) => builder.AddContent(seq++, value);

    Open("div");
    builder.AddAttribute(seq++, "class", "rc-player-character-sheet");

    Open("div");
    builder.AddAttribute(seq++, "class", "rc-player-character-sheet__hero");

    Open("div");
    builder.AddAttribute(seq++, "class", "rc-player-character-sheet__name");
    Text(sheet.Name);
    Close();

    Open("div");
    builder.AddAttribute(seq++, "class", $"rc-player-character-sheet__status {(sheet.IsAlive ? "alive" : "dead")}");
    Text(sheet.IsAlive ? L["Common_Alive"] : L["Common_Dead"]);
    Close();

    Close();

    if (sheet.Attributes.Count > 0)
    {
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-filter-group-card");
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-detail-block__title");
        Text(L["PlayerRoom_Attributes"]);
        Close();

        Open("div");
        builder.AddAttribute(seq++, "class", "rc-player-stat-grid");
        foreach (var item in sheet.Attributes)
        {
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-stat-card");
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-stat-card__label");
            Text(item.Name);
            Close();
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-stat-card__value");
            Text(item.Value.ToString());
            Close();
            Close();
        }
        Close();
        Close();
    }

    if (sheet.DerivedStats.Count > 0)
    {
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-filter-group-card");
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-detail-block__title");
        Text(L["PlayerRoom_DerivedStats"]);
        Close();

        Open("div");
        builder.AddAttribute(seq++, "class", "rc-player-stat-grid");
        foreach (var item in sheet.DerivedStats)
        {
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-stat-card");
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-stat-card__label");
            Text(item.Name);
            Close();
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-stat-card__value");
            Text(item.Value.ToString());
            Close();
            Close();
        }
        Close();
        Close();
    }

    if (sheet.Traits.Count > 0)
    {
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-filter-group-card");
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-detail-block__title");
        Text(L["PlayerRoom_Traits"]);
        Close();

        Open("div");
        builder.AddAttribute(seq++, "class", "rc-player-pill-list");
        foreach (var item in sheet.Traits)
        {
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-pill");
            Text($"{item.TraitName} : {item.OptionName}");
            Close();
        }
        Close();
        Close();
    }

    if (sheet.Talents.Count > 0)
    {
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-filter-group-card");
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-detail-block__title");
        Text(L["EditCharacter_Talents"]);
        Close();

        Open("div");
        builder.AddAttribute(seq++, "class", "rc-player-pill-list");
        foreach (var item in sheet.Talents)
        {
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-pill");
            Text(item.Name);
            Close();
        }
        Close();
        Close();
    }

    if (sheet.Items.Count > 0)
    {
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-filter-group-card");
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-detail-block__title");
        Text(L["EditCharacter_Items"]);
        Close();

        Open("div");
        builder.AddAttribute(seq++, "class", "rc-player-pill-list");
        foreach (var item in sheet.Items)
        {
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-pill");
            Text(item.Name);
            Close();
        }
        Close();
        Close();
    }

    if (sheet.Gauges.Count > 0)
    {
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-filter-group-card");
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-detail-block__title");
        Text(L["PlayerRoom_Gauges"]);
        Close();

        foreach (var gauge in sheet.Gauges)
        {
            var percent = gauge.MaxValue <= gauge.MinValue
                ? 0
                : Math.Clamp((int)Math.Round((double)(gauge.Value - gauge.MinValue) * 100 / (gauge.MaxValue - gauge.MinValue)), 0, 100);

            Open("div");
            builder.AddAttribute(seq++, "class", $"rc-player-gauge {(gauge.IsHealthGauge ? "rc-player-gauge--health" : string.Empty)}");

            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-gauge__header");
            Open("span");
            builder.AddAttribute(seq++, "class", "rc-player-gauge__name");
            Text(gauge.Name);
            Close();
            Open("span");
            builder.AddAttribute(seq++, "class", "rc-player-gauge__value");
            Text($"{gauge.Value} / {gauge.MaxValue}");
            Close();
            Close();

            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-gauge__track");
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-gauge__fill");
            builder.AddAttribute(seq++, "style", $"width:{percent}%");
            Close();
            Close();

            Close();
        }

        Close();
    }

    if (isDeadView)
    {
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-filter-group-card");
        Open("div");
        builder.AddAttribute(seq++, "class", "rc-detail-block__title");
        Text(L["PlayerRoom_Biography"]);
        Close();

        if (string.IsNullOrWhiteSpace(sheet.Biography))
        {
            Open("p");
            Text(L["PlayerRoom_NoBiography"]);
            Close();
        }
        else
        {
            Open("div");
            builder.AddAttribute(seq++, "class", "rc-player-character-sheet__biography");
            Text(sheet.Biography);
            Close();
        }

        Close();
    }

    Close();
};

    public async ValueTask DisposeAsync()
    {
        creationCountdownTimer?.Dispose();

        if (hubConnection is not null)
        {
            try
            {
                if (PresenceJoined && State is not null && hubConnection.State == HubConnectionState.Connected)
                {
                    await hubConnection.SendAsync(
                        "LeavePlayerPresence",
                        State.SessionId.ToString(),
                        PlayerSessionId.ToString());
                }
            }
            catch
            {
            }

            try
            {
                await hubConnection.StopAsync();
            }
            catch
            {
            }

            await hubConnection.DisposeAsync();
        }
    }

    private System.Threading.Timer? creationCountdownTimer;
    private int RemainingCreationSeconds;

    private void StartCreationCountdownIfNeeded()
    {
        creationCountdownTimer?.Dispose();
        creationCountdownTimer = null;

        if (State is null || State.CanCreateNewCharacter || !State.CanCreateNewCharacterAtUtc.HasValue)
        {
            RemainingCreationSeconds = 0;
            return;
        }

        void UpdateRemaining()
        {
            if (State?.CanCreateNewCharacterAtUtc is null)
            {
                RemainingCreationSeconds = 0;
                return;
            }

            var remaining = State.CanCreateNewCharacterAtUtc.Value - DateTime.UtcNow;
            RemainingCreationSeconds = Math.Max(0, (int)Math.Ceiling(remaining.TotalSeconds));
        }

        UpdateRemaining();

        creationCountdownTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                UpdateRemaining();

                if (RemainingCreationSeconds <= 0)
                {
                    creationCountdownTimer?.Dispose();
                    creationCountdownTimer = null;
                    await LoadState();
                }

                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private PollForPlayerDto? LatestPoll;

    private async Task LoadLatestPoll()
    {
        try
        {
            LatestPoll = await PollService.GetLatestPollForPlayerAsync(PlayerSessionId);
            IsPollDismissed = false;
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task Vote(Guid optionId)
    {
        try
        {
            Message = string.Empty;

            if (LatestPoll is null)
                return;

            await PollService.VoteAsync(PlayerSessionId, LatestPoll.PollId, optionId);
            await LoadLatestPoll();
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

