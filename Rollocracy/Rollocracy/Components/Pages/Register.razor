@page "/register"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using Rollocracy.Localization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["Auth_Register_Title"]</PageTitle>

<section class="rc-auth-shell">
    <div class="rc-auth-grid">
        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h1 class="rc-tool-panel__title">@L["Auth_Register_Title"]</h1>
                <p class="rc-tool-panel__subtitle">@L["Auth_Register_Subtitle"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="rc-inline-warning">@Message</div>
            }

            <div class="rc-auth-form">
                <div class="rc-form-field">
                    <label>@L["Common_Username"]</label>
                    <input @bind="Username" autocomplete="username" />
                </div>

                <div class="rc-form-field">
                    <label>@L["Auth_Register_EmailOptional"]</label>
                    <input @bind="Email" type="email" autocomplete="email" />
                </div>

                <div class="rc-form-field">
                    <label>@L["Common_Password"]</label>
                    <input @bind="Password" type="password" autocomplete="new-password" />
                </div>

                <div class="rc-form-field">
                    <label>@L["Common_Language"]</label>
                    <select @bind="SelectedLanguage">
                        <option value="fr">@L["Language_French"]</option>
                        <option value="en">@L["Language_English"]</option>
                    </select>
                </div>

                <div class="rc-inline-warning">
                    <strong>@L["Auth_Register_EmailWarningTitle"]</strong><br />
                    @L["Auth_Register_EmailWarningBody"]
                </div>

                <div class="rc-tool-actions">
                    <button @onclick="HandleRegister">@L["Auth_Register_Submit"]</button>
                    <a class="rc-auth-link-button" href="/login">@L["Auth_BackToLogin"]</a>
                </div>
            </div>
        </article>

        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h2 class="rc-tool-panel__title">@L["Auth_Register_WhyEmailTitle"]</h2>
                <p class="rc-tool-panel__subtitle">@L["Auth_Register_WhyEmailSubtitle"]</p>
            </div>

            <div class="rc-auth-stack">
                <div class="rc-readonly-value">@L["Auth_Register_WhyEmailLine1"]</div>
                <div class="rc-readonly-value">@L["Auth_Register_WhyEmailLine2"]</div>
                <div class="rc-readonly-value">@L["Auth_Register_WhyEmailLine3"]</div>
            </div>
        </article>
    </div>
</section>

@code {
    private string Username = string.Empty;
    private string Email = string.Empty;
    private string Password = string.Empty;
    private string SelectedLanguage = "fr";
    private string Message = string.Empty;

    private async Task HandleRegister()
    {
        try
        {
            Message = string.Empty;

            if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
            {
                Message = L["Auth_Register_RequiredFields"];
                return;
            }

            var request = new
            {
                Username,
                Email = string.IsNullOrWhiteSpace(Email) ? null : Email,
                Password,
                Language = SelectedLanguage
            };

            var response = await Http.PostAsJsonAsync("api/auth/register", request);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/login?registered=1", forceLoad: true);
                return;
            }

            Message = await ExtractApiErrorMessageAsync(response, L["Auth_Register_RequestFailed"]);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task<string> ExtractApiErrorMessageAsync(HttpResponseMessage response, string fallbackMessage)
    {
        var contentType = response.Content.Headers.ContentType?.MediaType;
        var body = await response.Content.ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(body))
            return fallbackMessage;

        if (!string.IsNullOrWhiteSpace(contentType) &&
            contentType.Contains("html", StringComparison.OrdinalIgnoreCase))
        {
            return fallbackMessage;
        }

        var trimmed = body.Trim();

        if (trimmed.StartsWith("<!DOCTYPE html>", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("<html", StringComparison.OrdinalIgnoreCase))
        {
            return fallbackMessage;
        }

        return $"{L["Common_Error"]} : {trimmed}";
    }
}
