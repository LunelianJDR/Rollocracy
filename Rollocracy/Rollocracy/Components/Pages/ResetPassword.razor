@page "/reset-password"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Account
@using Rollocracy.Localization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["ResetPassword_Title"]</PageTitle>

<section class="rc-auth-shell">
    <div class="rc-auth-grid">
        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h1 class="rc-tool-panel__title">@L["ResetPassword_Title"]</h1>
                <p class="rc-tool-panel__subtitle">@L["ResetPassword_Subtitle"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="rc-inline-warning">@Message</div>
            }

            @if (string.IsNullOrWhiteSpace(Token))
            {
                <div class="rc-inline-error">@L["ResetPassword_MissingToken"]</div>
            }
            else
            {
                <div class="rc-auth-form">
                    <div class="rc-form-field">
                        <label>@L["ResetPassword_NewPassword"]</label>
                        <input @bind="NewPassword" type="password" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["ResetPassword_ConfirmNewPassword"]</label>
                        <input @bind="ConfirmNewPassword" type="password" />
                    </div>

                    <div class="rc-tool-actions">
                        <button @onclick="HandleReset">@L["ResetPassword_Submit"]</button>
                        <a class="rc-auth-link-button" href="/login">@L["ResetPassword_BackToLogin"]</a>
                    </div>
                </div>
            }
        </article>
    </div>
</section>

@code {
    private string Token = string.Empty;
    private string NewPassword = string.Empty;
    private string ConfirmNewPassword = string.Empty;
    private string Message = string.Empty;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

        if (!string.IsNullOrWhiteSpace(uri.Query))
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            Token = query["token"] ?? string.Empty;
        }
    }

    private async Task HandleReset()
    {
        try
        {
            Message = string.Empty;

            var response = await Http.PostAsJsonAsync("api/auth/reset-password", new ResetPasswordRequestDto
            {
                Token = Token,
                NewPassword = NewPassword,
                ConfirmNewPassword = ConfirmNewPassword
            });

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = $"{L["Common_Error"]} : {error}";
                return;
            }

            Navigation.NavigateTo("/login?reset=1", forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }
}