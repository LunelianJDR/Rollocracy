@page "/twitch/complete"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Account
@using Rollocracy.Localization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["TwitchComplete_Title"]</PageTitle>

<section class="rc-auth-shell">
    <div class="rc-auth-grid">
        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h1 class="rc-tool-panel__title">@L["TwitchComplete_Title"]</h1>
                <p class="rc-tool-panel__subtitle">@L["TwitchComplete_Subtitle"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="rc-inline-warning">@Message</div>
            }

            @if (Pending is null)
            {
                <div class="rc-inline-error">@L["TwitchComplete_LoadError"]</div>
            }
            else
            {
                <div class="rc-tool-form-grid">
                    <div class="rc-form-field">
                        <label>@L["TwitchComplete_TwitchLogin"]</label>
                        <div class="rc-readonly-value">@Pending.TwitchLogin</div>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["TwitchComplete_TwitchEmail"]</label>
                        <div class="rc-readonly-value">
                            @(string.IsNullOrWhiteSpace(Pending.TwitchEmail) ? L["TwitchComplete_NoTwitchEmail"] : Pending.TwitchEmail)
                        </div>
                    </div>
                </div>

                <div class="rc-auth-form">
                    <div class="rc-form-field">
                        <label>@L["TwitchComplete_Username"]</label>
                        <input @bind="Username" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["TwitchComplete_EmailOptional"]</label>
                        <input @bind="Email" type="email" />
                    </div>

                    <div class="rc-form-field">
                        <label>@L["TwitchComplete_Language"]</label>
                        <select @bind="Language">
                            <option value="fr">@L["Language_French"]</option>
                            <option value="en">@L["Language_English"]</option>
                        </select>
                    </div>
                </div>

                <div class="rc-tool-actions">
                    <button type="button" @onclick="CompleteAsync">@L["TwitchComplete_Submit"]</button>
                    <a class="rc-auth-link-button" href="/login">@L["TwitchComplete_BackToLogin"]</a>
                </div>
            }
        </article>
    </div>
</section>

@code {
    private TwitchPendingSessionDto? Pending;
    private string PendingToken = string.Empty;
    private string Username = string.Empty;
    private string Email = string.Empty;
    private string Language = "fr";
    private string Message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        PendingToken = query["token"] ?? string.Empty;

        if (string.IsNullOrWhiteSpace(PendingToken))
            return;

        try
        {
            Pending = await Http.GetFromJsonAsync<TwitchPendingSessionDto>(
                $"api/twitch/pending?token={Uri.EscapeDataString(PendingToken)}");

            if (Pending != null)
            {
                Username = Pending.SuggestedUsername;
                Email = Pending.TwitchEmail ?? string.Empty;
                Language = Pending.Language;
            }
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task CompleteAsync()
    {
        try
        {
            Message = string.Empty;

            var response = await Http.PostAsJsonAsync("api/twitch/complete", new CompleteTwitchRegistrationRequestDto
            {
                PendingToken = PendingToken,
                Username = Username,
                Email = string.IsNullOrWhiteSpace(Email) ? null : Email,
                Language = Language
            });

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = $"{L["Common_Error"]} : {error}";
                return;
            }

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }
}