@page "/twitch/merge"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using Rollocracy.Domain.Account
@using Rollocracy.Localization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["TwitchMerge_Title"]</PageTitle>

<section class="rc-auth-shell">
    <div class="rc-auth-grid">
        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h1 class="rc-tool-panel__title">@L["TwitchMerge_Title"]</h1>
                <p class="rc-tool-panel__subtitle">@L["TwitchMerge_Subtitle"]</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="rc-inline-warning">@Message</div>
            }

            @if (Pending is null)
            {
                <div class="rc-inline-error">@L["TwitchMerge_LoadError"]</div>
            }
            else
            {
                <div class="rc-tool-form-grid">
                    <div class="rc-form-field">
                        <label>@L["TwitchMerge_MatchedLocalUsername"]</label>
                        <div class="rc-readonly-value">@Pending.MatchedUsername</div>
                    </div>

                    <div class="rc-form-field">
                        <label>@L["TwitchMerge_TwitchLogin"]</label>
                        <div class="rc-readonly-value">@Pending.TwitchLogin</div>
                    </div>

                    <div class="rc-form-field rc-form-field--full">
                        <label>@L["TwitchMerge_Email"]</label>
                        <div class="rc-readonly-value">
                            @(string.IsNullOrWhiteSpace(Pending.TwitchEmail) ? L["TwitchMerge_NoEmail"] : Pending.TwitchEmail)
                        </div>
                    </div>
                </div>

                @if (Pending.SuggestedUsernameAvailable &&
                                     !string.IsNullOrWhiteSpace(Pending.TwitchLogin) &&
                                     !string.Equals(Pending.MatchedUsername, Pending.TwitchLogin, StringComparison.Ordinal))
                {
                    <label class="rc-filter-toggle">
                        <input type="checkbox" @bind="RenameUsernameToTwitch" />
                        <span>@string.Format(L["TwitchMerge_RenameToTwitchLogin"], Pending.TwitchLogin)</span>
                    </label>
                }

                <div class="rc-tool-actions">
                    <button type="button" @onclick="MergeAsync">@L["TwitchMerge_Confirm"]</button>
                    <a class="rc-auth-link-button" href="/login">@L["TwitchMerge_Cancel"]</a>
                </div>
            }
        </article>
    </div>
</section>

@code {
    private TwitchPendingSessionDto? Pending;
    private string PendingToken = string.Empty;
    private bool RenameUsernameToTwitch;
    private string Message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        PendingToken = query["token"] ?? string.Empty;

        if (string.IsNullOrWhiteSpace(PendingToken))
            return;

        try
        {
            Pending = await Http.GetFromJsonAsync<TwitchPendingSessionDto>(
                $"api/twitch/pending?token={Uri.EscapeDataString(PendingToken)}");
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }

    private async Task MergeAsync()
    {
        try
        {
            Message = string.Empty;

            var response = await Http.PostAsJsonAsync("api/twitch/merge", new ConfirmTwitchMergeRequestDto
            {
                PendingToken = PendingToken,
                RenameUsernameToTwitchLogin = RenameUsernameToTwitch
            });

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = $"{L["Common_Error"]} : {error}";
                return;
            }

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = $"{L["Common_Error"]} : {ex.Message}";
        }
    }
}