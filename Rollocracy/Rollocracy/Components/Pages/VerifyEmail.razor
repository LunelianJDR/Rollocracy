@page "/verify-email"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using Rollocracy.Localization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedTexts> L

<PageTitle>@L["Auth_VerifyEmail_Title"]</PageTitle>

<section class="rc-auth-shell">
    <div class="rc-auth-grid">
        <article class="rc-auth-panel">
            <div class="rc-tool-panel__header-main">
                <h1 class="rc-tool-panel__title">@L["Auth_VerifyEmail_Title"]</h1>
                <p class="rc-tool-panel__subtitle">@L["Auth_VerifyEmail_Subtitle"]</p>
            </div>

            @if (IsLoading)
            {
                <p>@L["Common_Loading"]</p>
            }
            else if (IsSuccess)
            {
                <div class="rc-inline-warning">@L["Auth_VerifyEmail_Success"]</div>
                <div class="rc-tool-actions">
                    <a class="rc-auth-link-button" href="/login?verified=1">@L["Auth_VerifyEmail_GoToLogin"]</a>
                </div>
            }
            else
            {
                <div class="rc-inline-error">@ErrorMessage</div>
                <div class="rc-tool-actions">
                    <a class="rc-auth-link-button" href="/login">@L["Auth_VerifyEmail_GoToLogin"]</a>
                </div>
            }
        </article>
    </div>
</section>

@code {
    private bool IsLoading = true;
    private bool IsSuccess;
    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var token = query["token"] ?? string.Empty;

        if (string.IsNullOrWhiteSpace(token))
        {
            IsLoading = false;
            ErrorMessage = L["Auth_VerifyEmail_MissingToken"];
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/auth/verify-email?token={Uri.EscapeDataString(token)}");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await ExtractApiErrorMessageAsync(response, L["Auth_VerifyEmail_InvalidOrExpired"]);

                IsLoading = false;
                return;
            }

            IsSuccess = true;
            IsLoading = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"{L["Common_Error"]} : {ex.Message}";
            IsLoading = false;
        }
    }

    private async Task<string> ExtractApiErrorMessageAsync(HttpResponseMessage response, string fallbackMessage)
    {
        var contentType = response.Content.Headers.ContentType?.MediaType;
        var body = await response.Content.ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(body))
            return fallbackMessage;

        if (!string.IsNullOrWhiteSpace(contentType) &&
            contentType.Contains("html", StringComparison.OrdinalIgnoreCase))
        {
            return fallbackMessage;
        }

        var trimmed = body.Trim();

        if (trimmed.StartsWith("<!DOCTYPE html>", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("<html", StringComparison.OrdinalIgnoreCase))
        {
            return fallbackMessage;
        }

        return trimmed;
    }
}
